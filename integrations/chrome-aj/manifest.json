{
  "manifest_version": 3,
  "name": "Vibrexcup AJ — 내 AI 스트리머와 대화",
  "short_name": "Vibrexcup AJ",
  "description": "내 Vibrexcup AJ(AI 스트리머)와 어느 사이트에서든 대화해요. 지금 보는 페이지를 읽고 요약·반응합니다. 무료.",
  "version": "1.0.0",
  "homepage_url": "https://vibrexcup.com/dev",
  "action": { "default_popup": "popup.html", "default_title": "내 AJ와 대화" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://vibrexcup.com/*"]
}
