{
  "expo": {
    "name": "Vibrexcup",
    "slug": "vibrexcup",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vibrexcup",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.puritechlab.vibrexcup",
      "infoPlist": {
        "NSCameraUsageDescription": "게임 방송을 위해 카메라를 사용합니다.",
        "NSMicrophoneUsageDescription": "게임 방송을 위해 마이크를 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.puritechlab.vibrexcup",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "versionCode": 14
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "siteUrl": "https://vibrexcup.com",
      "eas": {
        "projectId": ""
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
}