orage',{value:s,configurable:true})}catch(_){}})()}</script><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>레일 질주</title>\n<style>html,body{margin:0;padding:0;background:#000;overflow:hidden;touch-action:none}#c{display:block;margin:auto}\n#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-family:sans-serif;color:#fff;text-align:center}\nbutton{padding:14px 28px;font-size:18px;border-radius:10px;border:none;background:#ff6b35;color:#fff;font-weight:bold}\n.pan{background:rgba(0,0,0,.6);padding:24px;border-radius:14px;max-width:90vw}</style></head>\n<body><canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nlet cv=document.getElementById('c'),ctx=cv.getContext('2d'),ui=document.getElementById('ui');\nlet W=0,H=0;\nfunction resize(){W=innerWidth;H=innerHeight;if(W<=0||H<=0){requestAnimationFrame(resize);return}cv.width=W;cv.height=H;}\naddEventListener('resize',resize);resize();\n\nlet phase='title',score=0,lives=3,dist=0,speedMul=1,lastSpeedUp=0,energy=1,guardCd=0,guarding=0,inv=0;\nconst GOAL=24000;const PXM=8;\nlet baseSpeed=180;\nlet px=W*0.28,vy=0,onRail=1,jumpHold=0,jumping=0;\nlet shield=0,shieldFlash=0;\nlet carY=0,carAngle=0;\nlet segs=[]; // rail segments: {x0,x1,gap:bool,gw}\nlet obstacles=[]; // {x,type}\nlet items=[]; // {x,type}\nlet startT=0,elapsed=0;\nlet playerSkin=null;\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;}\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\n\nlet keys={left:0,right:0,up:0,down:0,jump:0,fire:0,guard:0};\n\nfunction railY(x){\n  let y=H*0.45;\n  for(let f=0;f<3;f++){\n    y+=Math.sin(x*0.002*(f+1)+f*7)*40/(f+1);\n  }\n  y+=Math.sin(x*0.0006)*90;\n  return y;\n}\nfunction genWorld(){\n  segs=[];obstacles=[];items=[];\n  let x=0;\n  let lastGapX=-99999;\n  while(x<GOAL+2000){\n    let segLen=300+Math.random()*300;\n    let canGap=(x>800)&&(x-lastGapX>1000);\n    if(canGap&&Math.random()<0.35){\n      let gw=60+Math.random()*70;\n      segs.push({x0:x,x1:x+segLen,gap:false});\n      segs.push({x0:x+segLen,x1:x+segLen+gw,gap:true});\n      lastGapX=x+segLen;\n      x=x+segLen+gw;\n    } else {\n      segs.push({x0:x,x1:x+segLen,gap:false});\n      if(x>800&&Math.random()<0.3){\n        obstacles.push({x:x+segLen*0.5+Math.random()*100,type:Math.floor(Math.random()*3)});\n      }\n      if(Math.random()<0.5){\n        items.push({x:x+Math.random()*segLen,type:Math.random()<0.15?'star':(Math.random()<0.4?'heart':'coin'),got:0});\n      }\n      x+=segLen;\n    }\n  }\n}\n\nfunction isGapAt(x){\n  for(const s of segs){if(x>=s.x0&&x<s.x1)return s.gap;}\n  return false;\n}\nfunction nextGap(x){\n  for(const s of segs){if(s.gap&&s.x1>x)return s;}\n  return null;\n}\nfunction nextObstacle(x){\n  let best=null;\n  for(const o of obstacles){if(o.x>x&&(!best||o.x<best.x))best=o;}\n  return best;\n}\n\nfunction reset(){\n  score=0;lives=3;dist=0;speedMul=1;lastSpeedUp=0;energy=1;guardCd=0;guarding=0;inv=0;\n  px=W*0.28;vy=0;onRail=1;jumpHold=0;jumping=0;shield=0;\n  elapsed=0;startT=performance.now();\n  genWorld();\n  if(window.AJ)AJ.start();\n}\n\nfunction curSpeed(){return baseSpeed*speedMul*(guarding>0?0.45:1);}\n\nfunction update(dt){\n  if(phase!=='playing')return;\n  elapsed+=dt;\n  if(elapsed-lastSpeedUp>30){lastSpeedUp=elapsed;speedMul=Math.min(2.2,speedMul*1.15);}\n  if(guardCd>0)guardCd-=dt;\n  if(guarding>0)guarding-=dt;\n  if(keys.guard&&guardCd<=0&&guarding<=0){guarding=1;guardCd=3;}\n\n  inv=Math.max(0,inv-dt);\n  let sp=curSpeed();\n  dist+=sp*dt;\n  score=Math.floor(dist/PXM);\n  let worldX=dist;\n\n  let gapHere=isGapAt(worldX);\n  if(!jumping&&!gapHere){onRail=1;}\n\n  if(keys.fire&&jumpHold<0.35&&!jumping){jumpHold+=dt;}\n  else if(!keys.fire&&jumpHold>0&&!jumping){\n    jumping=1;vy=-(470+jumpHold*750);jumpHold=0;onRail=0;\n  }\n  if(jumping){\n    vy+=1500*dt;\n    carY+=vy*dt;\n    if(carY>=0){carY=0;jumping=0;vy=0;\n      if(isGapAt(worldX)){carY=0;jumping=0;onRail=1;}\n    }\n  } else {\n    carY=0;\n    if(gapHere){\n      hit();\n      let sg=segs.find(s=>s.gap&&worldX>=s.x0&&worldX<s.x1);\n      if(sg){dist=sg.x1+12;worldX=dist;}\n    }\n  }\n  let ob=obstacles.find(o=>Math.abs(o.x-worldX)<28&&!o.hit);\n  if(ob&&(!jumping||carY>-30)){\n    ob.hit=1;hit();\n  }\n  for(const it of items){\n    if(!it.got&&Math.abs(it.x-worldX)<25){\n      it.got=1;\n      if(it.type==='coin')score+=10;\n      else if(it.type==='heart')lives=Math.min(5,lives+1);\n      else if(it.type==='star')shield=1;\n    }\n  }\n  if(window.AJ)AJ.score(score);\n  if(dist>=GOAL){clearGame();}\n}\nfunction hit(){\n  if(inv>0)return;\n  if(shield){shield=0;shieldFlash=1;inv=0.8;return;}\n  lives--;inv=1.5;\n  if(lives<=0){gameOver();}\n}\nfunction gameOver(){\n  phase='over';\n  if(window.AJ)AJ.over(score);\n  showOver();\n}\nfunction clearGame(){\n  phase='cleared';\n  if(window.AJ)AJ.clear(score);\n  showClear();\n}\n\nfunction drawBg(){\n  let g=ctx.createLinearGradient(0,0,0,H);\n  g.addColorStop(0,'#3a7bd5');g.addColorStop(1,'#bfe6ff');\n  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);\n  let px1=(dist*0.05)%(W+400)-200;\n  ctx.fillStyle='rgba(255,255,255,0.85)';\n  for(let i=0;i<5;i++){\n    let x=(i*260-px1)%(W+300)-150;\n    ctx.beginPath();ctx.ellipse(x,80+((i*37)%60),40,20,0,0,7);ctx.fill();\n    ctx.beginPath();ctx.ellipse(x+35,90+((i*37)%60),30,16,0,0,7);ctx.fill();\n  }\n  let px2=(dist*0.12)%(W+400)-200;\n  ctx.strokeStyle='rgba(90,90,120,0.4)';ctx.lineWidth=6;\n  let wx=W*0.75-px2%(W+300);\n  ctx.beginPath();ctx.arc(wx,H*0.4,55,0,7);ctx.stroke();\n  for(let a=0;a<8;a++){let ang=a/8*7;ctx.beginPath();ctx.moveTo(wx,H*0.4);ctx.lineTo(wx+Math.cos(ang)*55,H*0.4+Math.sin(ang)*55);ctx.stroke();}\n  ctx.fillStyle='#5a8f3c';\n  ctx.fillRect(0,H-14,W,14);\n}\n\nfunction drawRail(){\n  ctx.lineWidth=2;\n  let camX=dist-W*0.28;\n  for(let wx=camX-50;wx<camX+W+50;wx+=8){\n    let sx=wx-camX;\n    let gap=isGapAt(wx);\n    let y=railY(wx);\n    if(!gap){\n      ctx.strokeStyle='#333';\n      let groundY=H-14;\n      ctx.beginPath();ctx.moveTo(sx,y+8);ctx.lineTo(sx,groundY);ctx.stroke();\n      if(wx%40<8){\n        ctx.beginPath();ctx.moveTo(sx-15,y+8);ctx.lineTo(sx+15,groundY-10);ctx.stroke();\n        ctx.beginPath();ctx.moveTo(sx+15,y+8);ctx.lineTo(sx-15,groundY-10);ctx.stroke();\n      }\n    }\n  }\n  for(let wx=camX-50;wx<camX+W+50;wx+=2){\n    let sx=wx-camX;\n    let gap=isGapAt(wx);\n    if(gap)continue;\n    let y0=railY(wx),y1=railY(wx+2);\n    ctx.strokeStyle='#8a3b12';ctx.lineWidth=5;\n    ctx.beginPath();ctx.moveTo(sx,y0-6);ctx.lineTo(sx+2,y1-6);ctx.stroke();\n    ctx.strokeStyle='#c96b2e';ctx.lineWidth=3;\n    ctx.beginPath();ctx.moveTo(sx,y0+6);ctx.lineTo(sx+2,y1+6);ctx.stroke();\n  }\n  for(let wx=camX-50;wx<camX+W+50;wx+=26){\n    let sx=wx-camX;\n    if(isGapAt(wx))continue;\n    let y=railY(wx);\n    let y2=railY(wx+2);\n    let ang=Math.atan2(y2-y,2);\n    ctx.strokeStyle='#5a2c0e';ctx.lineWidth=3;\n    ctx.save();ctx.translate(sx,y);ctx.rotate(ang);\n    ctx.beginPath();ctx.moveTo(-10,-6);ctx.lineTo(-10,7);ctx.stroke();\n    ctx.restore();\n  }\n  ctx.lineWidth=1;\n}\n\nfunction drawObstacles(){\n  let camX=dist-W*0.28;\n  const emo={0:'🪨',1:'🪵',2:'⚠️'};\n  ctx.font='30px sans-serif';ctx.textAlign='center';\n  for(const o of obstacles){\n    if(o.hit)continue;\n    let sx=o.x-camX;\n    if(sx<-30||sx>W+30)continue;\n    let y=railY(o.x);\n    ctx.fillText(emo[o.type],sx,y-10);\n  }\n  for(const it of items){\n    if(it.got)continue;\n    let sx=it.x-camX;\n    if(sx<-30||sx>W+30)continue;\n    let y=railY(it.x)-30;\n    ctx.font='24px sans-serif';\n    ctx.fillText(it.type==='star'?'★':it.type==='heart'?'♥':'🪙',sx,y);\n  }\n}\n\nfunction drawCart(){\n  let worldX=dist;\n  let y=railY(worldX)+carY;\n  let y2=railY(worldX+2);\n  let ang=Math.atan2(y2-railY(worldX