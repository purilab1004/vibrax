uto;text-align:center}\nbutton{font-size:20px;padding:12px 28px;border-radius:10px;border:none;background:#4ade80;color:#000;font-weight:bold;margin-top:14px;cursor:pointer}\n.hid{display:none}\n#hud{position:absolute;top:8px;left:8px;font-size:14px;text-shadow:1px 1px 2px #000}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\">\n<div id=\"hud\" class=\"hid\"></div>\n<div id=\"title\" class=\"scr\"><h1>🎢 레일 라이더</h1>\n<p>레일을 따라 카트를 몰아 종착역까지!</p>\n<p style=\"font-size:13px;max-width:320px\">이동: fire(스페이스/A)=부스트, guard(D)=브레이크<br>up/down=줌, 별 모으고 3스테이지 클리어</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>\n<div id=\"over\" class=\"scr hid\"><h1>탈선!</h1><p id=\"overScore\"></p>\n<button data-vibrex-role=\"restart\" id=\"rBtn1\">다시하기</button></div>\n<div id=\"clear\" class=\"scr hid\" data-vibrex-role=\"clear\"><h1>🏁 클리어!</h1><p id=\"clearScore\"></p>\n<button data-vibrex-role=\"restart\" id=\"rBtn2\">다시하기</button></div>\n</div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=innerWidth;cv.height=innerHeight;}\nresize();addEventListener('resize',resize);\nlet keys={left:0,right:0,up:0,down:0,jump:0,fire:0,guard:0};\naddEventListener('keydown',e=>{if(e.code=='Space')keys.fire=1;if(e.code=='KeyX'||e.code=='ShiftLeft')keys.guard=1;if(e.code=='ArrowUp')keys.up=1;if(e.code=='ArrowDown')keys.down=1;});\naddEventListener('keyup',e=>{if(e.code=='Space')keys.fire=0;if(e.code=='KeyX'||e.code=='ShiftLeft')keys.guard=0;if(e.code=='ArrowUp')keys.up=0;if(e.code=='ArrowDown')keys.down=0;});\n\nlet phase='title',stage=1,lives=3,score=0,zoom=1;\nlet cart,rail,camX=0,botOn=false;\nlet playerSkin=window.VIBREX_AVATAR||null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\n\nfunction genRail(seed,len,rough){\n  let pts=[],y=300,x=0,segs=[];\n  let n=Math.floor(len/60);\n  for(let i=0;i<n;i++){\n    let type='slope';\n    let r=Math.random();\n    if(i>2 && i<n-3){\n      if(r<0.15*rough) type='curve';\n      else if(r<0.22*rough) type='gap';\n    }\n    segs.push({x0:x,type,amp:(Math.random()*2-1)});\n    x+=60;\n  }\n  return segs;\n}\nfunction railY(seg,seedBase){\n  return seedBase;\n}\nfunction buildStage(st){\n  let rough=1+st*0.5;\n  let len=2400+st*900;\n  let n=Math.floor(len/50);\n  let pts=[],y=cv.height*0.45,vy=0;\n  let curves=[],gaps=[];\n  for(let i=0;i<n;i++){\n    let x=i*50;\n    let region=i/n;\n    let hilliness=0.3+rough*0.25;\n    if(i%14==0 && i>10 && i<n-14){\n      if(Math.random()<0.5){ curves.push(i); }\n      else { gaps.push(i); }\n    }\n    vy += (Math.sin(i*0.13+st)*hilliness*3 + (Math.random()-0.5)*hilliness);\n    vy=Math.max(-8,Math.min(8,vy));\n    y+=vy;\n    y=Math.max(cv.height*0.15,Math.min(cv.height*0.75,y));\n    pts.push({x,y,curve:false,gap:false});\n  }\n  curves.forEach(i=>{ for(let k=-1;k<=1;k++){ let idx=i+k; if(pts[idx]){pts[idx].curve=true; pts[idx].tight=0.5+Math.random()*0.5;} } });\n  let gapSet={};\n  gaps.forEach(i=>{ for(let k=0;k<3;k++){ let idx=i+k; if(pts[idx]) pts[idx].gap=true; } });\n  let stars=[];\n  for(let i=8;i<n-8;i+=Math.floor(6+Math.random()*6)){\n    if(!pts[i].gap && !pts[i].curve) stars.push({i,taken:false});\n  }\n  return {pts,len:n*50,stars,startX:pts[0].x,endX:pts[n-1].x};\n}\nfunction railYAt(rail,x){\n  let i=Math.floor(x/50);\n  if(i<0)i=0; if(i>=rail.pts.length-1)i=rail.pts.length-2;\n  let p0=rail.pts[i],p1=rail.pts[i+1];\n  if(!p0||!p1) return {y:cv.height*0.5,slope:0,curve:false,gap:false,tight:0};\n  let t=(x-p0.x)/50;\n  let y=p0.y+(p1.y-p0.y)*t;\n  let slope=(p1.y-p0.y)/50;\n  return {y,slope,curve:p0.curve,gap:p0.gap,tight:p0.tight||0};\n}\nfunction initStage(){\n  rail=buildStage(stage);\n  cart={x:rail.startX+30,vx:2,y:0,vy:0,airborne:false,energy:1,derailT:0,stallT:0};\n  let info=railYAt(rail,cart.x);\n  cart.y=info.y;\n  camX=0;\n}\nfunction resetGame(){stage=1;lives=3;score=0;initStage();phase='playing';}\n\nfunction startGame(){\n  document.getElementById('title').classList.add('hid');\n  document.getElementById('over').classList.add('hid');\n  document.getElementById('clear').classList.add('hid');\n  document.getElementById('hud').classList.remove('hid');\n  resetGame();\n  if(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\ndocument.getElementById('rBtn1').onclick=startGame;\ndocument.getElementById('rBtn2').onclick=startGame;\n\nfunction nextCurveInfo(){\n  let i0=Math.floor(cart.x/50);\n  for(let i=i0;i<Math.min(rail.pts.length,i0+60);i++){\n    let p=rail.pts[i];\n    if(p.curve) return {dist:Math.max(0,(p.x-cart.x))/3000,tight:p.tight,found:true};\n  }\n  return {dist:1,tight:0,found:false};\n}\nfunction nextGapInfo(){\n  let i0=Math.floor(cart.x/50);\n  for(let i=i0;i<Math.min(rail.pts.length,i0+60);i++){\n    let p=rail.pts[i];\n    if(p.gap) return {dist:Math.max(0,(p.x-cart.x))/3000,found:true};\n  }\n  return {dist:1,found:false};\n}\nfunction nextSlopeUpInfo(){\n  let i0=Math.floor(cart.x/50);\n  for(let i=i0;i<Math.min(rail.pts.length,i0+40);i++){\n    let a=rail.pts[i],b=rail.pts[i+1];\n    if(a&&b && (b.y-a.y)<-1.5) return {dist:Math.max(0,(a.x-cart.x))/2000,found:true};\n  }\n  return {dist:1,found:false};\n}\n\nfunction update(dt){\n  if(phase!=='playing')return;\n  let info=railYAt(rail,cart.x);\n  if(!cart.airborne){\n    let g=info.slope*0.35;\n    cart.vx += -g;\n    if(keys.fire && cart.energy>0){ cart.vx+=0.25; cart.energy=Math.max(0,cart.energy-0.012); }\n    else cart.energy=Math.min(1,cart.energy+0.003);\n    if(keys.guard) cart.vx*=0.93;\n    cart.vx=Math.max(0.3,Math.min(9,cart.vx));\n    if(info.gap){\n      cart.airborne=true; cart.vy=-2;\n    } else {\n      cart.y=info.y;\n    }\n    if(info.curve){\n      let maxSafe=4+ (1-info.tight)*4;\n      if(cart.vx>maxSafe+1.5){\n        cart.derailT+=dt;\n        if(cart.derailT>0.4){ loseLife(); }\n      } else cart.derailT=0;\n    } else cart.derailT=0;\n    if(info.slope<-0.15 && cart.vx<0.9){\n      cart.stallT+=dt;\n      if(cart.stallT>0.7){ loseLife(); }\n    } else cart.stallT=Math.max(0,cart.stallT-dt*2);\n  } else {\n    cart.vy+=0.25;\n    cart.x+=cart.vx*dt*60*0.3;\n    cart.y+=cart.vy*dt*60*0.3;\n    let info2=railYAt(rail,cart.x);\n    if(!info2.gap && cart.y>=info2.y-6){\n      cart.airborne=false; cart.y=info2.y; cart.vy=0;\n    }\n    if(cart.y>cv.height+200){ loseLife(); }\n  }\n  cart.x+=cart.vx*dt*60*0.5;\n  camX=cart.x-cv.width*0.3;\n  rail.stars.forEach(s=>{\n    if(!s.taken && Math.abs(rail.pts[s.i].x-cart.x)<25){\n      s.taken=true; score+=10; if(window.AJ)AJ.score(score);\n    }\n  });\n  if(keys.up) zoom=Math.min(1.6,zoom+0.02);\n  if(keys.down) zoom=Math.max(0.6,zoom-0.02);\n  if(cart.x>=rail.endX-40){\n    if(stage>=3){\n      phase='cleared';\n      document.getElementById('clearScore').innerText='최종 점수: '+score;\n      document.getElementById('clear').classList.remove('hid');\n      if(window.AJ)AJ.clear(score);\n    } else {\n      stage++;\n      if(window.AJ)AJ.level(stage);\n      initStage();\n    }\n  }\n}\nfunction loseLife(){\n  lives--;\n  if(lives<=0){\n    phase='over';\n    document.getElementById('overScore').innerText='점수: '+score;\n    document.getElementById('over').classList.remove('hid');\n    if(window.AJ)AJ.over(score);\n  } else {\n    let info=railYAt(rail,cart.x);\n    cart.vx=1.5; cart.airborne=false; cart.y=info.y; cart.vy=0; cart.derailT=0;cart.stallT=0;\n  }\n}\n\nfunction draw(){\n  ctx.fillStyle='#0a1030';ctx.fillRect(0,0,cv.width,cv.height);\n  if(phase==='title'){return;}\n  ctx.save();\n  let cx=cv.width*0.3,cy=cart?cart.y:cv.height*0.5;\n  ctx.translate(cx,cy);\n  ctx.scale(zoom,zoom);\n  ctx.translate(-cart.x,-cy);\n  ctx.strokeStyle='#94a3b8';ctx.lineWidth=6;\n  ctx.beginPath();\n  let i0=Math.max(0,Math.floor((camX-100)/50)),i1=Math.min(rail.pts.length-1,i0+40/zoom+60);\n  let started=false;\n  for(let i=i0;i<i1;i++){\n    let p=rail.pts[i];\n    if(p.gap){started=false;continue;}\n    if(!started){ctx.moveTo(p.x,p.y);started=true;}\n    else ctx.lineTo(p.x,p.y);\n    if(p.curve){ctx.strokeStyle='#f87171';}else{ctx.strokeStyle='#94a3b8';}\n  }\n  ctx.stroke();\n  ctx.fillStyle='#fde047';\n  rail.stars.forEach(s=>{\n    if(!s.taken){let p=rail.pts[s.i];ctx.font='20px sans-serif';ctx.fillText('⭐',p.x-10,p.y-20);}\n  });\n  ctx.font='26px sans-serif';\n  ctx.fillText('🏁',rail.endX-10,railYAt(rail,rail.endX).y-30);\n  let steep=Math.abs(railYAt(rail,cart.x).slope)>1.5;\n  ctx.font='18px sans-serif';\n  ctx.fillText(steep?'🙌':'🙂',cart.x-20,cart.y-18);\n  ctx.fillText(steep?'🙌':'🙂',cart.x+18,cart.y-18);\n  if(playerSkin){\n    let s=34;\n    ctx.drawImage(playerSkin,cart.x-s/2,cart.y-s,s,s);\n  } else {\n    ctx.fillStyle='#38bdf8';\n    ctx.fillRect(cart.x-14,cart.y-14,28,14);\n    ctx.beginPath();ctx.arc(cart.x-8,cart.y,5,0,7);ctx.arc(cart.x+8,cart.y,5,0,7);ctx.fillStyle='#111';ctx.fill();\n  }\n  ctx.restore();\n  if(botOn){ctx.fillStyle='#fbbf24';ctx.font='bold 14px sans-serif';ctx.fillText('AI PLAYING',cv.width/2-40,20);}\n  let hud=document.getElementById('hud');\n  hud.innerText=`스테이지 ${stage}/3  점수 ${score}  목숨 ${'❤'.repeat(lives)}  에너지 ${Math.round(cart.energy*100)}%`;\n}\n\nlet last=performance.now();\nfunction loop(t){\n  let dt=Math.min(0.033,(t-last)/1000);last=t;\n  update(dt);draw();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nwindow.VIBREX_GAME={\n  title:'레일 라이더',genre:'횡스크롤 라이딩',\n  goal:'3개 스테이지 종착역 도달',\n  clearCondition:'모든 스테이지 클리어',\n  controls:[{input:'fire',action:'부스트'},{input:'guard',action:'브레이크'},{input:'up',action:'줌인'},{input:'down',action:'줌아웃'}],\n  phase:()=>phase==='title'?'title':phase==='over'?'over':phase==='cleared'?'cleared':'playing',\n  progress:()=>{ if(!rail)return 0; let stageProg=cart.x/rail.len; return Math.min(1,((stage-1)+stageProg)/3); },\n  state:()=>{\n    if(!cart||!rail)return{score,lives,stage,phase};\n    let ci=nextCurveInfo(),gi=nextGapInfo();\n    let inf=railYAt(rail,cart.x);\n    return {score,lives,stage,phase,speed:cart.vx/9,slope:Math.max(-1,Math.min(1,inf.slope/3)),\n    energy:cart.energy,nextCurve:ci.dist,nextCurveTightness:ci.tight,gapAhead:gi.found&&gi.dist<0.3?1:0,gapDist:gi.dist,\n    progress:window.VIBREX_GAME.progress(),onGround:cart.airborne?0:1,selfVX:Math.min(1,cart.vx/9),selfVY:Math.max(-1,Math.min(1,cart.vy/5)),\n    fireReady:cart.energy>0.05?1:0};\n  },\n  start:()=>{ if(phase==='title')startGame(); },\n  restart:()=>{ startGame(); },\n  inputs:{left:v=>{},right:v=>{},up:v=>keys.up=v?1:0,down:v=>keys.down=v?1:0,jump:v=>{},fire:v=>keys.fire=v?1:0,guard:v=>keys.guard=v?1:0}\n};\n\nwindow.vibrexBot={\n  start(){\n    botOn=true;\n    this._t=setInterval(()=>{\n      if(phase==='title'){startGame();return;}\n      if(phase!=='playing')return;\n      let s=window.VIBREX_GAME.state();\n      keys.fire=0;keys.guard=0;\n      if(s.gapAhead){ if(s.speed<0.35)keys.fire=1; }\n      else if(s.nextCurve<0.15 && s.nextCurveTightness>0.5){\n        if(s.speed>0.45)keys.guard=1;\n      } else if(s.slope<-0.1 && s.speed<0.45){\n        keys.fire=1;\n      } else if(s.slope>0.3 && s.speed>0.6){\n        keys.guard=1;\n      }\n    },80);\n  },\n  stop(){botOn=false;clearInterval(this._t);keys.fire=0;keys.guard=0;}\n};\nif(window.VIBREX_AVATAR){window.vibrexAvatarAck&&window.vibrexAvatarAck();}\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,cancelable:true};try{var e=new KeyboardEvent(type,o);Object.defineProperty(e,'keyCode',{get:function(){return o.keyCode}});Object.defineProperty(e,'which',{get:function(){return o.keyCode}});wind