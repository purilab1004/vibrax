}\nfunction nextObst(){\n for(let i=0;i<rail.length;i++){\n  const s=rail[i];\n  if(s.x>camX+cartXscreen() && s.obst) return s;\n }\n return null;\n}\nfunction cartXscreen(){return W*0.28;}\n\nlet baseSpeed=140;\nfunction update(dt){\n if(phase!=='playing')return;\n const now=performance.now();\n if(now-lastBoost>30000){lastBoost=now;speedMul=Math.min(speedMul*1.15,3);}\n let sp=baseSpeed*speedMul;\n if(guardT>0){sp*=0.4;guardT-=dt;}\n if(guardCd>0)guardCd-=dt;\n energy=Math.min(1,energy+dt*0.33);\n camX+=sp*dt;\n dist=camX/10;\n score=Math.floor(dist);\n if(window.AJ)AJ.score(score);\n\n const cx=camX+cartXscreen();\n const info=railYatX(cx);\n let groundY_;\n if(info.gap && !jumping){\n  fallInto();\n }\n if(!jumping){\n  groundY_=info.y!=null?info.y:0;\n  cartY+=(-(groundY_)-cartY)*Math.min(1,dt*10);\n  if(Math.abs(cartVY)>50 && info.y!=null)cheer=0.5;\n } else {\n  cartVY+=800*dt;\n  cartY+=cartVY*dt;\n  const gy=info.y!=null?-(info.y):9999;\n  if(cartY>=gy && !info.gap){\n   cartY=gy;jumping=false;cartVY=0;cheer=0.4;\n  } else if(cartY>=200 && info.gap){\n   fallInto();\n  }\n }\n while(rail.length<400 || rail[rail.length-1].x<cx+800) genSeg();\n rail=rail.filter(s=>s.x+s.w+s.gw>cx-200);\n items=items.filter(it=>it.x>cx-200);\n for(const it of items){\n  if(!it.got && Math.abs(it.x-cx)<22 && Math.abs(-it.y-cartY)<40){\n   it.got=true;\n   if(it.t==='coin'){score+=10;}\n   else if(it.t==='♥'){lives=Math.min(5,lives+1);}\n   else if(it.t==='★'){shield=true;}\n  }\n }\n if(!jumping){\n  const obs=nextObst();\n  if(obs && Math.abs(obs.x+obs.w/2-cx)<18){\n   hit();\n  }\n }\n if(cheer>0)cheer-=dt;\n if(dist>=GOAL){clearGame();}\n}\nfunction fallInto(){\n if(!jumping){jumping=true;cartVY=200;}\n hit();\n}\nfunction hit(){\n if(shield){shield=false;return;}\n lives--;\n if(window.AJ)AJ.score(score);\n if(lives<=0){gameOver();}\n else{ // bump forward safely\n  jumping=true;cartVY=-300;cartY-=10;\n }\n}\nfunction gameOver(){\n phase='over';\n if(window.AJ)AJ.over(score);\n renderUI();\n}\nfunction clearGame(){\n phase='cleared';\n if(window.AJ)AJ.clear(score);\n renderUI();\n}\n\nfunction draw(){\n W=cv.width;H=cv.height;\n ctx.fillStyle='#87ceeb';ctx.fillRect(0,0,W,H);\n groundY=H*0.62;\n // parallax mountains\n ctx.fillStyle='#a9c7e0';\n for(let i=0;i<6;i++){\n  const mx=((i*260)-(camX*0.1)%260+260)%(W+300)-150;\n  ctx.beginPath();ctx.moveTo(mx,groundY);ctx.lineTo(mx+90,groundY-140);ctx.lineTo(mx+180,groundY);ctx.fill();\n }\n ctx.fillStyle='#fff';\n for(let i=0;i<5;i++){\n  const cx2=((i*300)-(camX*0.05)%300+300)%(W+300)-150;\n  ctx.beginPath();ctx.ellipse(cx2,80+((i%3)*30),40,18,0,0,7);ctx.fill();\n }\n if(phase!=='playing' && phase!=='paused' && phase!=='over' && phase!=='cleared'){return;}\n const cxScreen=cartXscreen();\n ctx.strokeStyle='#5a3a1a';ctx.lineWidth=6;\n ctx.beginPath();\n let started=false;\n for(const s of rail){\n  const sx=s.x-camX+cxScreen;\n  if(sx<-50||sx>W+50)continue;\n  if(!s.gap){\n   if(!started){ctx.moveTo(sx,groundY+s.y);started=true;}\n   ctx.lineTo(sx+s.w,groundY+s.y);\n  } else started=false;\n }\n ctx.stroke();\n for(const s of rail){\n  const sx=s.x-camX+cxScreen;\n  if(sx<-50||sx>W+50)continue;\n  if(s.obst){\n   ctx.font='26px sans-serif';ctx.textAlign='center';\n   ctx.fillText(s.obst,sx+s.w/2,groundY+s.y-10);\n  }\n }\n for(const it of items){\n  if(it.got)continue;\n  const sx=it.x-camX+cxScreen;\n  if(sx<-30||sx>W+30)continue;\n  ctx.font='24px sans-serif';ctx.textAlign='center';\n  ctx.fillText(it.t==='coin'?'🪙':it.t,sx,groundY+it.y);\n }\n // cart\n const cy=groundY+cartY;\n if(shield){\n  ctx.strokeStyle='rgba(255,255,0,.8)';ctx.lineWidth=3;\n  ctx.beginPath();ctx.arc(cxScreen,cy-14,32,0,7);ctx.stroke();\n }\n ctx.fillStyle='#e63946';\n ctx.fillRect(cxScreen-22,cy-16,44,20);\n ctx.beginPath();ctx.arc(cxScreen-14,cy+6,7,0,7);ctx.arc(cxScreen+14,cy+6,7,0,7);\n ctx.fillStyle='#333';ctx.fill();\n ctx.font=(cheer>0?'28px':'22px')+' sans-serif';ctx.textAlign='center';\n ctx.fillText('🧑',cxScreen-10,cy-16-(cheer>0?8:0));\n ctx.fillText('🧑',cxScreen+10,cy-16-(cheer>0?8:0));\n // hud\n ctx.textAlign='left';ctx.fillStyle='#000';ctx.font='16px sans-serif';\n ctx.fillText('점수 '+score,10,24);\n ctx.fillText('❤'.repeat(lives),10,46);\n ctx.fillText('거리 '+Math.floor(dist)+'/'+GOAL+'m',10,68);\n ctx.fillStyle='#333';ctx.fillRect(10,76,120,8);\n ctx.fillStyle='#2a9d8f';ctx.fillRect(10,76,120*Math.min(1,energy),8);\n if(botActive){ctx.fillStyle='#ff3333';ctx.font='bold 14px sans-serif';ctx.fillText('AI PLAYING',W/2-40,20);}\n}\n\nlet last=performance.now();\nfunction loop(t){\n const dt=Math.min(0.05,(t-last)/1000);last=t;\n if(jumping===false && phase==='playing' && keys.fire){\n  fireHeld+=dt;\n  if(fireHeld<0.35){cartVY=-(500+fireHeld*300);jumping=true;}\n }\n if(!keys.fire)fireHeld=0;\n if(keys.guard && guardCd<=0 && energy>=0.001 && guardT<=0){\n  guardT=1;guardCd=3;\n }\n if(botActive)botStep(dt);\n update(dt);\n draw();\n requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nfunction renderUI(){\n if(phase==='title'){\n  ui.innerHTML=`<div class=\"panel\"><h2>레일 질주</h2><p>끊임없이 가속하는 레일카트! 갭과 장애물을 점프로 피해 3000m 완주하라.</p>\n  <ul><li>fire(스페이스/탭): 길게 누를수록 높이 점프</li><li>guard(X/버튼): 짧은 감속</li></ul>\n  <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;\n  document.getElementById('vibrex-start').onclick=startGame;\n } else if(phase==='over'){\n  ui.innerHTML=`<div class=\"panel\"><h2>게임 오버</h2><p>점수: ${score}</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>`;\n  document.getElementById('rb').onclick=startGame;\n } else if(phase==='cleared'){\n  ui.innerHTML=`<div class=\"panel\" data-vibrex-role=\"clear\"><h2>클리어! 🎉</h2><p>최종 점수: ${score}</p><button data-vibrex-role=\"restart\" id=\"rb2\">다시하기</button></div>`;\n  document.getElementById('rb2').onclick=startGame;\n } else {\n  ui.innerHTML='';\n }\n}\nfunction startGame(){\n initRail();phase='playing';renderUI();\n if(window.AJ)AJ.start();\n}\nphase='title';r