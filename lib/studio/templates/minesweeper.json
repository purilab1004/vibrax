0,0,0,0.85);z-index:5}\n.ov h1{font-size:28px;margin:6px}\n.ov p{font-size:14px;color:#ccc;margin:4px}\n.ov button{margin-top:14px;padding:12px 26px;font-size:18px;border:none;border-radius:8px;background:#4caf50;color:#fff}\n#hud{position:absolute;top:6px;left:0;width:100%;text-align:center;color:#fff;font-size:15px;z-index:2;pointer-events:none}\n#botind{position:absolute;top:6px;right:10px;color:#0f0;font-size:12px;display:none;z-index:6}\n</style></head>\n<body>\n<div id=\"wrap\"><canvas id=\"c\"></canvas></div>\n<div id=\"hud\"></div>\n<div id=\"botind\">AI PLAYING</div>\n<div class=\"ov\" id=\"title\">\n<h1>💣 지뢰 탐색</h1>\n<p>9x9 칸, 지뢰 10개. 모든 안전칸을 열면 클리어!</p>\n<p>방향키: 커서 이동 · Space(fire): 열기 · X(useItem): 깃발 토글</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div class=\"ov\" id=\"over\" style=\"display:none\">\n<h1>💥 게임오버</h1><p id=\"overScore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restart()\">다시하기</button>\n</div>\n<div class=\"ov\" id=\"clear\" data-vibrex-role=\"clear\" style=\"display:none\">\n<h1>🎉 클리어!</h1><p id=\"clearScore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restart()\">다시하기</button>\n</div>\n<script>\nconst W=9,H=9,MINES=10,N=W*H,BUDGET=150;\nlet mine,opened,flag,num,cx,cy,phase='title',flagCount,openedCount,startT,timeSec,first;\nlet botActive=false,botTimerId=null,lastMove=0;\nconst held={left:false,right:false,up:false,down:false};\nconst canvas=document.getElementById('c'),ctx=canvas.getContext('2d');\nfunction idx(x,y){return y*W+x}\nfunction neighbors(x,y){let r=[];for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){if(dx==0&&dy==0)continue;let nx=x+dx,ny=y+dy;if(nx>=0&&nx<W&&ny>=0&&ny<H)r.push(idx(nx,ny))}return r}\nfunction init(){\n mine=new Array(N).fill(false);opened=new Array(N).fill(false);flag=new Array(N).fill(false);num=new Array(N).fill(0);\n cx=4;cy=4;flagCount=0;openedCount=0;first=true;timeSec=0;startT=performance.now();\n}\nfunction placeMines(ex){\n let exclude=new Set([ex,...neighbors(ex%W,Math.floor(ex/W))]);\n let cells=[];for(let i=0;i<N;i++)if(!exclude.has(i))cells.push(i);\n for(let i=cells.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[cells[i],cells[j]]=[cells[j],cells[i]]}\n for(let i=0;i<MINES;i++)mine[cells[i]]=true;\n for(let y=0;y<H;y++)for(let x=0;x<W;x++){let i=idx(x,y);if(mine[i])continue;let c=0;for(const n of neighbors(x,y))if(mine[n])c++;num[i]=c}\n}\nfunction floodOpen(sx,sy){\n let stack=[idx(sx,sy)];\n while(stack.length){\n  let i=stack.pop();\n  if(opened[i]||flag[i])continue;\n  opened[i]=true;openedCount++;\n  if(num[i]==0){let x=i%W,y=Math.floor(i/W);for(const n of neighbors(x,y))if(!opened[n]&&!flag[n])stack.push(n)}\n }\n}\nfunction doOpen(){\n if(phase!='playing')return;\n let i=idx(cx,cy);\n if(flag[i]||opened[i])return;\n if(first){placeMines(i);first=false;}\n if(mine[i]){opened[i]=true;phase='over';for(let k=0;k<N;k++)opened[k]=true;\n  document.getElementById('overScore').innerText='점수: '+openedCount;\n  document.getElementById('over').style.display='flex';\n  if(window.AJ)AJ.over(openedCount);\n  return;\n }\n floodOpen(cx,cy);\n if(window.AJ)AJ.score(openedCount);\n checkWin();\n}\nfunction doFlag(){\n if(phase!='playing')return;\n let i=idx(cx,cy);\n if(opened[i])return;\n flag[i]=!flag[i];flagCount+=flag[i]?1:-1;\n}\nfunction checkWin(){\n if(openedCount>=N-MINES){\n  phase='cleared';\n  let bonus=Math.max(0,Math.floor(BUDGET-timeSec))*2;\n  let sc=openedCount+bonus;\n  document.getElementById('clearScore').innerText='점수: '+sc+' (열린칸 '+openedCount+' + 시간보너스 '+bonus+')';\n  document.getElementById('clear').style.display='flex';\n  if(window.AJ)AJ.clear(sc);\n }\n}\nfunction moveCursor(dx,dy){cx=Math.max(0,Math.min(W-1,cx+dx));cy=Math.max(0,Math.min(H-1,cy+dy));}\nfunction analyze(){\n let safe=new Set(),mines=new Set(),changed=true;\n while(changed){\n  changed=false;\n  for(let y=0;y<H;y++)for(let x=0;x<W;x++){\n   let i=idx(x,y);\n   if(!opened[i]||num[i]==0)continue;\n   let nb=neighbors(x,y);\n   let unopened=nb.filter(n=>!opened[n]);\n   let flagOrMine=unopened.filter(n=>flag[n]||mines.has(n)).length;\n   let unknown=unopened.filter(n=>!flag[n]&&!mines.has(n)&&!safe.has(n));\n   if(flagOrMine==num[i]){for(const n of unknown){if(!safe.has(n)){safe.add(n);changed=true}}}\n   if(flagOrMine+unknown.length==num[i]&&unknown.length>0){for(const n of unknown){if(!mines.has(n)){mines.add(n);changed=true}}}\n  }\n }\n return {safe,mines};\n}\nfunction botTick(){\n if(phase=='title'){document.getElementById('vibrex-start').click();return;}\n if(phase!='playing')return;\n let {safe,mines}=analyze();\n let target=-1,act='open';\n for(const s of safe){target=s;act='open';break;}\n if(target<0)for(const m of mines){if(!flag[m]){target=m;act='flag';break;}}\n if(target<0){\n  let cand=[];for(let i=0;i<N;i++)if(!opened[i]&&!flag[i])cand.push(i);\n  if(cand.length>0){target=cand[Math.floor(Math.random()*cand.length)];act='open';}\n }\n if(target>=0){cx=target%W;cy=Math.floor(target/W);if(act=='open')doOpen();else doFlag();}\n}\nwindow.vibrexBot={start(){botActive=true;document.getElementById('botind').style.display='block';if(botTimerId)clearInterval(botTimerId);botTimerId=setInterval(botTick,350);},\n stop(){botActive=false;document.getElementById('botind').style.display='none';if(botTimerId){clearInterval(botTimerId);botTimerId=null;}},\n setSkill(){}};\ndocument.addEventListener('keydown',e=>{\n if(phase!='playing')return;\n let now=performance.now();\n if(e.code=='ArrowLeft'||e.code=='ArrowRight'||e.code=='ArrowUp'||e.code=='ArrowDown'){\n  if(now-lastMove<90)return;lastMove=now;\n  if(e.code=='ArrowLeft')moveCursor(-1,0);\n  if(e.code=='ArrowRight')moveCursor(1,0);\n  if(e.code=='ArrowUp')moveCursor(0,-1);\n  if(e.code=='ArrowDown')moveCursor(0,1);\n }\n if(e.code=='Space'&&!e.repeat)doOpen();\n if(e.code=='KeyX'&&!e.repeat)doFlag();\n});\nfunction resize(){\n let s=Math.min(window.innerWidth,window.innerHeight)*0.9;\n canvas.width=s;canvas.height=s;\n}\nwindow.addEventListener('resize',resize);resize();\nfunction draw(){\n ctx.clearRect(0,0,canvas.width,canvas.height);\n let cs=canvas.width/W;\n for(let y=0;y<H;y++)for(let x=0;x<W;x++){\n  let i=idx(x,y);\n  ctx.fillStyle=opened[i]?'#ddd':'#555';\n  ctx.fillRect(x*cs,y*cs,cs-2,cs-2);\n  if(opened[i]&&mine[i]){ctx.font=(cs*0.6)+'px sans-serif';ctx.fillText('💣',x*cs+cs*0.2,y*cs+cs*0.75);}\n  else if(opened[i]&&num[i]>0){\n   const cols=['','#2196f3','#4caf50','#f44336','#9c27b0','#795548','#00bcd4','#000','#888'];\n   ctx.fillStyle=cols[num[i]];ctx.font='bold '+(cs*0.55)+'px sans-serif';\n   ctx.fillText(num[i],x*cs+cs*0.35,y*cs+cs*0.68);\n  } else if(!opened[i]&&flag[i]){ctx.font=(cs*0.55)+'px sans-serif';ctx.fillText('🚩',x*cs+cs*0.22,y*cs+cs*0.72);}\n }\n if(phase=='playing'){\n  ctx.strokeStyle='#ffeb3b';ctx.lineWidth=3;\n  ctx.strokeRect(cx*cs+1,cy*cs+1,cs-4,cs-4);\n }\n document.getElementById('hud').innerText=phase=='playing'?('🚩 '+(MINES-flagCount)+'  ⏱ '+timeSec+'s  점수:'+openedCount):'';\n}\nfunction loop(){\n if(phase=='playing')timeSec=Math.floor((performance.now()-startT)/1000);\n if(held.left||held.right||held.up||held.down){\n  let now=performance.now();\n  if(now-lastMove>150){\n   if(held.left)moveCursor(-1,0);\n   if(held.right)moveCursor(1,0);\n   if(held.up)moveCursor(0,-1);\n   if(held.down)moveCursor(0,1);\n   lastMove=now;\n  }\n }\n draw();\n requestAnimationFrame(loop);\n}\nfunction startGame(){\n init();phase='playing';\n document.getElementById('title').style.display='none';\n document.getElementById('over').style.display='none';\n document.getElementById('clear').style.display='none';\n if(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\nfunction restart(){\n document.getElementById('over').style.display='none';\n document.getElementById('clear').style.display='none';\n if(window.AJ)AJ.restart();\n startGame();\n}\ninit();draw();\nrequestAnimationFrame(loop);\nwindow.VIBREX_GAME={\n title:'지뢰 탐색',genre:'퍼즐',goal:'모든 안전칸 열기',clearCondition:'지뢰 아닌 71칸을 모두 열면 클리어',\n controls:[{input:'left',action:'왼쪽 이동'},{input:'right',action:'오른쪽 이동'},{input:'up',action:'위 이동'},{input:'down',action:'아래 이동'},{input:'fire',action:'칸 열기'},{input:'useItem',action:'깃발 토글'}],\n phase(){return phase;},\n progress(){return openedCount/(N-MINES);},\n state(){\n  let {safe}=phase=='playing'?analyze():{safe:new Set()};\n  return {opened:openedCount,flags:flagCount,minesLeft:MINES-flagCount,progress:openedCount/(N-MINES),score:openedCount,cursorX:cx,cursorY:cy,safeMoves:safe.size,timeSec:timeSec};\n },\n start(){startGame();},\n restart(){restart();},\n inputs:{\n  left(on){held.left=on;},right(on){held.right=on;},up(on){held.up=on;},down(on){held.down=on;},\n  fire(on){if(on)doOpen();},useItem(on){if(on)doFlag();},\n  guard(){},jump(){},item1(){},item2(){},item3(){},item4(){},aimX(){},aimY(){}\n }\n};\nif(window.VIBREX_AVATAR){window.vibrexAvatarAck&&window.vibrexAvatarAck();}\nwindow.addEventListener('vibrex:avatar',e=>{window.vibrexAvatarAck&&window.vibrexAvatarAck();});\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,cancelable:true};try{var e=new KeyboardEvent(type,o);Object.defineProperty(e,'keyCode',{get:function(){return o.keyCode}});Object.defineProperty(e,'which',{get:function(){return o.keyCode}});window.dispatchEvent(e);document.dispatchEvent(e);(document.activeElement||document.body).dispatchEvent(e);var c=document.querySelector('canvas');if(c)c.dispatchEvent(e)}catch(e2){}}function inp(name,on){var G=window.VIBREX_GAME;if(G&&G.inputs&&typeof G.inputs[name]==='function'){try{G.inputs[name](on)}catch(e){}}}function set(key,name,on){if(!!held[key]===on)return;held[key]=on;kev(on?'keydown':