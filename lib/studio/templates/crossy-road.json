],logs:[]};\nif(r<0.7){\nlet dir=Math.random()<0.5?1:-1,speed=1+Math.random()*1.5,cars=[];\nfor(let k=0;k<3;k++)cars.push({x:(k*4+Math.random()*2)%(cols+4)-2,w:0.9,dir,speed});\nreturn{type:1,dir,speed,cars,logs:[]};\n}\nlet dir=Math.random()<0.5?1:-1,speed=0.6+Math.random()*1.2,logs=[];\nfor(let k=0;k<3;k++)logs.push({x:(k*4+Math.random()*2)%(cols+4)-2,w:2,dir,speed});\nreturn{type:2,dir,speed,cars:[],logs};\n}\nfor(let i=0;i<60;i++)lanes.push(mkLane(i));\nfunction laneAt(r){if(!lanes[r])lanes[r]=mkLane(r);return lanes[r];}\nfunction checkSafeAt(row,col){\nlet ln=laneAt(row);\nif(ln.type===0)return true;\nif(ln.type===1)return !ln.cars.some(c=>Math.abs(c.x-col)<1.0);\nreturn ln.logs.some(l=>Math.abs(l.x-col)<0.9);\n}\nfunction reset(){\nplayer={x:4,row:0};cameraRow=0;chaseRow=-6;maxRow=0;\nfor(let i=1;i<60;i++)lanes[i]=mkLane(i);\n}\nfunction tryMove(dx,dy){\nif(phase!=='playing')return;\nlet now=performance.now();\nif(now-lastMove<140)return;\nlastMove=now;\nlet nx=Math.max(0,Math.min(cols-1,Math.round(player.x)+dx));\nlet nr=Math.max(0,player.row+dy);\nplayer.x=nx;player.row=nr;\n}\ndocument.addEventListener('keydown',e=>{\nif(e.code==='ArrowUp')tryMove(0,1);\nelse if(e.code==='ArrowDown')tryMove(0,-1);\nelse if(e.code==='ArrowLeft')tryMove(-1,0);\nelse if(e.code==='ArrowRight')tryMove(1,0);\n});\nfunction findNearestCar(){\nlet best=null,bd=999;\nlet ln=laneAt(player.row);\nif(ln.type===1){\nfor(const c of ln.cars){let d=Math.abs(c.x-player.x);if(d<bd){bd=d;best=c;}}\n}\nreturn best;\n}\nfunction getState(){\nlet ln=laneAt(player.row)||{type:0,cars:[],logs:[]};\nlet car=findNearestCar();\nlet dDX=0,dDist=1,dETA=1;\nif(car){\ndDX=Math.max(-1,Math.min(1,(car.x-player.x)/cols));\ndDist=Math.max(0,Math.min(1,Math.abs(car.x-player.x)/cols));\nlet rel=car.dir*car.speed;\ndETA=rel!==0?Math.max(0,Math.min(1,Math.abs(car.x-player.x)/Math.abs(rel)/5)):1;\n}\nlet logDX=0;\nif(ln.type===2){\nlet bl=null,bd=999;\nfor(const l of ln.logs){let d=Math.abs(l.x-player.x);if(d<bd){