exBot&&typeof window.vibrexBot.stop==='function'){try{window.vibrexBot.stop()}catch(e1){}}fallbackStop()}});})();</script><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\"><title>미니 축구 3대3</title>\n<style>\nbody{margin:0;background:#000;overflow:hidden;touch-action:none}\n#c{display:block;background:#063}\n.ov{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;font-family:sans-serif;background:rgba(0,0,0,.78);text-align:center;padding:20px;box-sizing:border-box;z-index:10}\nbutton{font-size:20px;padding:10px 26px;margin-top:14px;border-radius:8px;border:none;background:#3af;color:#fff;cursor:pointer}\nli{list-style:none;margin:4px 0}\n#hud{position:fixed;top:8px;left:0;right:0;text-align:center;color:#fff;font-family:sans-serif;font-size:18px;z-index:5;pointer-events:none;text-shadow:0 0 4px #000}\n#bot{position:fixed;top:8px;right:8px;color:#ff0;font-family:sans-serif;font-size:14px;z-index:6}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"hud\"></div>\n<div id=\"bot\"></div>\n<div class=\"ov\" id=\"titleScr\"><h1>미니 축구 3대3</h1><p>내 팀 1명을 조작해 상대보다 많은 골을 넣으세요! (전후반 45초)</p>\n<ul><li>방향키/WASD : 이동</li><li>X : 슛 / 태클</li><li>Space : 패스(가까운 아군)</li><li>Shift 또는 Z : 스프린트</li></ul>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>\n<div class=\"ov\" id=\"overScr\" style=\"display:none\"><h1>패배...</h1><p id=\"overScore\"></p><button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button></div>\n<div class=\"ov\" id=\"clearScr\" data-vibrex-role=\"clear\" style=\"display:none\"><h1>승리!</h1><p id=\"clearScore\"></p><button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=innerWidth;cv.height=innerHeight;}\naddEventListener('resize',resize);resize();\nconst FW=960,FH=600,GY1=220,GY2=380,HALF=45;\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\nlet phase='title',matchTime=0,half=1,myGoals=0,theirGoals=0,score=0,controlledId=0;\nlet ball={x:FW/2,y:FH/2,vx:0,vy:0,owner:null,grace:null,graceT:0};\nlet players=[];\nlet botActive=false,botRestarted=false;\nlet keys={left:false,right:false,up:false,down:false,jump:false,fire:false,guard:false};\nlet prevFire=false,prevJump=false;\nlet so={me:0,them:0,round:0,max:3,sub:'me',timer:0,themDone:false,finished:false};\nfunction mkPlayer(team,x,y,id){return{team,x,y,vx:0,vy:0,fx:team===0?1:-1,fy:0,id};}\nfunction formTeams(){\n players=[];\n players.push(mkPlayer(0,180,180,0),mkPlayer(0,180,300,1),mkPlayer(0,180,420,2));\n players.push(mkPlayer(1,780,180,3),mkPlayer(1,780,300,4),mkPlayer(1,780,420,5));\n}\nfunction team(t){return players.filter(p=>p.team===t);}\nfunction clampP(p){p.x=Math.max(14,Math.min(FW-14,p.x));p.y=Math.max(14,Math.min(FH-14,p.y));}\nfunction resetKickoff(){\n formTeams();\n ball.x=FW/2;ball.y=FH/2;ball.vx=0;ball.vy=0;ball.owner=null;ball.grace=null;ball.graceT=0;\n}\nfunction nearestTo(list,x,y){let b=null,bd=1e9;for(const p of list){const d=Math.hypot(p.x-x,p.y-y);if(d<bd){bd=d;b=p;}}return{p:b,d:bd};}\nfunction goalScored(teamThatScored){\n if(teamThatScored===0)myGoals++;else theirGoals++;\n score=myGoals*10;\n if(window.AJ)AJ.score(score);\n resetKickoff();\n}\nfunction shootBall(p,gx,gy,spread){\n const dx=gx-p.x+(Math.random()-.5)*spread, dy=gy-p.y+(Math.random()-.5)*(spread*1.2);\n const d=Math.hypot(dx,dy)||1;\n ball.vx=dx/d*480;ball.vy=dy/d*480;ball.owner=null;ball.grace=p;ball.graceT=0.3;\n}\nfunction passBall(p){\n const mates=team(p.team).filter(t=>t!==p);\n const r=nearestTo(mates,p.x,p.y);\n if(!r.p)return;\n const dx=r.p.x-p.x, dy=r.p.y-p.y, d=Math.hypot(dx,dy)||1;\n ball.vx=dx/d*320;ball.vy=dy/d*320;ball.owner=null;ball.grace=p;ball.graceT=0.25;\n}\nfunction moveTowards(p,dx,dy,dt,spd){\n const d=Math.hypot(dx,dy);\n if(d>3){const fx=dx/d,fy=dy/d;p.x+=fx*spd*dt;p.y+=fy*spd*dt;p.fx=fx;p.fy=fy;p.vx=fx*spd;p.vy=fy*spd;}\n else{p.vx=0;p.vy=0;}\n clampP(p);\n}\nfunction aiPlayer(p,dt){\n const carrier=ball.owner;\n if(carrier===p){\n  const gx=p.team===0?FW-20:20, gy=(GY1+GY2)/2;\n  const dx=gx-p.x, dy=gy-p.y, dist=Math.hypot(dx,dy);\n  const opps=team(1-p.team);\n  const no=nearestTo(opps,p.x,p.y);\n  if(dist<170){shootBall(p,gx,gy,60);}\n  else if(no.p&&no.d<55){passBall(p);}\n  else moveTowards(p,dx,dy,dt,150);\n  return;\n }\n const mine=team(p.team);\n const teamCarrier=mine.find(t=>t===ball.owner);\n let tx,ty;\n if(teamCarrier){\n  const dir=p.team===0?1:-1;\n  tx=teamCarrier.x+dir*90+(p.id%2?0:20);\n  ty=teamCarrier.y+(p.id%2?70:-70);\n } else if(ball.owner&&ball.owner.team!==p.team){\n  tx=ball.owner.x-(p.team===0?40:-40); ty=ball.owner.y;\n } else {\n  tx=ball.x; ty=ball.y;\n }\n moveTowards(p,tx-p.x,ty-p.y,dt,130);\n}\nfunction updateBallPhysics(dt){\n if(ball.owner){\n  ball.x=ball.owner.x+ball.owner.fx*18;\n  ball.y=ball.owner.y+ball.owner.fy*18;\n } else {\n  ball.x+=ball.vx*dt; ball.y+=ball.vy*dt;\n  ball.vx*=Math.pow(0.35,dt); ball.vy*=Math.pow(0.35,dt);\n  if(ball.y<12){ball.y=12;ball.vy*=-0.6;}\n  if(ball.y>FH-12){ball.y=FH-12;ball.vy*=-0.6;}\n  if(ball.x<12){\n   if(ball.y>GY1&&ball.y<GY2){goalScored(1);return;}\n   else{ball.x=12;ball.vx*=-0.6;}\n  }\n  if(ball.x>FW-12){\n   if(ball.y>GY1&&ball.y<GY2){goalScored(0);return;}\n   else{ball.x=FW-12;ball.vx*=-0.6;}\n  }\n  if(ball.grace){ball.graceT-=dt; if(ball.graceT<=0)ball.grace=null;}\n  let best=null,bd=20;\n  for(const p of players){\n   if(p===ball.grace)continue;\n   const d=Math.hypot(p.x-ball.x,p.y-ball.y);\n   if(d<bd){bd=d;best=p;}\n  }\n  if(best){ball.owner=best;ball.grace=null;}\n }\n if(ball.owner){\n  for(const p of players){\n   if(p.team!==ball.owner.team){\n    const d=Math.hypot(p.x-ball.owner.x,p.y-ball.owner.y);\n    if(d<20&&Math.random()<0.02){ball.owner=p;ball.grace=null;}\n   }\n  }\n }\n}\nfunction updatePlaying(dt){\n matchTime+=dt;\n if(ball.owner&&ball.owner.team===0){controlledId=ball.owner.id;}\n else {const r=nearestTo(team(0),ball.x,ball.y); controlledId=r.p.id;}\n const cp=players[controlledId];\n let mx=(keys.right?1:0)-(keys.left?1:0), my=(keys.down?1:0)-(keys.up?1:0);\n const spd=keys.guard?230:140;\n if(mx||my){const d=Math.hypot(mx,my);cp.fx=mx/d;cp.fy=my/d;cp.x+=cp.fx*spd*dt;cp.y+=cp.fy*spd*dt;cp.vx=cp.fx*spd;cp.vy=cp.fy*spd;}\n else{cp.vx=0;cp.vy=0;}\n clampP(cp);\n const justFire=keys.fire&&!prevFire, justJump=keys.jump&&!prevJump;\n const hasBall=ball.owner===cp;\n if(justJump&&hasBall)passBall(cp);\n if(justFire){\n  if(hasBall)shootBall(cp,FW-10,(GY1+GY2)/2,30);\n  else{\n   const opps=team(1);\n   const carrierOpp=opps.find(o=>o===ball.owner);\n   if(carrierOpp&&Math.hypot(carrierOpp.x-cp.x,carrierOpp.y-cp.y)<45){\n    if(Math.random()<0.7){ball.owner=cp;ball.grace=null;}\n    else{ball.owner=null;ball.vx=(Math.random()-.5)*200;ball.vy=(Math.random()-.5)*200;ball.grace=carrierOpp;ball.graceT=0.2;}\n   }\n  }\n }\n for(const p of players){ if(p!==cp) aiPlayer(p,dt); }\n updateBallPhysics(dt);\n prevFire=keys.fire; prevJump=keys.jump;\n if(half===1&&matchTime>=HALF){half=2;matchTime=0;resetKickoff();if(window.AJ)AJ.level(2);}\n else if(half===2&&matchTime>=HALF){ endMatch(); }\n}\nfunction endMatch(){\n if(myGoals>theirGoals){phase='cleared';showEnd(true);}\n else if(myGoals<theirGoals){phase='over';showEnd(false);}\n else { phase='shootout'; so={me:0,them:0,round:0,max:3,sub:'me',timer:0,themDone:false,finished:false}; }\n}\nfunction updateShootout(dt){\n if(so.finished)return;\n so.timer+=dt;\n const marker=Math.sin(so.timer*4);\n const justFire=keys.fire&&!prevFire;\n if(so.sub==='me'){\n  if(justFire){ if(Math.abs(marker)<0.35)so.me++; advanceSO(); }\n  else if(so.timer>2.5) advanceSO();\n } else {\n  if(so.timer>1.0&&!so.themDone){ if(Math.random()<0.6)so.them++; so.themDone=true; }\n  if(so.timer>1.8) advanceSO();\n }\n prevFire=keys.fire; prevJump=keys.jump;\n}\nfunction advanceSO(){\n if(so.sub==='me'){ so.sub='them'; so.timer=0; so.themDone=false; }\n else {\n  so.sub='me'; so.timer=0; so.round++;\n  if(so.round>=so.max){\n   if(so.me!==so.them||so.max>=8) finishSO();\n   else so.max++;\n  }\n }\n}\nfunction finishSO(){\n so.finished=true;\n score=myGoals*10+so.me;\n if(so.me>so.them){phase='cleared';showEnd(true);}\n else{phase='over';showEnd(false);}\n}\nfunction showEnd(won){\n if(won){document.getElementById('clearScore').textContent='최종 점수: '+score;document.getElementById('clearScr').style.display='flex';if(window.AJ)AJ.clear(score);}\n else{document.getElementById('overScore').textContent='최종 점수: '+score;document.getElementById('overScr').style.display='flex';if(window.AJ)AJ.over(score);}\n}\nfunction startGame(){\n document.getElementById('titleScr').style.display='none';\n document.getElementById('overScr').style.display='none';\n document.getElementById('clearScr').style.display='none';\n phase='playing';matchTime=0;half=1;myGoals=0;theirGoals=0;score=0;botRestarted=false;\n resetKickoff();\n if(window.AJ)AJ.start();\n}\nfunction restartGame(){\n if(window.AJ)AJ.restart();\n startGame();\n}\ndocument.getElementById('vibrex-start').addEventListener('click',startGame);\nwindow.addEventListener('keydown',e=>{\n if(e.code==='ArrowLeft'||e.code==='KeyA')keys.left=true;\n if(e.code==='ArrowRight'||e.code==='KeyD')keys.right=true;\n if(e.code==='ArrowUp'||e.code==='KeyW')keys.up=true;\n if(e.code==='ArrowDown'||e.code==='KeyS')keys.down=true;\n if(e.code==='Space')keys.jump=true;\n if(e.code==='KeyX')keys.fire=true;\n if(e.code==='ShiftLeft'||e.code==='ShiftRight'||e.code==='KeyZ')keys.guard=true;\n});\nwindow.addEventListener('keyup',e=>{\n if(e.code==='ArrowLeft'||e.code==='KeyA')keys.left=false;\n if(e.code==='ArrowRight'||e.code==='KeyD')keys.right=false;\n if(e.code==='ArrowUp'||e.code==='KeyW')keys.up=false;\n if(e.code==='ArrowDown'||e.code==='KeyS')keys.down=false;\n if(e.code==='Space')keys.jump=false;\n if(e.code==='KeyX')keys.fire=false;\n if(e.code==='ShiftLeft'||e.code==='ShiftRight'||e.code==='KeyZ')keys.guard=false;\n});\nfunction render(){\n ctx.fillStyle='#000';ctx.fillRect(0,0,cv.width,cv.height);\n const s=Math.min(cv.width/FW,cv.height/FH);\n const ox=(cv.width-FW*s)/2, oy=(cv.height-FH*s)/2;\n ctx.save();ctx.translate(ox,oy);ctx.scale(s,s);\n ctx.fillStyle='#063';ctx.fillRect(0,0,FW,FH);\n ctx.strokeStyle='#fff';ctx.lineWidth=3;\n ctx.strokeRect(4,4,FW-8,FH-8);\n ctx.beginPath();ctx.moveTo(FW/2,4);ctx.lineTo(FW/2,FH-4);ctx.stroke();\n ctx.beginPath();ctx.arc(FW/2,FH/2,60,0,7);ctx.stroke();\n ctx.strokeRect(-4,GY1,20,GY2-GY1);\n ctx.strokeRect(FW-16,GY1,20,GY2-GY1);\n if(phase!=='title'){\n  for(const p of players){\n   const col=p.team===0?'#3af':'#f55';\n   if(p.team===0&&p.id===controlledId&&playerSkin){\n    ctx.drawImage(playerSkin,p.x-20,p.y-20,40,40);\n   } else {\n    ctx.beginPath();ctx.arc(p.x,p.y,15,0,7);ctx.fillStyle=col;ctx.fill();\n    if(p.team===0&&p.id===controlledId){ctx.lineWidth=3;ctx.strokeStyle='#ff0';ctx.stroke();}\n   }\n  }\n  ctx.beginPath();ctx.arc(ball.x,ball.y,8,0,7);ctx.fillStyle='#fff';ctx.fill();\n  ctx.strokeStyle='#333';ctx.stroke();\n }\n ctx.restore();\n const hud=document.getElementById('hud');\n if(phase==='playing'){\n  const t=Math.max(0,Math.ceil(HALF-matchTime));\n  hud.textContent='내팀 '+myGoals+' : '+theirGoals+' 상대   '+(half===1?'전반':'후반')+'  '+t+'초';\n } else if(phase==='shootout'){\n  hud.textContent='승부차기 '+so.me+' : '+so.them+'  ('+(so.sub==='me'?'내 차례! X를 타이밍에 맞춰':'상대 차례')+')';\n } else hud.textContent='';\n document.getElementById('bot').textContent=botActive?'🤖 AI PLAYING':'';\n if(phase==='shootout'){\n  const s2=Math.min(cv.width/FW,cv.height/FH);\n  const ox2=(cv.width-FW*s2)/2, oy2=(cv.height-FH*s2)/2;\n  ctx.save();ctx.translate(ox2,oy2);ctx.scale(s2,s2);\n  const cx=FW/2,cy=FH-60,w=300;\n  ctx.strokeStyle='#fff';ctx.strokeRect(cx-w/2,cy-15,w,30);\n  ctx.fillStyle='#0f0';ctx.fillRect(cx-30,cy-15,60,30);\n  const mk=Math.sin(so.timer*4);\n  ctx.fillStyle='#f00';ctx.fillRect(cx+mk*w/2-4,cy-15,8,30);\n  ctx.restore();\n }\n}\nlet lastT=performance.now();\nfunction loop(now){\n const dt=Math.min(0.033,(now-lastT)/1000);lastT=now;\n if(botActive)botTick();\n if(phase==='playing')updatePlaying(dt);\n else if(phase==='shootout')updateShootout(dt);\n render();\n requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\nfunction botTick(){\n if(phase==='title'){document.getElementById('vibrex-start').click();return;}\n if(phase==='over'||phase==='cleared'){\n  if(!botRestarted){botRestarted=true;setTimeout(()=>{if(botActive)restartGame();},1200);}\n  return;\n }\n if(phase==='playing'){\n  const cp=players[controlledId];\n  const hasBall=ball.owner===cp;\n  if(hasBall){\n   const gx=FW-20,gy=(GY1+GY2)/2;\n   const dx=gx-cp.x, dy=gy-cp.y, dist=Math.hypot(dx,dy);\n   const opps=team(1);\n   const no=nearestTo(opps,cp.x,cp.y);\n   keys.left=dx<-10;keys.right=dx>10;keys.up=dy<-10;keys.down=dy>10;\n   keys.guard=dist>250;\n   keys.fire=dist<160;\n   keys.jump=!!(no.p&&no.d<55);\n  } else {\n   const dx=ball.x-cp.x, dy=ball.y-cp.y;\n   keys.left=dx<-8;keys.right=dx>8;keys.up=dy<-8;keys.down=dy>8;\n   keys.guard=true;keys.jump=false;\n   const carrierOpp=team(1).find(o=>o===ball.owner);\n   keys.fire=!!(carrierOpp&&Math.hypot(carrierOpp.x-cp.x,carrierOpp.y-cp.y)<45);\n  }\n } else if(phase==='shootout'){\n  if(so.sub==='me'){\n   const mk=Math.sin(so.timer*4);\n   keys.fire=Math.abs(mk)<0.3;\n  } else keys.fire=false;\n }\n}\nwindow.VIBREX_GAME={\n title:'미니 축구 3대3',\n genre:'sports',\n goal:'전후반 경기에서 상대보다 많은 골을 넣어라',\n clearCondition:'경기 종료 시 상대보다 골이 많으면(동점 시 승부차기 승리) 클리어',\n controls:[\n  {input:'left/right/up/down',actio