\nbutton{font-size:20px;padding:10px 20px;margin-top:15px;border-radius:8px;border:none;background:#0af;color:#fff}\n#bar{position:fixed;top:5px;left:5%;width:90%;height:8px;background:#333;border-radius:4px}\n#barfill{height:100%;width:0%;background:#0f0;border-radius:4px}\n#atry{position:fixed;top:18px;left:10px;color:#fff;font-family:sans-serif}\n#botmsg{position:fixed;top:18px;right:10px;color:#0f0;font-family:sans-serif;display:none}\n</style></head>\n<body>\n<div id=\"bar\"><div id=\"barfill\"></div></div>\n<div id=\"atry\">시도: 1</div>\n<div id=\"botmsg\">AI PLAYING</div>\n<div id=\"title\" data-vibrex-role=\"title\">\n<h1>비트 큐브 러너</h1>\n<p>자동 달리는 큐브를 조작해 가시/틈/블록을 넘어라!</p>\n<p>조작: Space/↑/탭 = 점프</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div id=\"over\" data-vibrex-role=\"over\" style=\"display:none\">\n<h1>부딪혔다!</h1><p id=\"oscore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button>\n</div>\n<div id=\"clear\" data-vibrex-role=\"clear\" style=\"display:none\">\n<h1>클리어!</h1><p id=\"cscore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button>\n</div>\n<canvas id=\"c\"></canvas>\n<script>\nlet cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=innerWidth;cv.height=innerHeight;}\naddEventListener('resize',resize);resize();\n\nlet GROUND, playerY, playerVY, playerX=100, onGround=true, gravity=1800;\nlet obstacles=[], distTraveled=0, speed=340, LEVELLEN=60*speed, running=false, phase='title', attempts=1, score=0, jumpHeld=false;\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.()});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;}\n\nfunction genLevel(){\n  obstacles=[];\n  let beat=60/120; // sec per beat\n  let x=800;\n  while(x < LEVELLEN-400){\n    let t = Math.floor(Math.random()*3);\n    obstacles.push({x:x, type:t, hit:false});\n    x += beat*speed*(2+Math.floor(Math.random()*2));\n  }\n}\n\nfunction resetGame(){\n  playerY=0;playerVY=0;onGround=true;distTraveled=0;score=0;jumpHeld=false;\n  genLevel();\n}\n\nfunction startGame(){\n  document.getElementById('title').style.display='none';\n  document.getElementById('over').style.display='none';\n  document.getElementById('clear').style.display='none';\n  resetGame();\n  running=true;phase='playing';\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){\n  attempts++;\n  document.getElementById('atry').innerText='시도: '+attempts;\n  startGame();\n}\nfunction doJump(){\n  if(phase!=='playing')return;\n  if(onGround){playerVY=-820;onGround=false;}\n}\naddEventListener('keydown',e=>{\n  if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();doJump();}\n});\ncv.addEventListener('touchstart',e=>{e.preventDefault();doJump();});\ncv.addEventListener('mousedown',()=>doJump());\n\nfunction getGroundY(){return cv.height-100;}\n\nfunction loop(dt){\n  if(phase!=='playing')return;\n  GROUND=getGroundY();\n  distTraveled += speed*dt;\n  playerVY += gravity*dt;\n  playerY += playerVY*dt;\n  if(playerY>0){playerY=0;playerVY=0;onGround=true;}\n  score = Math.floor(distTraveled/10);\n  if(window.AJ)AJ.score(score);\n\n  let px = playerX;\n  let py = GROUND + playerY;\n  let psize=40;\n  let dead=false;\n  for(let o of obstacles){\n    let ox = o.x - distTraveled + playerX;\n    if(o.type===0){ // spike\n      let sx=ox, sy=GROUND, w=40,h=40;\n      if(px+psize*0.3 > sx-w/2 && px-psize*0.3 < sx+w/2 && py+psize > sy-h+8){\n        dead=true;\n      }\n    } else if(o.type===1){ // gap\n      let gx=ox,gw=80;\n      if(px+psize/2 > gx-gw/2 && px-psize/2 < gx+gw/2){\n        if(py+psize >= GROUND+50) dead=true;\n      }\n    } else { // block\n      let bx=ox, by=GROUND-60, bw=40,bh=60;\n      if(px+psize*0.5 > bx-bw/2 && px-psize*0.5 < bx+bw/2 && py+psize > by){\n        dead=true;\n      }\n    }\n  }\n  if(dead){\n    phase='over';running=false;\n    document.getElementById('oscore').innerText='점수: '+score;\n    document.getElementById('over').style.display='flex';\n    if(window.AJ)AJ.over(score);\n    return;\n  }\n  if(distTraveled >= LEVELLEN){\n    phase='cleared';running=false;\n    document.getElementById('cscore').innerText='점수: '+score;\n    document.getElementById('clear').style.display='flex';\n    if(window.AJ)AJ.clear(score);\n    return;\n  }\n  document.getElementById('barfill').style.width=(100*distTraveled/LEVELLEN)+'%';\n}\n\nfunction draw(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,cv.width,cv.height);\n  GROUND=getGroundY();\n  ctx.fillStyle='#333';ctx.fillRect(0,GROUND+50,cv.width,cv.height-GROUND-50);\n  if(phase==='playing'||phase==='over'||phase==='cleared'){\n    for(let o of obstacles){\n      let ox = o.x - distTraveled + playerX;\n      if(ox<-100||ox>cv.width+100)continue;\n      if(o.type===0){\n        ctx.fillStyle='#f33';\n        ctx.beginPath();\n        ctx.moveTo(ox-20,GROUND);\n        ctx.lineTo(ox,GROUND-40);\n        ctx.lineTo(ox+20,GROUND);\n        ctx.closePath();ctx.fill();\n      } else if(o.type===1){\n        ctx.fillStyle='#000';\n        ctx.fillRect(ox-40,GROUND+50,80,200);\n      } else {\n        ctx.fillStyle='#0af';\n        ctx.fillRect(ox-20,GROUND-60,40,60);\n      }\n    }\n    let px=playerX, py=GROUND+playerY, psize=40;\n    if(playerSkin){\n      let s=psize*1.3;\n      ctx.drawImage(playerSkin, px-s/2, py-s+psize/2-s/2+psize/2, s, s);\n    } else {\n      ctx.fillStyle='#ff0';\n      ctx.fillRect(px-psize/2, py-psize, psize, psize);\n    }\n  }\n}\n\nlet last=performance.now();\nfunction frame(t){\n  let dt=Math.min(0.033,(t-last)/1000);last=t;\n  loop(dt);\n  draw();\n  if(window.vibrexBot && window.vibrexBot._active) window.vibrexBot._tick();\n  requestAnimationFrame(frame);\n}\nrequestAnimationFrame(frame);\n\ndocument.getElementById('vibrex-start').onclick=startGame;\n\nfunction nextObstacle(){\n  let best=null,bd=1e9;\n  for(let o of obstacles){\n    let d=o.x-distTraveled;\n    if(d>= -20 && d<bd){bd=d;best=o;}\n  }\n  return best;\n}\n\nwindow.VIBREX_GAME={\n  title:'비트 큐브 러너',genre:'리듬러너',\n  goal:'60초 분량의 레벨을 끝까지 생존',\n  clearCondition:'레벨 끝까지 도달',\n  controls:[{input:'jump',action:'점프'}],\n  phase:()=>phase==='title'?'title':phase==='playing'?'playing':phase==='over'?'over':phase==='cleared'?'cleared':'title',\n  progress:()=>Math.min(1,distTraveled/LEVELLEN),\n  state:()=>{\n    let o=nextObstacle();\n    let dx=0,ddist=1,eta=1,otype=0;\n    if(o){\n      let d=(o.x-distTraveled);\n      dx=Math.max(-1,Math.min(1,d/400));\n      ddist=Math.max(0,Math.min(1,d/800));\n      eta=Math.max(0,Math.min(1,d/speed/1.2));\n      otype=o.type;\n    }\n    return {\n      selfX:playerX/cv.width, selfY:(GROUND+playerY)/cv.height, selfVX:speed/400, selfVY:playerVY/800,\n      onGround:onGround?1:0, facing:1,\n      dangerDX:dx, dangerDY:0, dangerDist:ddist, dangerETA:eta, obstacleType:otype,\n      progress:Math.min(1,distTraveled/LEVELLEN), score:score, attempts:attempts, lives:1\n    };\n  },\n  start:()=>{if(phase==='title')startGame();},\n  restart:()=>restartGame(),\n  inputs:{\n    left:()=>{},right:()=>{},up:()=>{},down:()=>{},\n    jump:(on)=>{if(on)doJump();},\n    fire:(on)=>{if(on)doJump();},\n    guard:()=>{},useItem:()=>{},item1:()=>{},item2:()=>{},item3:()=>{},item4:()=>{}\n  }\n};\n\nwindow.vibrexBot={\n  _active:false,\n  start(){\n    this._active=true;\n    document.getElementById('botmsg').style.display='block';\n    if(phase==='title')startGame();\n    if(phase==='over'||phase==='cleared')restartGame();\n  },\n  stop(){this._active=false;document.getElementById('botmsg').style.display='none';},\n  setSkill(){},\n  _tick(){\n    if(!this._active)return;\n    if(phase==='title'){startGame();return;}\n    if(phase==='over'||phase==='cleared'){restartGame();return;}\n    let rules=window.VIBREX_POLICY&&window.VIBREX_POLICY.rules;\n    if(rules){\n      let s=window.VIBREX_GAME.state();\n      for(let r of rules){\n        try{ if(eval(r.cond)){ if(r.action==='jump'||r.action==='fire')doJump(); return; } }catch(e){}\n      }\n    }\n    let o=nextObstacle();\n    if(o){\n      let d=o.x-distTraveled;\n      let etaThresh = 260;\n      if(d>0 && d<etaThresh) doJump();\n    }\n  }\n};\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,cancelable:true};try{var e=new KeyboardEvent(type,o);Object.defineProperty(e,'keyCode',{get:function(){return o.keyCode}});Object.defineProperty(e,'which',{get:function(){return o.keyCode}});window.dispatchEvent(e);document.dispatchEvent(e);(document.activeElement||document.body).dispatchEvent(e);var c=document.querySelector('canvas');if(c)c.dispatchEvent(e)}catch(e2){}}function inp(name,on){var G=window.VIBREX_GAME;if(G&&G.inputs&&typeof G.inputs[name]==='function'){try{G.inputs[name](on)}catch(e){}}}function set(key,name,on){if(!!held[key]===on)return;held[key]=on;kev(on?'keydown':'keyup',key);inp(name,on)}function hideLegacy(){try{var els=document.querySelectorAll('button,div,span,a');for(var i=0;i<els.length;i++){var el=els[i];var t=(el.textContent||'').trim();var cls=(el.className&&el.className.baseVal!==undefined?el.className.baseVal:el.className)||'';var id=el.id||'';if((/^[\\u25C0\\u25B6\\u25B2\\u25BC\\u2190\\u2192\\u2191\\u2193\\u25C4\\u25BA\\u2039\\u203A<>^v]{1,2}$/.test(t)&&el.children.length===0)||/(^|[\\s_-])(dpad|joystick|touch-?controls?|mobile-?controls?|ctrl-?btn|ctrl-?left|ctrl-?right|btn-?left|btn-?right|btn-?up|btn-?down)([\\s_-]|$)/i.test(cls+' '+id)){var box=el;for(var k=0;k<3&&box.parentElement&&box.parentElement!==document.body;k++){var sib=box.parentElement.children.length;if(sib<=6&&/control|ctrl|dpad|touch|mobile|pad/i.test(box.parentElement.className+' '+box.parentElement.id)){box=box.parentElement}else break}box.style.setProperty('display','none','important')}}}catch(e){}}function build(){var G=window.VIBREX_GAME;if(G&&G.touchUI==='custom')return;if(document.getElementById('vbx-touch'))return;var root=document.createElement('div');root.id='vbx-touch';root.style.cssText='position:fixed;inset:0;z-index:2147482000;pointer-events:none;';root.innerHTML='<style>#vbx-touch *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}#vbx-zone{position:absolute;left:0;bottom:0;width:50%;height:55%;pointer-events:auto;touch-action:none}#vbx-stick{position:absolute;width:124px;height:124px;margin:-62px 0 0 -62px;border-radius:50%;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.35);backdrop-filter:blur(6px);display:none}#vbx-knob{position:absolute;left:50%;top:50%;width:52px;height:52px;margin:-26px 0 0 -26px;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.95),rgba(200,210,230,.75));box-shadow:0 4px 14px rgba(0,0,0,.45)}#vbx-hint{position:absolute;left:22px;bottom:26px;width:84px;height:84px;border-radius:50%;border:1.5px dashed rgba(255,255,255,.28);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.45);font:600 10px/1 -apple-system,system-ui,sans-serif;letter-spacing:.12em}#vbx-acts{position:absolute;right:16px;bottom:22px;display:flex;gap:12px;align-items:flex-end;pointer-events:auto}.vbx-btn{width:64px;height:64px;border-radius:50%;border:1.5px solid rgba(255,255,255,.35);background:rgba(255,255,255,.10);backdrop-filter:blur(6px);color:#fff;font:800 15px/1 -apple-system,system-ui,sans-serif;display:flex;align-items:center;justify-content:center;touch-action:none;box-shadow:0 4px 14px rgba(0,0,0,.35)}.vbx-btn.b{width:52px;height:52px;margin-bottom:34px;opacity:.9}.vbx-btn:active,.vbx-btn.on{background:rgba(255,255,255,.32)}</style><div id=\"vbx-zone\"><div id=\"vbx-hint\">MOVE</div><div id=\"vbx-stick\"><div id=\"vbx-knob\"></div></div></div><div id=\"vbx-acts\"><div class=\"vbx-btn b\" data-k=\"x\" data-n=\"action2\">B</div><div class=\"vbx-btn\" data-k=\" \" data-n=\"action\">A</div></div>';(document.body||document.documentElement).appendChild(root);var zone=root.querySelector('#vbx-zone'),stick=root.querySelector('#vbx-stick'),knob=root.querySelector('#vbx-knob'),hint=root.querySelector('#vbx-hint');var ox=0,oy=0,pid=null,R=44;function apply(dx,dy){var d=Math.hypot(dx,dy);var nx=d>R?dx/d*R:dx,ny=d>R?dy/d*R:dy;knob.style.transform='translate('+nx+'px,'+ny+'px)';var dead=12;set('ArrowLeft','left',dx<-dead&&Math.abs(dx)>=Math.abs(dy)*0.5);set('ArrowRight','right',dx>dead&&Math.abs(dx)>=Math.abs(dy)*0.5);set('ArrowUp','up',dy<-dead&&Math.abs(dy)>=Math.abs(dx)*0.5);set('ArrowDown','down',dy>dead&&Math.abs(dy)>=Math.abs(dx)*0.5)}function release(){['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].forEach(function(k,i){set(k,['left','right','up','down'][i],false)});knob.style.transform='';stick.style.display='none';hint.style.display='flex';pid=null}zone.addEventListener('pointerdown',function(e){if(pid!==null)return;pid=e.pointerId;ox=e.clientX;oy=e.clientY;stick.style.left=ox+'px';stick.style.top=oy+'px';stick.style.display='block';hint.style.display='none';try{zone.setPointerCapture(e.pointerId)}catch(e1){}e.preventDefault()});zone.addEventListener('pointermove',function(e){if(e.pointerId!==pid)return;apply(e.clientX-ox,e.clientY-oy);e.preventDefault()});zone.addEventListener('pointerup',function(e){if(e.pointerId===pid)release()});zone.addEventListener('pointercancel',function(e){if(e.pointerId===pid)release()});root.querySelectorAll('.vbx-btn').forEach(function(b){var k=b.getAttribute('data-k'),n=b.getAttribute('data-n');b.addEventListener('pointerdown',function(e){b.classList.add('on');set(k,n,true);try{b.setPointerCapture(e.pointerId)}catch(e1){}e.preventDefault()});var up=function(){b.classList.remove('on');set(k,n,false)};b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up)});hideLegacy();setTimeout(hideLegacy,1500);setTimeout(hideLegacy,4000)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(build,50)});else setTimeout(build,50);})();</script></body></html>"
