 obstacles=[], distTraveled=0, speed=340, LEVELLEN=60*speed, running=false, phase='title', attempts=1, score=0, jumpHeld=false;\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.()});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;}\n\nfunction genLevel(){\n  obstacles=[];\n  let beat=60/120; // sec per beat\n  let x=800;\n  while(x < LEVELLEN-400){\n    let t = Math.floor(Math.random()*3);\n    obstacles.push({x:x, type:t, hit:false});\n    x += beat*speed*(2+Math.floor(Math.random()*2));\n  }\n}\n\nfunction resetGame(){\n  playerY=0;playerVY=0;onGround=true;distTraveled=0;score=0;jumpHeld=false;\n  genLevel();\n}\n\nfunction startGame(){\n  document.getElementById('title').style.display='none';\n  document.getElementById('over').style.display='none';\n  document.getElementById('clear').style.display='none';\n  resetGame();\n  running=true;phase='playing';\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){\n  attempts++;\n  document.getElementById('atry').innerText='시도: '+attempts;\n  startGame();\n}\nfunction doJump(){\n  if(phase!=='playing')return;\n  if(onGround){playerVY=-820;onGround=false;}\n}\naddEventListener('keydown',e=>{\n  if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();doJump();}\n});\ncv.addEventListener('touchstart',e=>{e.preventDefault();doJump();});\ncv.addEventListener('mousedown',()=>doJump());\n\nfunction getGroundY(){return cv.height-100;}\n\nfunction loop(dt){\n  if(phase!=='playing')return;\n  GROUND=getGroundY();\n  distTraveled += speed*dt;\n  playerVY += gravity*dt;\n  playerY += playerVY*dt;\n  if(playerY>0){playerY=0;playerVY=0;onGround=true;}\n  score = Math.floor(distTraveled/10);\n  if(window.AJ)AJ.score(score);\n\n  let px = playerX;\n  let py = GROUND + playerY;\n  let psize=40;\n  let dead=false;\n  for(let o of obstacles){\n    let ox = o.x - distTraveled + playerX;\n    if(o.type=