=(W*s)+'px';cv.style.height=(H*s)+'px';}\naddEventListener('resize',resize);resize();\nlet phase='title',mode='bball';\nlet kLeft=false,kRight=false,kUp=false,kDown=false,fireHeld=false;\nlet angle=0.5,powerPhase=0,power=0,targetDist=0.5,attempts=0,bballScore=0,timeLeft=60,resultMsg='',resultT=0;\nlet golfCharging=false,golfPower=0,golfChargeStart=0,holes=[],holeIndex=0,strokesThisHole=0,totalStrokes=0,totalPar=27,remainingDist=0.5,elapsed=0;\nlet playerSkin=null;\nfunction newBball(){targetDist=0.2+Math.random()*0.8;}\nfunction genHoles(){holes=[];for(let i=0;i<9;i++)holes.push({dist:0.3+Math.random()*0.6,slope:(Math.random()*2-1)});}\nfunction resetGame(){\n angle=0.5;powerPhase=0;power=0;attempts=0;bballScore=0;timeLeft=60;resultMsg='';resultT=0;\n genHoles();holeIndex=0;strokesThisHole=0;totalStrokes=0;remainingDist=holes[0].dist;golfPower=0;golfCharging=false;elapsed=0;\n newBball();\n}\nfunction doBballShot(){\n if(phase!=='playing'||mode!=='bball')return;\n const angDeg=20+angle*50,rad=angDeg*Math.PI/180;\n const v0=power*14;\n const range=(v0*v0*Math.sin(2*rad))/9.8;\n const norm=range/20;\n const diff=Math.abs(norm-targetDist);\n attempts++;\n if(diff<0.07){bballScore+=2;resultMsg='명중! +2';if(window.AJ)AJ.score(bballScore);\n  if(bballScore>=20){phase='cleared';showScr();if(window.AJ)AJ.clear(bballScore);return;}\n }else resultMsg='아쉬워요';\n resultT=1;\n newBball();\n}\nfunction doGolfPutt(){\n if(phase!=='playing'||mode!=='golf')return;\n const p=golfPower,lat=(angle-0.5)*2,slope=holes[holeIndex].slope;\n const traveled=p*1.3,lateralErr=lat+slope*0.4;\n strokesThisHole++;totalStrokes++;\n const distDiff=remainingDist-traveled;\n if(Math.abs(distDiff)<0.05&&Math.abs(lateralErr)<0.12){\n   resultMsg='홀인! ('+strokesThisHole+'타)';resultT=1;nextHole();\n }else{\n   remainingDist=Math.max(0.03,Math.abs(distDiff));\n   resultMsg='+'+strokesThisHole+'타 진행중';resultT=1;\n   if(strokesThisHole>=6)nextHole();\n }\n if(window.AJ)AJ.score(totalStrokes);\n golfPower=0;angle=0.5;\n}\nfunction nextHole(){\n holeIndex++;strokesThisHole=0;\n if(holeIndex>=9){\n   if(totalStrokes<=totalPar){phase='cleared';showScr();if(window.AJ)AJ.clear(totalStrokes);}\n   else{phase='over';showScr();if(window.AJ)AJ.over(totalStrokes);}\n }else{remainingDist=holes[holeIndex].dist;if(window.AJ)AJ.level(holeIndex+1);}\n}\nfunction fireDown(){\n if(fireHeld)return;fireHeld=true;\n if(phase!=='playing')return;\n if(mode==='bball')doBballShot();\n else{golfCharging=true;golfChargeStart=performance.now();}\n}\nfunction fireUp(){\n fireHeld=false;\n if(mode==='golf'&&golfCharging){golfCharging=false;doGolfPutt();}\n}\naddEventListener('keydown',e=>{\n if(e.repeat)return;\n if(e.code==='ArrowLeft')kLeft=true;\n if(e.code==='ArrowRight')kRight=true;\n if(e.code==='ArrowUp')kUp=true;\n if(e.code==='ArrowDown')kDown=true;\n if(e.code==='Space'||e.code==='KeyX')fireDown();\n if(e.key==='1')selMode('bball');\n if(e.key==='2')selMode('golf');\n});\naddEventListener('keyup',e=>{\n if(e.code==='ArrowLeft')kLeft=false;\n if(e.code==='ArrowRight')kRight=false;\n if(e.code==='ArrowUp')kUp=false;\n if(e.code==='ArrowDown')kDown=false;\n if(e.code==='Space'||e.code==='KeyX')fireUp();\n});\nfunction selMode(m){mode=m;document.getElementById('mB').classList.toggle('sel',m==='bball');document.getElementById('mG').classList.toggle('sel',m==='golf');}\ndocument.getElementById('mB').onclick=()=>selMode('bball');\ndocument.getElementById('mG').onclick=()=>selMode('golf');\nselMode('bball');\nfunction showScr(){\n document.getElementById('titleScr').classList.toggle('show',phase==='title');\n document.getElementById('overScr').classList.toggle('show',phase==='over');\n document.getElementById('clearScr').classList.toggle('show',phase==='cleared');\n if(phase==='over')document.getElementById('overTxt').textContent=mode==='bball'?('최종 점수: '+bballScore):('총 타수: '+totalStrokes+' / 파 '+totalPar);\n if(phase==='cleared')document.getElementById('clearTxt').textContent=mode==='bball'?('최종 점수: '+bballScore):('총 타수: '+totalStrokes+' / 파 '+totalPar);\n}\n[['rB1'],['rB2']].forEach(a=>document.getElementById(a[0]).onclick=()=>VIBREX_GAME.restart());\ndocument.getElementById('vibrex-start').onclick=()=>VIBREX_GAME.start();\nlet last=performance.now();\nfunction loop(ts){\n let dt=Math.min(0.05,(ts-last)/1000);last=ts;\n if(phase==='playing'){\n   if(mode==='bball'){\n     timeLeft-=dt;\n     if(kUp)angle=Math.min(1,angle+dt*0.6);\n     if(kDown)angle=Math.max(0,angle-dt*0.6);\n     powerPhase+=dt*2.2;power=(Math.sin(powerPhase)+1)/2;\n     if(timeLeft<=0){timeLeft=0;phase='over';showScr();if(window.AJ)AJ.over(bballScore);}\n   }else{\n     elapsed+=dt;\n     if(kLeft)angle=Math.max(0,angle-dt*0.5);\n     if(kRight)angle=Math.min(1,angle+dt*0.5);\n     if(golfCharging)golfPower=Math.min(1,(performance.now()-golfChargeStart)/1600);\n     if(elapsed>150&&phase==='playing'){phase='over';showScr();if(window.AJ)AJ.over(totalStrokes);}\n   }\n   if(resultT>0){resultT-=dt;if(resultT<0)resultT=0;}\n }\n botTick(dt);\n draw();\n requestAnimationFrame(loop);\n}\nfunction draw(){\n ctx.fillStyle='#111';ctx.fillRect(0,0,W,H);\n if(phase!=='playing')return;\n ctx.fillStyle='#fff';ctx.font='16px sans-serif';ctx.textAlign='left';\n if(mode==='bball'){\n   ctx.fillText('점수: '+bballScore+' / 20',10,26);\n   ctx.fillText('시간: '+timeLeft.toFixed(1)+'s',10,48);\n   ctx.fillText('거리: '+Math.round(targetDist*20)+'m',10,70);\n   ctx.strokeStyle='#666';ctx.strokeRect(40,100,300,24);\n   ctx.fillStyle='#3ba0ff';ctx.fillRect(40,100,300*power,24);\n   ctx.fillStyle='#fff';ctx.fillText('파워',10,118);\n   let cx=190,cy=250,len=90,rad=(20+angle*50)*Math.PI/180;\n   ctx.strokeStyle='#fff';ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+len*Math.cos(rad),cy-len*Math.sin(rad));ctx.stroke();\n   ctx.fillText('각도: '+Math.round(20+angle*50)+'°',10,300);\n   ctx.font='40px sans-serif';ctx.textAlign='center';\n   if(playerSkin)ctx.drawImage(playerSkin,cx-35,H-120,70,70);\n   else ctx.fillText('🏀',cx,H-70);\n   if(resultT>0){ctx.font='24px sans-serif';ctx.fillStyle='#ffd93b';ctx.fillText(resultMsg,W/2,180);}\n }else{\n   ctx.textAlign='left';\n   ctx.fillText('홀 '+(holeIndex+1)+'/9  타수 '+totalStrokes+'/'+totalPar,10,26);\n   ctx.fillText('현재 홀 타수: '+strokesThisHole,10,48);\n   ctx.fillText('남은거리: '+Math.round(remainingDist*100)+'m',10,70);\n   let slope=holes[holeIndex]?holes[holeIndex].slope:0;\n   ctx.fillText('경사: '+(slope>0?'→':slope<0?'←':'-'),10,92);\n   ctx.strokeStyle='#666';ctx.strokeRect(40,110,300,24);\n   ctx.fillStyle='#3ba0ff';ctx.fillRect(40,110,300*golfPower,24);\n   ctx.fillStyle='#fff';ctx.fillText('파워(홀드)',10,128);\n   let cx=190,cy=220,len=70,rad=(90-(angle-0.5)*160)*Math.PI/180;\n   ctx.strokeStyle='#0f0';ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+len*Math.cos(rad),cy-len*Math.sin(rad));ctx.stroke();\n   ctx.font='40px sans-serif';ctx.textAlign='center';\n   if(playerSkin)ctx.drawImage(playerSkin,cx-35,H-120,70,70);\n   else ctx.fillText('⛳',cx,H-70);\n   if(resultT>0){ctx.font='22px sans-serif';ctx.fillStyle='#ffd93b';ctx.fillText(resultMsg,W/2,170);}\n }\n}\nfunction state(){\n if(mode==='bball'){\n   return{mode,angle,power,targetDX:0,targetDY:-targetDist,targetDist,windOrSlope:0,attempts,score:bballScore,progress:Math.min(1,bballScore/20),timeLeft:Math.max(0,timeLeft)};\n }else{\n   let lat=(angle-0.5)*2;\n   return{mode,angle,power:golfPower,targetDX:lat,targetDY:-remainingDist,targetDist:remainingDist,windOrSlope:holes[holeIndex]?holes[holeIndex].slope:0,attempts:totalStrokes,score:totalStrokes,progress:Math.min(1,holeIndex/9),timeLeft:Math.max(0,150-elapsed)};\n }\n}\nwindow.VIBREX_GAME={\n title:'미니 스포츠 챌린지',genre:'스포츠',goal:'농구 20점 or 골프 파 이하로 완료',\n clearCondition:'농구: 60초내 20점 / 골프: 9홀 총타수 파(27) 이하',\n controls:[{input:'up/down',action:'농구 각도'},{input:'left/right',action:'골프 각도'},{input:'fire',action:'농구 슛 타이밍 / 골프 파워 충전-퍼팅'},{input:'item1',action:'농구 모드 선택'},{input:'item2',action:'골프 모드 선택'}],\n phase:()=>phase,progress:()=>state().progress,state,\n start(){resetGame();phase='playing';showScr();if(window.AJ)AJ.start();},\n restart(){phase='title';showScr();if(window.AJ)AJ.restart();},\n inputs:{\n  left:on=>kLeft=on,right:on=>kRight=on,up:on=>kUp=on,down:on=>kDown=on,\n  jump:on=>{},fire:on=>{if(on)fireDown();else fireUp();},guard:on=>{},\n  aimX:v=>{},aimY:v=>{},useItem:on=>{},\n  item1:on=>{if(on&&phase==='title')selMode('bball');},\n  item2:on=>{if(on&&phase==='title')selMode('golf');},\n  item3:on=>{},item4:on=>{}\n }\n};\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;if(window.vibrexAvatarAck)window.vibrexAvatarAck();}\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;if(window.vibrexAvatarAck)window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nlet botOn=false,botSkill=0.7,botState='idle',botCooldown=0,botDesiredPower=0.5,botDesiredLat=0;\nwindow.vibrexBot={\n start(){botOn=true;},stop(){botOn=false;},\n setSkill(v){botSkill=Math.max(0,Math.min(1,v));}\n};\nfunction botTick(dt){\n if(!botOn)return;\n ctx.save();ctx.fillStyle='#ffd93b';ctx.font='14px sans-serif';ctx.textAlign='left';ctx.fillText('AI PLAYING',10,H-10);ctx.restore();\n if(phase==='title'){VIBREX_GAME.start();return;}\n if(phase!=='playing')return;\n if(mode==='bball'){\n   botCooldown-=dt;\n   if(botCooldown<=0){\n     const angDeg=45,rad=angDeg*Math.PI/180;\n     let idealV0=Math.sqrt(Math.max(0.01,targetDist*20*9.8/Math.sin(2*rad)));\n     let idealPower=Math.max(0,Math.min(1,idealV0/14));\n     let err=(1-botSkill)*(Math.random()*0.3-0.15);\n     botDesiredPower=Math.max(0,Math.min(1,idealPower+err));\n     angle=0.5+(1-botSkill)*(Math.random()-0.5)*0.2;\n     if(Math.abs(power-botDesiredPower)<0.03){doBballShot();botCooldown=0.4;}\n   }\n }else{\n   if(botState==='idle'){\n     let slope=holes[holeIndex]?holes[holeIndex].slope:0;\n     let err=(1-botSkill)*(Math.random()-0.5)*0.6;\n     botDesiredLat=Math.max(-1,Math.min(1,-slope*0.4+err));\n     angle=0.5+botDesiredLat/2;\n     let perr=(1-botSkill)*(Math.random()*0.2-0.1);\n     botDesiredPower=Math.max(0,Math.min(1,remainingDist/1.3+perr));\n     golfCharging=true;golfChargeStart=performance.now();botState='charging';\n   }else{\n     if(golfPower>=botDesiredPower){golfCharging=false;botState='idle';doGolfPutt();}\n   }\n }\n}\nrequestAnimationFrame(loop);\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"fire\"]};function I(){var G=window.VIBREX_GAME;return G&&G.inputs?G.inputs:null}function ch(code){var i=I();if(!i)return null;var T=window.VIBREX_CONTROLS||[{\"id\":\"left\",\"label\":\"왼쪽\",\"desc\":\"좌 이동·조향\",\"pc\":[\"ArrowLeft\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"right\",\"label\":\"오른쪽\",\"desc\":\"우 이동·조향\",\"pc\":[\"ArrowRight\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"up\",\"label\":\"위\",\"desc\":\"상 이동·가속·회전\",\"pc\":[\"ArrowUp\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"down\",\"label\":\"아래 (앉기)\",\"desc\":\"하 이동·앉기·슬라이드·빠른 낙하\",\"pc\":[\"ArrowDown\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"jump\",\"label\":\"점프\",\"desc\":\"도약·확정 (점프가 없는 게임은 스페이스가 발사)\",\"pc\":[\"Space\"],\"mobile\":\"button\",\"btnLabel\":\"JUMP\",\"size\":\"lg\",\"group\":\"main\",\"enabled\":true},{\"id\":\"fire\",\"label\":\"발사·공격\",\"desc\":\"발사·타격·상호작용\",\"pc\":[\"KeyA\"],\"mobile\":\"button\",\"btnLabel\":\"A\",\"size\":\"md\",\"group\":\"main\",\"enabled\":true},{\"id\":\"guard\",\"label\":\"방어·특수\",\"desc\":\"방어·제동·대시 등 특수 동작\",\"pc\":[\"KeyS\"],\"mobile\":\"button\",\"btnLabel\":\"S\",\"size\":\"md\",\"group\":\"main\",\"enabled\":true},{\"id\":\"useItem\",\"label\":\"아이템 사용\",\"desc\":\"현재 선택된 퀵슬롯 아이템 사용\",\"pc\":[\"KeyD\"],\"mobile\":\"button\",\"btnLa