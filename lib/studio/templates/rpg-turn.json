viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>턴제 전투</title>\n<style>\nhtml,body{margin:0;background:#111;color:#fff;font-family:sans-serif;overflow:hidden;height:100%}\ncanvas{display:block;margin:auto;background:#111}\n#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center}\nbutton{font-size:18px;padding:10px 20px;margin:6px;border-radius:8px;border:none;background:#4a7;color:#fff}\n#cmds{position:fixed;bottom:10px;left:0;right:0;display:none;justify-content:center;gap:8px;z-index:5}\n.cb{width:70px;height:70px;border-radius:12px;background:#333c;border:2px solid #666;color:#fff;font-size:24px}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\">\n<h1>턴제 전투</h1>\n<p>아군 1명으로 몬스터 5마리+보스를 순서대로 격파</p>\n<p>fire=공격 / guard=방어(피해절반+MP회복) / useItem=마법(MP소모) / jump=포션(HP회복,3개)<br>키보드: Z=공격 X=방어 C=마법 V=포션</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div id=\"cmds\">\n<button class=\"cb\" id=\"b_atk\">⚔️</button>\n<button class=\"cb\" id=\"b_grd\">🛡️</button>\n<button class=\"cb\" id=\"b_mag\">✨</button>\n<button class=\"cb\" id=\"b_pot\">🧪</button>\n</div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=innerWidth;cv.height=innerHeight;}\naddEventListener('resize',resize);resize();\n\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.()});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\n\nconst MAXHP=100,MAXMP=50;\nlet phase='title',player,enemies,eIdx,enemy,turn,msg,guarding,logTimer,score,pendingAction;\n\nfunction newEnemy(i){\n  const boss=i===5;\n  return {name:boss?'보스':'몬스터'+(i+1), hp:boss?150:40+i*10, maxHp:boss?150:40+i*10,\n    atk:boss?18:8+i*2, intent:0, boss};\n}\nfunction initGame(){\n  player={hp:MAXHP,mp:MAXMP,items:3};\n  enemies=[0,1,2,3,4,5].map(newEnemy);\n  eIdx=0;enemy=enemies[0];turn=1;msg='전투 시작!';guarding=false;score=0;phase='playing';\n  decideIntent();\n  document.getElementById('ui').style.display='none';\n  document.getElementById('cmds').style.display='flex';\n  if(window.AJ)AJ.start();\n}\nfunction decideIntent(){\n  const r=Math.random();\n  enemy.intent = r<0.15?2:(r<0.55?0:1);\n}\nfunction playerAction(act){\n  if(phase!=='playing')return;\n  guarding=false;\n  let log='';\n  if(act==='fire'){\n    const dmg=10+Math.floor(Math.random()*6);\n    enemy.hp-=dmg;log='공격! '+dmg+' 피해';\n  } else if(act==='guard'){\n    guarding=true;player.mp=Math.min(MAXMP,player.mp+8);log='방어 태세, MP 회복';\n  } else if(act==='useItem'){\n    if(player.mp>=15){\n      const dmg=22+Math.floor(Math.random()*10);\n      player.mp-=15;enemy.hp-=dmg;log='마법! '+dmg+' 피해';\n    } else {log='MP 부족!';}\n  } else if(act==='jump'){\n    if(player.items>0){\n      player.items--;player.hp=Math.min(MAXHP,player.hp+30);log='포션 사용, HP 회복';\n    } else {log='포션 없음!';}\n  }\n  msg=log;\n  if(enemy.hp<=0){\n    msg=enemy.name+' 처치!';score+=100+Math.floor(player.hp);\n    if(window.AJ)AJ.score(score);\n    eIdx++;\n    if(eIdx>=enemies.length){\n      phase='cleared';score+=turn<30?50:0;\n      if(window.AJ)AJ.clear(score);\n      return;\n    }\n    enemy=enemies[eIdx];decideIntent();\n    if(window.AJ)AJ.level(eIdx+1);\n    return;\n  }\n  enemyTurn();\n}\nfunction enemyTurn(){\n  let dmg=0;\n  if(enemy.intent===0)dmg=enemy.atk+Math.floor(Math.random()*4);\n  else if(enemy.intent===1)dmg=Math.floor((enemy.atk+Math.floor(Math.random()*4))*2);\n  if(guarding)dmg=Math.floor(dmg/2);\n  player.hp-=dmg;\n  msg+=' | 적 턴: '+(dmg>0?dmg+' 피해':'대기');\n  turn++;\n  if(player.hp<=0){\n    player.hp=0;phase='over';\n    if(window.AJ)AJ.over(score);\n    return;\n  }\n  decideIntent();\n}\nfunction restart(){initGame();}\n\ndocument.getElementById('vibrex-start').onclick=()=>initGame();\ndocument.getElementById('b_atk').onclick=()=>playerAction('fire');\ndocument.getElementById('b_grd').onclick=()=>playerAction('guard');\ndocument.getElementById('b_mag').onclick=()=>playerAction('useItem');\ndocument.getElementById('b_pot').onclick=()=>playerAction('jump');\n\naddEventListener('keydown',e=>{\n  if(phase==='title'&&e.code==='Space')initGame();\n  if(phase!=='playing')return;\n  if(e.code==='KeyZ')playerAction('fire');\n  if(e.code==='KeyX')playerAction('guard');\n  if(e.code==='KeyC')playerAction('useItem');\n  if(e.code==='KeyV')playerAction('jump');\n});\n\nfunction draw(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,cv.width,cv.height);\n  const w=cv.width,h=cv.height,cx=w/2;\n  if(phase==='title'){requestAnimationFrame(draw);return;}\n  ctx.fillStyle='#fff';ctx.font='bold 22px sans-serif';ctx.textAlign='center';\n  ctx.fillText('턴 '+turn,cx,30);\n\n  if(phase==='playing'||phase==='over'||phase==='cleared'){\n    // enemy\n    ctx.font='60px sans-serif';\n    ctx.fillText(enemy.boss?'👹':'👾',cx,h*0.35);\n    ctx.font='16px sans-serif';\n    ctx.fillText(enemy.name,cx,h*0.35+40);\n    ctx.fillStyle='#333';ctx.fillRect(cx-100,h*0.35+50,200,14);\n    ctx.fillStyle='#e44';ctx.fillRect(cx-100,h*0.35+50,200*Math.max(0,enemy.hp/enemy.maxHp),14);\n    const icon=enemy.intent===0?'⚔️':enemy.intent===1?'💥':'💤';\n    ctx.font='30px sans-serif';\n    ctx.fillText(icon,cx,h*0.35+90);\n\n    // player\n    ctx.font='60px sans-serif';\n    if(playerSkin){\n      const s=90;ctx.drawImage(playerSkin,cx-s/2,h*0.65-s+10,s,s);\n    } else {\n      ctx.fillText('🧙',cx,h*0.65);\n    }\n    ctx.font='14px sans-serif';\n    ctx.fillStyle='#fff';\n    ctx.fillText('HP',cx-140,h*0.65+20);\n    ctx.fillStyle='#333';ctx.fillRect(cx-110,h*0.65+10,220,14);\n    ctx.fillStyle='#4c4';ctx.fillRect(cx-110,h*0.65+10,220*Math.max(0,player.hp/MAXHP),14);\n    ctx.fillStyle='#fff';ctx.fillText('MP',cx-140,h*0.65+45);\n    ctx.fillStyle='#333';ctx.fillRect(cx-110,h*0.65+35,220,14);\n    ctx.fillStyle='#48f';ctx.fillRect(cx-110,h*0.65+35,220*Math.max(0,player.mp/MAXMP),14);\n    ctx.fillText('포션x'+player.items,cx,h*0.65+70);\n\n    ctx.font='16px sans-serif';\n    ctx.fillText(msg,cx,h*0.85);\n    ctx.fillText('점수: '+score,cx,h*0.9);\n  }\n\n  if(phase==='over'){\n    ctx.fillStyle='rgba(0,0,0,0.7)';ctx.fillRect(0,0,w,h);\n    ctx.fillStyle='#f55';ctx.font='bold 36px sans-serif';ctx.fillText('게임 오버',cx,h/2-40);\n    ctx.fillStyle='#fff';ctx.font='20px sans-serif';ctx.fillText('점수: '+score,cx,h/2);\n    drawRestartBtn();\n  }\n  if(phase==='cleared'){\n    ctx.fillStyle='rgba(0,0,0,0.7)';ctx.fillRect(0,0,w,h);\n    ctx.fillStyle='#4f4';ctx.font='bold 36px sans-serif';ctx.fillText('클리어!',cx,h/2-40);\n    ctx.fillStyle='#fff';ctx.font='20px sans-serif';ctx.fillText('최종 점수: '+score,cx,h/2);\n    drawRestartBtn();\n  }\n  requestAnimationFrame(draw);\n}\nlet restartRect=null;\nfunction drawRestartBtn(){\n  const w=cv.width,h=cv.height,cx=w/2;\n  const bw=140,bh=44,bx=cx-bw/2,by=h/2+30;\n  ctx.fillStyle='#4a7';ctx.fillRect(bx,by,bw,bh);\n  ctx.fillStyle='#fff';ctx.font='18px sans-serif';ctx.fillText('다시하기',cx,by+28);\n  restartRect={x:bx,y:by,w:bw,h:bh};\n}\ncv.addEventListener('click',e=>{\n  if((phase==='over'||phase==='cleared')&&restartRect){\n    const r=cv.getBoundingClientRect();\n    const x=e.clientX-r.left,y=e.clientY-r.top;\n    if(x>=restartRect.x&&x<=restartRect.x+restartRect.w&&y>=restartRect.y&&y<=restartRect.y+restartRect.h){\n      restart();\n    }\n  }\n});\ndocument.body.setAttribute('data-vibrex-role','');\ndraw();\n\nwindow.VIBREX_GAME={\n  title:'턴제 전투',genre:'RPG',goal:'몬스터5마리+보스 격파',\n  clearCondition:'모든 적 처치',\n  controls:[{input:'fire',action:'공격'},{input:'guard',action:'방어'},{input:'useItem',action:'마법'},{input:'jump',action:'포션'}],\n  phase:()=>phase==='playing'?'playing':phase==='over'?'over':phase==='cleared'?'cleared':'title',\n  progress:()=>eIdx/6,\n  state:()=>({\n    health:player?player.hp/MAXHP:1, mp:player?player.mp/MAXMP:1,\n    enemyHp:enemy?Math.max(0,enemy.hp/enemy.maxHp):0,\n    enemyIntent:enemy?enemy.intent:2,\n    itemCount:player?player.items:0,\n    progress:eIdx/6, score, turn,\n    targetDX:0,targetDY:0,targetDist:enemy?Math.max(0,enemy.hp/enemy.maxHp):0,\n    dangerDX:0,dangerDY:0,dangerDist:enemy&&enemy.intent!==2?0.3:1,\n    dangerETA:enemy&&enemy.intent!==2?0.2:1,\n    fireReady:1\n  }),\n  start:()=>{ if(phase==='title')initGame(); },\n  restart:()=>restart(),\n  inputs:{\n    left:()=>{},right:()=>{},up:()=>{},down:()=>{},\n    jump:on=>{if(on)playerAction('jump');},\n    fire:on=>{if(on)playerAction('fire');},\n    guard:on=>{if(on)playerAction('guard');},\n    useItem:on=>{if(on)playerAction('useItem');},\n    item1:()=>{},item2:()=>{},item3:()=>{},item4:()=>{}\n  }\n};\n\nlet botOn=false,botTimer=null;\nwindow.vibrexBot={\n  start(){\n    botOn=true;\n    if(botTimer)clearInterval(botTimer);\n    botTimer=setInterval(()=>{\n      if(!botOn)return;\n      if(phase==='title'){initGame();return;}\n      if(phase!=='playing')return;\n      if(enemy.intent===1){playerAction('guard');return;}\n      if(player.hp<MAXHP*0.35&&player.items>0){playerAction('jump');return;}\n      if(player.mp>=15&&Math.random()<0.6){playerAction('useItem');return;}\n      playerAction('fire');\n    },700);\n  },\n  stop(){botOn=false;if(botTimer)clearInterval(botTimer);}\n};\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"fire\"]};function I(){var G=window.VIBREX_GAME;return G&&G.inputs?G.inputs:null}function ch(code){var i=I();if(!i)return null;var T=window.VIBREX_CONTROLS||[{\"id\":\"left\",\"label\":\"왼쪽\",\"desc\":\"좌 이동·조향\",\"pc\":[\"ArrowLeft\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"right\",\"label\":\"오른쪽\",\"desc\":\"우 이동·조향\",\"pc\":[\"ArrowRight\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"up\",\"label\":\"위\",\"