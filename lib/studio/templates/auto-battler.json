ewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>골드 진영 배틀</title>\n<style>\nhtml,body{margin:0;padding:0;background:#111;overflow:hidden;height:100%;font-family:sans-serif;color:#fff}\ncanvas{display:block;background:#111;touch-action:none}\n.scr{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:#111;text-align:center;padding:20px;box-sizing:border-box}\nbutton{font-size:20px;padding:12px 24px;border-radius:10px;border:none;background:#4a7;color:#fff;cursor:pointer}\n.hide{display:none}\nul{text-align:left;font-size:14px;line-height:1.5}\n</style></head>\n<body>\n<div id=\"titleScreen\" class=\"scr\">\n<h1>골드 진영 배틀</h1>\n<p>골드로 유닛을 사서 진영을 채우고 8라운드 승리하라!</p>\n<ul>\n<li>item1~3: 상점 유닛 구매</li>\n<li>방향키: 배치 칸 선택 (left/right/up/down)</li>\n<li>fire: 선택 칸에 유닛 배치 (같은 유닛3개 합체)</li>\n<li>guard: 라운드 시작(전투)</li>\n</ul>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div id=\"overScreen\" class=\"scr hide\">\n<h1>패배</h1><p id=\"overScore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button>\n</div>\n<div id=\"clearScreen\" class=\"scr hide\" data-vibrex-role=\"clear\">\n<h1>클리어! 🏆</h1><p id=\"clearScore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button>\n</div>\n<canvas id=\"c\" class=\"hide\"></canvas>\n<script>\nvar cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=innerWidth;cv.height=innerHeight;}\naddEventListener('resize',resize);resize();\n\nvar POOL=[\n{n:'전사',e:'⚔️',c:3,p:5},{n:'궁수',e:'🏹',c:3,p:5},\n{n:'방패병',e:'🛡️',c:4,p:7},{n:'법사',e:'🔥',c:5,p:9},\n{n:'야수',e:'🐺',c:5,p:9},{n:'용',e:'🐉',c:8,p:15}];\n\nvar phase='title',round=1,wins=0,gold=10,health=5,board=[],eboard=[],shop=[],bench=[],cursor=0,score=0;\nvar battleTimer=0,resultMsg='',myPower=0,enemyPower=0,playerSkin=null,autoBot=false,botCd=0;\nfor(var i=0;i<10;i++)board.push(null);\n\nfunction rndUnit(){return POOL[Math.floor(Math.random()*POOL.length)];}\nfunction genShop(){shop=[rndUnit(),rndUnit(),rndUnit()];}\nfunction genEnemy(){\n eboard=[];var cnt=Math.min(10,3+Math.floor(round*0.7));\n for(var i=0;i<cnt;i++){var u=rndUnit();var p=u.p*(1+round*0.13)*(0.85+Math.random()*0.3);eboard.push({n:u.n,e:u.e,p:p});}\n}\nfunction mergeCheck(){\n var groups={};\n for(var i=0;i<10;i++){var u=board[i];if(!u)continue;var k=u.n+'_'+u.lvl;if(!groups[k])groups[k]=[];groups[k].push(i);}\n for(var k in groups){\n  if(groups[k].length>=3 && board[groups[k][0]].lvl<3){\n   var idxs=groups[k].slice(0,3);var base=board[idxs[0]];\n   var nu={n:base.n,e:base.e,lvl:base.lvl+1,p:Math.round(base.p*2.3)};\n   for(var j=0;j<3;j++)board[idxs[j]]=null;\n   board[idxs[0]]=nu;\n  }\n }\n}\nfunction buyUnit(i){\n if(phase!=='shop'||!shop[i])return;\n if(gold>=shop[i].c){gold-=shop[i].c;bench.push(shop[i]);shop[i]=rndUnit();}\n}\nfunction moveCursor(dir){\n var col=cursor%5,row=Math.floor(cursor/5);\n if(dir==='left')col=(col+4)%5;\n if(dir==='right')col=(col+1)%5;\n if(dir==='up'||dir==='down')row=(row+1)%2;\n cursor=row*5+col;\n}\nfunction placeAt(){\n if(phase!=='shop'||bench.length===0)return;\n if(!board[cursor]){board[cursor]={n:bench[0].n,e:bench[0].e,lvl:1,p:bench[0].p};bench.shift();mergeCheck();}\n}\nfunction startBattle(){\n if(phase!=='shop')return;\n genEnemy();\n myPower=0;for(var i=0;i<10;i++)if(board[i])myPower+=board[i].p;\n enemyPower=0;for(var i=0;i<eboard.length;i++)enemyPower+=eboard[i].p;\n var mE=myPower*(0.85+Math.random()*0.3),eE=enemyPower*(0.85+Math.random()*0.3);\n var win=mE>=eE;\n if(win){wins++;gold+=4+round;score+=100+Math.round(myPower);resultMsg='승리!';}\n else{health--;score+=Math.round(myPower*0.2);resultMsg='패배...';}\n round++;\n if(window.AJ)AJ.score(score);\n phase='battle';battleTimer=2.2;\n window._pendingWin=win;\n}\nfunction afterBattle(){\n if(wins>=8){phase='cleared';show('clearScreen');document.getElementById('clearScore').textContent='최종 점수: '+score;if(window.AJ)AJ.clear(score);return;}\n if(health<=0){phase='over';show('overScreen');document.getElementById('overScore').textContent='최종 점수: '+score;if(window.AJ)AJ.over(score);return;}\n genShop();phase='shop';\n}\nfunction show(id){['titleScreen','overScreen','clearScreen'].forEach(function(s){document.getElementById(s).classList.add('hide');});\n document.getElementById(id).classList.remove('hide');\n cv.classList.toggle('hide',id!==null&&id!=='');\n}\nfunction startGame(){\n round=1;wins=0;gold=10;health=5;score=0;board=[];for(var i=0;i<10;i++)board.push(null);\n bench=[];cursor=0;genShop();phase='shop';\n document.getElementById('titleScreen').classList.add('hide');\n document.getElementById('overScreen').classList.add('hide');\n document.getElementById('clearScreen').classList.add('hide');\n cv.classList.remove('hide');\n if(window.AJ)AJ.start();\n}\nfunction restartGame(){startGame();}\n\nvar keys={};\nfunction setIn(name,on){\n if(on && !keys[name]){\n  if(name==='left'||name==='right'||name==='up'||name==='down')moveCursor(name);\n  if(name==='fire')placeAt();\n  if(name==='guard')startBattle();\n  if(name==='item1')buyUnit(0);\n  if(name==='item2')buyUnit(1);\n  if(name==='item3')buyUnit(2);\n }\n keys[name]=on;\n}\naddEventListener('keydown',function(e){\n if(e.code==='ArrowLeft')setIn('left',true);\n if(e.code==='ArrowRight')setIn('right',true);\n if(e.code==='ArrowUp')setIn('up',true);\n if(e.code==='ArrowDown')setIn('down',true);\n if(e.code==='Space')setIn('fire',true);\n if(e.code==='KeyX')setIn('guard',true);\n if(e.code==='Digit1')setIn('item1',true);\n if(e.code==='Digit2')setIn('item2',true);\n if(e.code==='Digit3')setIn('item3',true);\n});\naddEventListener('keyup',function(e){\n if(e.code==='ArrowLeft')keys.left=false;\n if(e.code==='ArrowRight')keys.right=false;\n if(e.code==='ArrowUp')keys.up=false;\n if(e.code==='ArrowDown')keys.down=false;\n if(e.code==='Space')keys.fire=false;\n if(e.code==='KeyX')keys.guard=false;\n if(e.code==='Digit1')keys.item1=false;\n if(e.code==='Digit2')keys.item2=false;\n if(e.code==='Digit3')keys.item3=false;\n});\n\nfunction drawCell(x,y,w,h,u){\n ctx.strokeStyle='#555';ctx.lineWidth=2;ctx.strokeRect(x,y,w,h);\n if(u){\n  ctx.font=Math.floor(h*0.45)+'px sans-serif';ctx.textAlign='center';\n  ctx.fillText(u.e,x+w/2,y+h*0.5);\n  ctx.font='12px sans-serif';ctx.fillStyle='#fff';\n  ctx.fillText(u.n+' Lv'+(u.lvl||1),x+w/2,y+h*0.72);\n  ctx.fillStyle='#fd6';ctx.fillText('P'+Math.round(u.p),x+w/2,y+h*0.9);\n }\n}\nfunction draw(){\n ctx.fillStyle='#111';ctx.fillRect(0,0,cv.width,cv.height);\n if(phase==='shop'||phase==='battle'){\n  var W=cv.width,H=cv.height;\n  ctx.fillStyle='#fff';ctx.font='16px sans-serif';ctx.textAlign='left';\n  ctx.fillText('라운드 '+round+'/8  승'+wins+'  골드 '+gold+'  체력 '+health+'  점수 '+score,10,24);\n  var gx=10,gy=50,gw=W*0.42,gh=H-160;\n  var cw=gw/5,ch=gh/2;\n  for(var i=0;i<10;i++){\n   var col=i%5,row=Math.floor(i/5);\n   var x=gx+col*cw,y=gy+row*ch;\n   drawCell(x,y,cw,ch,board[i]);\n   if(phase==='shop'&&i===cursor){ctx.strokeStyle='#4f4';ctx.lineWidth=3;ctx.strokeRect(x+2,y+2,cw-4,ch-4);}\n  }\n  var ex=W*0.55,ew=W*0.42;\n  ctx.fillText('적 진영',ex,gy-8);\n  var ecw=ew/5,ech=gh/2;\n  for(var i=0;i<10;i++){\n   var col=i%5,row=Math.floor(i/5);\n   drawCell(ex+col*ecw,gy+row*ech,ecw,ech,eboard[i]||null);\n  }\n  ctx.fillStyle='#fff';ctx.fillText('상점 (item1~3 구매)',10,gy+gh+24);\n  for(var i=0;i<3;i++){\n   var sx=10+i*140;\n   ctx.strokeStyle='#888';ctx.strokeRect(sx,gy+gh+34,120,60);\n   if(shop[i]){\n    ctx.font='24px sans-serif';ctx.fillText(shop[i].e,sx+10,gy+gh+62);\n    ctx.font='13px sans-serif';ctx.fillText(shop[i].n+' G'+shop[i].c,sx+40,gy+gh+62);\n   }\n  }\n  ctx.fillText('대기중: '+bench.length,10,gy+gh+120);\n  ctx.fillText('guard: 전투시작',W-180,gy+gh+120);\n  if(phase==='battle'){\n   ctx.fillStyle='rgba(0,0,0,0.6)';ctx.fillRect(W/2-160,H/2-40,320,80);\n   ctx.fillStyle='#ff5';ctx.font='28px sans-serif';ctx.textAlign='center';\n   ctx.fillText(resultMsg,W/2,H/2+10);\n  }\n  if(autoBot){ctx.fillStyle='#0f0';ctx.font='14px sans-serif';ctx.textAlign='right';}\n }\n}\nfunction loop(t){\n requestAnimationFrame(loop);\n var dt=1/60;\n if(phase==='battle'){\n  battleTimer-=dt;\n  if(battleTimer<=0){afterBattle();}\n }\n if(autoBot)botTick(dt);\n if(phase!=='title')draw();\n}\nrequestAnimationFrame(loop);\n\nfunction botTick(dt){\n botCd-=dt;\n if(phase==='title'){document.getElementById('vibrex-start').click();return;}\n if(botCd>0)return;\n botCd=0.35;\n if(phase!=='shop')return;\n var bestI=-1,bestC=-1;\n for(var i=0;i<3;i++)if(shop[i]&&shop[i].c<=gold&&shop[i].c>bestC){bestC=shop[i].c;bestI=i;}\n if(bestI>=0){buyUnit(bestI);return;}\n if(bench.length>0){\n  for(var i=0;i<10;i++)if(!board[i]){cursor=i;placeAt();return;}\n }\n startBattle();\n}\n\nwindow.vibrexBot={\n start:function(){autoBot=true;},\n stop:function(){autoBot=false;}\n};\n\nfunction nearestEmpty(){\n var best=99,bi=-1;\n for(var i=0;i<10;i++)if(!board[i]){var d=Math.abs(i-cursor);if(d<best){best=d;bi=i;}}\n return bi;\n}\n\nwindow.VIBREX_GAME={\n title:'골드 진영 배틀',\n genre:'오토배틀러',\n goal:'8라운드 승리하기',\n clearCondition:'8승 달성',\n controls:[\n  {input:'left',action:'왼쪽 칸 선택'},{input:'right',action:'오른쪽 칸 선택'},\n  {input:'up',action:'줄 변경'},{input:'down',action:'줄 변경'},\n  {input:'fire',action:'유닛 배치'},{input:'guard',action:'라운드 시작'},\n  {input:'item1',action:'상점 1번 구매'},{input:'item2',action:'상점 2번 구매'},{input:'item3',action:'상점 3번 구매'}\n ],\n phase:function(){return phase==='title'?'title':phase==='over'?'over':phase==='cleared'?'cleared':'playing';},\n progress:function(){return Math.min(1,wins/8);},\n state:function(){\n  var ne=nearestEmpty();\n  return{\n   round:round,gold:gold,health:health,lives:health/5,\n   myPower:Math.min(1,myPower/150),enemyPower:Math.min(1,enemyPower/150),\n   benchCount:bench.length,itemCount:bench.length,activeItem:0,\n   progress:Math.min(1,wins/8),score:score,\n   shopBest:shop.reduce(function(m,