ue:s,configurable:true})}catch(_){}try{Object.defineProperty(window,'sessionStorage',{value:s,configurable:true})}catch(_){}})()}</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>네온 테트리스</title>\n<style>\n  html,body{margin:0;padding:0;width:100%;height:100%;background:#050510;overflow:hidden;\n    font-family:'Consolas','Courier New',monospace;touch-action:none;}\n  #wrap{width:100%;height:100%;display:flex;align-items:center;justify-content:center;position:relative;}\n  canvas{background:#0a0a18;box-shadow:0 0 40px rgba(0,255,255,0.15);image-rendering:optimizeSpeed;}\n  #overlay{\n    position:absolute;top:0;left:0;width:100%;height:100%;\n    display:flex;flex-direction:column;align-items:center;justify-content:center;\n    background:rgba(0,0,0,0.75);color:#0ff;text-align:center;z-index:10;\n  }\n  #overlay h1{font-size:clamp(24px,6vw,42px);text-shadow:0 0 15px #0ff,0 0 30px #0ff;letter-spacing:3px;margin:0 0 10px 0;}\n  #overlay p{font-size:clamp(12px,3vw,16px);color:#8ff;margin:6px 0;}\n  #overlay button{\n    margin-top:20px;padding:12px 30px;font-size:clamp(14px,3.5vw,18px);\n    background:transparent;border:2px solid #0ff;color:#0ff;border-radius:8px;\n    cursor:pointer;box-shadow:0 0 15px #0ff inset,0 0 15px #0ff;letter-spacing:2px;\n  }\n  #overlay button:active{background:#0ff;color:#001;}\n  .hidden{display:none !important;}\n\n  #touchControls{\n    position:fixed;bottom:0;left:0;width:100%;\n    display:none;justify-content:space-between;align-items:flex-end;\n    padding:10px 14px 16px 14px;box-sizing:border-box;z-index:5;pointer-events:none;\n  }\n  #touchControls .side{display:flex;gap:10px;pointer-events:auto;}\n  #touchControls button{\n    width:58px;height:58px;border-radius:50%;\n    background:rgba(0,255,255,0.08);border:2px solid #0ff;color:#0ff;\n    font-size:22px;box-shadow:0 0 12px #0ff;user-select:none;\n    display:flex;align-items:center;justify-content:center;\n  }\n  #touchControls button:active{background:rgba(0,255,255,0.3);}\n  #touchControls .big{width:70px;height:70px;font-size:14px;border-color:#f0f;color:#f0f;box-shadow:0 0 12px #f0f;background:rgba(255,0,255,0.08);}\n  #touchControls .big:active{background:rgba(255,0,255,0.3);}\n\n  @media (pointer: coarse){\n    #touchControls{display:flex;}\n  }\n</style>\n</head>\n<body>\n<div id=\"wrap\">\n  <canvas id=\"game\"></canvas>\n\n  <div id=\"overlay\">\n    <h1 id=\"ovTitle\">NEON TETRIS</h1>\n    <p id=\"ovMsg\">방향키로 이동, 위 화살표로 회전, 스페이스로 하드드롭</p>\n    <p id=\"ovMsg2\">모바일: 하단 버튼 사용</p>\n    <button id=\"ovBtn\">시작하기</button>\n  </div>\n</div>\n\n<div id=\"touchControls\">\n  <div class=\"side\">\n    <button id=\"btnLeft\">◀</button>\n    <button id=\"btnRight\">▶</button>\n  </div>\n  <div class=\"side\">\n    <button id=\"btnDown\">▼</button>\n    <button id=\"btnRotate\">⟳</button>\n    <button class=\"big\" id=\"btnDrop\">DROP</button>\n  </div>\n</div>\n\n<script>\n(function(){\n  const canvas = document.getElementById('game');\n  const ctx = canvas.getContext('2d');\n\n  // ---- logical resolution ----\n  const BLOCK = 26;\n  const COLS = 10, ROWS = 20;\n  const BOARD_X = 16, BOARD_Y = 16;\n  const BOARD_W = COLS*BLOCK, BOARD_H = ROWS*BLOCK;\n  const SIDE_X = BOARD_X + BOARD_W + 20;\n  const LOGICAL_W = SIDE_X + 150 + 16;\n  const LOGICAL_H = BOARD_Y + BOARD_H + 16;\n\n  canvas.width = LOGICAL_W;\n  canvas.height = LOGICAL_H;\n\n  function resize(){\n    const controlsH = (window.matchMedia('(pointer: coarse)').matches) ? 110 : 0;\n    const availW = window.innerWidth;\n    const availH = window.innerHeight - controlsH;\n    const scale = Math.min(availW/LOGICAL_W, availH/LOGICAL_H);\n    canvas.style.width = (LOGICAL_W*scale)+'px';\n    canvas.style.height = (LOGICAL_H*scale)+'px';\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  // ---- tetromino definitions ----\n  const COLORS = {\n    I:'#00f0ff', O:'#ffe600', T:'#c400ff', S:'#00ff6a', Z:'#ff2050', J:'#2070ff', L:'#ff9500'\n  };\n\n  const SHAPES = {\n    I:[ [[0,1],[1,1],[2,1],[3,1]], [[2,0],[2,1],[2,2],[2,3]], [[0,2],[1,2],[2,2],[3,2]], [[1,0],[1,1],[1,2],[1,3]] ],\n    O:[ [[1,0],[2,0],[1,1],[2,1]], [[1,0],[2,0],[1,1],[2,1]], [[1,0],[2,0],[1,1],[2,1]], [[1,0],[2,0],[1,1],[2,1]] ],\n    T:[ [[1,0],[0,1],[1,1],[2,1]], [[1,0],[1,1],[2,1],[1,2]], [[0,1],[1,1],[2,1],[1,2]], [[1,0],[0,1],[1,1],[1,2]] ],\n    S:[ [[1,0],[2,0],[0,1],[1,1]], [[1,0],[1,1],[2,1],[2,2]], [[1,1],[2,1],[0,2],[1,2]], [[0,0],[0,1],[1,1],[1,2]] ],\n    Z:[ [[0,0],[1,0],[1,1],[2,1]], [[2,0],[1,1],[2,1],[1,2]], [[0,1],[1,1],[1,2],[2,2]], [[1,0],[0,1],[1,1],[0,2]] ],\n    J:[ [[0,0],[0,1],[1,1],[2,1]], [[1,0],[2,0],[1,1],[1,2]], [[0,1],[1,1],[2,1],[2,2]], [[1,0],[1,1],[0,2],[1,2]] ],\n    L:[ [[2,0],[0,1],[1,1],[2,1]], [[1,0],[1,1],[1,2],[2,2]], [[0,1],[1,1],[2,1],[0,2]], [[0,0],[1,0],[1,1],[1,2]] ]\n  };\n  const TYPES = Object.keys(SHAPES);\n\n  // ---- game state ----\n  let board, piece, nextQueue, bag;\n  let score, level, lines, dropInterval, dropCounter, lastTime;\n  let gameOver, paused, running=false;\n  let ghostY = 0;\n\n  function newBag(){\n    let b = TYPES.slice();\n    for(let i=b.length-1;i>0;i--){\n      const j = Math.floor(Math.random()*(i+1));\n      [b[i],b[j]]=[b[j],b[i]];\n    }\n    return b;\n  }\n\n  function refillQueue(){\n    while(nextQueue.length < 4){\n      if(bag.length===0) bag = newBag();\n      nextQueue.push(bag.pop());\n    }\n  }\n\n  function spawnPiece(){\n    refillQueue();\n    const type = nextQueue.shift();\n    refillQueue();\n    return { type, rot:0, x:3, y:-1 };\n  }\n\n  function cellsOf(p){\n    return SHAPES[p.type][p.rot].map(c=>[c[0]+p.x, c[1]+p.y]);\n  }\n\n  function collide(p){\n    const cells = cellsOf(p);\n    for(const [x,y] of cells){\n      if(x<0||x>=COLS||y>=ROWS) return true;\n      if(y>=0 && board[y][x]) return true;\n    }\n    return false;\n  }\n\n  function resetGame(){\n    board = Array.from({length:ROWS}, ()=>Array(COLS).fill(null));\n    bag = newBag();\n    nextQueue = [];\n    refillQueue();\n    piece = spawnPiece();\n    score = 0; level = 1; lines = 0;\n    dropInterval = 1000;\n    dropCounter = 0;\n    gameOver = false;\n    paused = false;\n    updateGhost();\n  }\n\n  function updateGhost(){\n    let testP = {type:piece.type, rot:piece.rot, x:piece.x, y:piece.y};\n    while(!collide({...testP, y:testP.y+1})){\n      testP.y++;\n    }\n    ghostY = testP.y;\n  }\n\n  function lockPiece(){\n    const cells = cellsOf(piece);\n    for(const [x,y] of cells){\n      if(y>=0) board[y][x] = COLORS[piece.type];\n    }\n    clearLines();\n    piece = spawnPiece();\n    if(collide(piece)){\n      endGame();\n    } else {\n      updateGhost();\n    }\n  }\n\n  function clearLines(){\n    let cleared = 0;\n    for(let y=ROWS-1;y>=0;y--){\n      if(board[y].every(c=>c!==null)){\n        board.splice(y,1);\n        board.unshift(Array(COLS).fill(null));\n        cleared++;\n        y++;\n      }\n    }\n    if(cleared>0){\n      const table = {1:100,2:300,3:500,4:800};\n      score += (table[cleared]||0) * level;\n      lines += cleared;\n      const newLevel = Math.floor(lines/10)+1;\n      if(newLevel !== level){\n        level = newLevel;\n        dropInterval = Math.max(100, 1000 - (level-1)*80);\n      }\n    }\n  }\n\n  function move(dx){\n    const test = {...piece, x:piece.x+dx};\n    if(!collide(test)){ piece.x = test.x; updateGhost(); return true; }\n    return false;\n  }\n\n  function softDrop(){\n    const test = {...piece, y:piece.y+1};\n    if(!collide(test)){\n      piece.y = test.y;\n      score += 1;\n      return true;\n    } else {\n      lockPiece();\n      return false;\n    }\n  }\n\n  function hardDrop(){\n    let dist = 0;\n    while(!collide({...piece, y:piece.y+1})){\n      piece.y++;\n      dist++;\n    }\n    score += dist*2;\n    lockPiece();\n  }\n\n  function rotate(){\n    const oldRot = piece.rot;\n    const newRot = (piece.rot+1)%4;\n    const kicks = [0,-1,1,-2,2];\n    for(const k of kicks){\n      const test = {...piece, rot:newRot, x:piece.x+k};\n      if(!collide(test)){\n        piece.rot = newRot;\n        piece.x = test.x;\n        updateGhost();\n        return;\n      }\n    }\n  }\n\n  function endGame(){\n    gameOver = true;\n    running = false;\n    showOverlay('GAME OVER', `점수: ${score}   레벨: ${level}   라인: ${lines}`, '다시 시작');\n  }\n\n  // ---- rendering ----\n  function roundRect(x,y,w,h,r){\n    ctx.beginPath();\n    ctx.moveTo(x+r,y);\n    ctx.arcTo(x+w,y,x+w,y+h,r);\n    ctx.arcTo(x+w,y+h,x,y+h,r);\n    ctx.arcTo(x,y+h,x,y,r);\n    ctx.arcTo(x,y,x+w,y,r);\n    ctx.closePath();\n  }\n\n  function drawCell(px,py,size,color,glow,alpha){\n    ctx.save();\n    ctx.globalAlpha = alpha!==undefined?alpha:1;\n    ctx.shadowColor = color;\n    ctx.shadowBlur = glow!==undefined?glow:12;\n    ctx.fillStyle = color;\n    roundRect(px+1.5, py+1.5, size-3, size-3, 4);\n    ctx.fill();\n    ctx.shadowBlur = 0;\n    ctx.strokeStyle = 'rgba(255,255,255,0.25)';\n    ctx.lineWidth = 1;\n    roundRect(px+1.5, py+1.5, size-3, size-3, 4);\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  function draw(){\n    ctx.clearRect(0,0,canvas.width,canvas.height);\n\n    // background grid\n    ctx.save();\n    ctx.translate(BOARD_X, BOARD_Y);\n    ctx.fillStyle = '#080814';\n    ctx.fillRect(0,0,BOARD_W,BOARD_H);\n    ctx.strokeStyle = 'rgba(0,255,255,0.06)';\n    ctx.lineWidth = 1;\n    for(let x=0;x<=COLS;x++){\n      ctx.beginPath(); ctx.moveTo(x*BLOCK,0); ctx.lineTo(x*BLOCK,BOARD_H); ctx.stroke();\n    }\n    for(let y=0;y<=ROWS;y++){\n      ctx.beginPath(); ctx.moveTo(0,y*BLOCK); ctx.lineTo(BOARD_W,y*BLOCK); ctx.stroke();\n    }\n\n    // locked cells\n    for(let y=0;y<ROWS;y++){\n      for(let x=0;x<COLS;x++){\n        if(board[y][x]){\n          drawCell(x*BLOCK, y*BLOCK, BLOCK, board[y][x]);\n        }\n      }\n    }\n\n    if(running && !gameOver){\n      // ghost\n      const gcells = SHAPES[piece.type][piece.rot].map(c=>[c[0]+piece.x, c[1]+ghostY]);\n      for(const [x,y] of gcells){\n        if(y>=0) drawCell(x*BLOCK, y*BLOCK, BLOCK, COLORS[piece.type], 4, 0.18);\n      }\n      // active piece\n      const cells = cellsOf(piece);\n      for(const [x,y] of cells){\n        if(y>=0) drawCell(x*BLOCK, y*BLOCK, BLOCK, COLORS[piece.type], 16, 1);\n      }\n    }\n\n    ctx.strokeStyle = 'rgba(0,255,255,0.4)';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(0,0,BOARD_W,BOARD_H);\n    ctx.restore();\n\n    // sidebar\n    ctx.save();\n    ctx.translate(SIDE_X, BOARD_Y);\n    const sw = 150-16;\n\n    ctx.fillStyle = '#0ff';\n    ctx.font = 'bold 15px Consolas, monospace';\n    ctx.shadowColor = '#0ff';\n    ctx.shadowBlur = 8;\n    ctx.fillText('NEXT', 0, 14);\n    ctx.shadowBlur = 0;\n\n    let ny = 26;\n    for(let i=0;i<3;i++){\n      const t = nextQueue[i];\n      ctx.strokeStyle = 'rgba(255,255,255,0.15)';\n      roundRect(0, ny, sw, 62, 6);\n      ctx.stroke();\n      if(t){\n        const shape = SHAPES[t][0];\n        let minX=4,maxX=0,minY=4,maxY=0;\n        shape.forEach(([x,y])=>{minX=Math.min(minX,x);maxX=Math.max(maxX,x);minY=Math.min(minY,y);maxY=Math.max(maxY,y);});\n        const cw = (maxX-minX+1), ch=(maxY-minY+1);\n        const cell = 16;\n        const offX = (sw - cw*cell)/2;\n        const offY = (62 - ch*cell)/2;\n        shape.forEach(([x,y])=>{\n          drawCell(offX+(x-minX)*cell, ny+offY+(y-minY)*cell, cell, COLORS[t], 8);\n        });\n      }\n      ny += 74;\n    }\n\n    ny += 10;\n    function statBlock(label, value, color){\n      ctx.fillStyle = color;\n      ctx.font = 'bold 12px Consolas, monospace';\n      ctx.shadowColor = color; ctx.shadowBlur = 6;\n      ctx.fillText(label, 0, ny);\n      ctx.shadowBlur = 0;\n      ctx.fillStyle = '#fff';\n      ctx.font = 'bold 20px Consolas, monospace';\n      ctx.fillText(value, 0, ny+22);\n      ny += 46;\n    }\n    statBlock('SCORE', score, '#0ff');\n    statBlock('LEVEL', level, '#f0f');\n    statBlock('LINES', lines, '#ff9500');\n\n    ctx.restore();\n  }\n\n  // ---- overlay ----\n  const overlay = document.getElementById('overlay');\n  const ovTitle = document.getElementById('ovTitle');\n  const ovMsg = document.getElementById('ovMsg');\n  const ovMsg2 = document.getElementById('ovMsg2');\n  const ovBtn = document.getElementById('ovBtn');\n\n  function showOverlay(title, msg, btnText){\n    ovTitle.textContent = title;\n    ovMsg.textContent = msg;\n    ovMsg2.textContent = '';\n    ovBtn.textContent = btnText;\n    overlay.classList.remove('hidden');\n  }\n  function hideOverlay(){\n    overlay.classList.add('hidden');\n  }\n\n  ovBtn.addEventListener('click', ()=>{\n    resetGame();\n    running = true;\n    hideOverlay();\n    lastTime = performance.now();\n    requestAnimationFrame(loop);\n  });\n\n  // ---- input ----\n  window.addEventListener('keydown', (e)=>{\n    if(!running || gameOver){\n      if((e.key==='r'||e.key==='R') && gameOver){\n        resetGame(); running=true; hideOverlay(); lastTime = performance.now(); requestAnimationFrame(loop);\n      }\n      return;\n    }\n    switch(e.key){\n      case 'ArrowLeft': move(-1); e.preventDefault(); break;\n      case 'ArrowRight': move(1); e.preventDefault(); break;\n      case 'ArrowDown': softDrop(); e.preventDefault(); break;\n      case 'ArrowUp': rotate(); e.preventDefault(); break;\n      case ' ': hardDrop(); e.preventDefault(); break;\n      case 'p': case 'P': paused = !paused; e.preventDefault(); break;\n    }\n  });\n\n  function bindHold(id, fn, interval){\n    const el = document.getElementById(id);\n    let timer = null;\n    const start = (ev)=>{\n      ev.preventDefault();\n      if(!running||gameOver) return;\n      fn();\n      timer = setInterval(()=>{ if(running&&!gameOver) fn(); }, interval);\n    };\n    const stop = (ev)=>{ if(ev) ev.preventDefault(); if(timer){ clearInterval(timer); timer=null; } };\n    el.addEventListener('touchstart', start, {passive:false});\n    el.addEventListener('touchend', stop, {passive:false});\n    el.addEventListener('touchcancel', stop, {passive:false});\n    el.addEventListener('mousedown', start);\n    el.addEventListener('mouseup', stop);\n    el.addEventListener('mouseleave', stop);\n  }\n\n  bindHold('btnLeft', ()=>move(-1), 130);\n  bindHold('btnRight', ()=>move(1), 130);\n  bindHold('btnDown', ()=>softDrop(), 60);\n\n  document.getElementById('btnRotate').addEventListener('touchstart', (e)=>{ e.preventDefault(); if(running&&!gameOver) rotate(); }, {passive:false});\n  document.getElementById('btnRotate').addEventListener('mousedown', ()=>{ if(running&&!gameOver) rotate(); });\n  document.getElementById('btnDrop').addEventListener('touchstart', (e)=>{ e.preventDefault(); if(running&&!gameOver) hardDrop(); }, {passive:false});\n  document.getElementById('btnDrop').addEventListener('mousedown', ()=>{ if(running&&!gameOver) hardDrop(); });\n\n  document.addEventListener('touchmove', (e)=>{ e.preventDefault(); }, {passive:false});\n  document.addEventListener('dblclick', (e)=>{ e.preventDefault(); });\n\n  // ---- main loop ----\n  function loop(time){\n    if(!running) return;\n    const dt = time - lastTime;\n    lastTime = time;\n    if(!paused && !gameOver){\n      dropCounter += dt;\n      if(dropCounter > dropInterval){\n        dropCounter = 0;\n        softDrop();\n      }\n    }\n    draw();\n    if(paused){\n      ctx.save();\n      ctx.fillStyle = 'rgba(0,0,0,0.6)';\n      ctx.fillRect(0,0,canvas.width,canvas.height);\n      ctx.fillStyle = '#0ff';\n      ctx.font = 'bold 28px Consolas, monospace';\n      ctx.textAlign = 'center';\n      ctx.shadowColor='#0ff'; ctx.shadowBlur=15;\n      ctx.fillText('PAUSED', canvas.width/2, canvas.height/2);\n      ctx.textAlign = 'left';\n      ctx.restore();\n    }\n    if(!gameOver) requestAnimationFrame(loop);\n  }\n\n  // init screen draw (empty board preview)\n  resetGame();\n  running = false;\n  draw();\n\n  // ==== VIBREX 표준 매니페스트 + 완성형 봇 (템플릿이 보유한 정석 지식 — 실력은 setSkill 로 단계적 해제) ====\n  (function(){\n    function colHeights(b){var hs=[];for(var x=0;x<COLS;x++){var y=0;while(y<ROWS&&!b[y][x])y++;hs.push(ROWS-y)}return hs}\n    function countHoles(b){var n=0;for(var x=0;x<COLS;x++){var y=0;while(y<ROWS&&!b[y][x])y++;for(var yy=y+1;yy<ROWS;yy++)if(!b[yy][x])n++}return n}\n    var W={lines:80,holes:22,agg:1.1,bump:2.2,height:6}; var FEAT=['lines','holes','agg','bump','height']; function feat(b){ var hs=colHeights(b),agg=0,bump=0,maxh=0; for(var i=0;i<COLS;i++){agg+=hs[i];if(hs[i]>maxh)maxh=hs[i];if(i)bump+=Math.abs(hs[i]-hs[i-1])} var full=0;for(var r=0;r<ROWS;r++){var f=true;for(var c=0;c<COLS;c++)if(!b[r][c]){f=false;break}if(f)full++} return [full,countHoles(b),agg,bump,(maxh>ROWS*0.6?(maxh-ROWS*0.6):0)] } function evalFeat(f){ return f[0]*W.lines - f[1]*W.holes - f[2]*W.agg - f[3]*W.bump - f[4]*W.height } function evalBoard(b){ return evalFeat(feat(b)) }\n    function simulate(rot,x,pc){ pc=pc||piece; var p={type:pc.type,rot:rot,x:x,y:pc.y}; if(collide(p))return null; while(!collide({type:p.type,rot:rot,x:x,y:p.y+1}))p.y++; var cells=SHAPES[p.type][rot],b=board.map(function(r){return r.slice()}); for(var i=0;i<cells.length;i++){var cx=cells[i][0]+x,cy=cells[i][1]+p.y;if(cy<0)return null;b[cy][cx]=1} return feat(b); } function candidates(pc){ var cands=[]; pc=pc||piece; if(!pc)return cands; for(var rot=0;rot<4;rot++)for(var x=-2;x<COLS;x++){var f=simulate(rot,x,pc);if(f)cands.push({rot:rot,x:x,f:f,s:evalFeat(f)})} return cands }\n    var skill=0.3,botOn=false,botTimer=null,target=null,lastPieceRef=null;\n    function plan(){ var cands=candidates(); if(!cands.length)return null;\n      cands.sort(function(a,b){return b.s-a.s});\n      var idx=0;\n      if(Math.random()>0.35+skill*0.65)idx=Math.min(cands.length-1,1+Math.floor(Math.random()*3)); // 낮은 실력 = 차선책 실수\n      return cands[idx];\n    }\n    function tick(){\n      if(!botOn)return;\n      if(gameOver){target=null;return}\n      if(!running){try{overlay&&overlay.querySelector('button')&&overlay.querySelector('button').click()}catch(e){}return}\n      if(!piece)return;\n      if(!target||lastPieceRef!==piece){var pl=plan();if(!pl)return;target=pl;lastPieceRef=piece}\n      if(piece.rot!==target.rot){rotate();return}\n      if(piece.x<target.x){move(1);return}\n      if(piece.x>target.x){move(-1);return}\n      if(skill>0.55){hardDrop()}else{softDrop()}\n      target=null;\n    }\n    function botLoop(){if(!botOn)return;try{tick()}catch(e){}botTimer=setTimeout(botLoop,Math.max(45,300-240*skill)*(0.8+Math.random()*0.4))}\n    window.vibrexBot={start:function(){if(botOn)return;botOn=true;botLoop()},stop:function(){botOn=false;if(botTimer)clearTimeout(botTimer)},setSkill:function(s){if(typeof s==='number'&&isFinite(s))skill=Math.max(0,Math.min(1,s))},setWeights:function(w){if(!w||typeof w!=='object')return;for(var k in W){if(typeof w[k]==='number'&&isFinite(w[k]))W[k]=w[k]}},getWeights:function(){return {lines:W.lines,holes:W.holes,agg:W.agg,bump:W.bump,height:W.height}},featureNames:function(){return FEAT.slice()},candidates:function(){return candidates().map(function(c){return {id:c.rot+','+c.x,f:c.f}})}}; /* 사람 배치 기록(모방 학습): 사람이 조각을 놓을 때마다 (후보들의 특징, 선택한 후보) 를 부모에 알린다 */ (function(){var refP=null,lastRot=0,lastX=0,cands=null;setInterval(function(){try{if(botOn||gameOver||!running)return;if(piece!==refP){if(refP&&cands&&cands.length&&window.parent!==window){var chosen=lastRot+','+lastX;var ok=false;for(var i=0;i<cands.length;i++)if(cands[i].id===chosen){ok=true;break}if(ok)parent.postMessage({type:'vibrex:demo-choice',names:FEAT,cands:cands,chosen:chosen},'*')}refP=piece;cands=piece?candidates(piece).map(function(c){return {id:c.rot+','+c.x,f:c.f}}):null}if(piece){lastRot=piece.rot;lastX=piece.x}}catch(e){}},60)})();\n    window.VIBREX_GAME={\n      title:'네온 테트리스',genre:'puzzle',goal:'줄을 지워 점수를 올린다',clearCondition:'40줄 제거',\n      controls:[{input:'ArrowLeft',action:'왼쪽'},{input:'Arr