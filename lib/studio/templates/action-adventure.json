J)AJ.score(game.score);}\nfunction dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y);}\nfunction doInteract(){\n let r=curRoom();\n if(r.type==='key'){\n  if(!r.solved && r.key.taken && player.x>720){r.solved=true;game.keys--;}\n }\n if(r.type==='final'){\n  if(!r.treasure.taken && dist(player,r.treasure)<40){r.treasure.taken=true;game.phase='cleared';addScore(100);if(window.AJ)AJ.clear(game.score);}\n }\n}\nfunction doFire(){\n player.atk=14;\n let r=curRoom();\n if(r.type==='monster'&&r.mon&&r.mon.hp>0){\n  let dx=r.mon.x-player.x,dy=r.mon.y-player.y;\n  if(Math.hypot(dx,dy)<60){\n   r.mon.hp--;addScore(10);\n   if(r.mon.hp<=0){r.solved=true;r.mon=null;addScore(30);}\n  }\n }\n}\nfunction doBomb(){\n let r=curRoom();\n if(r.type==='bomb'&&!r.solved&&game.bombs>0){\n  let w=r.wall;\n  if(player.x>w.x-60&&player.x<w.x+60&&Math.abs(player.y-(w.y+w.h/2))<80){\n   r.solved=true;game.bombs--;addScore(20);\n  }\n }\n}\nfunction rectHit(px,py,pr,rx,ry,rw,rh){\n let cx=Math.max(rx,Math.min(px,rx+rw)),cy=Math.max(ry,Math.min(py,ry+rh));\n return Math.hypot(px-cx,py-cy)<pr;\n}\nfunction update(dt){\n if(game.phase!=='playing')return;\n let r=curRoom();\n let sp=180;\n let dx=(keysDown.right-keysDown.left)*sp*dt;\n let dy=(keysDown.down-keysDown.up)*sp*dt;\n if(dx!==0)player.facing=dx>0?1:-1;\n let nx=player.x+dx,ny=player.y+dy;\n nx=Math.max(20,Math.min(780,nx));ny=Math.max(50,Math.min(420,ny));\n if(r.type==='box'){\n  let b=r.box;\n  if(nx+15>b.x-b.w/2&&nx-15<b.x+b.w/2&&ny+15>b.y-b.h/2&&ny-15<b.y+b.h/2){\n   b.x+=dx;b.y+=dy;\n   b.x=Math.max(60,Math.min(740,b.x));b.y=Math.max(70,Math.min(400,b.y));\n   if(!r.solved&&dist(b,r.marker)<26){r.solved=true;addScore(20);}\n  }\n }\n if(r.type==='bomb'&&!r.solved){\n  let w=r.wall;\n  if(rectHit(nx,ny,16,w.x,w.y,w.w,w.h)){nx=player.x;ny=player.y;}\n }\n if(r.type==='switch'&&!r.solved){\n  if(dist({x:nx,y:ny},r.sw)<26){r.solved=true;addScore(15);}\n }\n if(r.type==='key'&&!r.key.taken){\n  if(dist({x:nx,y:ny},r.key)<24){r.key.taken=true;game.keys++;addScore(10);}\n }\n let openRight=r.solved||r.type==='switch'&&r.solved||r.type==='final';\n if(nx>780&&!openRight)nx=780;\n if(nx>790&&game.roomIndex<5&&openRight){game.roomIndex++;nx=40;addScore(25);if(window.AJ)AJ.level(game.roomIndex+1);}\n if(nx<20&&game.roomIndex>0){game.roomIndex--;nx=760;}\n player.x=nx;player.y=ny;\n if(player.atk>0)player.atk--;\n if(player.inv>0)player.inv--;\n if(r.type==='monster'&&r.mon){\n  let m=r.mon;\n  m.y+=m.vy*dt*60;\n  if(m.y<r.mon.range[0]||m.y>r.mon.range[1])m.vy*=-1;\n  if(player.inv===0&&dist(player,m)<28){\n   game.health--;player.inv=60;\n   if(game.health<=0){\n    game.lives--;game.health=3;player.x=60;player.y=225;\n    if(game.lives<=0){game.phase='over';if(window.AJ)AJ.over(game.score);}\n   }\n  }\n }\n doInteract();\n}\nfunction drawRoomBg(){\n ctx.fillStyle='#222';ctx.fillRect(0,0,W,H);\n ctx.fillStyle='#333';ctx.fillRect(20,50,760,370);\n let r=curRoom();\n let open=r.solved;\n ctx.fillStyle=open?'#2a2':'#a22';\n if(game.roomIndex<5)ctx.fillRect(788,180,10,90);\n ctx.fillStyle='#555';\n ctx.fillRect(2,180,10,90);\n}\nfunction draw(){\n drawRoomBg();\n let r=curRoom();\n if(r.type==='switch'){ctx.fillStyle=r.solved?'#0f0':'#f80';ctx.beginPath();ctx.arc(r.sw.x,r.sw.y,20,0,7);ctx.fill();}\n if(r.type==='box'){\n  ctx.fillStyle='#0af8';ctx.beginPath();ctx.arc(r.marker.x,r.marker.y,20,0,7);ctx.fill();\n  ctx.fillStyle='#a63';ctx.fillRect(r.box.x-r.box.w/2,r.box.y-r.box.h/2,r.box.w,r.box.h);\n }\n if(r.type==='key'&&!r.key.taken){ctx.font='24px sans-serif';ctx.fillText('🔑',r.key.x-12,r.key.y+8);}\n if(r.type==='key'&&!r.solved){ctx.fillText('🚪',770,240);}\n if(r.type==='monster'&&r.mon){ctx.font='30px sans-serif';ctx.fillText('👹',r.mon.x-15,r.mon.y+12);}\n if(r.type==='bomb'&&!r.solved){ctx.fillStyle='#654';ctx.fillRect(r.wall.x,r.wall.y,r.wall.w,r.wall.h);}\n if(r.type==='final'&&!r.treasure.taken){ctx.font='30px sans-serif';ctx.fillText('💎',r.treasure.x-15,r.treasure.y+12);}\n ctx.save();\n ctx.translate(player.x,player.y);\n if(player.inv>0&&Math.floor(player.inv/6)%2===0)ctx.globalAlpha=0.4;\n if(playerSkin){ctx.drawImage(playerSkin,-22,-22,44,44);}\n else{ctx.fillStyle='#4af';ctx.beginPath();ctx.arc(0,0,16,0,7);ctx.fill();}\n if(player.atk>0){ctx.strokeStyle='#fff';ctx.lineWidth=4;ctx.beginPath();ctx.arc(0,0,30,-.6+(player.facing<0?Math.PI:0),.6+(player.facing<0?Math.PI:0));ctx.stroke();}\n ctx.restore();\n ctx.fillStyle='#fff';ctx.font='14px sans-serif';\n ctx.fillText('방 '+(game.roomIndex+1)+'/6  체력:'+game.health+'/3  목숨:'+game.lives+'  열쇠:'+game.keys+'  폭탄:'+game.bombs+'  점수:'+game.score,10,20);\n}\nfunction getState(){\n let r=curRoom();\n let tp=null;\n if(r.type==='switch')tp=r.solved?{x:785,y:225}:r.sw;\n if(r.type==='box')tp=r.solved?{x:785,y:225}:r.marker;\n if(r.type==='key')tp=(!r.key.taken)?r.key:(r.solved?{x:785,y:225}:{x:785,y:225});\n if(r.type==='monster')tp=(r.mon&&r.mon.hp>0)?r.mon:{x:785,y:225};\n if(r.type==='bomb')tp=r.solved?{x:785,y:225}:{x:r.wall.x,y:r.wall.y+r.wall.h/2};\n if(r.type==='final')tp=r.treasure;\n let tdx=0,tdy=0,tdist=1;\n if(tp){tdx=Math.max(-1,Math.min(1,(tp.x-player.x)/400));tdy=Math.max(-1,Math.min(1,(tp.y-player.y)/225));tdist=Math.min(1,dist(player,tp)/500);}\n let ddx=0,ddy=0,ddist=1;\n if(r.type==='monster'&&r.mon){ddx=Math.max(-1,Math.min(1,(r.mon.x-player.x)/400));ddy=Math.max(-1,Math.min(1,(r.mon.y-player.y)/225));ddist=Math.min(1,dist(player,r.mon)/500);}\n return{\n  selfX:player.x/800,selfY:player.y/450,roomIndex:game.roomIndex,\n  targetDX:tdx,targetDY:tdy,targetDist:tdist,\n  dangerDX:ddx,dangerDY:ddy,dangerDist:ddist,\n  health:game.health/3,lives:game.lives,keys:game.keys,itemCount:game.bombs,\n  progress:game.roomIndex/6,score:game.score,facing:player.facing\n };\n}\nwindow.VIBREX_GAME={\n title:'육방 던전 탈출',genre:'탑다운 액션 어드벤처',\n goal:'6개의 방을 지나 마지막 방의 보물을 획득하라',\n clearCondition:'마지막 방에서 보물 획득',\n controls:[{input:'ArrowKeys',action:'이동'},{input:'Space',action:'상호작용(스위치/문)'},{input:'KeyX',action:'검 휘두르기'