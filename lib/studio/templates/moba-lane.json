iewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>라인 대전</title>\n<style>\nbody{margin:0;background:#111;overflow:hidden}\ncanvas{display:block;margin:auto;background:#223}\n#ui{position:fixed;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#fff;font-family:sans-serif;text-align:center;z-index:5}\nbutton{font-size:20px;padding:10px 20px;margin-top:10px;border-radius:8px;border:none;background:#4a9;color:#fff}\n#hud{position:fixed;top:5px;left:5px;color:#fff;font-family:sans-serif;font-size:14px;z-index:3}\n</style></head><body>\n<div id=\"hud\"></div>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nlet W,H,cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){W=innerWidth;H=innerHeight;cv.width=W;cv.height=H;}\naddEventListener('resize',resize);resize();\n\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\n\nconst LANE_Y=()=>H*0.55, LANE_LEN=2000;\nlet keys={left:0,right:0,fire:0,useItem:0,guard:0};\nlet game={phase:'title',score:0,gold:0,lvl:1,atk:8,hp:100,maxhp:100,x:60,skillCd:0,skillMax:6,spawnT:0,time:0,alliesTowerHP:800,enemyTowerHP:800,allyMinions:[],enemyMinions:[],effects:[],botOn:false};\n\nfunction reset(){\n  game={phase:'playing',score:0,gold:0,lvl:1,atk:8,hp:100,maxhp:100,x:60,skillCd:0,skillMax:6,spawnT:0,time:0,alliesTowerHP:800,enemyTowerHP:800,allyMinions:[],enemyMinions:[],effects:[],botOn:game.botOn};\n  if(window.AJ)AJ.start();\n  renderUI();\n}\nfunction worldX(px){return px/LANE_LEN*W;}\n\nfunction spawnWave(){\n  for(let i=0;i<3;i++){\n    game.allyMinions.push({x:80+i*20,hp:60,maxhp:60,atk:5,side:0});\n    game.enemyMinions.push({x:LANE_LEN-80-i*20,hp:60,maxhp:60,atk:5,side:1});\n  }\n}\n\nfunction nearestEnemy(){\n  let best=null,bd=1e9;\n  for(const m of game.enemyMinions){let d=Math.abs(m.x-game.x);if(d<bd){bd=d;best={x:m.x,type:'minion',ref:m}}}\n  let d2=Math.abs(LANE_LEN-40-game.x);\n  return best?{best,bd}:{best:{x:LANE_LEN-40,type:'tower'},bd:d2};\n}\n\nfunction update(dt){\n  if(game.phase!=='playing')return;\n  game.time+=dt;\n  game.spawnT+=dt;\n  if(game.spawnT>=30){game.spawnT=0;spawnWave();}\n  if(game.skillCd>0)game.skillCd-=dt;\n  let speed=120;\n  if(keys.left)game.x-=speed*dt;\n  if(keys.right)game.x+=speed*dt;\n  game.x=Math.max(20,Math.min(LANE_LEN-20,game.x));\n\n  // minion movement & combat\n  for(const m of game.allyMinions){\n    let target=game.enemyMinions.find(e=>Math.abs(e.x-m.x)<25);\n    if(target){target.hp-=m.atk*dt*2;}\n    else if(Math.abs(LANE_LEN-m.x)<40){game.enemyTowerHP-=m.atk*dt*2;}\n    else m.x+=25*dt;\n  }\n  for(const m of game.enemyMinions){\n    let target=game.allyMinions.find(e=>Math.abs(e.x-m.x)<25);\n    if(target){target.hp-=m.atk*dt*2;}\n    else if(Math.abs(m.x-40)<40){game.alliesTowerHP-=m.atk*dt*2;}\n    else m.x-=25*dt;\n    if(Math.abs(m.x-game.x)<30){game.hp-=m.atk*dt;}\n  }\n  game.allyMinions=game.allyMinions.filter(m=>{if(m.hp<=0){game.gold+=10;grow();return false}return true});\n  game.enemyMinions=game.enemyMinions.filter(m=>{if(m.hp<=0){game.gold+=20;grow();return false}return true});\n\n  // near tower attacked by enemy minions\n  for(const m of game.enemyMinions){if(Math.abs(m.x-40)<40){game.alliesTowerHP-=m.atk*dt*2;}}\n\n  // fire (auto attack range)\n  if(keys.fire){\n    let hit=false;\n    for(const m of game.enemyMinions){if(Math.abs(m.x-game.x)<50){m.hp-=game.atk*dt*3;hit=true;}}\n    if(!hit&&Math.abs(LANE_LEN-40-game.x)<50){game.enemyTowerHP-=game.atk*dt*3;}\n  }\n  if(keys.useItem&&game.skillCd<=0){\n    game.skillCd=game.skillMax;\n    let hitc=0;\n    for(const m of game.enemyMinions){if(Math.abs(m.x-game.x)<100){m.hp-=30;hitc++;}}\n    game.effects.push({x:game.x,t:0.3});\n  }\n  if(keys.guard&&game.x<120){\n    game.hp=Math.min(game.maxhp,game.hp+40*dt);\n  }\n  game.effects.forEach(e=>e.t-=dt);\n  game.effects=game.effects.filter(e=>e.t>0);\n\n  if(game.hp<=0||game.alliesTowerHP<=0){\n    game.phase='over';\n    if(window.AJ)AJ.over(game.score);\n    renderUI();\n  }\n  if(game.enemyTowerHP<=0){\n    game.phase='cleared';\n    if(window.AJ)AJ.clear(game.score);\n    renderUI();\n  }\n  let ns=Math.floor(game.gold/2)+Math.floor((LANE_LEN-Math.abs(LANE_LEN-40-game.x))/5);\n  if(ns>game.score){game.score=ns;if(window.AJ)AJ.score(game.score);}\n}\nfunction grow(){\n  game.lvl++;\n  game.atk+=2;\n  game.maxhp+=10;\n  game.hp=Math.min(game.maxhp,game.hp+10);\n}\n\nfunction draw(){\n  ctx.fillStyle='#223';ctx.fillRect(0,0,W,H);\n  let y=LANE_Y();\n  ctx.strokeStyle='#456';ctx.lineWidth=4;\n  ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();\n  // towers\n  ctx.fillStyle='#39f';ctx.fillRect(worldX(20)-10,y-40,20,80);\n  ctx.fillStyle='#f55';ctx.fillRect(worldX(LANE_LEN-20)-10,y-40,20,80);\n  ctx.fillStyle='#fff';ctx.font='12px sans-serif';ctx.textAlign='center';\n  ctx.fillText(Math.max(0,Math.round(game.alliesTowerHP)),worldX(20),y-45);\n  ctx.fillText(Math.max(0,Math.round(game.enemyTowerHP)),worldX(LANE_LEN-20),y-45);\n  for(const m of game.allyMinions){\n    ctx.fillStyle='#5cf';ctx.beginPath();ctx.arc(worldX(m.x),y-10,8,0,7);ctx.fill();\n  }\n  for(const m of game.enemyMinions){\n    ctx.fillStyle='#f77';ctx.beginPath();ctx.arc(worldX(m.x),y-10,8,0,7);ctx.fill();\n  }\n  // player\n  let px=worldX(game.x),py=y-10;\n  if(playerSkin){\n    let s=36;ctx.drawImage(playerSkin,px-s/2,py-s/2,s,s);\n  }else{\n    ctx.fillStyle='#0f0';ctx.beginPath();ctx.arc(px,py,14,0,7);ctx.fill();\n  }\n  for(const e of game.effects){\n    ctx.strokeStyle='rgba(255,255,0,'+(e.t/0.3)+')';ctx.lineWidth=3;\n    ctx.beginPath();ctx.arc(worldX(e.x),py,100/LANE_LEN*W,0,7);ctx.stroke();\n  }\n  ctx.fillStyle='#fff';ctx.font='14px sans-serif';ctx.textAlign='left';\n  ctx.fillText('HP '+Math.round(game.hp)+'/'+game.maxhp,10,20);\n  ctx.fillText('Lv '+game.lvl+' Gold '+game.gold+' Score '+game.score,10,38);\n  ctx.fillText('Skill:'+(game.skillCd>0?Math.ceil(game.skillCd)+'s':'Ready'),10,56);\n  if(game.botOn){ctx.fillStyle='#ff0';ctx.font='16px sans-serif';ctx.textAlign='center';}\n}\n\nlet last=performance.now();\nfunction loop(t){\n  let dt=Math.min(0.05,(t-last)/1000);last=t;\n  update(dt);draw();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nfunction renderUI(){\n  const ui=document.getElementById('ui');\n  if(game.phase==='title'){\n    ui.style.display='flex';\n    ui.innerHTML='<div><h1>라인 대전</h1><p>가로 한 줄 전투 - 적 타워를 부숴라</p>'+\n    '<p>조작: 방향키 이동, 스페이스 평타, X 스킬, 방향키+아래 없음 - 타워근처 D 회복</p>'+\n    '<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>';\n    document.getElementById('vibrex-start').onclick=()=>{reset();ui.style.display='none';};\n  }else if(game.phase==='over'){\n    ui.style.display='flex';\n    ui.innerHTML='<div data-vibrex-role=\"over\"><h1>게임 오버</h1><p>점수: '+game.score+'</p>'+\n    '<button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>';\n    document.getElementById('rb').onclick=()=>{reset();ui.style.display='none';};\n  }else if(game.phase==='cleared'){\n    ui.style.display='flex';\n    ui.innerHTML='<div data-vibrex-role=\"clear\"><h1>클리어!</h1><p>점수: '+game.score+'</p>'+\n    '<button data-vibrex-role=\"restart\" id=\"rb2\">다시하기</button></div>';\n    document.getElementById('rb2').onclick=()=>{reset();ui.style.display='none';};\n  }else{\n    ui.style.display='none';\n  }\n}\nrenderUI();\n\naddEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')keys.left=1;\n  if(e.code==='ArrowRight')keys.right=1;\n  if(e.code==='Space'){keys.fire=1;}\n  if(e.code==='KeyX'){keys.useItem=1;}\n  if(e.code==='ArrowDown')keys.guard=1;\n});\naddEventListener('keyup',e=>{\n  if(e.code==='ArrowLeft')keys.left=0;\n  if(e.code==='ArrowRight')keys.right=0;\n  if(e.code==='Space'){keys.fire=0;}\n  if(e.code==='KeyX'){keys.useItem=0;}\n  if(e.code==='ArrowDown')keys.guard=0;\n});\n\nwindow.VIBREX_GAME={\n  title:'라인 대전',genre:'MOBA',\n  goal:'적 타워(넥서스)를 파괴하라',\n  clearCondition:'적 타워 HP 0 만들기',\n  controls:[\n    {input:'ArrowLeft',action:'왼쪽 이동'},\n    {input:'ArrowRight',action:'오른쪽 이동'},\n    {input:'fire',action:'평타 공격'},\n    {input:'useItem',action:'범위 스킬(쿨다운)'},\n    {input:'guard',action:'타워 근처 회복'}\n  ],\n  phase:()=>game.phase,\n  progress:()=>1-Math.max(0,game.enemyTowerHP)/800,\n  state:()=>{\n    let ne=nearestEnemy();\n    let dx=(ne.best.x-game.x)/LANE_LEN;\n    let ddist=Math.min(1,ne.bd/300);\n    let towerRangeDist=Math.min(1,Math.abs(LANE_LEN-40-game.x)/150);\n    return{\n      score:game.score,\n      health:Math.max(0,game.hp/game.maxhp),\n      lives:Math.max(0,Math.round(game.hp)),\n      progress:1-Math.max(0,game.enemyTowerHP)/800,\n      selfX:game.x/LANE_LEN,\n      laneProgress:game.x/LANE_LEN,\n      targetDX:Math.max(-1,Math.min(1,dx*5)),\n      targetDist:ddist,\n      dangerDX:Math.max(-1,Math.min(1,-dx*5)),\n      dangerDY:0,\n      dangerDist:towerRangeDist,\n      dangerETA:towerRangeDist,\n      allyMinions:game.allyMinions.length,\n      enemyMinions:game.enemyMinions.length,\n      fireReady:1,\n      selfVX:keys.right-keys.left,\n      selfVY:0,\n      facing:keys.right?1:(keys.left?-1:1),\n      groundDist:0,onGround:1\n    };\n  },\n  start:()=>{if(game.phase==='title'){reset();document.getElementById('ui').style.display='none';}},\n  restart:()=>{reset();document.getElementById('ui').style.display='none';},\n  inputs:{\n    left:v=>keys.left=v?1:0,\n    right:v=>keys.right=v?1:0,\n    up:v=>{},down:v=>keys.guard=v?1:0,\n    jump:v=>{},\n    fire:v=>keys.fire=v?1:0,\n    guard:v=>keys.guard=v?1:0,\n    useItem:v=>keys.useItem=v?1:0,\n    item1:v=>{},item2:v=>{},item3:v=>{},item4:v=>{}\n  }\n};\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\n\nlet botT=null;\nwindow.vibrexBot={\n  start(){\n    game.botOn