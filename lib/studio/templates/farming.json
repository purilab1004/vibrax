;i++){if(!cond(plots[i]))continue;let p=plotPos(i);let d=Math.hypot(p.x-px,p.y-py);if(d<bd){bd=d;best=i}}\n  return best;\n}\n\nfunction update(dt){\n  if(phase!=='playing')return;\n  timeLeft-=dt;\n  let sp=180*dt;\n  if(keys.left)px-=sp;if(keys.right)px+=sp;if(keys.up)py-=sp;if(keys.down)py+=sp;\n  px=Math.max(20,Math.min(cv.width-20,px));py=Math.max(20,Math.min(cv.height-20,py));\n  for(let i=0;i<3;i++){if(keys['item'+(i+1)])activeItem=i}\n  if(keys.useItem){\n    let i=nearestPlot(p=>p.state===0);\n    if(i>=0){let p=plotPos(i);if(Math.hypot(p.x-px,p.y-py)<50){\n      let s=SEEDS[activeItem];if(gold>=s.cost){plots[i].state=1;plots[i].type=activeItem;plots[i].grow=0;plots[i].water=0;gold-=s.cost;setGold(gold);}\n    }}\n    keys.useItem=0;\n  }\n  if(keys.fire){\n    let i=nearestPlot(p=>p.state===1&&p.water<1);\n    if(i>=0){let p=plotPos(i);if(Math.hypot(p.x-px,p.y-py)<50)plots[i].water=1;}\n    keys.fire=0;\n  }\n  if(keys.jump){\n    let i=nearestPlot(p=>p.state===2);\n    if(i>=0){let p=plotPos(i);if(Math.hypot(p.x-px,p.y-py)<50){\n      let s=SEEDS[plots[i].type];gold+=s.sell;plots[i].state=0;setGold(gold);\n    }}\n    for(let e=eggs.length-1;e>=0;e--){if(Math.hypot(eggs[e].x-px,eggs[e].y-py)<35){gold+=15;eggs.splice(e,1);setGold(gold)}}\n    keys.jump=0;\n  }\n  for(let p of plots){if(p.state===1&&p.water>0){p.grow+=dt;let s=SEEDS[p.type];if(p.grow>=s.time)p.state=2;}}\n  chick.timer-=dt;chick.x+=chick.vx*40*dt;chick.y+=chick.vy*40*dt;\n  if(chick.x<40||chick.x>cv.width-40)chick.vx*=-1;\n  if(chick.y<40||chick.y>cv.height-40)chick.vy*=-1;\n  if(chick.timer<=0){chick.timer=6+Math.random()*4;eggs.push({x:chick.x,y:chick.y+15})}\n  if(gold>=1000){phase='cleared';score=gold;if(window.AJ)AJ.clear(score);\n    document.getElementById('clearScore').textContent='최종 골드: '+gold;\n    document.getElementById('clearScr').style.display='flex';}\n  if(timeLeft<=0){timeLeft=0;phase='over';score=gold;if(window.AJ)AJ.over(score);\n    document.getElementById('overScore').textContent='최종 골드: '+gold;\n    document.getElementById('overScr').style.display='flex';}\n}\nfunction setGold(g){score=g;if(window.AJ)AJ.score(g)}\n\nfunction draw(){\n  ctx.fillStyle='#3a6b35';ctx.fillRect(0,0,cv.width,cv.height);\n  for(let i=0;i<16;i++){\n    let p=plotPos(i),pl=plots[i];\n    ctx.fillStyle=pl.state===0?'#6b4a2b':(pl.water?'#4a3320':'#8a6b3a');\n    ctx.fillRect(p.x-38,p.y-38,76,76);\n    ctx.strokeStyle='#2a1a10';ctx.strokeRect(p.x-38,p.y-38,76,76);\n    if(pl.state>=1){\n      let s=SEEDS[pl.type];\n      ctx.font='30px sans-serif';ctx.textAlign='center';\n      if(pl.state===2)ctx.fillText(s.e,p.x,p.y+10);\n      else{ctx.fillText('🌱',p.x,p.y+10);\n        ctx.fillStyle='#0f0';ctx.fillRect(p.x-25,p.y+20,50*(pl.grow/s.time),6);}\n    }\n  }\n  ctx.font='24px sans-serif';ctx.textAlign='center';\n  ctx.fillText('🐔',chick.x,chick.y);\n  for(let e of eggs)ctx.fillText('🥚',e.x,e.y);\n  if(playerSkin){ctx.drawImage(playerSkin,px-24,py-24,48,48);}\n  else{ctx.font='32px sans-serif';ctx.fillText('🧑‍🌾',px,py+10);}\n  let ui=document.getElementById('ui');\n  ui.textContent=`골드:${gold} 시간:${Math.ceil(timeLeft)}s 씨앗:${SEEDS[activeItem].n}`;\n  if(window.vibrexBot&&window.vibrexBot._on){ctx.fillStyle='#ff0';ctx.font='16px sans-serif';ctx.fillText('AI PLAYING',cv.width/2,20);}\n}\n\nlet last=performance.now();\nfunction loop(t){\n  let dt=Math.min(.05,(t-last)/1000);last=t;\n  update(dt);draw();requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nfunction start(){\n  reset();phase='playing';\n  document.getElementById('titleScr').style.display='none';\n  document.getElementById('clearScr').style.display='none';\n  document.getElementById('overScr').style.display='none';\n  if(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=start;\ndocument.querySelectorAll('[data-vibrex-role=\"restart\"]').forEach(b=>b.onclick=start);\n\naddEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')keys.left=1;if(e.code==='ArrowRight')keys.right=1;\n  if(e.code==='ArrowUp')keys.up=1;if(e.code==='ArrowDown')keys.down=1;\n  if(e.code==='Space')keys.jump=1;if(e.code==='KeyX')keys.useItem=1;\n  if(e.code==='KeyZ')keys.fire=1;\n  if(e.code==='Digit1')keys.item1=1;if(e.code==='Digit2')keys.item2=1;if(e.code==='Digit3')keys.item3=1;\n});\naddEventListener('keyup',e=>{\n  if(e.code==='ArrowLeft')keys.left=0;if(e.code==='ArrowRight')keys.right=0;\n  if(e.code==='ArrowUp')keys.up=0;if(e.code==='ArrowDown')keys.down=0;\n  if(e.code==='Digit1')keys.item1=0;if(e.code==='Digit2')keys.item2=0;if(e.code==='Digit3')keys.item3=0;\n});\n\nwindow.VIBREX_GAME={\n  title:'힐링 농장',genre:'농장 시뮬레이션',goal:'3분 안에 1000골드 모으기',\n  clearCondition:'골드 1000 달성',\n  controls:[{input:'ArrowKeys',action:'이동'},{input:'item1~3',action:'씨앗 선택'},\n    {input:'useItem',action:'심기'},{input:'fire',action:'물주기'},{input:'jump',action:'수확/줍기'}],\n  phase:()=>phase==='title'?'title':phase==='playing'?'playing':phase==='cleared'?'cleared':'over',\n  progress:()=>Math.min(1,gold/1000),\n  state:()=>{\n    let growing=plots.filter(p=>p.state===1).length;\n    let ready=plots.filter(p=>p.state===2).length;\n    let needWater=plots.filter(p=>p.state===1&&p.water<1);\n    let harvest=plots.map((p,i)=>({p,i})).filter(o=>o.p.state===2);\n    let targets=[...harvest.map(o=>({...plotPos(o.i)})),...eggs];\n    let td=1e9,tdx=0,tdy=0;\n    for(let t of targets){let dx=t.x-px,dy=t.y-py,d=Math.hypot(dx,dy);if(d<td){td=d;tdx=dx/(d||1);tdy=dy/(d||1)}}\n    if(td>1e8){td=0;tdx=0;tdy=0}\n    return{selfX:px/cv.width,selfY:py/cv.height,gold,seeds,growingPlots:growing,readyPlots:ready,\n      targetDX:tdx,targetDY:tdy,targetDist:Math.min(1,td/500),\n      progress:Math.min(1,gold/1000),score:gold,timeLeft,itemCount:3,activeItem};\n  },\n  start(){start()},restart(){start()},\n  inputs:{left:v=>keys.left=v?1:0,right:v=>keys.right=v?1:0,up:v=>keys.up=v?1:0,down:v=>keys.down=v?1:0,\n    jump:v=>{if(v)keys.jump=1},fire:v=>{if(v)keys.fire=1},guard:()=>{},\n    useItem:v=>{if(v)keys.useItem=1},item1:v=>{if(v)keys.item1=1},item2:v=>{if(v)keys.item2=1},item3:v=>{if(v)keys.item3=1},item4:()=>{}}\n};\n\nwindow.vibrexBot={_on:false,_t:null,\n  start(){this._on=true;\n    if(phase==='title')start();\n    this._t=setInterval(()=>{\n      if(phase!=='playing')return;\n      let s=window.VIBREX_GAME.state();\n      let i=nearestPlot(p=>p.state===2);\n      if(i>=0){let p=plotPos(i);let dx=p.x-px,dy=p.y-py,d=Math.hypot(dx,dy);\n        if(d<40){keys.jump=1;keys.left=keys.right=keys.up=keys.down=0;return}\n        keys.left=dx<-10?1:0;keys.right=dx>10?1:0;keys.up=dy<-10?1:0;keys.down=dy>10?1:0;return;}\n      if(eggs.length){let e=eggs[0];let dx=e.x-px,dy=e.y-py,d=Math.hypot(dx,dy);\n        if(d<40){keys.jump=1;keys.left=keys.right=keys.up=keys.down=0;return}\n        keys.left=dx<-10?1:0;keys.right=dx>10?1:0;keys.up=dy<-10?1:0;keys.down=dy>10?1:0;return;}\n      let w=nearestPlot(p=>p.state===1&&p.water<1);\n      if(w>=0){let p=plotPos(w);let dx=p.x-px,dy=p.y-py,d=Math.hypot(dx,dy);\n        if(d<40){keys.fire=1;keys.left=keys.right=keys.up=keys.down=0;return}\n        keys.left=dx<-10?1:0;keys.right=dx>10?1:0;keys.up=dy<-10?1:0;keys.down=dy>10?1:0;return;}\n      let e2=nearestPlot(p=>p.state===0);\n      if(e2>=0){\n        let best=0,bs=-1;for(let k=0;k<3;k++){if(gold>=SEEDS[k].cost&&SEEDS[k].sell/SEEDS[k].time>bs){bs=SEEDS[k].sell/SEEDS[k].time;best=k}}\n        activeItem=best;\n        let p=plotPos(e2);let dx=p.x-px,dy=p.y-py,d=Math.hypot(dx,dy);\n        if(d<40){keys.useItem=1;keys.left=keys.right=keys.up=keys.down=0;return}\n        keys.left=dx<-10?1:0;keys.right=dx>10?1:0;keys.up=dy<-10?1:0;keys.down=dy>10?1:0;\n      }\n    },100);\n  },\n  stop(){this._on=false;clearInterval(this._t);keys.left=keys.right=keys.up=keys.down=0}\n};\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev