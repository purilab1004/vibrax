+){\nmap.push({owner:0,food:1+Math.floor(Math.random()*3),gold:1+Math.floor(Math.random()*3),city:false});\n}\nmap[myCityIdx].owner=1;map[myCityIdx].city=true;\nmap[enemyCityIdx].owner=2;map[enemyCityIdx].city=true;\nturn=1;actionsLeft=3;gold=10;army=5;enemyGold=10;enemyArmy=5;cursor={x:0,y:0};score=0;\n}\ninitMap();\nfunction neighbors(c,r){\nvar n;\nif(r%2===0)n=[[c-1,r],[c+1,r],[c,r-1],[c-1,r-1],[c,r+1],[c-1,r+1]];\nelse n=[[c-1,r],[c+1,r],[c+1,r-1],[c,r-1],[c+1,r+1],[c,r+1]];\nreturn n.filter(function(p){return p[0]>=0&&p[0]<COLS&&p[1]>=0&&p[1]<ROWS;});\n}\nfunction ownedAdj(c,r,owner){\nreturn neighbors(c,r).some(function(p){return map[idx(p[0],p[1])].owner===owner;});\n}\nfunction cost(t){return t.owner===0?1:2;}\nfunction tileCount(o){return map.filter(function(t){return t.owner===o;}).length;}\nfunction capture(c,r,who){\nvar t=map[idx(c,r)];\nif(t.owner===who)return false;\nif(!ownedAdj(c,r,who))return false;\nvar cs=cost(t);\nif(who===1){\nif(army<cs)return false;\narmy-=cs;\nif(t.owner===2)enemyArmy=Math.max(0,enemyArmy-cs);\nt.owner=1;t.city=false;\n}else{\nif(enemyArmy<cs)return false;\nenemyArmy-=cs;\nif(t.owner===1)army=Math.max(0,army-cs);\nt.owner=2;t.city=false;\n}\nreturn true;\n}\nfunction bestTarget(who){\nvar best=null,bv=-1;\nfor(var r=0;r<ROWS;r++)for(var c=0;c<COLS;c++){\nvar t=map[idx(c,r)];\nif(t.owner!==who&&ownedAdj(c,r,who)){\nvar v=t.food+t.gold;\nif(v>bv){bv=v;best={x:c,y:r};}\n}\n}\nreturn best;\n}\nfunction income(){\nvar mg=0,mf=0,mc=0,eg=0,ef=0,ec=0;\nmap.forEach(function(t){\nif(t.owner===1){mg+=t.gold;mf+=t.food;if(t.city)mc++;}\nif(t.owner===2){eg+=t.gold;ef+=t.food;if(t.city)ec++;}\n});\ngold+=mg+mc*2;army+=Math.floor(mf/4)+mc;\nenemyGold+=eg+ec*2;enemyArmy+=Math.floor(ef/4)+ec;\n}\nfunction enemyAI(){\nvar acts=3;\nwhile(acts>0){\nif(enemyGold>=8&&Math.random()<0.4){enemyGold-=8;enemyArmy+=3;acts--;continue;}\nvar t=bestTarget(2);\nif(t&&enemyArmy>=cost(map[idx(t.x,t.y)])){capture(t.x,t.y,2);acts--;}\nelse break;\n}\n}\nfunction endTurn(){\nenemyAI();income();turn++;actionsLeft=3;checkEnd();\n}\nfunction useAction(n){actionsLeft-=n;if(actionsLeft<=0)endTurn();checkEnd();}\nfunction doFire(){\nvar t=map[idx(cursor.x,cursor.y)];\nif(t.owner!==1&&ownedAdj(cursor.x,cursor.y,1)&&army>=cost(t)){\ncapture(cursor.x,cursor.y,1);useAction(1);setScore();\n}\n}\nfunction doItem1(){\nif(gold>=5){gold-=5;army+=3;useAction(1);}\n}\nfunction doItem2(){\nvar t=map[idx(cursor.x,cursor.y)];\nif(t.owner===1&&!t.city&&gold>=10){gold-=10;t.city=true;useAction(1);}\n}\nfunction doGuard(){actionsLeft=0;endTurn();}\nfunction checkEnd(){\nvar mt=tileCount(1);\nif(mt/(COLS*ROWS)>=0.6||map[enemyCityIdx].owner===1){\nphase='cleared';score=mt*10+gold+army;\nif(window.AJ)AJ.clear(score);\nshowEnd(true);\n}else if(turn>20){\nphase='over';score=tileCount(1)*10+gold+army;\nif(window.AJ)AJ.over(score);\nshowEnd(false);\n}\n}\nfunction setScore(){\nvar s=tileCount(1)*10+gold+army;\nif(s!==score){score=s;if(window.AJ)AJ.score(score);}\n}\nvar ui=document.getElementById('ui'),ib=document.getElementById('ib');\nfunction showEnd(win){\nui.style.display='flex';\nui.setAttribute('data-vibrex-role',win?'clear':'over');\nui.innerHTML='<div><h2>'+(win?'클리어!':'게임 오버')+'</h2><p>최종 점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>';\ndocument.getElementById('rb').onclick=restart;\nib.style.display='none';\n}\nfunction restart(){\ninitMap();phase='playing';ui.style.display='none';ib.style.display='flex';\nif(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=function(){\ninitMap();phase='playing';ui.style.display='none';ib.style.display='flex';\nif(window.AJ)AJ.start();\n};\ndocument.getElementById('b1').onclick=function(){if(phase==='playing')doItem1();};\ndocument.getElementById('b2').onclick=function(){if(phase==='playing')doItem2();};\nvar keys={},last={};\nfunction edge(k,fn,cd){\nif(keys[k]&&(!last[k]||performance.now()-last[k]>(cd||220))){fn();last[k]=performance.now();}\