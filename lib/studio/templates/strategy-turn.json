'#fff';ctx.font='16px sans-serif';ctx.textAlign='left';\nctx.fillText('턴 '+turn+'/20  행동 '+actionsLeft+'  금 '+gold+'  병력 '+army+'  적병력 '+enemyArmy,10,24);\nif(botOn){document.getElementById('ai').style.display='block';}else{document.getElementById('ai').style.display='none';}\n}\nfunction runBot(){\nbotTimer++;\nif(botTimer<20)return;\nbotTimer=0;\nvar t=bestTarget(1);\nif(t){\nif(cursor.x<t.x)moveCursor(1,0);else if(cursor.x>t.x)moveCursor(-1,0);\nelse if(cursor.y<t.y)moveCursor(0,1);else if(cursor.y>t.y)moveCursor(0,-1);\nelse if(army>=cost(map[idx(t.x,t.y)]))doFire();\nelse if(gold>=5)doItem1();\n}else if(gold>=5&&army<enemyArmy+3){doItem1();}\nelse if(gold>=10){doItem2();}\n}\nwindow.VIBREX_GAME={\ntitle:'육각 영토 전쟁',genre:'전략',goal:'적 도시 점령 또는 60% 영토 확보',\nclearCondition:'맵의 60% 점령 또는 적 도시 점령',\ncontrols:[{input:'ArrowKeys',action:'커서 이동'},{input:'Space/fire',action:'타일 점령'},{input:'item1',action:'병력 생산'},{input:'item2',action:'도시 건설'},{input:'guard',action:'턴 종료'}],\nphase:function(){return phase==='title'?'title':phase==='playing'?'playing':phase==='over'?'over':phase==='cleared'?'cleared':'title';},\nprogress:function(){return Math.min(1,tileCount(1)/(COLS*ROWS*0.6));},\nstate:function(){\nvar t=bestTarget(1)||{x:cursor.x,y:cursor.y};\nreturn{turn:turn,myTiles:tileCount(1),enemyTiles:tileCount(2),gold:gold,army:army,enemyArmy:enemyArmy,\nprogress:Math.min(1,tileCount(1)/(COLS*ROWS*0.6)),score:score,cursorX:cursor.x/(COLS-1),cursorY:cursor.y/(ROWS-1),\nactionsLeft:actionsLeft,targetDX:(t.x-cursor.x)/COLS,targetDY:(t.y-cursor.y)/ROWS,\ntargetDist:(Math.abs(t.x-cursor.x)+Math.abs(t.y-cursor.y))/(COLS+ROWS),\nfireReady:(map[idx(cursor.x,cursor.y)].owner!==1&&ownedAdj(cursor.x,cursor.y,1)&&army>=cost(map[idx(cursor.x,cursor.y)]))?1:0,\nselfX:cursor.x/(COLS-1),selfY:cursor.y/(ROWS-1)};\n},\nstart:function(){document.getElementById('vibrex-start').click();},\nrestart:function(){restart();},\ninputs:{\nleft:function(on){keys.left=on;},right:function(on){keys.right=on;