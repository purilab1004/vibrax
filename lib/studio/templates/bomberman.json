ackground:rgba(0,0,0,.4);padding:4px 8px;border-radius:4px}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"hud\"></div>\n<div id=\"ui\"></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d'),ui=document.getElementById('ui'),hud=document.getElementById('hud');\nconst COLS=13,ROWS=11;let CELL=32;\nfunction resize(){let w=innerWidth,h=innerHeight;CELL=Math.floor(Math.min(w/COLS,h/ROWS));cv.width=CELL*COLS;cv.height=CELL*ROWS;}\naddEventListener('resize',resize);resize();\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.()});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\nlet grid=[],enemies=[],bombs=[],fires=[],items=[];\nlet px=1,py=1,lives=3,score=0,power=1,bombCap=1,exit={x:COLS-2,y:ROWS-2},phase='title',progress=0;\nlet keys={},lastMove=0,botOn=false,botTimer=0;\nfunction initGrid(){\n  grid=[];\n  for(let y=0;y<ROWS;y++){grid.push([]);for(let x=0;x<COLS;x++){\n    let v=0;\n    if(x===0||y===0||x===COLS-1||y===ROWS-1)v=1;\n    else if(x%2===0&&y%2===0)v=1;\n    else if(Math.random()<0.35 && !((x<=2&&y<=2)||(x>=COLS-3&&y>=ROWS-3)))v=2;\n    grid[y].push(v);\n  }}\n  grid[1][1]=0;grid[1][2]=0;grid[2][1]=0;\n  grid[exit.y][exit.x]=2;\n}\nfunction emptyCells(){let c=[];for(let y=1;y<ROWS-1;y++)for(let x=1;x<COLS-1;x++)if(grid[y][x]===0&&!(x<=2&&y<=2))c.push({x,y});return c;}\nfunction initEnemies(){\n  enemies=[];\n  let c=emptyCells();\n  for(let i=0;i<6;i++){\n    let idx=Math.floor(Math.random()*c.length);\n    let p=c.splice(idx,1)[0]||{x:COLS-2,y:ROWS-2};\n    enemies.push({x:p.x,y:p.y,dx:0,dy:0,alive:true,t:Math.random()*2});\n  }\n}\nfunction resetGame(){\n  initGrid();initEnemies();\n  px=1;py=1;lives=3;score=0;power=1;bombCap=1;bombs=[];fires=[];items=[];\n  phase='playing';progress=0;\n  if(window.AJ)AJ.start();\n}\nfunction addScore(n){score+=n;if(window.AJ)AJ.score(score);}\nfunction cellSolid(x,y){return grid[y]&&(grid[y][x]===1||grid[y][x]===2);}\nfunction tryMove(nx,ny){\n  if(nx<0||ny<0||nx>=COLS||ny>=ROWS)return;\n  if(cellSolid(nx,ny))return;\n  if(bombs.some(b=>b.x===nx&&b.y===ny))return;\n  px=nx;py=ny;\n  let it=items.findIndex(i=>i.x===px&&i.y===py);\n  if(it>=0){let i=items[it];if(i.type===0)bombCap++;else power++;items.splice(it,1);addScore(20);}\n  if(px===exit.x&&py===exit.y&&enemies.every(e=>!e.alive)){\n    phase='cleared';progress=1;if(window.AJ)AJ.clear(score);\n  }\n}\nfunction placeBomb(){\n  if(bombs.filter(b=>b.owner).length>=bombCap)return;\n  if(bombs.some(b=>b.x===px&&b.y===py))return;\n  bombs.push({x:px,y:py,t:2,owner:true,power});\n}\nfunction explode(b){\n  let cells=[{x:b.x,y:b.y}];\n  for(const[dx,dy]of[[1,0],[-1,0],[0,1],[0,-1]]){\n    for(let i=1;i<=b.power;i++){\n      let nx=b.x+dx*i,ny=b.y+dy*i;\n      if(nx<0||ny<0||nx>=COLS||ny>=ROWS||grid[ny][nx]===1)break;\n      cells.push({x:nx,y:ny});\n      if(grid[ny][nx]===2){\n        grid[ny][nx]=0;\n        if(Math.random()<0.4)items.push({x:nx,y:ny,type:Math.random()<0.5?0:1});\n        break;\n      }\n    }\n  }\n  for(const c of cells)fires.push({x:c.x,y:c.y,t:0.4});\n  return cells;\n}\nfunction update(dt){\n  if(phase!=='playing')return;\n  let now=performance.now();\n  if(now-lastMove>140){\n    let dx=0,dy=0;\n    if(keys.left)dx=-1;else if(keys.right)dx=1;\n    else if(keys.up)dy=-1;else if(keys.down)dy=1;\n    if(dx||dy){tryMove(px+dx,py+dy);lastMove=now;}\n  }\n  if(keys.fire){placeBomb();keys.fire=false;}\n  for(const b of bombs){\n    b.t-=dt;\n    if(b.t<=0&&!b.exploded){\n      b.exploded=true;\n      let cells=explode(b);\n      for(const c of cells){\n        if(c.x===px&&c.y===py){lives--;if(window.AJ)AJ.score(score);if(lives<=0){phase='over';if(window.AJ)AJ.over(score);}}\n        for(const e of enemies)if(e.alive&&e.x===c.x&&e.y===c.y){e.alive=false;addScore(100);}\n      }\n      for(const ob of bombs)if(ob!==b&&!ob.exploded&&cells.some(c=>c.x===ob.x&&c.y===ob.y))ob.t=0;\n    }\n  }\n  bombs=bombs.filter(b=>!b.exploded||b.t>-0.1);\n  fires.forEach(f=>f.t-=dt);\n  fires=fires.filter(f=>f.t>0);\n  for(const e of enemies){\n    if(!e.alive)continue;\n    e.t-=dt;\n    if(e.t<=0){\n      e.t=0.5+Math.random()*0.5;\n      let dirs=[[1,0],[-1,0],[0,1],[0,-1]].filter(([dx,dy])=>{\n        let nx=e.x+dx,ny=e.y+dy;\n        return nx>=0&&ny>=0&&nx<COLS&&ny<ROWS&&!cellSolid(nx,ny)&&!bombs.some(b=>b.x===nx&&b.y===ny);\n      });\n      if(dirs.length){let[dx,dy]=dirs[Math.floor(Math.random()*dirs.length)];e.x+=dx;e.y+=dy;}\n    }\n    if(e.x===px&&e.y===py){lives--;e.x=1;e.y=ROWS-2;if(window.AJ)AJ.score(score);if(lives<=0){phase='over';if(window.AJ)AJ.over(score);}}\n    for(const f of fires)if(f.x===e.x&&f.y===e.y){e.alive=false;addScore(100);}\n  }\n  progress=1-enemies.filter(e=>e.alive).length/6;\n}\nfunction draw(){\n  ctx.clearRect(0,0,cv.width,cv.height);\n  for(let y=0;y<ROWS;y++)for(let x=0;x<COLS;x++){\n    let v=grid[y][x];\n    ctx.fillStyle=v===1?'#444':v===2?'#8a5a2b':'#1a1a1a';\n    ctx.fillRect(x*CELL,y*CELL,CELL,CELL);\n    ctx.strokeStyle='#000';ctx.strokeRect(x*CELL,y*CELL,CELL,CELL);\n  }\n  ctx.font=(CELL*0.7)+'px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';\n  ctx.fillText('🚪',(exit.x+0.5)*CELL,(exit.y+0.5)*CELL);\n  for(const i of items)ctx.fillText(i.type===0?'💣':'🔥',(i.x+0.5)*CELL,(i.y+0.5)*CELL);\n  for(const b of bombs)if(!b.exploded)ctx.fillText('💣',(b.x+0.5)*CELL,(b.y+0.5)*CELL);\n  ctx.fillStyle='rgba(255,120,0,.8)';\n  for(const f of fires)ctx.fillRect(f.x*CELL+2,f.y*CELL+2,CELL-4,CELL-4);\n  for(const e of enemies)if(e.alive)ctx.fillText('👹',(e.x+0.5)*CELL,(e.y+0.5)*CELL);\n  if(playerSkin)ctx.drawImage(playerSkin,px*CELL-2,py*CELL-2,CELL+4,CELL+4);\n  else{ctx.fillText('🧑',(px+0.5)*CELL,(py+0.5)*CELL);}\n  if(botOn){ctx.fillStyle='#0f0';ctx.font='14px sans-serif';ctx.textAlign='left';ctx.fillText('AI PLAYING',5,15);}\n  hud.textContent=`❤${lives} 💣${bombCap} 🔥${power} 적:${enemies.filter(e=>e.alive).length}/6 점수:${score}`;\n}\nfunction showTitle(){\n  ui.style.display='flex';\n  ui.innerHTML=`<div><h1>미로 폭발 대작전</h1><p>격자 미로에서 폭탄으로 벽을 부수고 적을 전멸시킨 뒤 출구로!</p>\n  <p>조작: 방향키 이동 / 스페이스=폭탄 설치 / 터치: 가상조이스틱+A버튼</p>\n  <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;\n  document.getElementById('vibrex-start').onclick=()=>{ui.style.display='none';resetGame();};\n}\nfunction showEnd(win){\n  ui.style.display='flex';\n  ui.setAttribute('data-vibrex-role',win?'clear':'');\n  ui.innerHTML=`<div><h1>${win?'클리어!':'게임 오버'}</h1><p>최종 점수: ${score}</p>\n  <button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>`;\n  document.getElementById('rb').onclick=()=>{ui.style.display='none';resetGame();};\n}\nlet last=performance.now();\nfunction loop(t){\n  let dt=Math.min((t-last)/1000,0.05);last=t;\n  if(botOn)botStep(dt);\n  update(dt);draw();\n  if(phase==='over')showEnd(false);\n  else if(phase==='cleared')showEnd(true);\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\nshowTitle();\ninitGrid();initEnemies();\naddEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')keys.left=true;\n  if(e.code==='ArrowRight')keys.right=true;\n  if(e.code==='ArrowUp')keys.up=true;\n  if(e.code==='ArrowDown')keys.down=true;\n  if(e.code==='Space')keys.fire=true;\n});\naddEventListener('keyup',e=>{\n  if(e.code==='ArrowLeft')keys.left=false;\n  if(e.code==='ArrowRight')keys.right=false;\n  if(e.code==='ArrowUp')keys.up=false;\n  if(e.code==='ArrowDown')keys.down=false;\n});\nfunction dist01(dx,dy){return Math.min(1,Math.sqrt(dx*dx+dy*dy)/Math.max(COLS,ROWS));}\nfunction nearestDanger(){\n  let best=null,bd=1e9;\n  for(const e of (enemies||[])){\n    if(!e||!e.alive)continue;\n    let dx=e.x-px,dy=e.y-py,d=Math.abs(dx)+Math.abs(dy);\n    if(d<bd){bd=d;best={dx,dy,d,eta:d/2};}\n  }\n  for(const b of (bombs||[])){\n    let dx=b.x-px,dy=b.y-py,d=Math.abs(dx)+Math.abs(dy);\n    if(d<=b.power+1&&b.t<bd){if(b.t<bd){bd=b.t;best={dx,dy,d:b.t,eta:b.t/2};}}\n  }\n  if(!best)return{dx:0,dy:0,dist:1,eta:1};\n  return{dx:Math.max(-1,Math.min(1,best.dx/COLS*2)),dy:Math.max(-1,Math.min(1,best.dy/ROWS*2)),dist:dist01(best.dx,best.dy),eta:Math.max(0,Math.min(1,best.eta/2))};\n}\nfunction nearestTarget(){\n  let aliveE=(enemies||[]).filter(e=>e&&e.alive);\n  let tx,ty;\n  if(aliveE.length){let n=aliveE[0];tx=n.x;ty=n.y;}\n  else{tx=exit.x;ty=exit.y;}\n  let dx=tx-px,dy=ty-py;\n  return{dx:Math.max(-1,Math.min(1,dx/COLS*2)),dy:Math.max(-1,Math.min(1,dy/ROWS*2)),dist:dist01(dx,dy)};\n}\nwindow.VIBREX_GAME={\n  title:'미로 폭발 대작전',genre:'액션퍼즐',\n  goal:'적 6마리를 모두 없애고 출구로 탈출',\n  clearCondition:'적 전멸 후 출구 도달',\n  controls:[{input:'ArrowKeys',action:'이동'},{input:'Space',action:'폭탄 설치'}],\n  phase:()=>phase==='title'?'title':phase==='playing'?'playing':phase==='over'?'over':phase==='cleared'?'cleared':'title',\n  progress:()=>progress||0,\n  state:()=>{\n    let d=nearestDanger(),tg=nearestTarget();\n    return{score:score||0,lives:lives||0,selfX:(px||0)/COLS,selfY:(py||0)/ROWS,bombs:bombCap||0,power:power||0,\n      enemiesLeft:(enemies||[]).filter(e=>e&&e.alive).length,\n      dangerDX:d.dx,dangerDY:d.dy,dangerDist:d.dist,dangerETA:d.eta,\n      targetDX:tg.dx,targetDY:tg.dy,targetDist:tg.dist,progress:progress||0};\n  },\n  start:()=>{if(phase==='title'||!phase)resetGame();ui.style.display='none';},\n  restart:()=>resetGame(),\n  inputs:{\n    left:v=>keys.left=v,right:v=>keys.right=v,up:v=>keys.up=v,down:v=>keys.down=v,\n    jump:v=>{},fire:v=>{if(v)keys.fire=true;},guard:v=>{}\n  }\n};\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\nlet botMoveT=0,botDir=null;\nfunction botStep(dt){\n  if(phase==='title'){document.getElementById('vibrex-start')?.click();return;}\n  if(phase!=='playing')return;\n  botTimer-=dt;\n  if(botTimer>0)return;\n  botTimer=0.15;\n  let danger=bombs.some(b=>Math.abs(b.x-px)+Math.abs(b.y-py)<=b.power+1);\n  let dirs=[{dx:1,dy:0},{dx:-1,dy:0},{dx:0,dy:1},{dx:0,dy:-1}];\n  if(danger){\n    let safe=dirs.filter(d=>{let nx=px+d.dx,ny=py+d.dy;return !cellSolid(nx,ny)&&!bombs.some(b=>b.x===nx&&b.y===ny)&&!bombs.some(b=>Math.abs(b.x-nx)+Math.abs(b.y-ny)<=b.power+1);});\n    keys.left=keys.right=keys.up=keys.down=false;\n    if(safe.length){let s=safe[Math.floor(Math.random()*safe.length)];if(s.dx<0)keys.left=true;if(s.dx>0)keys.right=true;if(s.dy<0)keys.up=true;if(s.dy>0)keys.down=true;}\n    return;\n  }\n  let nearWall=dirs.some(d=>grid[py+d.dy]?.[px+d.dx]===2);\n  let nearEnemy=enemies.some(e=>e.alive&&Math.abs(e.x-px)+Math.abs(e.y-py)<=2);\n  if((nearWall||nearEnemy)&&bombs.filter(b=>b.owner).length<bombCap){keys.fire=true;return;}\n  let tg=nearestTarget();\n  keys.left=keys.right=keys.up=keys.down=false;\n  if(Math.abs(tg.dx)>Math.abs(tg.dy)){if(tg.dx<0)keys.left=true;else keys.right=true;}\n  else{if(tg.dy<0)keys.up=true;else keys.down=true;}\n}\nwindow.vibrexBot={start:()=>{botOn=true;if(phase==='title')VIBREX_GAME.start();},stop:()=>{botOn=false;keys={};},setSkill:()=>{}};\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,cancelable:true};try{var e=new KeyboardEvent(type,o);Object.defineProperty(e,'keyCode',{get:function(){return o.keyCode}});Object.defineProperty(e,'which',{get:function(){return o.keyCode}});window.dispatchEvent(e);document.dispatchEvent(e);(document.activeElement||document.body).dispatchEvent(e);var c=document.querySelector('canvas');if(c)c.dispatchEvent(e)}catch(e2){}}function inp(name,on){var G=window.VIBREX_GAME;if(G&&G.inputs&&typeof G.inputs[name]==='function'){try{G.inputs[name](on)}catch(e){}}}function set(key,name,on){if(!!held[key]===on)return;held[key]=on;kev(on?'keydown':'keyup',key);inp(name,on)}function hideLegacy(){try{var els=document