se,fire:false,guard:false,useItem:false,item1:false,item2:false,item3:false,item4:false};\n\nfunction resetRound(){\n  gameIdx=Math.floor(Math.random()*3);\n  timer=0;\n  tug.pos=0.5;\n  dodge={p1x:0.5,p2x:0.5,obs:[],timer:0,alive1:true,alive2:true};\n  react={signal:0,waitT:1+Math.random()*2,p1t:-1,p2t:-1,started:false};\n}\n\nfunction startGame(){\n  phase='playing';round=0;p1w=0;p2w=0;p2AI=false;p2InputTimer=0;\n  resetRound();\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){startGame();if(window.AJ)AJ.restart();}\n\nwindow.VIBREX_GAME={\n  title:'2인 파티 대결',genre:'party',\n  goal:'3판 중 2승 먼저 하면 승리',\n  clearCondition:'3판 중 2승',\n  controls:[{input:'ArrowLeft/Right',action:'1P 이동'},{input:'Space',action:'1P 점프/연타/반응'},\n  {input:'A/D',action:'2P 이동'},{input:'W',action:'2P 점프/연타/반응'}],\n  phase:()=>phase,\n  progress:()=>Math.min(1,round/3),\n  state:()=>{\n    let s={game:gameIdx,myScore:p1w,otherScore:p2w,progress:round/3,score:p1w,signal:react.signal};\n    if(gameIdx===0){s.targetDX=tug.pos>0.5?1:-1;s.selfX=tug.pos}\n    if(gameIdx===1){\n      let d=dodge.obs.filter(o=>o.side===0).sort((a,b)=>a.y-b.y)[0];\n      if(d){s.dangerDX=(d.x-dodge.p1x);s.dangerDY=1;s.dangerDist=Math.max(0,1-d.y);s.dangerETA=Math.max(0,1-d.y)}\n      s.selfX=dodge.p1x;\n    }\n    return s;\n  },\n  start:()=>{if(phase==='title'||phase==='over'||phase==='cleared')startGame()},\n  restart:()=>restartGame(),\n  inputs:{\n    left:v=>inputs.left=v,right:v=>inputs.right=v,up:v=>inputs.up=v,down:v=>inputs.down=v,\n    jump:v=>inputs.jump=v,fire:v=>inputs.fire=v,guard:v=>inputs.guard=v,useItem:v=>inputs.useItem=v,\n    item1:v=>inputs.item1=v,item2:v=>inputs.item2=v,item3:v=>inputs.item3=v,item4:v=>inputs.item4=v\n  }\n};\n\n// touch zones for 2p (custom)\nwindow.VIBREX_GAME.touchUI='custom';\nlet zl=document.getElementById('zl'),zr=document.getElementById('zr'),zones=document.getElementById('zones');\nlet touchL={left:false,right:false,jump:false},touchR={left:false,right:false,jump: