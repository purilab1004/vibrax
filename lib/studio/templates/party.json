){return {jump:true};p2ai_tap=0.09+Math.random()*0.05}return{jump:false}}\n  if(gameIdx===1){\n    let d=dodge.obs.filter(o=>o.side===1).sort((a,b)=>a.y-b.y)[0];\n    let l=false,r=false;\n    if(d && d.y>0.3 && d.y<0.9 && Math.abs(d.x-dodge.p2x)<0.15){\n      if(d.x>dodge.p2x)l=true;else r=true;\n    }\n    return {left:l,right:r};\n  }\n  if(gameIdx===2){return {jump:react.signal===1 && Math.random()<0.5}}\n  return {};\n}\n\nfunction endRound(winner){\n  round++;\n  if(winner===1)p1w++;else if(winner===2)p2w++;\n  if(window.AJ)AJ.score(p1w);\n  if(p1w>=2){phase='cleared';if(window.AJ)AJ.clear(p1w)}\n  else if(p2w>=2){phase='over';if(window.AJ)AJ.over(p1w)}\n  else resetRound();\n}\n\nlet last=performance.now();\nfunction loop(now){\n  let dt=Math.min(0.05,(now-last)/1000);last=now;\n  if(phase==='playing'){\n    if(botOn)botAct(dt);\n    if(p1Held())p2InputTimer=0;else p2InputTimer+=dt;\n    let real2=p2Held();\n    p2AI = p2InputTimer>5 && !real2;\n    let p2in = p2AI?p2AIAct(dt):{left:keys['KeyA']||touchR.left,right:keys['KeyD']||touchR.right,jump:keys['KeyW']||touchR.jump};\n    let p1in = {left:keys['ArrowLeft']||inputs.left||touchL.left,right:keys['ArrowRight']||inputs.right||touchL.right,jump:keys['Space']||inputs.jump||touchL.jump};\n\n    timer+=dt;\n    if(gameIdx===0){\n      let f1=p1in.jump?0.006:0,f2=p2in.jump?0.006:0;\n      tug.pos+=f2-f1;\n      tug.pos+=(Math.random()-0.5)*0.001;\n      tug.pos=Math.max(0,Math.min(1,tug.pos));\n      if(tug.pos<=0.03)endRound(1);\n      else if(tug.pos>=0.97)endRound(2);\n      else if(timer>15)endRound(tug.pos<0.5?1:2);\n    } else if(gameIdx===1){\n      let sp=0.9;\n      if(p1in.left)dodge.p1x-=sp*dt;if(p1in.right)dodge.p1x+=sp*dt;\n      if(p2in.left)dodge.p2x-=sp*dt;if(p2in.right)dodge.p2x+=sp*dt;\n      dodge.p1x=Math.max(0,Math.min(1,dodge.p1x));dodge.p2x=Math.max(0,Math.min(1,dodge.p2x));\n      dodge.timer-=dt;\n      if(dodge.timer<=0){\n        dodge.timer=0.5+Math.random()*0.3;\n        dodge.obs.push({x:Math.random(),y:0,side:0,sp:0.3+Math.random()*0.2});\n        dodge.obs.push({x:Math.random(),y:0,side:1,sp:0.3+Math.random()*0.2});\n      }\n      dodge.obs.forEach(o=>o.y+=o.sp*dt);\n      dodge.obs=dodge.obs.filter(o=>{\n        if(o.y>0.95 && o.y<1.05){\n          let px=o.side===0?dodge.p1x:dodge.p2x;\n          if(Math.abs(px-o.x)<0.06){\n            if(o.side===0)dodge.alive1=false;else dodge.alive2=false;\n          }\n        }\n        return o.y<1.1;\n      });\n      if(!dodge.alive1)endRound(2);\n      else if(!dodge.alive2)endRound(1);\n      else if(timer>20)endRound(0);\n    } else if(gameIdx===2){\n      if(!react.started){\n        react.waitT-=dt;\n        if(react.waitT<=0){react.signal=1;react.started=true;react.startT=timer}\n      } else {\n        if(p1in.jump && react.p1t<0)react.p1t=timer-react.startT;\n        if(p2in.jump && react.p2t<0)react.p2t=timer-react.startT;\n        if(react.p1t>=0 && react.p2t>=0){\n          endRound(react.p1t<react.p2t?1:2);\n        } else if(react.p1t>=0 && timer-react.startT>2){endRound(1)}\n        else if(react.p2t>=0 && timer-react.startT>2){endRound(2)}\n      }\n    }\n  }\n  draw();\n  requestAnimationFrame(loop);\n}\n\nfunction draw(){\n  ctx.clearRect(0,0,W(),H());\n  let ui=document.getElementById('ui');\n  if(phase==='title'){\n    zones.style.display='none';\n    ui.innerHTML=`<div><h1>2인 파티 대결</h1>\n    <p>줄다리기 연타 · 장애물 피하기 · 반응속도 대결! 3판 2선승제</p>\n    <p>1P: ←/→/Space 　 2P: A/D/W (5초 무입력시 AI 대신)</p>\n    <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;\n    document.getElementById('vibrex-start').onclick=()=>VIBREX_GAME.start();\n    return;\n  }\n  ui.innerHTML='';\n  zones.style.display='block';\n  ctx.fillStyle='#333';ctx.fillRect(0,0,W(),H());\n  ctx.fillStyle='#fff';ctx.font='20px sans-serif';ctx.textAlign='left';\n  ctx.fillText('1P '+p1w+' : '+p2w+' 2P'+(p2AI?' (AI)':''),10,30);\n  if(botOn){ctx.fillStyle='#ff0';ctx.font='16px sans-serif';}\n\n  if(phase===