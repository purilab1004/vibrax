\n  controls:[{input:'ArrowLeft/Right',action:'1P 이동'},{input:'Space',action:'1P 점프/연타/반응'},\n  {input:'A/D',action:'2P 이동'},{input:'W',action:'2P 점프/연타/반응'}],\n  phase:()=>phase,\n  progress:()=>Math.min(1,round/3),\n  state:()=>{\n    let s={game:gameIdx,myScore:p1w,otherScore:p2w,progress:round/3,score:p1w,signal:react.signal};\n    if(gameIdx===0){s.targetDX=tug.pos>0.5?1:-1;s.selfX=tug.pos}\n    if(gameIdx===1){\n      let d=dodge.obs.filter(o=>o.side===0).sort((a,b)=>a.y-b.y)[0];\n      if(d){s.dangerDX=(d.x-dodge.p1x);s.dangerDY=1;s.dangerDist=Math.max(0,1-d.y);s.dangerETA=Math.max(0,1-d.y)}\n      s.selfX=dodge.p1x;\n    }\n    return s;\n  },\n  start:()=>{if(phase==='title'||phase==='over'||phase==='cleared')startGame()},\n  restart:()=>restartGame(),\n  inputs:{\n    left:v=>inputs.left=v,right:v=>inputs.right=v,up:v=>inputs.up=v,down:v=>inputs.down=v,\n    jump:v=>inputs.jump=v,fire:v=>inputs.fire=v,guard:v=>inputs.guard=v,useItem:v=>inputs.useItem=v,\n    item1:v=>inputs.item1=v,item2:v=>inputs.item2=v,item3:v=>inputs.item3=v,item4:v=>inputs.item4=v\n  }\n};\n\n// touch zones for 2p (custom)\nwindow.VIBREX_GAME.touchUI='custom';\nlet zl=document.getElementById('zl'),zr=document.getElementById('zr'),zones=document.getElementById('zones');\nlet touchL={left:false,right:false,jump:false},touchR={left:false,right:false,jump:false};\nfunction setupTouch(){\n  zones.style.display='block';\n  let lstate={},rstate={};\n  zl.addEventListener('touchstart',e=>{e.preventDefault();touchL.jump=true;let t=e.touches[0];let x=t.clientX;touchL.left=x<zl.getBoundingClientRect().width/2;touchL.right=!touchL.left},{passive:false});\n  zl.addEventListener('touchend',e=>{e.preventDefault();touchL.jump=false;touchL.left=false;touchL.right=false},{passive:false});\n  zr.addEventListener('touchstart',e=>{e.preventDefault();touchR.jump=true;let rect=zr.getBoundingClientRect();let t=e.touches[0];let x=t.clientX-rect.left;touchR.left=x<rect.width/2;touchR.right=!touchR.left},{passive:false});\n  zr.addEventListener('touchend',e=>{e.preventDefault();touchR.jump=false;touchR.left=false;touchR.right=false},{passive:false});\n}\nsetupTouch();\n\n// AI bot for 1P\nlet botOn=false,botTapT=0;\nwindow.vibrexBot={\n  start(){botOn=true;if(phase==='title')VIBREX_GAME.start()},\n  stop(){botOn=false;inputs.left=false;inputs.right=false;inputs.jump=false},\n  setSkill(){}\n};\n\nfunction botAct(dt){\n  if(phase==='title'){VIBREX_GAME.start();return}\n  if(gameIdx===0){\n    botTapT-=dt;if(botTapT<=0){inputs.jump=true;botTapT=0.08+Math.random()*0.05}else inputs.jump=false;\n  } else if(gameIdx===1){\n    let d=dodge.obs.filter(o=>o.side===0).sort((a,b)=>a.y-b.y)[0];\n    inputs.left=false;inputs.right=false;\n    if(d && d.y>0.3 && d.y<0.9){\n      if(Math.abs(d.x-dodge.p1x)<0.15){\n        if(d.x>dodge.p1x)inputs.left=true;else inputs.right=true;\n      }\n    }\n  } else if(gameIdx===2){\n    inputs.jump = react.signal===1;\n  }\n}\n\n// p2 keys: A(left) D(right) W(jump)\nfunction p2Held(){return keys['KeyA']||keys['KeyD']||keys['KeyW']||touchR.left||touchR.right||touchR.jump}\nfunction p1Held(){return keys['ArrowLeft']||keys['ArrowRight']||keys['Space']||inputs.jump||inputs.left||inputs.right||touchL.left||touchL.right||touchL.jump}\n\nlet p2ai_tap=0;\nfunction p2AIAct(dt){\n  if(gameIdx===0){p2ai_tap-=dt;if(p2ai_tap<=0){return {jump:true};p2ai_tap=0.09+Math.random()*0.05}return{jump:false}}\n  if(gameIdx===1){\n    let d=dodge.obs.filter(o=>o.side===1).sort((a,b)=>a.y-b.y)[0];\n    let l=false,r=false;\n    if(d && d.y>0.3 && d.y<0.9 && Math.abs(d.x-dodge.p2x)<0.15){\n      if(d.x>dodge.p2x)l=true;else r=true;\n    }\n    return {left:l,right:r};\n  }\n  if(gameIdx===2){return {jump:react.signal===1 && Math.random()<0.5}}\n  return {};\n}\n\nfunction endRound(winner){\n  round++;\n  if(winner===1)p1w++;else if(winner===2)p2w++;\n  if(window.AJ)AJ.score(p1w);\n  if(p1w>=2){phase='cleared';if(window.AJ)AJ.clear(p1w)}\n  else if(p2w>=2){phase='over';if(window.AJ)AJ.over(p1w)}\n  else resetRound();\n}\n\nlet last=performance.now();\nfunction loop(now){\n  let dt=Math.min(0.05,(now-last)/1000);last=now;\n  if(phase==='playing'){\n    if(botOn)botAct(dt);\n    if(p1Held())p2InputTimer=0;else p2InputTimer+=dt;\n    let real2=p2Held();\n    p2AI = p2InputTimer>5 && !real2;\n    let p2in = p2AI?p2AIAct(dt):{left:keys['KeyA']||touchR.left,right:keys['KeyD']||touchR.right,jump:keys['KeyW']||touchR.jump};\n    let p1in = {left:keys['ArrowLeft']||inputs.left||touchL.left,right:keys['ArrowRight']||inputs.right||touchL.right,jump:keys['Space']||inputs.jump||touchL.jump};\n\n    timer+=dt;\n    if(gameIdx===0){\n      let f1=p1in.jump?0.006:0,f2=p2in.jump?0.006:0;\n      tug.pos+=f2-f1;\n      tug.pos+=(Math.random()-0.5)*0.001;\n      tug.pos=Math.max(0,Math.min(1,tug.pos));\n      if(tug.pos<=0.03)endRound(1);\n      else if(tug.pos>=0.97)endRound(2);\n      else if(timer>15)endRound(tug.pos<0.5?1:2);\n    } else if(gameIdx===1){\n      let sp=0.9;\n      if(p1in.left)dodge.p1x-=sp*dt;if(p1in.right)dodge.p1x+=sp*dt;\n      if(p2in.left)dodge.p2x-=sp*dt;if(p2in.right)dodge.p2x+=sp*dt;\n      dodge.p1x=Math.max(0,Math.min(1,dodge.p1x));dodge.p2x=Math.max(0,Math.min(1,dodge.p2x));\n      dodge.timer-=dt;\n      if(dodge.timer<=0){\n        dodge.timer=0.5+Math.random()*0.3;\n        dodge.obs.push({x:Math.random(),y:0,side:0,sp:0.3+Math.random()*0.2});\n        dodge.obs.push({x:Math.random(),y:0,side:1,sp:0.3+Math.random()*0.2});\n      }\n      dodge.obs.forEach(o=>o.y+=o.sp*dt);\n      dodge.obs=dodge.obs.filter(o=>{\n        if(o.y>0.95 && o.y<1.05){\n          let px=o.side===0?dodge.p1x:dodge.p2x;\n          if(Math.abs(px-o.x)<0.06){\n            if(o.side===0)dodge.alive1=false;else dodge.alive2=false;\n          }\n        }\n        return o.y<1.1;\n      });\n      if(!dodge.alive1)endRound(2);\n      else if(!dodge.alive2)endRound(1);\n      else if(timer>20)endRound(0);\n    } else if(gameIdx===2){\n      if(!react.started){\n        react.waitT-=dt;\n        if(react.waitT<=0){react.signal=1;react.started=true;react.startT=timer}\n      } else {\n        if(p1in.jump && react.p1t<0)react.p1t=timer-react.startT;\n        if(p2in.jump && react.p2t<0)react.p2t=timer-react.startT;\n        if(react.p1t>=0 && react.p2t>=0){\n          endRound(react.p1t<react.p2t?1:2);\n        } else if(react.p1t>=0 && timer-react.startT>2){endRound(1)}\n        else if(react.p2t>=0 && timer-react.startT>2){endRound(2)}\n      }\n    }\n  }\n  draw();\n  requestAnimationFrame(loop);\n}\n\nfunction draw(){\n  ctx.clearRect(0,0,W(),H());\n  let ui=document.getElementById('ui');\n  if(phase==='title'){\n    zones.style.display='none';\n    ui.innerHTML=`<div><h1>2인 파티 대결</h1>\n    <p>줄다리기 연타 · 장애물 피하기 · 반응속도 대결! 3판 2선승제</p>\n    <p>1P: ←/→/Space 　 2P: A/D/W (5초 무입력시 AI 대신)</p>\n    <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;\n    document.getElementById('vibrex-start').onclick=()=>VIBREX_GAME.start();\n    return;\n  }\n  ui.innerHTML='';\n  zones.style.display='block';\n  ctx.fillStyle='#333';ctx.fillRect(0,0,W(),H());\n  ctx.fillStyle='#fff';ctx.font='20px sans-serif';ctx.textAlign='left';\n  ctx.fillText('1P '+p1w+' : '+p2w+' 2P'+(p2AI?' (AI)':''),10,30);\n  if(botOn){ctx.fillStyle='#ff0';ctx.font='16px sans-serif';ctx.fillText('AI PLAYING',10,55)}\n\n  if(phase==='playing'){\n    if(gameIdx===0){\n      ctx.fillStyle='#666';ctx.fillRect(50,H()/2-10,W()-100,20);\n      let x=50+(W()-100)*tug.pos;\n      ctx.fillStyle='#4af';ctx.beginPath();ctx.arc(x,H()/2,20,0,7);ctx.fill();\n      ctx.fillStyle='#fff';ctx.textAlign='center';\n      ctx.fillText('1P ⬅',80,H()/2+60);ctx.fillText('➡ 2P',W()-80,H()/2+60);\n      ctx.fillText('Space/W 연타!',W()/2,H()/2+60);\n    } else if(gameIdx===1){\n      ctx.fillStyle='#555';ctx.fillRect(0,0,W()/2,H());\n      ctx.fillStyle='#666';ctx.fillRect(W()/2,0,W()/2,H());\n      ctx.fillStyle=dodge.alive1?'#4af':'#f44';\n      ctx.fillRect(dodge.p1x*(W()/2)-15,H()-40,30,20);\n      ctx.fillStyle=dodge.alive2?'#fa4':'#f44';\n      ctx.fillRect(W()/2+dodge.p2x*(W()/2)-15,H()-40,30,20);\n      ctx.fillStyle='#e33';\n      dodge.obs.forEach(o=>{\n        let bx=(o.side===0?o.x*(W()/2):W()/2+o.x*(W()/2));\n        ctx.beginPath();ctx.arc(bx,o.y*H(),12,0,7);ctx.fill();\n      });\n      ctx.fillStyle='#fff';ctx.textAlign='center';\n      ctx.fillText('1P',W()/4,25+30);ctx.fillText('2P',W()*3/4,25+30);\n    } else if(gameIdx===2){\n      ctx.fillStyle=react.signal?'#3f3':'#a33';\n      ctx.beginPath();ctx.arc(W()/2,H()/2,80,0,7);ctx.fill();\n      ctx.fillStyle='#fff';ctx.textAlign='center';ctx.font='28px sans-serif';\n      ctx.fillText(react.signal?'지금 눌러!':'대기...',W()/2,H()/2+120);\n    }\n  } else if(phase==='over'){\n    ui.innerHTML=`<div><h1>패배</h1><p>최종 스코어 ${p1w}:${p2w}</p>\n    <button data-vibrex-role=\"restart\" onclick=\"VIBREX_GAME.restart()\">다시하기</button></div>`;\n  } else if(phase==='cleared'){\n    ui.setAttribute('data-vibrex-role','clear');\n    ui.innerHTML=`<div><h1>승리! 🎉</h1><p>최종 스코어 ${p1w}:${p2w}</p>\n    <button data-vibrex-role=\"restart\" onclick=\"VIBREX_GAME.restart()\">다시하기</button></div>`;\n  }\n}\nrequestAnimationFrame(loop);\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,cancelable:true};try{var e=new KeyboardEvent(type,o);Object.defineProperty(e,'keyCode',{get:function(){return o.keyCode}});Object.defineProperty(e,'which',{get:function(){return o.keyCode}});window.dispatchEvent(e);document.dispatchEvent(e);(document.activeElement||document.body).dispatchEvent(e);var c=document.querySelector('canvas');if(c)c.dispatchEvent(e)}catch(e2){}}function inp(name,on){var G=window.VIBREX_GAME;if(G&&G.inputs&&typeof G.inputs[name]==='function'){try{G.inputs[name](on)}catch(e){}}}function set(key,name,on){if(!!held[key]===on)return;held[key]=on;kev(on?'keydown':'keyup',key);inp(name,on)}function hideLegacy(){try{var els=document.querySelectorAll('button,div,span,a');for(var i=0;i<els.length;i++){var el=els[i];var t=(el.textContent||'').trim();var cls=(el.className&&el.className.baseVal!==undefined?el.className.baseVal:el.className)||'';var id=el.id||'';if((/^[\\u25C0\\u25B6\\u25B2\\u25BC\\u2190\\u2192\\u2191\\u2193\\u25C4\\u25BA\\u2039\\u203A<>^v]{1,2}$/.test(t)&&el.children.length===0)||/(^|[\\s_-])(dpad|joystick|touch-?controls?|mobile-?controls?|ctrl-?btn|ctrl-?left|ctrl-?right|btn-?left|btn-?right|btn-?up|btn-?down)([\\s_-]|$)/i.test(cls+' '+id)){var box=el;for(var k=0;k<3&&box.parentElement&&box.parentElement!==document.body;k++){var sib=box.parentElement.children.length;if(sib<=6&&/control|ctrl|dpad|touch|mobile|pad/i.test(box.parentElement.className+' '+box.parentElement.id)){box=box.parentElement}else break}box.style.setProperty('display','none','important')}}}catch(e){}}function build(){var G=window.VIBREX_GAME;if(G&&G.touchUI==='custom')return;if(document.getElementById('vbx-touch'))return;var root=document.createElement('div');root.id='vbx-touch';root.style.cssText='position:fixed;inset:0;z-index:2147482000;pointer-events:none;';root.innerHTML='<style>#vbx-touch *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}#vbx-zone{position:absolute;left:0;bottom:0;width:50%;height:55%;pointer-events:auto;touch-action:none}#vbx-stick{position:absolute;width:124px;height:124px;margin:-62px 0 0 -62px;border-radius:50%;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.35);backdrop-filter:blur(6px);display:none}#vbx-knob{position:absolute;left:50%;top:50%;width:52px;height:52px;margin:-26px 0 0 -26px;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.95),rgba(20