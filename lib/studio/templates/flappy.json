dow,'sessionStorage',{value:s,configurable:true})}catch(_){}})()}</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>둥이 새의 하늘여행</title>\n<style>\n  html,body{\n    margin:0; padding:0; width:100%; height:100%;\n    background:#000; overflow:hidden;\n    touch-action:none;\n    font-family:'Malgun Gothic', sans-serif;\n  }\n  #gameContainer{\n    width:100%; height:100%;\n    display:flex; align-items:center; justify-content:center;\n    position:relative;\n  }\n  canvas{\n    background:#000;\n    touch-action:none;\n    display:block;\n  }\n  #jumpBtn{\n    position:absolute;\n    bottom:5%;\n    left:50%;\n    transform:translateX(-50%);\n    width:110px;\n    height:64px;\n    border-radius:32px;\n    background:rgba(255,255,255,0.18);\n    border:3px solid rgba(255,255,255,0.6);\n    color:#fff;\n    font-size:18px;\n    font-weight:bold;\n    display:none;\n    align-items:center;\n    justify-content:center;\n    user-select:none;\n    -webkit-user-select:none;\n    touch-action:none;\n    z-index:10;\n    letter-spacing:2px;\n  }\n  #jumpBtn.show{ display:flex; }\n</style>\n</head>\n<body>\n<div id=\"gameContainer\">\n  <canvas id=\"game\"></canvas>\n  <div id=\"jumpBtn\">점프</div>\n</div>\n\n<script>\n(function(){\n  const canvas = document.getElementById('game');\n  const ctx = canvas.getContext('2d');\n  const jumpBtn = document.getElementById('jumpBtn');\n\n  // 내부 해상도 (세로형)\n  const W = 480, H = 720;\n  canvas.width = W;\n  canvas.height = H;\n\n  function resize(){\n    const scale = Math.min(window.innerWidth / W, window.innerHeight / H);\n    canvas.style.width = (W*scale) + 'px';\n    canvas.style.height = (H*scale) + 'px';\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  // 터치 기기 감지 -> 버튼 표시\n  const isTouch = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;\n  if(isTouch){ jumpBtn.classList.add('show'); }\n\n  // ===== 게임 상태 =====\n  const STATE = { READY:0, PLAY:1, OVER:2 };\n  let state = STATE.READY;\n\n  let score = 0;\n  let highScore = 0;\n  try{\n    highScore = parseInt(localStorage.getItem('flappyHighScore_v1')||'0',10);\n  }catch(e){ highScore = 0; }\n\n  // 새(캐릭터)\n  const bird = {\n    x: W*0.3,\n    y: H*0.45,\n    r: 20,\n    vy: 0,\n    rotation: 0,\n    flapTimer: 0,\n    flapSpeed: 6\n  };\n\n  const GRAVITY = 1500; // px/s^2\n  const JUMP_V = -430;  // px/s\n  const MAX_FALL = 620;\n\n  // 파이프\n  const PIPE_W = 70;\n  const PIPE_GAP_MIN = 150;\n  const PIPE_GAP_MAX = 190;\n  let pipeSpeed = 180; // px/s\n  let pipes = [];\n  let pipeTimer = 0;\n  let pipeInterval = 1.5; // 초\n\n  // 바닥\n  const GROUND_H = 90;\n\n  // 패럴랙스 배경 레이어\n  let cloudOffset = 0;\n  let hillOffset = 0;\n  let groundOffset = 0;\n\n  // 구름 데이터(고정된 랜덤 위치, 반복 스크롤)\n  const clouds = [];\n  for(let i=0;i<6;i++){\n    clouds.push({\n      x: Math.random()*W,\n      y: 40 + Math.random()*140,\n      s: 0.6 + Math.random()*0.8\n    });\n  }\n  // 언덕 데이터\n  const hills = [];\n  for(let i=0;i<5;i++){\n    hills.push({\n      x: i * (W/2.2),\n      w: 160 + Math.random()*80,\n      h: 60 + Math.random()*50\n    });\n  }\n\n  function resetGame(){\n    bird.y = H*0.45;\n    bird.vy = 0;\n    bird.rotation = 0;\n    pipes = [];\n    pipeTimer = 0;\n    score = 0;\n    cloudOffset = 0;\n    hillOffset = 0;\n    groundOffset = 0;\n    state = STATE.READY;\n  }\n\n  function startGame(){\n    if(state === STATE.READY){\n      state = STATE.PLAY;\n      doJump();\n    } else if(state === STATE.OVER){\n      resetGame();\n      state = STATE.PLAY;\n      doJump();\n    } else if(state === STATE.PLAY){\n      doJump();\n    }\n  }\n\n  function doJump(){\n    bird.vy = JUMP_V;\n    bird.flapTimer = 0;\n  }\n\n  function gameOver(){\n    if(state !== STATE.OVER){\n      state = STATE.OVER;\n      if(score > highScore){\n        highScore = score;\n        try{ localStorage.setItem('flappyHighScore_v1', String(highScore)); }catch(e){}\n      }\n    }\n  }\n\n  // ===== 입력 =====\n  function onAction(e){\n    if(e) e.preventDefault();\n    startGame();\n  }\n\n  canvas.addEventListener('mousedown', onAction);\n  canvas.addEventListener('touchstart', onAction, {passive:false});\n  jumpBtn.addEventListener('touchstart', onAction, {passive:false});\n  jumpBtn.addEventListener('mousedown', onAction);\n\n  window.addEventListener('keydown', function(e){\n    if(e.code === 'Space' || e.key === ' ' || e.code === 'ArrowUp'){\n      e.preventDefault();\n      onAction();\n    }\n  });\n\n  // 페이지 스크롤/줌 방지\n  document.addEventListener('touchmove', function(e){ e.preventDefault(); }, {passive:false});\n  document.addEventListener('dblclick', function(e){ e.preventDefault(); });\n\n  // ===== 파이프 생성 =====\n  function spawnPipe(){\n    const gap = PIPE_GAP_MIN + Math.random()*(PIPE_GAP_MAX-PIPE_GAP_MIN);\n    const margin = 60;\n    const gapY = margin + Math.random()*(H - GROUND_H - margin*2 - gap);\n    pipes.push({\n      x: W + PIPE_W,\n      gapY: gapY,\n      gapH: gap,\n      passed: false\n    });\n  }\n\n  // ===== 그리기 함수들 =====\n  function drawBackground(){\n    // 하늘 그라디언트\n    const g = ctx.createLinearGradient(0,0,0,H);\n    g.addColorStop(0, '#7ec8ff');\n    g.addColorStop(0.7, '#bfe9ff');\n    g.addColorStop(1, '#e8f9ff');\n    ctx.fillStyle = g;\n    ctx.fillRect(0,0,W,H);\n\n    // 구름 (느린 패럴랙스)\n    ctx.fillStyle = 'rgba(255,255,255,0.85)';\n    clouds.forEach(c=>{\n      let cx = (c.x - cloudOffset) % (W+120);\n      if(cx < -120) cx += (W+120);\n      drawCloud(cx, c.y, c.s);\n    });\n\n    // 언덕 (중간 패럴랙스)\n    ctx.fillStyle = '#7bc86c';\n    hills.forEach(h=>{\n      let hx = (h.x - hillOffset) % (W + h.w);\n      if(hx < -h.w) hx += (W + h.w);\n      ctx.beginPath();\n      ctx.moveTo(hx, H-GROUND_H);\n      ctx.quadraticCurveTo(hx + h.w/2, H-GROUND_H-h.h, hx + h.w, H-GROUND_H);\n      ctx.closePath();\n      ctx.fill();\n    });\n  }\n\n  function drawCloud(x,y,s){\n    ctx.save();\n    ctx.translate(x,y);\n    ctx.scale(s,s);\n    ctx.beginPath();\n    ctx.arc(0,0,20,0,Math.PI*2);\n    ctx.arc(22,-8,16,0,Math.PI*2);\n    ctx.arc(-20,-4,15,0,Math.PI*2);\n    ctx.arc(10,8,18,0,Math.PI*2);\n    ctx.fill();\n    ctx.restore();\n  }\n\n  function drawGround(){\n    // 바닥\n    ctx.fillStyle = '#e0c07a';\n    ctx.fillRect(0, H-GROUND_H, W, GROUND_H);\n    ctx.fillStyle = '#6fbf4f';\n    ctx.fillRect(0, H-GROUND_H, W, 14);\n\n    // 줄무늬 스크롤\n    ctx.fillStyle = 'rgba(0,0,0,0.08)';\n    const stripeW = 40;\n    let gx = -(groundOffset % stripeW);\n    for(let x = gx; x < W; x += stripeW){\n      ctx.fillRect(x, H-GROUND_H+14, stripeW/2, GROUND_H-14);\n    }\n  }\n\n  function drawPipe(p){\n    const topH = p.gapY;\n    const botY = p.gapY + p.gapH;\n    const botH = H - GROUND_H - botY;\n\n    const capH = 26;\n\n    // 몸통 그라디언트\n    function bodyGrad(x){\n      const g = ctx.createLinearGradient(x,0,x+PIPE_W,0);\n      g.addColorStop(0, '#3fae4a');\n      g.addColorStop(0.5, '#6fdb6f');\n      g.addColorStop(1, '#2f8a3a');\n      return g;\n    }\n\n    // 위 파이프\n    ctx.fillStyle = bodyGrad(p.x);\n    ctx.fillRect(p.x, 0, PIPE_W, topH - capH);\n    ctx.fillStyle = '#2f8a3a';\n    ctx.fillRect(p.x-4, topH-capH, PIPE_W+8, capH);\n    ctx.strokeStyle = 'rgba(0,0,0,0.15)';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(p.x-4, topH-capH, PIPE_W+8, capH);\n\n    // 아래 파이프\n    ctx.fillStyle = bodyGrad(p.x);\n    ctx.fillRect(p.x, botY+capH, PIPE_W, botH-capH);\n    ctx.fillStyle = '#2f8a3a';\n    ctx.fillRect(p.x-4, botY, PIPE_W+8, capH);\n    ctx.strokeRect(p.x-4, botY, PIPE_W+8, capH);\n  }\n\n  function drawBird(){\n    ctx.save();\n    ctx.translate(bird.x, bird.y);\n    ctx.rotate(bird.rotation);\n\n    // 날개 각도(퍼덕임)\n    const wingAngle = Math.sin(bird.flapTimer * bird.flapSpeed) * 0.9;\n\n    // 몸통\n    const bodyGrad = ctx.createRadialGradient(-5,-5,4, 0,0, bird.r+4);\n    bodyGrad.addColorStop(0, '#fff4b0');\n    bodyGrad.addColorStop(1, '#ffcb3c');\n    ctx.beginPath();\n    ctx.ellipse(0,0, bird.r, bird.r*0.88, 0, 0, Math.PI*2);\n    ctx.fillStyle = bodyGrad;\n    ctx.fill();\n    ctx.strokeStyle = '#e0a010';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n\n    // 배(하이라이트)\n    ctx.beginPath();\n    ctx.ellipse(2, bird.r*0.35, bird.r*0.62, bird.r*0.42, 0, 0, Math.PI*2);\n    ctx.fillStyle = '#fff8de';\n    ctx.fill();\n\n    // 날개\n    ctx.save();\n    ctx.translate(-4, 4);\n    ctx.rotate(wingAngle);\n    ctx.beginPath();\n    ctx.ellipse(0,6, bird.r*0.62, bird.r*0.4, 0.3, 0, Math.PI*2);\n    ctx.fillStyle = '#f5a623';\n    ctx.fill();\n    ctx.strokeStyle = '#c67c0f';\n    ctx.lineWidth = 1.5;\n    ctx.stroke();\n    ctx.restore();\n\n    // 꽁지깃\n    ctx.beginPath();\n    ctx.moveTo(-bird.r*0.9, -2);\n    ctx.lineTo(-bird.r*1.4, -10);\n    ctx.lineTo(-bird.r*1.4, 8);\n    ctx.closePath();\n    ctx.fillStyle = '#f5a623';\n    ctx.fill();\n\n    // 볼터치\n    ctx.beginPath();\n    ctx.arc(4, 4, 4.2, 0, Math.PI*2);\n    ctx.fillStyle = 'rgba(255,120,120,0.55)';\n    ctx.fill();\n\n    // 눈\n    ctx.beginPath();\n    ctx.arc(7, -6, 7, 0, Math.PI*2);\n    ctx.fillStyle = '#fff';\n    ctx.fill();\n    ctx.strokeStyle = '#e0a010';\n    ctx.lineWidth = 1;\n    ctx.stroke();\n\n    ctx.beginPath();\n    ctx.arc(9, -6, 3.4, 0, Math.PI*2);\n    ctx.fillStyle = '#3a2a1a';\n    ctx.fill();\n    // 눈 반짝임\n    ctx.beginPath();\n    ctx.arc(10.2, -7.2, 1, 0, Math.PI*2);\n    ctx.fillStyle = '#fff';\n    ctx.fill();\n\n    // 부리\n    ctx.beginPath();\n    ctx.moveTo(bird.r*0.85, 0);\n    ctx.lineTo(bird.r*1.45, -3);\n    ctx.lineTo(bird.r*1.45, 6);\n    ctx.closePath();\n    ctx.fillStyle = '#ff8a1e';\n    ctx.fill();\n    ctx.strokeStyle = '#d16a00';\n    ctx.lineWidth = 1.2;\n    ctx.stroke();\n\n    ctx.restore();\n  }\n\n  function drawScore(){\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n\n    if(state === STATE.PLAY || state === STATE.OVER){\n      ctx.font = 'bold 52px sans-serif';\n      ctx.lineWidth = 4;\n      ctx.strokeStyle = 'rgba(0,0,0,0.35)';\n      ctx.fillStyle = '#fff';\n      ctx.strokeText(score, W/2, 90);\n      ctx.fillText(score, W/2, 90);\n    }\n\n    if(state === STATE.READY){\n      ctx.font = 'bold 40px sans-serif';\n      ctx.fillStyle = '#fff';\n      ctx.strokeStyle = 'rgba(0,0,0,0.35)';\n      ctx.lineWidth = 3;\n      ctx.strokeText('둥이 새의 하늘여행', W/2, H*0.28);\n      ctx.fillText('둥이 새의 하늘여행', W/2, H*0.28);\n\n      ctx.font = '22px sans-serif';\n      ctx.fillStyle = '#fff';\n      ctx.strokeText(isTouch ? '화면을 탭해서 시작!' : '스페이스바로 시작!', W/2, H*0.34);\n      ctx.fillText(isTouch ? '화면을 탭해서 시작!' : '스페이스바로 시작!', W/2, H*0.34);\n    }\n\n    if(state === STATE.OVER){\n      ctx.fillStyle = 'rgba(0,0,0,0.45)';\n      ctx.fillRect(0, H*0.32, W, H*0.34);\n\n      ctx.font = 'bold 38px sans-serif';\n      ctx.fillStyle = '#ff5252';\n      ctx.fillText('게임 오버', W/2, H*0.40);\n\n      ctx.font = 'bold 26px sans-serif';\n      ctx.fillStyle = '#fff';\n      ctx.fillText('점수: ' + score, W/2, H*0.47);\n      ctx.fillText('최고점: ' + highScore, W/2, H*0.53);\n\n      ctx.font = '20px sans-serif';\n      ctx.fillStyle = '#ffe';\n      ctx.fillText(isTouch ? '탭해서 재시작' : '스페이스바로 재시작', W/2, H*0.60);\n    }\n\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'alphabetic';\n  }\n\n  // ===== 충돌 판정 =====\n  function checkCollision(){\n    // 바닥/천장\n    if(bird.y + bird.r*0.85 >= H - GROUND_H){\n      bird.y = H - GROUND_H - bird.r*0.85;\n      return true;\n    }\n    if(bird.y - bird.r*0.85 <= 0){\n      bird.y = bird.r*0.85;\n      bird.vy = 0;\n    }\n    // 파이프\n    for(let p of pipes){\n      if(bird.x + bird.r*0.75 > p.x && bird.x - bird.r*0.75 < p.x + PIPE_W){\n        if(bird.y - bird.r*0.75 < p.gapY || bird.y + bird.r*0.75 > p.gapY + p.gapH){\n          return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  // ===== 업데이트 =====\n  let lastTime = null;\n  function update(dt){\n    // 패럴랙스는 항상 살짝 움직임(대기화면 포함)\n    cloudOffset += dt * 20;\n    hillOffset += dt * 45;\n\n    if(state === STATE.PLAY){\n      groundOffset += dt * pipeSpeed;\n\n      bird.vy += GRAVITY * dt;\n      if(bird.vy > MAX_FALL) bird.vy = MAX_FALL;\n      bird.y += bird.vy * dt;\n\n      bird.rotation = Math.max(-0.5, Math.min(1.2, bird.vy / 500));\n\n      bird.flapTimer += dt;\n\n      // 파이프 이동/생성\n      pipeTimer += dt;\n      if(pipeTimer >= pipeInterval){\n        pipeTimer = 0;\n        spawnPipe();\n      }\n      pipes.forEach(p => p.x -= pipeSpeed * dt);\n      pipes = pipes.filter(p => p.x > -PIPE_W - 10);\n\n      // 점수 체크\n      pipes.forEach(p => {\n        if(!p.passed && p.x + PIPE_W < bird.x){\n          p.passed = true;\n          score++;\n        }\n      });\n\n      if(checkCollision()){\n        gameOver();\n      }\n    } else if(state === STATE.READY){\n      // 대기 중 새 위아래 살짝 흔들림\n      bird.y = H*0.45 + Math.sin(performance.now()/300)*8;\n      bird.flapTimer += dt;\n      bird.rotation = Math.sin(performance.now()/300)*0.05;\n    } else if(state === STATE.OVER){\n      // 낙하는 멈춤 (바닥에 있으면 유지)\n      if(bird.y + bird.r*0.85 < H - GROUND_H){\n        bird.vy += GRAVITY * dt;\n        bird.y += bird.vy * dt;\n        bird.rotation = Math.min(1.4, bird.rotation + dt*2);\n      }\n    }\n  }\n\n  function render(){\n    drawBackground();\n    if(state !== STATE.READY){\n      pipes.forEach(drawPipe);\n    }\n    drawGround();\n    drawBird();\n    drawScore();\n  }\n\n  function loop(ts){\n    if(lastTime === null) lastTime = ts;\n    let dt = (ts - lastTime) / 1000;\n    lastTime = ts;\n    if(dt > 0.05) dt = 0.05; // 탭 전환 시 큰 점프 방지\n\n    update(dt);\n    render();\n\n    requestAnimationFrame(loop);\n  }\n\n  resetGame();\n  requestAnimationFrame(loop);\n\n})();\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"