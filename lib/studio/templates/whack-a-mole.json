or:#fff}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){let w=window.innerWidth,h=window.innerHeight;let s=Math.min(w,h,600);cv.width=s;cv.height=s;cv.style.width=s+'px';cv.style.height=s+'px';}\nwindow.addEventListener('resize',resize);resize();\n\nlet playerSkin=null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\n\nlet phase='title',score=0,hits=0,misses=0,timeLeft=60,cursorX=1,cursorY=1;\nlet holes=[]; // {mole:null/'normal'/'bomb', t:spawnTime}\nfor(let i=0;i<9;i++)holes.push({mole:null,t:0,age:0});\nlet spawnTimer=0,lastTime=0,rafId=null;\n\nconst GOAL=30;\n\nfunction reset(){\n  score=0;hits=0;misses=0;timeLeft=60;cursorX=1;cursorY=1;\n  holes.forEach(h=>{h.mole=null;h.t=0;h.age=0;});\n  spawnTimer=0;\n}\n\nfunction start(){\n  reset();phase='playing';\n  document.getElementById('ui').innerHTML='';\n  if(window.AJ)AJ.start();\n  lastTime=performance.now();\n  if(rafId)cancelAnimationFrame(rafId);\n  loop(lastTime);\n}\n\nfunction spawnMole(){\n  let empties=holes.map((h,i)=>h.mole?null:i).filter(v=>v!==null);\n  if(empties.length===0)return;\n  let idx=empties[Math.floor(Math.random()*empties.length)];\n  holes[idx].mole=Math.random()<0.2?'bomb':'normal';\n  holes[idx].t=performance.now();\n  holes[idx].age=performance.now();\n}\n\nfunction hitCursor(){\n  let idx=cursorY*3+cursorX;\n  let h=holes[idx];\n  if(!h.mole)return;\n  if(h.mole==='bomb'){\n    score=Math.max(0,score-5);misses++;\n  }else{\n    score+=1;hits++;\n  }\n  if(window.AJ)AJ.score(score);\n  h.mole=null;\n  if(hits>=GOAL)doClear();\n}\n\nfunction doOver(){\n  phase='over';\n  if(window.AJ)AJ.over(score);\n  showOverUI();\n}\nfunction doClear(){\n  phase='cleared';\n  if(window.AJ)AJ.clear(score);\n  showClearUI();\n}\n\nfunction showOverUI(){\n  document.getElementById('ui').innerHTML=`\n  <div>\n  <h2>게임 오버</h2>\n  <p>점수: ${score} / 잡은 두더지: ${hits}</p>\n  <button data-vibrex-role=\"restart\" onclick=\"window.VIBREX_GAME.restart()\">다시하기</button>\n  </div>`;\n}\nfunction showClearUI(){\n  document.getElementById('ui').setAttribute('data-vibrex-role','clear');\n  document.getElementById('ui').innerHTML=`\n  <div>\n  <h2>클리어! 🎉</h2>\n  <p>최종 점수: ${score}</p>\n  <button data-vibrex-role=\"restart\" onclick=\"window.VIBREX_GAME.restart()\">다시하기</button>\n  </div>`;\n}\nfunction showTitleUI(){\n  document.getElementById('ui').removeAttribute('data-vibrex-role');\n  document.getElementById('ui').innerHTML=`\n  <div>\n  <h1>두더지 잡기</h1>\n  <p>3x3 구멍에서 두더지를 잡으세요! 폭탄은 피하세요.</p>\n  <p>조작: 방향키 이동, 스페이스 타격 / 모바일: 구멍 탭</p>\n  <p>목표: 60초 안에 30마리 잡기</p>\n  <button id=\"vibrex-start\" data-vibrex-role=\"start\" onclick=\"window.VIBREX_GAME.start()\">시작</button>\n  </div>`;\n}\nshowTitleUI();\n\nfunction loop(now){\n  if(phase!=='playing'){rafId=null;return;}\n  let dt=(now-lastTime)/1000;lastTime=now;\n  timeLeft-=dt;\n  spawnTimer-=dt;\n  if(spawnTimer<=0){\n    spawnMole();\n    spawnTimer=0.7+Math.random()*0.5;\n  }\n  if(timeLeft<=0){\n    timeLeft=0;\n    render();\n    doOver();\n    return;\n  }\n  render();\n  rafId=requestAnimationFrame(loop);\n}\n\nfunction render(){\n  let s=cv.width;\n  ctx.fillStyle='#222';ctx.fillRect(0,0,s,s);\n  let cell=s/3;\n  for(let y=0;y<3;y++){\n    for(let x=0;x<3;x++){\n      let idx=y*3+x;\n      let h=holes[idx];\n      let cx=x*cell+cell/2,cy=y*cell+cell/2;\n      ctx.fillStyle='#3a2a1a';\n      ctx.beginPath();ctx.ellipse(cx,cy,cell*0.4,cell*0.28,0,0,Math.PI*2);ctx.fill();\n      if(h.mole){\n        ctx.font=(cell*0.5)+'px sans-serif';\n        ctx.textAlign='center';ctx.textBaseline='middle';\n        ctx.fillText(h.mole==='bomb'?'💣':'🐹',cx,cy-cell*0.05);\n      }\n      if(x===cursorX&&y===cursorY){\n        ctx.strokeStyle='#ff0';ctx.lineWidth=4;\n        ctx.strokeRect(x*cell+4,y*cell+4,cell-8,cell-8);\n      }\n    }\n  }\n  ctx.fillStyle='#fff';ctx.font='18px sans-serif';ctx.textAlign='left';\n  ctx.fillText('점수:'+score+' 잡음:'+hits+'/'+GOAL,10,20);\n  ctx.textAlign='right';\n  ctx.fillText('시간:'+Math.ceil(timeLeft),s-10,20);\n  if(botActive){\n    ctx.fillStyle='#0f0';ctx.textAlign='center';\n    ctx.fillText('AI PLAYING',s/2,20);\n  }\n}\n\n// keyboard\nlet keys={};\nwindow.addEventListener('keydown',e=>{\n  if(phase!=='playing')return;\n  if(e.code==='ArrowLeft'){cursorX=Math.max(0,cursorX-1);}\n  if(e.code==='ArrowRight'){cursorX=Math.min(2,cursorX+1);}\n  if(e.code==='ArrowUp'){cursorY=Math.max(0,cursorY-1);}\n  if(e.code==='ArrowDown'){cursorY=Math.min(2,cursorY+1);}\n  if(e.code==='Space'){hitCursor();e.preventDefault();}\n});\n\n// touch tap on holes\ncv.addEventListener('pointerdown',e=>{\n  if(phase!=='playing')return;\n  let rect=cv.getBoundingClientRect();\n  let x=(e.clientX-rect.left)/rect.width*cv.width;\n  let y=(e.clientY-rect.top)/rect.height*cv.height;\n  let cell=cv.width/3;\n  let gx=Math.floor(x/cell),gy=Math.floor(y/cell);\n  gx=Math.max(0,Math.min(2,gx));gy=Math.max(0,Math.min(2,gy));\n  cursorX=gx;cursorY=gy;\n  hitCursor();\n});\n\nwindow.VIBREX_GAME={\n  title:'두더지 잡기',\n  genre:'reaction',\n  goal:'60초 안에 두더지 30마리 잡기',\n  clearCondition:'hits>=30',\n  controls:[\n    {input:'ArrowLeft/Right/Up/Down',action:'커서 이동'},\n    {input:'Space(fire)',action:'타격'}\n  ],\n  phase:()=>phase,\n  progress:()=>Math.min(1,hits/GOAL),\n  state:()=>{\n    let oldest=null,oldestT=Infinity;\n    holes.forEach((h,i)=>{\n      if(h.mole&&h.t<oldestT){oldestT=h.t;oldest={i,mole:h.mole};}\n    });\n    let tdx=0,tdy=0,tdist=1,bombActive=0;\n    if(oldest){\n      let tx=oldest.i%3,ty=Math.floor(oldest.i/3);\n      tdx=Math.max(-1,Math.min(1,(tx-cursorX)/2));\n      tdy=Math.max(-1,Math.min(1,(ty-cursorY)/2));\n      tdist=(Math.abs(tx-cursorX)+Math.abs(ty-cursorY))/4;\n      if(oldest.mole==='bomb')bombActive=1;\n    }\n    let activeMoles=holes.filter(h=>h.mole).length;\n    return{\n      score,hits,misses,activeMoles,\n      targetDX:tdx,targetDY:tdy,targetDist:tdist,\n      timeLeft:Math.max(0,timeLeft),\n      progress:Math.min(1,hits/GOAL),\n      cursorX,cursorY,bombActive\n    };\n  },\n  start:()=>{ if(phase==='title'||phase==='over'||phase==='cleared')start(); },\n  restart:()=>{ if(window.AJ)AJ.restart(); phase='title'; showTitleUI(); start(); },\n  inputs:{\n    left:on=>{ if(on&&phase==='playing')cursorX=Math.max(0,cursorX-1); },\n    right:on=>{ if(on&&phase==='playing')cursorX=Math.min(2,cursorX+1); },\n    up:on=>{ if(on&&phase==='playing')cursorY=Math.max(0,cursorY-1); },\n    down:on=>{ if(on&&phase==='playing')cursorY=Math.min(2,cursorY+1); },\n    jump:on=>{},\n    fire:on=>{ if(on&&phase==='playing')hitCursor(); },\n    guard:on=>{}\n  }\n};\n\nlet botActive=false,botTimer=null;\nwindow.vibrexBot={\n  start(){\n    botActive=true;\n    if(phase==='title')window.VIBREX_GAME.start();\n    if(botTimer)clearInterval(botTimer);\n    botTimer=setInterval(()=>{\n      if(!botActive)return;\n      if(phase==='title'||phase==='over'||phase==='cleared'){\n        window.VIBREX_GAME.start();\n        return;\n      }\n      if(phase!=='playing')return;\n      let oldest=null,oldestT=Infinity;\n      holes.forEach((h,i)=>{\n        if(h.mole==='normal'&&h.t<oldestT){oldestT=h.t;oldest=i;}\n      });\n      if(oldest===null)return;\n      let tx=oldest%3,ty=Math.floor(oldest/3);\n      if(cursorX<tx)cursorX++;\n      else if(cursorX>tx)cursorX--;\n      else if(cursorY<ty)cursorY++;\n      else if(cursorY>ty)cursorY--;\n      else hitCursor();\n    },100);\n  },\n  stop(){\n    botActive=false;\n    if(botTimer)clearInterval(botTimer);\n  },\n  setSkill(){}\n};\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))r