shEdge=false,fireDown=false;\n\nvar player,wallA,gap,door,pickups,enemies,core,bullets,camX,visited;\nfunction reset(){\n player={x:50,y:400,vx:0,vy:0,w:24,h:32,onGround:false,facing:1,jumps:0,dashT:0,dashCD:0,fireCD:0,inv:0,hp:5,maxHp:5,ab:{d:false,da:false,m:false}};\n wallA={x:1600,y:230,w:24,h:220};\n gap={x1:2600,x2:2800};\n door={x:3400,y:250,w:30,h:200,hp:3,broken:false};\n pickups=[{id:'dj',x:1200,y:410,got:false},{id:'da',x:2000,y:410,got:false},{id:'ms',x:3000,y:410,got:false}];\n enemies=[\n  {x:500,y:418,w:26,h:26,vx:1.5,min:400,max:700,hp:2,alive:true},\n  {x:1000,y:418,w:26,h:26,vx:1.5,min:900,max:1500,hp:2,alive:true},\n  {x:1900,y:418,w:26,h:26,vx:1.8,min:1700,max:2400,hp:2,alive:true},\n  {x:2900,y:418,w:26,h:26,vx:1.8,min:2850,max:3350,hp:2,alive:true},\n  {x:3600,y:418,w:26,h:26,vx:2,min:3450,max:4000,hp:2,alive:true}\n ];\n core={x:4100,y:350,w:60,h:100,hp:6,alive:true};\n bullets=[];camX=0;score=0;visited=[true,false,false,false,false];\n}\nreset();\n\nfunction overlap(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;}\nfunction setScore(s){if(s!==score){score=s;if(window.AJ)AJ.score(score);}}\n\nfunction collideSolid(rect,prevY){\n var p={x:player.x,y:player.y,w:player.w,h:player.h};\n if(overlap(p,rect)){\n  if(prevY+player.h<=rect.y+4){player.y=rect.y-player.h;player.vy=0;player.onGround=true;player.jumps=0;}\n  else{\n   if(player.vx>0)player.x=rect.x-player.w;else if(player.vx<0)player.x=rect.x+rect.w;\n   player.vx=0;\n  }\n }\n}\n\nfunction inGap(x){return x+player.w>gap.x1&&x<gap.x2;}\n\nfunction update(){\n if(phase!=='playing')return;\n var prevY=player.y;\n if(leftDown){player.vx=-4;player.facing=-1;}\n else if(rightDown){player.vx=4;player.facing=1;}\n else if(player.dashT<=0){player.vx*=0.8;}\n if(jumpEdge){\n  var maxJ=1+(player.ab.d?1:0);\n  if(player.onGround){player.vy=-11;player.jumps=1;player.onGround=false;}\n  else if(player.jumps<maxJ){player.vy=-11;player.jumps++;}\n  jumpEdge=false;\n }\n if(dashEdge){\n  if(player.ab.da&&player.dashCD<=0){player.dashT=14;player.dashCD=60;}\n  dashEdge=false;\n }\n if(player.dashCD>0)player.dashCD--;\n if(player.dashT>0){player.dashT--;player.vx=player.facing*18;player.vy=0;}\n else{player.vy+=0.6;}\n if(player.fireCD>0)player.fireCD--;\n if(player.inv>0)player.inv--;\n player.x+=player.vx;player.y+=player.vy;\n player.x=Math.max(0,Math.min(worldW-player.w,player.x));\n\n var wasGround=player.onGround;player.onGround=false;\n if(!inGap(player.x)){\n  if(player.y+player.h>=groundY){player.y=groundY-player.h;player.vy=0;player.onGround=true;player.jumps=0;}\n } else if(player.y>H+80){\n  player.x=Math.max(0,gap.x1-120);player.y=380;player.vy=0;player.hp-=1;\n }\n collideSolid(wallA,prevY);\n if(!door.broken)collideSolid(door,prevY);\n\n for(var i=0;i<pickups.length;i++){var pk=pickups[i];\n  if(!pk.got&&overlap(player,{x:pk.x,y:pk.y,w:26,h:26})){\n   pk.got=true;setScore(score+100);\n   if(pk.id=='dj')player.ab.d=true;if(pk.id=='da')player.ab.da=true;if(pk.id=='ms')player.ab.m=true;\n  }\n }\n\n for(var i=0;i<enemies.length;i++){var e=enemies[i];if(!e.alive)continue;\n  e.x+=e.vx;if(e.x<e.min||e.x>e.max)e.vx*=-1;\n  if(player.inv<=0&&overlap(player,e)){player.hp-=1;player.inv=60;player.vx=-player.facing*6;player.vy=-4;}\n }\n\n if(fireDown&&player.fireCD<=0){\n  player.fireCD=20;\n  if(player.ab.m){bullets.push({x:player.x+player.facing*20+10,y:player.y+10,vx:player.facing*10});}\n  else{\n   for(var i=0;i<enemies.length;i++){var e=enemies[i];if(!e.alive)continue;\n    if(Math.abs(e.x-player.x)<45&&((e.x-player.x)*player.facing>0)){e.hp--;if(e.hp<=0){e.alive=false;setScore(score+20);}}\n   }\n  }\n }\n for(var i=bullets.length-1;i>=0;i--){var b=bullets[i];b.x+=b.vx;var hit=false;\n  for(var j=0;j<enemies.length;j++){var e=enemies[j];if(e.alive&&overlap({x:b.x,y:b.y,w:8,h:8},e)){e.hp--;hit=true;if(e.hp<=0){e.alive=false;setScore(score+20);}}}\n  if(!door.broken&&overlap({x:b.x,y:b.y,w:8,h:8},door)){door.hp--;hit=true;if(door.hp<=0){door.broken=true;setScore(score+100);}}\n  if(core.alive&&overlap({x:b.x,y:b.y,w:8,h:8},core)){core.hp--;hit=true;setScore(score+50);\n   if(core.hp<=0){core.alive=false;setScore(score+500);phase='cleared';showEnd(true);if(window.AJ)AJ.clear(score);}\n  }\n  if(hit||b.x<0||b.x>worldW)bullets.splice(i,1);\n }\n\n var zi=Math.floor(player.x/(worldW/5));visited[zi]=true;\n if(player.hp<=0){phase='over';showEnd(false);if(window.AJ)AJ.over(score);}\n\n camX=Math.max(0,Math.min(worldW-W,player.x-W/2));\n if(botOn)runBot();\n}\n\nfunction nearestEnemy(){var best=null,bd=1e9;for(var i=0;i<enemies.length;i++){var e=enemies[i];if(!e.alive)continue;var d=Math.abs(e.x-player.x);if(d<bd){bd=d;best=e;}}return best;}\nfunction target(){\n if(!player.ab.d){var p=pickups[0];return{x:p.x,y:p.y};}\n if(!player.ab.da){var p=pickups[1];return{x:p.x,y:p.y};}\n if(!player.ab.m){var p=pickups[2];return{x:p.x,y:p.y};}\n if(!door.broken)return{x:door.x,y:door.y};\n return{x:core.x,y:core.y};\n}\n\nfunction runBot(){\n var t=target();var dx=t.x-player.x;\n leftDown=false;rightDown=false;\n if(dx>15)rightDown=true;else if(dx<-15)leftDown=true;\n var e=nearestEnemy();\n fireDown=false;\n if(e&&Math.abs(e.x-player.x)<60){fireDown=true;}\n if(!door.broken&&Math.abs(door.x-player.x)<90&&player.ab.m)fireDown=true;\n if(!player.ab.d&&Math.abs(wallA.x-player.x)<70&&player.onGround)jumpEdge=true;\n if(player.ab.d&&!player.ab.da&&Math.abs(wallA.x-player.x)<80&&player.onGround)jumpEdge=true;\n if(player.ab.da&&Math.abs(gap.x1-player.x)<60&&player.dashCD<=0)dashEdge=true;\n if(!inGap(player.x+30)&&Math.random()<0.02&&player.onGround)jumpEdge=true;\n}\n\nfunction draw(){\n ctx.fillStyle='#111';ctx.fillRect(0,0,W,H);\n ctx.save();ctx.translate(-camX,0);\n var zoneColors=['#223','#2a2a1a','#1a2a2a','#2a1a2a','#301a1a'];\n for(var i=0;i<5;i++){ctx.fillStyle=zoneColors[i];ctx.fillRect(i*worldW/5,0,worldW/5,H);}\n ctx.fillStyle='#484';ctx.fillRect(0,groundY,gap.x1,50);\n ctx.fillStyle='#484';ctx.fillRect(gap.x2,groundY,worldW-gap.x2,50);\n ctx.fillStyle='#654';ctx.fillRect(wallA.x,wallA.y,wallA.w,wallA.h);\n if(!door.broken){ctx.fillStyle='#a84';ctx.fillRect(door.x,door.y,door.w,door.h);}\n pickups.forEach(function(p){if(!p.got){ctx.font='24px sans-serif';ctx.fillText(p.id=='dj'?'⬆️':p.id=='da'?'💨':'🚀',p.x,p.y+22);}});\n enemies.forEach(function(e){if(e.alive){ctx.fillStyle='#e33';ctx.fillRect(e.x,e.y,e.w,e.h);}});\n if(core.alive){ctx.fillStyle='#f55';ctx.fillRect(core.x,core.y,core.w,core.h);ctx.fillStyle='#fff';ctx.font='16px sans-serif';ctx.fillText('CORE '+core.hp,core.x-5,core.y-8);}\n bullets.forEach(function(b){ctx.fillStyle='#0ff';ctx.fillRect(b.x,b.y,8,8);});\n if(playerSkin){ctx.drawImage(playerSkin,player.x-6,player.y-8,player.w+12,player.h+12);}\n else{ctx.fillStyle=player.inv>0?'#fff':'#4af';ctx.fillRect(player.x,player.y,player.w,player.h);}\n ctx.restore();\n\n ctx.fillStyle='#fff';ctx.font='14px sans-serif';\n ctx.fillText('HP: '+player.hp+'/'+player.maxHp+'  점수: '+score,10,20);\n ctx.fillText('능력: '+(player.ab.d?'⬆️':'')+(player.ab.da?'💨':'')+(player.ab.m?'🚀':''),10,38);\n var mw=200,mx=W-mw-10;\n for(var i=0;i<5;i++){ctx.fillStyle=visited[i]?'#6c6':'#444';ctx.fillRect(mx+i*(mw/5),10,mw/5-3,14);}\n var pz=Math.floor(player.x/(worldW/5));\n ctx.strokeStyle='#ff0';ctx.strokeRect(mx+pz*(mw/5),10,mw/5-3,14);\n if(botOn){ctx.fillStyle='#ff0';ctx.fillText('AI PLAYING',W/2-40,20);}\n}\n\nfunction loop(){update();draw();requestAnimationFrame(loop);}\nloop();\n\nfunction showEnd(cleared){\n var d=document.getElementById('end');\n d.setAttribute('data-vibrex-role',cleared?'clear':'over');\n d.innerHTML='<h1>'+(cleared?'클리어!':'게임 오버')+'</h1><p>점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button>';\n d.style.display='flex';\n document.getElementById('rb').onclick=function(){startGame();};\n}\nfunction startGame(){\n reset();phase='playing';document.getElementById('title').style.display='none';document.getElementById('end').style.display='none';\n if(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\n\nwindow.addEventListener('keydown',function(e){\n if(e.code=='ArrowLeft'||e.code=='KeyA')leftDown=true;\n if(e.code=='ArrowRight'||e.code=='KeyD')rightDown=true;\n if((e.code=='ArrowUp'||e.code=='Space'||e.code=='KeyW')&&!e.repeat)jumpEdge=true;\n if((e.code=='ArrowDown'||e.code=='KeyS')&&!e.repeat)dashEdge=true;\n if(e.code=='KeyX')fireDown=true;\n});\nwindow.addEventListener('keyup',function(e){\n if(e.code=='ArrowLeft'||e.code=='KeyA')leftDown=false;\n if(e.code=='ArrowRight'||e.code=='KeyD')rightDown=false;\n if(e.code=='KeyX')fireDown=false;\n});\n\nwindow.VIBREX_GAME={\n title:'코어 파괴자',genre:'metroidvania',\n goal:'능력을 모아 최종 구역의 코어를 파괴하라',\n clearCondition:'코어 체력을 0으로 만들면 클리어',\n controls:[{input:'left',action:'왼쪽 이동'},{input:'right',action:'오른쪽 이동'},{input:'jump',action:'점프(능력후 2단)'},{input:'guard',action:'대시'},{input:'fire',action:'공격/미사일'}],\n phase:function(){return phase;},\n progress:function(){var ab=(player.ab.d?1:0)+(player.ab.da?1:0)+(player.ab.m?1:0);var zi=Math.floor(player.x/(worldW/5));return Math.min(1,(ab+zi)/8);},\n state:function(){\n  var t=target();var tdx=(t.x-player.x)/400,tdy=(t.y-player.y)/400,tdist=Math.min(1,Math.hypot(t.x-player.x,t.y-player.y)/2000);\n  var e=nearestEnemy();var ddx=0,ddy=0,ddist=1;\n  if(e){ddx=Math.max(-1,Math.min(1,(e.x-player.x)/300));ddy=Math.max(-1,Math.min(1,(e.y-player.y)/300));ddist=Math.min(1,Math.hypot(e.x-player.x,e.y-player.y)/1000);}\n  var gd=player.onGround?0:Math.min(1,(groundY-(player.y+player.h))/300);\n  return{\n   selfX:player.x/worldW,selfY:player.y/H,selfVX:Math.max(-1,Math.min(1,player.vx/12)),selfVY:Math.max(-1,Math.min(1,player.vy/15)),\n   onGround:player.onGround?1:0,groundDist:gd,\n   targetDX:Math.max(-1,Math.min(1,tdx)),targetDY:Math.max(-1,Math.min(1,tdy)),targetDist:tdist,\n   dangerDX:ddx,dangerDY:ddy,dangerDist:ddist,\n   abilities:(player.ab.d?1:0)+(player.ab.da?1:0)+(player.ab.m?1:0),\n   h