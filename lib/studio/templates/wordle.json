    else if(st==='y' && cur2!=='g') letterState[L]='y';\n    else if(st==='b' && !cur2) letterState[L]='b';\n  }\n  let sc=greensCount()*20+attempt*0;\n  if(window.AJ) AJ.score(sc);\n  if(g===ANSWER.toLowerCase()){\n    phase='cleared';\n    let finalScore=(7-attempt)*100;\n    if(window.AJ) AJ.clear(finalScore);\n    showClear(finalScore);\n    return;\n  }\n  attempt++;\n  if(attempt>=maxAttempt){\n    phase='over';\n    if(window.AJ) AJ.over(greensCount()*20);\n    showOver();\n    return;\n  }\n  grid.push([\"\",\"\",\"\",\"\",\"\"]);\n  cur={r:0,c:0};\n}\nfunction greensCount(){\n  if(feedbacks.length===0)return 0;\n  let last=feedbacks[feedbacks.length-1];\n  return last?[...last].filter(x=>x==='g').length:0;\n}\nfunction yellowsCount(){\n  if(feedbacks.length===0)return 0;\n  let last=feedbacks[feedbacks.length-1];\n  return last?[...last].filter(x=>x==='y').length:0;\n}\nfunction inputLetter(){\n  if(phase!=='playing')return;\n  let L=KB[cur.r][cur.c];\n  let slot=grid[attempt].findIndex(x=>x==='');\n  if(slot>=0){grid[attempt][slot]=L;}\n}\nfunction deleteLetter(){\n  if(phase!=='playing')return;\n  for(let i=4;i>=0;i--){\n    if(grid[attempt][i]!==''){grid[attempt][i]='';break;}\n  }\n}\nfunction moveCursor(dr,dc){\n  cur.r=Math.max(0,Math.min(2,cur.r+dr));\n  cur.c=Math.max(0,Math.min(KB[cur.r].length-1,cur.c+dc));\n}\nconst canvas=document.getElementById('c');\nconst ctx=canvas.getContext('2d');\nfunction resize(){\n  let w=window.innerWidth,h=window.innerHeight;\n  canvas.width=w;canvas.height=h;\n}\nwindow.addEventListener('resize',resize);resize();\n\nfunction draw(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,canvas.width,canvas.height);\n  let W=canvas.width,H=canvas.height;\n  let cell=Math.min(W/8,H/16);\n  let gx=W/2-cell*2.5,gy=cell*0.8;\n  for(let r=0;r<maxAttempt;r++){\n    for(let c=0;c<5;c++){\n      let x=gx+c*cell,y=gy+r*cell;\n      let letter=grid[r]?grid[r][c]:'';\n      let col='#333';\n      if(feedbacks[r]){\n        let st=feedbacks[r][c];\n        col=st==='g'?'#4caf50':st==='y'?'#c9b458':'#3a3a3c';\n      }\n      ctx.fillStyle=col;\n      ctx.fillRect(x+2,y+2,cell-4,cell-4);\n      ctx.strokeStyle='#555';ctx.strokeRect(x+2,y+2,cell-4,cell-4);\n      if(letter){\n        ctx.fillStyle='#fff';ctx.font=(cell*0.5)+'px sans-serif';\n        ctx.textAlign='center';ctx.textBaseline='middle';\n        ctx.fillText(letter,x+cell/2,y+cell/2+2);\n      }\n    }\n  }\n  let kbY=gy+maxAttempt*cell+cell*0.5;\n  let kw=Math.min(W/12,cell*0.8);\n  for(let r=0;r<KB.length;r++){\n    let rowW=KB[r].length*kw;\n    let startX=W/2-rowW/2;\n    for(let c=0;c<KB[r].length;c++){\n      let L=KB[r][c];\n      let x=startX+c*kw,y=kbY+r*kw*1.1;\n      let st=letterState[L];\n      let col=st==='g'?'#4caf50':st==='y'?'#c9b458':st==='b'?'#3a3a3c':'#555';\n      ctx.fillStyle=col;\n      ctx.fillRect(x+1,y+1,kw-2,kw-2);\n      if(cur.r===r&&cur.c===c){\n        ctx.strokeStyle='#fff';ctx.lineWidth=3;ctx.strokeRect(x+1,y+1,kw-2,kw-2);ctx.lineWidth=1;\n      }\n      ctx.fillStyle='#fff';ctx.font=(kw*0.45)+'px sans-serif';\n      ctx.textAlign='center';ctx.textBaseline='middle';\n      ctx.fillText(L,x+kw/2,y+kw/2+1);\n    }\n  }\n  ctx.fillStyle='#0f0';ctx.font='14px sans-serif';ctx.textAlign='left';\n  ctx.fillText('시도 '+(attempt+1)+'/'+maxAttempt,10,20);\n  if(playerSkin){\n    try{ctx.drawImage(playerSkin,W-50,10,40,40);}catch(e){}\n  } else {\n    ctx.font='28px sans-serif';ctx.fillText('🙂',W-46,36);\n  }\n  if(botRunning){\n    ctx.fillStyle='#ff0';ctx.font='16px sans-serif';ctx.textAlign='center';\n    ctx.fillText('AI PLAYING',W/2,16);\n  }\n}\nfunction loop(){\n  if(phase==='playing') draw();\n  requestAnimationFrame(loop);\n}\nloop();\n\nfunction showTitle(){\n  phase='title';\n  document.getElementById('ui').innerHTML=`\n  <div>\n  <h1>단어 맞추기</h1>\n  <p>5글자 영단어를 6번 안에 맞혀보세요</p>\n  <p style=\"text-align:left;display:inline-block\">\n  ← → : 키보드 알파벳 좌우 이동<br>\n  ↑ ↓ : 키보드 행 이동<br>\n  X(fire) : 글자 입력<br>\n  Z(guard) : 글자 삭제<br>\n  Space(jump) : 제출\n  </p><br>\n  <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n  </div>`;\n  document.getElementById('ui').style.display='flex';\n}\nfunction showOver(){\n  document.getElementById('ui').innerHTML=`\n  <div>\n  <h1>실패</h1>\n  <p>정답: ${ANSWER.toUpperCase()}</p>\n  <button data-vibrex-role=\"restart\" id=\"restartBtn\">다시하기</button>\n  </div>`;\n  document.getElementById('ui').style.display='flex';\n  document.getElementById('restartBtn').onclick=restart;\n}\nfunction showClear(score){\n  document.getElementById('ui').setAttribute('data-vibrex-role','clear');\n  document.getElementById('ui').innerHTML=`\n  <div>\n  <h1>정답입니다! 🎉</h1>\n  <p>최종 점수: ${score}</p>\n  <button data-vibrex-role=\"restart\" id=\"restartBtn2\">다시하기</button>\n  </div>`;\n  document.getElementById('ui').style.display='flex';\n  document.getElementById('restartBtn2').onclick=restart;\n}\nfunction startGame(){\n  phase='playing';\n  document.getElementById('ui').style.display='none';\n  document.getElementById('ui').removeAttribute('data-vibrex-role');\n  if(window.AJ) AJ.start();\n}\nfunction restart(){\n  ANSWER=WORDS[Math.floor(Math.random()*WORDS.length)];\n  attempt=0;grid=[[\"\",\"\",\"\",\"\",\"\"]];feedbacks=[];letterState={};cur={r:0,c:0};\n  if(window.AJ) AJ.restart();\n  startGame();\n}\n\n// keyboard\nlet keys={};\nwindow.addEventListener('keydown',e=>{\n  if(keys[e.code])return;\n  keys[e.code]=true;\n  if(e.code==='ArrowLeft'){moveCursor(0,-1);}\n  else if(e.code==='ArrowRight'){moveCursor(0,1);}\n  else if(e.code==='ArrowUp'){moveCursor(-1,0);}\n  else if(e.code==='ArrowDown'){moveCursor(1,0);}\n  else if(e.code==='KeyX'){inputLetter();}\n  else if(e.code==='KeyZ'){deleteLetter();}\n  else if(e.code==='Space'){submit();}\n});\nwindow.addEventListener('keyup',e=>{keys[e.code]=false;});\n\nwindow.VIBREX_GAME={\n  title:'단어 맞추기',\n  genre:'퍼즐',\n  goal:'6번 안에 5글자 단어 맞히기',\n  clearCondition:'정답 단어를 맞히면 클리어',\n  controls:[\n    {input:'ArrowLeft/Right',action:'키보드 알파벳 좌우 이동'},\n    {input:'ArrowUp/Down',action:'키보드 행 이동'},\n    {input:'fire',action:'글자 입력'},\n    {input:'guard',action:'글자 삭제'},\n    {input:'jump',action:'제출'}\n  ],\n  phase:()=>phase==='title'?'title':phase==='playing'?'playing':phase==='cleared'?'cleared':phase==='over'?'over':'title',\n  progress:()=>greensCount()/5,\n  state:()=>{\n    let cands=phase==='playing'||phase==='over'||phase==='cleared'?computeCandidates():WORDS;\n    return {\n      attempt:attempt,\n      greens:greensCount(),\n      yellows:yellowsCount(),\n      progress:greensCount()/5,\n      score:greensCount()*20,\n      candidatesLeft:cands.length,\n      cursorLetter:KB[cur.r][cur.c]\n    };\n  },\n  start:()=>{startGame();},\n  restart:()=>{restart();},\n  inputs:{\n    left:(on)=>{if(on)moveCursor(0,-1);},\n    right:(on)=>{if(on)moveCursor(0,1);},\n    up:(on)=>{if(on)moveCursor(-1,0);},\n    down:(on)=>{if(on)moveCursor(1,0);},\n    jump:(on)=>{if(on)submit();},\n    fire:(on)=>{if(on)inputLetter();},\n    guard:(on)=>{if(on)deleteLetter();}\n  }\n};\n\n// bot\nlet botRunning=false,botTimer=null;\nfunction letterFreqScore(word,cands){\n  let seen=new Set();\n  let sc=0;\n  for(let i=0;i<5;i++){\n    let L=word[i];\n    if(seen.has(L))continue;\n    seen.add(L);\n    let cnt=0;\n    for(let w of cands) if(w.includes(L)) cnt++;\n    sc+=cnt;\n  }\n  return sc;\n}\nfunction botPickWord(cands){\n  if(cands.length<=2) return cands[0];\n  let best=cands[0],bestScore=-1;\n  let pool=WORDS.length>300?cands:WORDS;\n  for(let w of pool){\n    let s=letterFreqScore(w,cands);\n    if(s>bestScore){bestScore=s;best=w;}\n  }\n  return best;\n}\nfunction botStep(){\n  if(!botRunning)return;\n  if(phase==='title'){\n    document.getElementById('vibrex-start')?.click();\n    startGame();\n    return;\n  }\n  if(phase==='cleared'||phase==='over'){\n    return;\n  }\n  if(phase!=='playing')return;\n  let cands=computeCandidates();\n  let word=botPickWord(cands).toUpperCase();\n  grid[attempt]=word.split('');\n  submit();\n}\nwindow.vibrexBot={\n  start(){\n    botRunning=true;\n    botTimer=setInterval(botStep,600);\n    if(phase==='title'){document.getElementById('vibrex-start')?.click();startGame();}\n  },\n  stop(){\n    botRunning=false;\n    if(botTimer)clearInterval(botTimer);\n  },\n  setSkill(){}\n};\n\ndocument.getElementById('ui').addEventListener('click',e=>{\n  if(e.target && e.target.id==='vibrex-start'){startGame();}\n});\nshowTitle();\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"fire\"]};function I(){var G=window.VIBREX_GAME;return G&&G.inputs?G.inputs:null}function ch(code){var i=I();if(!i)return null;var T=window.VIBREX_CONTROLS||[{\"id\":\"left\",\"label\":\"왼쪽\",\"desc\":\"좌 이동·조향\",\"pc\":[\"ArrowLeft\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"right\",\"label\":\"오른쪽\",\"desc\":\"우 이동·조향\",\"pc\":[\"ArrowRight\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"up\",\"label\":\"위\",\"desc\":\"상 이동·가속·회전\",\"pc\":[\"ArrowUp\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"down\",\"label\":\"아래 (앉기)\",\"desc\":\"하 이동·앉기·슬라이드·빠른 낙하\",\"pc\":[\"ArrowDown\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"jump\",\"label\":\"점프\",\"desc\":\"도약·확정 (점프가 없는 게임은 스페이스가 발사)\",\"pc\":[\"Space\"],\"mobile\":\"button\",\"btnLabel\":\"JUMP\",\"size\":\"lg\",\"group\":\"main\",\"enabled\":true},{\"id\":\"fire\",\"label\":\"발사·공격\",\"desc\":\"발사·타격·상호작용\",\"pc\":[\"KeyA\"],\"mobile\":\"button\",\"btnLabel\":\"A\",\"size\":\"md\",\"group\":\"main\",\"enabled\":true},{\"id\":\"guard\",\"label\":\"방어·특수\",\"desc\":\"방어·제동·대시 등 특수 동작\",\"pc\":[\"KeyS\"],\"mobile\":\"button\",\"btnLabel\":\"S\",\"size\":\"md\",\"group\":\"main\",\"enabled\":true},{\"id\":\"useItem\",\"label\":\"아이템 사용\",\"desc\":\"현재 선택된 퀵슬롯 아이템 사용\",\"pc\":[\"KeyD\"],\"mobile\":\"button\",\"btnLabel\":\"D\",\"size\":\"md\",\"group\":\"main\",\"enabled\":true},{\"id\":\"item1\",\"label\":\"슬롯 1\",\"desc\":\"퀵슬롯 1 선택\",\"pc\":[\"Digit1\"],\"mobile\":\"button\",\"btnLabel\":\"1\",\"size\":\"sm\",\"group\":\"item\",\"enabled\":true},{\"id\":\"item2\",\"label\":\"슬롯 2\",\"desc\":\"퀵슬롯 2 선택\",\"pc\":[\"Digit2\"],\"mobile\":\"button\",\"btnLabel\":\"2\",\"size\":\"sm\",\"group\":\"item\",\"enabled\":true},{\"id\":\"item3\",\"label\":\"슬롯 3\",\"desc\":\"퀵슬롯 3 선택\",\"pc\":[\"Digit3\"],\"mobile\":\"button\",\"btnLabel\":\"3\",\"size\":\"sm\",\"group\":\"item\",\"enabled\":true},{\"id\":\"item4\",\"label\":\"슬롯 4\",\"desc\":\"퀵슬롯 4 선택\",\"pc\":[\"Digit4\"],\"mobile\":\"button\",\"btnLabel\":\"4\",\"size\":\"sm\",\"group\":\"item\",\"enabled\":true},{\"id\":\"action\",\"label\":\"(구) 액션\",\"desc\":\"옛 게임의 주 행동 ≈ jump/fire\",\"pc\":[\"Space\"],\"mobile\":\"button\",\"btnLabel\":\"A\",\"size\":\"lg\",\"group\":\"legacy\",\"enabled\":true},{\"id\":\"action2\",\"label\":\"(구) 액션2\",\"desc\":\"옛 게임의 보조 행동 ≈ useItem\",\"pc\":[\"KeyX\"],\"mobile\":\"button\",\"btnLabel\":\"B\",\"size\":\"md\",\"group\":\"legacy\",\"enabled\":true},{\"id\":\"crouch\",\"label\":\"(구) 앉기\",\"desc\":\"옛 게임의 앉기 ≈ down/guard\",\"pc\":[\"ArrowDown\"],\"mobile\":\"none\",\"group\":\"legacy\",\"enabled\":true}];var has=function(n){return typeof i[n]==='function'};for(var k=0;k<T.length;k++){var c=T[k];if(!c.enabled||c.pc.indexOf(code)<0)continue;if(has(c.id))return c.id;var fb=FB[c.id]||[];for(var j=0;j<fb.length;j++)if(has(fb[j]))return fb[j]}return null}function on(e,down){if(e.__vbx)return;var n=ch(e.code);if(!n)return;if(down&&held[n])return;held[n]=down;try{I()[n](down)}catch(x){}}window.addEventListener('keydown',function(e){on(e,true)},true);window.addEventListener('keyup',function(e){on(e,false)},true);window.addEventListener('blur',function(){var i=I();if(!i)return;Object.keys(held)