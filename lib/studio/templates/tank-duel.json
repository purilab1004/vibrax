brexBot&&typeof window.vibrexBot.stop==='function'){try{window.vibrexBot.stop()}catch(e1){}}fallbackStop()}});})();</script><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>언덕 포격전</title>\n<style>\nhtml,body{margin:0;padding:0;background:#000;overflow:hidden;height:100%;touch-action:none}\n#wrap{display:flex;align-items:center;justify-content:center;width:100%;height:100%}\ncanvas{background:#111;display:block}\n.ov{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;font-family:sans-serif;background:rgba(0,0,0,.75);text-align:center;padding:20px;box-sizing:border-box}\n.ov h1{font-size:clamp(22px,5vw,36px);margin:0 0 10px}\n.ov p{font-size:clamp(13px,2.5vw,16px);margin:4px 0}\n.ov button{margin-top:16px;padding:12px 28px;font-size:16px;border:none;border-radius:8px;background:#e6543a;color:#fff;font-weight:bold}\n.hid{display:none!important}\n</style></head>\n<body>\n<div id=\"wrap\"><canvas id=\"c\" width=\"800\" height=\"450\"></canvas></div>\n<div id=\"title\" class=\"ov\">\n<h1>언덕 포격전</h1>\n<p>파괴되는 언덕 지형 위에서 벌이는 턴제 탱크 대전. 3판 2선승!</p>\n<p>이동: ←→ (연료제한) | 각도: ↑↓ | 파워충전: X(길게) | 발사: Space</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div id=\"over\" class=\"ov hid\">\n<h1>패배</h1>\n<p id=\"overScore\"></p>\n<button data-vibrex-role=\"restart\" id=\"btnOver\">다시하기</button>\n</div>\n<div id=\"clear\" class=\"ov hid\" data-vibrex-role=\"clear\">\n<h1>승리! 🏆</h1>\n<p id=\"clearScore\"></p>\n<button data-vibrex-role=\"restart\" id=\"btnClear\">다시하기</button>\n</div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nconst W=800,H=450,cols=160,colW=W/cols;\nfunction clamp(a,b,v){return Math.max(a,Math.min(b,v));}\nlet terrain=[];\nfunction genTerrain(){\n  terrain=[];let h=H*0.55;\n  for(let i=0;i<cols;i++){h+=(Math.random()-0.5)*16;h=clamp(H*0.35,H*0.75,h);terrain.push(h);}\n  for(let k=0;k<2;k++){let t=terrain.slice();for(let i=1;i<cols-1;i++)terrain[i]=(t[i-1]+t[i]+t[i+1])/3;}\n}\ngenTerrain();\nfunction tankY(x){let idx=clamp(0,cols-1,Math.floor(x/colW));return terrain[idx];}\nlet player={x:70,hp:100,fuel:100,angle:55,power:55,lastErr:0};\nlet enemy={x:W-70,hp:100,angle:125,power:55,lastErr:0};\nlet wins={p:0,e:0};\nlet wind=0;\nlet turn='player';\nlet phase='title';\nlet proj=null;\nlet shooterWas='player';\nlet enemyTimer=0;\nlet playerLastErr=0;\nlet keys={left:false,right:false,up:false,down:false,guard:false};\nlet botActive=false,botTarget=null;\n\nfunction resetRound(){\n  genTerrain();\n  player.hp=100;enemy.hp=100;\n  player.x=70;enemy.x=W-70;\n  player.fuel=100;\n  wind=(Math.random()*2-1);\n  turn='player';proj=null;enemyTimer=0;\n}\nfunction startProjectile(sh,facing){\n  let rad=sh.angle*Math.PI/180;\n  let spd=sh.power*4+60;\n  proj={x:sh.x,y:tankY(sh.x)-12,vx:Math.cos(rad)*spd*facing,vy:-Math.sin(rad)*spd,owner:sh};\n}\nfunction craterTerrain(cx,r){\n  let depth=32;\n  for(let i=0;i<cols;i++){\n    let cxi=i*colW+colW/2;let d=Math.abs(cxi-cx);\n    if(d<r){terrain[i]=clamp(terrain[i],H-10,terrain[i]+depth*(1-d/r));}\n  }\n}\nfunction dmgTank(t,x,y){\n  let d=Math.hypot(t.x-x,(tankY(t.x)-12)-y);\n  if(d<48){let dmg=Math.max(0,42*(1-d/48));t.hp=clamp(0,100,t.hp-dmg);}\n}\nfunction explode(x,y){\n  craterTerrain(x,42);\n  dmgTank(player,x,y);dmgTank(enemy,x,y);\n  let owner=proj.owner;\n  let target=owner===player?enemy.x:player.x;\n  let err=clamp(-1,1,(x-target)/300);\n  owner.lastErr=err;\n  if(owner===player)playerLastErr=err;\n  proj=null;\n  if(window.AJ)AJ.score(wins.p*100+Math.round(player.hp));\n  if(enemy.hp<=0||player.hp<=0)roundEnd();\n  else{turn=shooterWas==='player'?'enemy':'player';if(turn==='player')player.fuel=100;if(turn==='enemy')enemyTimer=0.9;}\n}\nfunction roundEnd(){\n  if(enemy.hp<=0)wins.p++;else if(player.hp<=0)wins.e++;\n  if(wins.p>=2){phase='cleared';document.getElementById('clearScore').textContent='최종 점수 '+(wins.p*100+Math.round(player.hp));document.getElementById('clear').classList.remove('hid');if(window.AJ)AJ.clear(wins.p*100+Math.round(player.hp));}\n  else if(wins.e>=2){phase='over';document.getElementById('overScore').textContent='최종 점수 '+(wins.p*100+Math.round(player.hp));document.getElementById('over').classList.remove('hid');if(window.AJ)AJ.over(wins.p*100+Math.round(player.hp));}\n  else resetRound();\n}\nfunction doFire(){\n  if(phase!=='playing'||turn!=='player'||proj)return;\n  shooterWas='player';startProjectile(player,1);turn='anim';\n}\nfunction enemyFire(){\n  let dx=player.x-enemy.x;\n  let basePower=clamp(25,100,Math.abs(dx)*0.22+30);\n  let baseAngle=45;\n  let corr=enemy.lastErr;\n  if(Math.abs(corr)>0.02)basePower=clamp(15,100,basePower-corr*18);\n  basePower+=(Math.random()*8-4);\n  baseAngle+=(Math.random()*8-4);\n  enemy.power=clamp(10,100,basePower);enemy.angle=clamp(10,170,baseAngle);\n  shooterWas='enemy';startProjectile(enemy,-1);turn='anim';\n}\nlet last=performance.now();\nfunction update(dt){\n  if(phase!=='playing')return;\n  if(turn==='player'&&!proj){\n    if(keys.left){player.x=clamp(15,W-15,player.x-110*dt);player.fuel=clamp(0,100,player.fuel-40*dt);}\n    if(keys.right){player.x=clamp(15,W-15,player.x+110*dt);player.fuel=clamp(0,100,player.fuel-40*dt);}\n    if(keys.up)player.angle=clamp(10,170,player.angle+70*dt);\n    if(keys.down)player.angle=clamp(10,170,player.angle-70*dt);\n    if(keys.guard)player.power=clamp(10,100,player.power+70*dt);\n  }\n  if(turn==='enemy'){\n    enemyTimer-=dt;\n    if(enemyTimer<=0)enemyFire();\n  }\n  if(proj){\n    proj.vx+=wind*30*dt;proj.vy+=240*dt;\n    proj.x+=proj.vx*dt;proj.y+=proj.vy*dt;\n    if(proj.x<0||proj.x>W){explode(clamp(0,W,proj.x),proj.y);}\n    else if(proj.y>=tankY(proj.x)){explode(proj.x,proj.y);}\n    else if(Math.hypot(proj.x-player.x,proj.y-(tankY(player.x)-12))<14){explode(proj.x,proj.y);}\n    else if(Math.hypot(proj.x-enemy.x,proj.y-(tankY(enemy.x)-12))<14){explode(proj.x,proj.y);}\n  }\n  if(botActive)runBot(dt);\n}\nfunction drawTank(t,facing,color){\n  let y=tankY(t.x);\n  ctx.fillStyle=color;\n  ctx.fillRect(t.x-14,y-12,28,14);\n  let rad=t.angle*Math.PI/180;\n  let tx=t.x+Math.cos(rad)*22*facing,ty=y-12-Math.sin(rad)*22;\n  ctx.strokeStyle=color;ctx.lineWidth=4;\n  ctx.beginPath();ctx.moveTo(t.x,y-12);ctx.lineTo(tx,ty);ctx.stroke();\n}\nfunction draw(){\n  ctx.clearRect(0,0,W,H);\n  ctx.fillStyle='#1a2a3a';ctx.fillRect(0,0,W,H);\n  ctx.fillStyle='#3a8a4a';\n  ctx.beginPath();ctx.moveTo(0,H);\n  for(let i=0;i<cols;i++)ctx.lineTo(i*colW,terrain[i]);\n  ctx.lineTo(W,H);ctx.closePath();ctx.fill();\n  drawTank(player,1,'#4aa8ff');\n  drawTank(enemy,-1,'#ff5a4a');\n  if(proj){ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(proj.x,proj.y,4,0,7);ctx.fill();}\n  ctx.fillStyle='#fff';ctx.font='14px sans-serif';\n  ctx.fillText('HP '+Math.round(player.hp),10,20);\n  ctx.fillText('승 '+wins.p+'/2',10,38);\n  ctx.textAlign='right';\n  ctx.fillText('HP '+Math.round(enemy.hp),W-10,20);\n  ctx.fillText('승 '+wins.e+'/2',W-10,38);\n  ctx.textAlign='center';\n  ctx.fillText('바람 '+(wind>0?'▶':'◀')+Math.abs(wind).toFixed(1),W/2,20);\n  ctx.fillText('각도 '+Math.round(player.angle)+' 파워 '+Math.round(player.power)+' 연료 '+Math.round(player.fuel),W/2,H-10);\n  ctx.fillText(turn==='player'?'내 턴':(turn==='enemy'?'적 턴':'발사중'),W/2,38);\n  if(botActive){ctx.fillStyle='#ff0';ctx.fillText('AI PLAYING',W/2,60);}\n  ctx.textAlign='left';\n}\nfunction loop(t){\n  let dt=Math.min(0.05,(t-last)/1000);last=t;\n  update(dt);draw();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\ndocument.addEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')keys.left=true;\n  if(e.code==='ArrowRight')keys.right=true;\n  if(e.code==='ArrowUp')keys.up=true;\n  if(e.code==='ArrowDown')keys.down=true;\n  if(e.code==='KeyX')keys.guard=true;\n  if(e.code==='Space'){doFire();e.preventDefault();}\n});\ndocument.addEventListener('keyup',e=>{\n  if(e.code==='ArrowLeft')keys.left=false;\n  if(e.code==='ArrowRight')keys.right=false;\n  if(e.code==='ArrowUp')keys.up=false;\n  if(e.code==='ArrowDown')keys.down=false;\n  if(e.code==='KeyX')keys.guard=false;\n});\n\nfunction startGame(){\n  phase='playing';wins.p=0;wins.e=0;resetRound();\n  document.getElementById('title').classList.add('hid');\n  document.getElementById('over').classList.add('hid');\n  document.getElementById('clear').classList.add('hid');\n  if(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\ndocument.getElementById('btnOver').onclick=startGame;\ndocument.getElementById('btnClear').onclick=startGame;\n\nwindow.VIBREX_GAME={\n  title:'언덕 포격전',genre:'포격 대전',goal:'적 탱크의 HP를 0으로 만들어 3판 2선승',\n  clearCondition:'2라운드 먼저 승리',\n  controls:[{input:'ArrowLeft',action:'왼쪽 이동'},{input:'ArrowRight',action:'오른쪽 이동'},{input:'ArrowUp',action:'각도 올리기'},{input:'ArrowDown',action:'각도 내리기'},{input:'KeyX',action:'파워 충전(guard)'},{input:'Space',action:'발사(fire)'}],\n  phase:()=>phase,\n  progress:()=>wins.p/2,\n  state:()=>({\n    selfX:(player.x||0)/W,\n    targetDX:clamp(-1,1,((enemy.x-player.x)||0)/400),\n    targetDist:clamp(0,1,Math.abs((enemy.x-player.x)||0)/W),\n    dangerDX:proj?clamp(-1,1,(proj.x-player.x)/400):0,\n    dangerDY:proj?clamp(-1,1,(proj.y-(tankY(player.x)-12))/400):0,\n    dangerDist:proj?clamp(0,1,Math.hypot(proj.x-player.x,proj.y-(tankY(player.x)-12))/W):1,\n    angle:((player.angle||10)-10)/160,\n    power:((player.power||10)-10)/90,\n    wind:clamp(-1,1,wind||0),\n    health:(player.hp||0)/100,\n    enemyHp:(enemy.hp||0)/100,\n    turn:turn==='player'?1:0,\n    progress:wins.p/2,\n    score:wins.p*100+Math.round(player.hp||0),\n    lastShotError:playerLastErr||0,\n    lives:Math.max(1,Math.ceil((player.hp||0)/34)),\n    fireReady:(!proj&&turn==='player')?1:0\n  }),\n  start:startGame,restart:startGame,\n  inputs:{\n    left:on=>keys.left=on,right:on=>keys.right=on,\n    up:on=>keys.up=on,down:on=>keys.down=on,\n    guard:on=>keys.guard=on,\n    fire:on=>{if(on)doFire();},\n    jump:on=>{if(on)doFire();},\n    action:on=>{if(on)doFire();},\n    action2:on=>keys.guard=on,\n    useItem:()=>{}\n  }\n};\nfunction runBot(dt){\n  if(phase==='title'){document.getElementById('vibrex-start').click();return;}\n  if(phase==='over'||phase==='cleared'){document.getElementById(phase==='over'?'btnOver':'btnClear').click();return;}\n  if(phase!=='playing'||turn!=='player'||proj){return;}\n  if(!botTarget){\n    let dx=enemy.x-player.x;\n    let bp=clamp(25,100,Math.abs(dx)*0.22+30);\n    let ba=45;\n    if(Math.abs(playerLastErr)>0.02)bp=clamp(15,100,bp-playerLastErr*18);\n    botTarget={angle:clamp(10,170,ba),power:clamp(10,100,bp)};\n  }\n  keys.up=false;keys.down=false;keys.guard=false;keys.left=false;keys.right=false;\n  if(player.angle<botTarget.angle-2)keys.up=true;\n  else if(player.angle>botTarget.angle+2)keys.down=true;\n  if(player.power<botTarget.power-2)keys.guard=true;\n  if(Math.abs(player.angle-botTarget.angle)<=2&&Math.abs(player.power-botTarget.power)<=2){\n    doFire();botTarget=null;\n  }\n}\nwindow.vibrexBot={\n  start:()=>{botActive=true;},\n  stop:()=>{botActive=false;keys.left=false;keys.right=false;keys.up=false;keys.down=false;keys.guard=false;},\n  setSkill:()=>{}\n};\nif(window.VIBREX_AVATAR){}\nwindow.addEventListener('vibrex:avatar',e=>{window.vibrexAvatarAck&&window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{});\n\nfunction resize(){\n  let scale=Math.min(innerWidth/W,innerHeight/H);\n  cv.style.width=(W*scale)+'px';cv.style.height=(H*scale)+'px';\n}\nwindow.addEventListener('resize',resize);resize();\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"fire\"]};function I(){var G=window.VIBREX_GAME;return G&&G.inputs?G.inputs:null}function ch(code){var 