aying';\n  if(window.AJ)AJ.start();\n}\nfunction angNorm(a){a=a%(Math.PI*2);if(a<0)a+=Math.PI*2;return a}\nfunction inRed(floorAngle,redLen,ballAngle){\n  let start=angNorm(floorAngle+GAP);\n  let d=angNorm(ballAngle-start);\n  return d<redLen;\n}\nfunction nearestGapDX(){\n  let f=floors[floorIdx];if(!f)return{dx:0,dist:1};\n  let ballAngle=angNorm(-rot);\n  let gapCenter=angNorm(f.gapA+GAP+f.redLen/2);\n  let diff=angNorm(gapCenter-ballAngle);\n  if(diff>Math.PI)diff-=Math.PI*2;\n  return{dx:Math.max(-1,Math.min(1,diff/Math.PI)),dist:Math.abs(diff)/Math.PI};\n}\nfunction update(dt){\n  if(phase!=='playing')return;\n  let rspeed=2.4;\n  if(left)rot-=rspeed*dt;\n  if(right)rot+=rspeed*dt;\n  vy+=900*dt;\n  if(vy>700)vy=700;\n  ballY+=vy*dt;\n  if(invuln>0)invuln-=dt;\n  while(floorIdx<floors.length && ballY> -floors[floorIdx].y-RING_H*0.5){\n    let f=floors[floorIdx];\n    if(!f.passed){\n      f.passed=true;\n      let ballAngle=angNorm(-rot);\n      let hit=inRed(f.gapA,f.redLen,ballAngle);\n      if(hit && invuln<=0){\n        phase='over';\n        if(window.AJ)AJ.over(score);\n        shake=20;\n      } else {\n        combo++;\n        let bonus=10+combo*2;\n        score+=bonus;\n        if(window.AJ)AJ.score(score);\n        if(combo>0 && combo%5===0)invuln=2.5;\n        floorIdx++;\n        if(window.AJ)AJ.level(floorIdx);\n        if(floorIdx>=FLOORS){\n          phase='cleared';\n          if(window.AJ)AJ.clear(score);\n        }\n      }\n    }\n  }\n  camY+=(ballY-camY-H()*0.35)*Math.min(1,dt*4);\n}\nfunction draw(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,W(),H());\n  ctx.save();\n  let sx=shake>0?(Math.random()-0.5)*shake:0;\n  let sy=shake>0?(Math.random()-0.5)*shake:0;\n  if(shake>0)shake-=1;\n  ctx.translate(W()/2+sx,H()/2-camY+sy);\n  for(let i=0;i<floors.length;i++){\n    let f=floors[i];\n    let y=f.y;\n    if(y<camY-H()*0.7||y>camY+H()*0.7)continue;\n    let segCount=48;\n    for(let s=0;s<segCount;s++){\n      let a0=s/segCount*Math.PI*2;\n      let a1=(s+1)/segCount*Math.PI*2;\n      let ang=angNorm(a0-rot);\n      let isGap=false,isRed=false;\n      let gs=angNorm(f.gapA),ge=angNorm(f.gapA+GAP);\n      let rs2=angNorm(f.gapA+GAP),re=angNorm(f.gapA+GAP+f.redLen);\n      function between(a,s,e){let d1=angNorm(a-s),d2=angNorm(e-s);return d1<=d2}\n      if(between(ang,gs,ge))isGap=true;\n      else if(between(ang,rs2,re))isRed=true;\n      if(isGap)continue;\n      ctx.beginPath();\n      ctx.arc(0,y,RAD,a0-rot,a1-rot);\n      ctx.arc(0,y+RING_H*0.3,RAD,a1-rot,a0-rot,true);\n      ctx.closePath();\n      ctx.fillStyle=isRed?'#e74c3c':'#3498db';\n      ctx.fill();\n    }\n  }\n  let bs=invuln>0?'#f1c40f':'#fff';\n  ctx.beginPath();\n  if(playerSkin){\n    let sz=44;\n    ctx.drawImage(playerSkin,-sz/2,ballY-sz/2,sz,sz);\n  } else {\n    ctx.arc(0,ballY,16,0,Math.PI*2);\n    ctx.fillStyle=bs;ctx.fill();\n  }\n  ctx.restore();\n  document.getElementById('ui').innerHTML=\n    '<div style=\"margin-top:8px;font-size:20px\">층 '+floorIdx+'/'+FLOORS+' 점수 '+score+' 콤보 '+combo+(invuln>0?' 무적':'')+'</div>';\n  if(window.vibrexBotOn)\n}\nfunction loop(t){\n  requestAnimationFrame(loop);\n  update(1/60);\n  draw();\n}\nrequestAnimationFrame(loop);\n\naddEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')left=true;\n  if(e.code==='ArrowRight')right=true;\n});\naddEventListener('keyup',e=>{\n  if(e.code==='ArrowLeft')left=false;\n  if(e.code==='ArrowRight')right=false;\n});\n\ndocument.getElementById('vibrex-start').onclick=()=>{\n  document.getElementById('scr').style.display='none';\n  initGame();\n};\n\nfunction showEnd(role,title){\n  let d=document.createElement('div');\n  d.id='endscr';d.setAttribute('data-vibrex-role',role);\n  d.style.cssText='position:fixed;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#fff;font-family:sans-serif;background:rgba(0,0,0,.85)';\n  d.innerHTML='<h1>'+title+'</h1><p>점수: '+score+'</p><button data-vibrex-ro