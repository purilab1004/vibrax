viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>아레나 서바이버</title>\n<style>\nhtml,body{margin:0;padding:0;background:#000;overflow:hidden;height:100%;touch-action:none;font-family:sans-serif}\ncanvas{display:block;background:#111}\n#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;text-align:center;z-index:5}\n#ui.hidden{display:none}\nbutton{padding:14px 28px;font-size:18px;border:none;border-radius:8px;background:#3af;color:#fff;cursor:pointer;margin-top:12px}\n#hud{position:fixed;top:8px;left:8px;color:#fff;font-size:14px;z-index:3;text-shadow:1px 1px 2px #000}\n#bot{position:fixed;top:8px;right:8px;color:#0f0;font-size:13px;z-index:3;display:none}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"hud\"></div>\n<div id=\"bot\"></div>\n<div id=\"ui\"><div id=\"uiInner\">\n<h1>아레나 서바이버</h1>\n<p>사방에서 몰려오는 적을 물리치고 5웨이브 보스를 처치하세요</p>\n<p style=\"font-size:13px;opacity:.8\">이동: 방향키/조이스틱 · 조준: 이동방향 자동 · 발사: 자동연사(A버튼/스페이스로 보조) · 스킬: X/B버튼</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div></div>\n<script>\nvar canvas=document.getElementById('c'),ctx=canvas.getContext('2d');\nvar W,H;\nfunction resize(){W=canvas.width=innerWidth;H=canvas.height=innerHeight;}\naddEventListener('resize',resize);resize();\n\nvar phase='title',score=0,wave=1,waveActive=false,waveTimer=0,botOn=false;\nvar maxHP=100;\nvar player={x:0,y:0,hp:maxHP,r:16,speed:220,vx:0,vy:0,facing:1};\nvar enemies=[],bullets=[],items=[];\nvar fireCd=0,fireRate=180,skillCd=0,skillMax=5000,skillRadius=180;\nvar aimOverride=null;\nvar playerSkin=window.VIBREX_AVATAR||null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\n\nvar keys={left:false,right:false,up:false,down:false,fire:false,useItem:false};\nfunction keyMap(code,down){\n  if(code=='ArrowLeft'||code=='KeyA')keys.left=down;\n  if(code=='ArrowRight'||code=='KeyD')keys.right=down;\n  if(code=='ArrowUp'||code=='KeyW')keys.up=down;\n  if(code=='ArrowDown'||code=='KeyS')keys.down=down;\n  if(code=='Space')keys.fire=down;\n  if(code=='KeyX')keys.useItem=down;\n}\naddEventListener('keydown',e=>{keyMap(e.code,true);});\naddEventListener('keyup',e=>{keyMap(e.code,false);});\n\nfunction dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y);}\n\nfunction startGame(){\n  phase='playing';score=0;wave=1;player.hp=maxHP;player.x=W/2;player.y=H/2;\n  enemies=[];bullets=[];items=[];fireCd=0;skillCd=0;\n  document.getElementById('ui').classList.add('hidden');\n  spawnWave(1);\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){startGame();if(window.AJ)AJ.restart();}\ndocument.getElementById('vibrex-start').onclick=startGame;\n\nfunction spawnWave(n){\n  waveActive=true;\n  var count=4+n*2;\n  if(n==5){\n    enemies.push({x:20,y:20,hp:400,maxhp:400,r:36,speed:60,dmg:20,boss:true});\n    count=3;\n  }\n  for(var i=0;i<count;i++){\n    var side=Math.floor(Math.random()*4),x,y;\n    if(side==0){x=-30;y=Math.random()*H;}\n    else if(side==1){x=W+30;y=Math.random()*H;}\n    else if(side==2){x=Math.random()*W;y=-30;}\n    else{x=Math.random()*W;y=H+30;}\n    enemies.push({x:x,y:y,hp:20+n*4,maxhp:20+n*4,r:14,speed:70+n*6,dmg:8,boss:false});\n  }\n  if(window.AJ)AJ.level(n);\n}\n\nfunction nearestEnemy(){\n  if(!enemies||enemies.length==0)return null;\n  var best=null,bd=1e9;\n  for(var i=0;i<enemies.length;i++){\n    var d=dist(enemies[i],player);\n    if(d<bd){bd=d;best=enemies[i];}\n  }\n  return best?{e:best,d:bd}:null;\n}\n\nfunction activateSkill(){\n  if(skillCd>0)return;\n  skillCd=skillMax;\n  for(var i=enemies.length-1;i>=0;i--){\n    var e=enemies[i];\n    if(dist(e,player)<skillRadius){\n      e.hp-=60;\n      if(e.hp<=0)killEnemy(i);\n    }\n  }\n}\n\nfunction killEnemy(i){\n  var e=enemies[i];\n  score+=e.boss?100:10;\n  if(window.AJ)AJ.score(score);\n  if(Math.random()<0.25){items.push({x:e.x,y:e.y,r:10});}\n  enemies.splice(i,1);\n}\n\nfunction fireBullet(dx,dy){\n  var len=Math.hypot(dx,dy)||1;\n  bullets.push({x:player.x,y:player.y,vx:dx/len*400,vy:dy/len*400,r:5,life:1.5});\n}\n\nvar lastT=0;\nfunction loop(t){\n  var dt=Math.min(0.05,(t-lastT)/1000||0);lastT=t;\n  if(phase=='playing'){\n    if(botOn)botUpdate(dt);\n    update(dt);\n  }\n  draw();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nfunction update(dt){\n  var mx=0,my=0;\n  if(keys.left)mx-=1;if(keys.right)mx+=1;\n  if(keys.up)my-=1;if(keys.down)my+=1;\n  var len=Math.hypot(mx,my);\n  if(len>0){mx/=len;my/=len;player.facing=mx>=0?1:-1;}\n  player.vx=mx*player.speed;player.vy=my*player.speed;\n  player.x=Math.max(player.r,Math.min(W-player.r,player.x+player.vx*dt));\n  player.y=Math.max(player.r,Math.min(H-player.r,player.y+player.vy*dt));\n\n  var aimx=0,aimy=0;\n  if(aimOverride){aimx=aimOverride.x;aimy=aimOverride.y;}\n  else{\n    var ne=nearestEnemy();\n    if(ne){aimx=ne.e.x-player.x;aimy=ne.e.y-player.y;}\n    else if(len>0){aimx=mx;aimy=my;}\n  }\n  fireCd-=dt*1000;skillCd=Math.max(0,skillCd-dt*1000);\n  if(keys.fire&&fireCd<=0&&(aimx||aimy)){fireCd=fireRate;fireBullet(aimx,aimy);}\n  if(keys.useItem)activateSkill();\n\n  for(var i=bullets.length-1;i>=0;i--){\n    var b=bullets[i];\n    b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;\n    if(b.life<=0||b.x<-20||b.x>W+20||b.y<-20||b.y>H+20){bullets.splice(i,1);continue;}\n    for(var j=enemies.length-1;j>=0;j--){\n      var e=enemies[j];\n      if(dist(b,e)<e.r+b.r){\n        e.hp-=10;bullets.splice(i,1);\n        if(e.hp<=0)killEnemy(j);\n        break;\n      }\n    }\n  }\n\n  for(var i=enemies.length-1;i>=0;i--){\n    var e=enemies[i];\n    var dx=player.x-e.x,dy=player.y-e.y,d=Math.hypot(dx,dy)||1;\n    e.x+=dx/d*e.speed*dt;e.y+=dy/d*e.speed*dt;\n    if(d<e.r+player.r){\n      player.hp-=e.dmg*dt;\n      if(player.hp<=0){player.hp=0;gameOver();}\n    }\n  }\n\n  for(var i=items.length-1;i>=0;i--){\n    var it=items[i];\n    if(dist(it,player)<it.r+player.r){\n      player.hp=Math.min(maxHP,player.hp+20);\n      items.splice(i,1);\n    }\n  }\n\n  if(waveActive&&enemies.length==0){\n    waveActive=false;waveTimer=1.5;\n  }\n  if(!waveActive){\n    waveTimer-=dt;\n    if(waveTimer<=0){\n      if(wave>=5){cleared();}\n      else{wave++;spawnWave(wave);}\n    }\n  }\n}\n\nfunction gameOver(){\n  phase='over';\n  if(window.AJ)AJ.over(score);\n  showOverlay('게임 오버','최종 점수: '+score,'다시하기',false);\n}\nfunction cleared(){\n  phase='cleared';\n  if(window.AJ)AJ.clear(score);\n  showOverlay('클리어!','최종 점수: '+score,'다시하기',true);\n}\nfunction showOverlay(title,sub,btn,clear){\n  var ui=document.getElementById('ui');\n  ui.classList.remove('hidden');\n  ui.setAttribute('data-vibrex-role',clear?'clear':'');\n  document.getElementById('uiInner').innerHTML='<h1>'+title+'</h1><p>'+sub+'</p><button data-vibrex-role=\"restart\" id=\"rb\">'+btn+'</button>';\n  document.getElementById('rb').onclick=restartGame;\n}\n\nfunction draw(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,W,H);\n  if(phase!='playing'){return;}\n  for(var i=0;i<items.length;i++){\n    var it=items[i];\n    ctx.fillStyle='#3f6';ctx.beginPath();ctx.arc(it.x,it.y,it.r,0,7);ctx.fill();\n  }\n  for(var i=0;i<enemies.length;i++){\n    var e=enemies[i];\n    ctx.fillStyle=e.boss?'#a0f':'#f44';\n    ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,7);ctx.fill();\n    ctx.fillStyle='#000';ctx.fillRect(e.x-e.r,e.y-e.r-8,e.r*2,4);\n    ctx.fillStyle='#0f0';ctx.fillRect(e.x-e.r,e.y-e.r-8,e.r*2*(e.hp/e.maxhp),4);\n  }\n  for(var i=0;i<bullets.length;i++){\n    var b=bullets[i];\n    ctx.fillStyle='#ff0';ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,7);ctx.fill();\n  }\n  if(playerSkin){\n    var s=player.r*2.4;\n    ctx.drawImage(playerSkin,player.x-s/2,player.y-s/2,s,s);\n  }else{\n    ctx.fillStyle='#3af';ctx.beginPath();ctx.arc(player.x,player.y,player.r,0,7);ctx.fill();\n  }\n  if(skillCd>0){\n    ctx.strokeStyle='rgba(255,255,255,.5)';ctx.beginPath();\n    ctx.arc(player.x,player.y,player.r+6,0,7*(1-skillCd/skillMax));ctx.stroke();\n  }\n  document.getElementById('hud').textContent='웨이브 '+wave+'/5 점수:'+score+' 체력:'+Math.ceil(player.hp);\n  document.getElementById('bot').style.display=botOn?'block':'none';\n}\n\nfunction botUpdate(dt){\n  var ne=nearestEnemy();\n  keys.left=keys.right=keys.up=keys.down=false;\n  if(ne){\n    aimOverride={x:ne.e.x-player.x,y:ne.e.y-player.y};\n    var dx=player.x-ne.e.x,dy=player.y-ne.e.y;\n    if(Math.abs(dx)>10)keys.left=dx>0?false:true,keys.right=dx>0?true:false;\n    if(dx>10)keys.right=true;else if(dx<-10)keys.left=true;\n    if(dy>10)keys.down=true;else if(dy<-10)keys.up=true;\n  }else{aimOverride=null;}\n  keys.fire=true;\n  var near=0;\n  for(var i=0;i<enemies.length;i++)if(dist(enemies[i],player)<160)near++;\n  keys.useItem=near>=3;\n}\n\nwindow.vibrexBot={\n  start:function(){botOn=true;if(phase=='title')startGame();},\n  stop:function(){botOn=false;keys={left:false,right:false,up:false,down:false,fire:false,useItem:false};aimOverride=null;}\n};\n\nwindow.VIBREX_GAME={\n  title:'아레나 서바이버',genre:'탑다운 슈터',\n  goal:'5웨이브를 버티고 보스를 처치하라',\n  clearCondition:'5웨이브 보스 처치',\n  controls:[\n    {input:'left',action:'왼쪽 이동'},{input:'right',action:'오른쪽 이동'},\n    {input:'up',action:'위 이동'},{input:'down',action:'아래 이동'},\n    {input:'fire',action:'사격(자동조준)'},{input:'useItem',action:'폭발 스킬'}\n  ],\n  phase:function(){return phase;},\n  progress:function(){return phase=='cleared'?1:Math.min(1,(wave-1)/5+(waveActive?0:0));},\n  state:function(){\n    var maxDist=Math.hypot(W,H);\n    var ne=nearestEnemy();\n    var tdx=0,tdy=0,tdist=0,dc=0;\n    if(ne){\n      var dx=ne.e.x-player.x,dy=ne.e.y-player.y,d=ne.d||1;\n      tdx=d>0?dx/d:0;tdy=d>0?dy/d:0;tdist=Math.min(1,d/maxDist);\n    }\n    for(var i=0;i<enemies.length;i++)if(dist(enemies[i],player)<200)dc++;\n    return{\n      selfX:player.x/W,selfY:player.y/H,\n      selfVX:Math.max(-1,Math.min(1,player.vx/player.speed)),\n      selfVY:Ma