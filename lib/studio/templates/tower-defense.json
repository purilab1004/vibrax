exBot&&typeof window.vibrexBot.stop==='function'){try{window.vibrexBot.stop()}catch(e1){}}fallbackStop()}});})();</script><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\"><title>구불길 방어대</title>\n<style>html,body{margin:0;background:#000;overflow:hidden;height:100%}canvas{display:block;margin:0 auto;background:#1a2b1a;touch-action:none}\n#ui{position:fixed;left:0;top:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;pointer-events:none;color:#fff;font-family:sans-serif;text-align:center}\n.scr{pointer-events:auto;background:rgba(0,0,0,.85);padding:20px 30px;border-radius:12px;max-width:90vw}\nbutton{font-size:18px;padding:10px 24px;margin-top:12px;border-radius:8px;border:none;background:#4caf50;color:#fff;cursor:pointer}\n.itembar{position:fixed;top:8px;left:8px;display:flex;gap:6px;z-index:5}\n.ib{width:44px;height:44px;background:rgba(255,255,255,.15);border:2px solid #888;border-radius:8px;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;pointer-events:auto}\n.ib.sel{border-color:#ff0}\n#hud{position:fixed;top:8px;right:8px;color:#fff;font-family:sans-serif;text-align:right;font-size:14px;z-index:5}\n</style></head>\n<body>\n<canvas id=\"c\" width=\"800\" height=\"560\"></canvas>\n<div class=\"itembar\" id=\"itembar\">\n<div class=\"ib sel\" id=\"ib1\">🏹</div><div class=\"ib\" id=\"ib2\">💥</div><div class=\"ib\" id=\"ib3\">❄️</div>\n</div>\n<div id=\"hud\"></div>\n<div id=\"ui\">\n<div class=\"scr\" id=\"title\" data-vibrex-role=\"title\">\n<h2>구불길 방어대</h2>\n<p>10웨이브 동안 적이 길을 따라 몰려온다.<br>골드로 빈 칸에 타워를 세워 막아라!</p>\n<p style=\"text-align:left;font-size:13px\">방향키: 커서 이동<br>fire(스페이스): 타워 설치<br>1/2/3: 화살/폭발/감속탑 선택<br>useItem(X): 선택 타워 업그레이드</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div class=\"scr\" id=\"overOver\" data-vibrex-role=\"over\" style=\"display:none\">\n<h2>패배</h2><p id=\"overScore\"></p><button data-vibrex-role=\"restart\" id=\"btnR1\">다시하기</button>\n</div>\n<div class=\"scr\" id=\"overClear\" data-vibrex-role=\"clear\" style=\"display:none\">\n<h2>승리! 10웨이브 방어 성공</h2><p id=\"clearScore\"></p><button data-vibrex-role=\"restart\" id=\"btnR2\">다시하기</button>\n</div>\n</div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nconst W=800,H=560,CELL=80,COLS=10,ROWS=7;\nfunction fit(){let s=Math.min(innerWidth/W,innerHeight/H);cv.style.width=(W*s)+'px';cv.style.height=(H*s)+'px';}\nwindow.addEventListener('resize',fit);fit();\nlet playerSkin=null;\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\n\nfunction genPath(){let p=[];for(let x=0;x<10;x++)p.push([x,1]);for(let y=2;y<=3;y++)p.push([9,y]);for(let x=8;x>=0;x--)p.push([x,3]);for(let y=4;y<=5;y++)p.push([0,y]);for(let x=1;x<10;x++)p.push([x,5]);p.push([9,6]);for(let x=8;x>=0;x--)p.push([x,6]);return p;}\nconst path=genPath();const pathSet=new Set(path.map(p=>p[0]+','+p[1]));\nfunction minDist(x,y){let m=99;for(const p of path){let d=Math.abs(p[0]-x)+Math.abs(p[1]-y);if(d<m)m=d;}return m;}\nlet buildable=[];for(let x=0;x<COLS;x++)for(let y=0;y<ROWS;y++)if(!pathSet.has(x+','+y))buildable.push([x,y,minDist(x,y)]);\n\nlet gold,lives,wave,score,cursorX,cursorY,selectedItem,towers,enemies,spawnQueue,spawnTimer,waveCd,phase,killCount;\nlet keyState={left:false,right:false,up:false,down:false,fire:false,useItem:false};\nlet prevFire=false,prevUse=false,moveAcc=0;\nlet botOn=false,botTimer=0;\n\nfunction reset(){gold=100;lives=10;wave=0;score=0;cursorX=0;cursorY=0;selectedItem=1;towers=[];enemies=[];spawnQueue=0;spawnTimer=0;waveCd=1.5;killCount=0;updateItemBar();}\nreset();phase='title';\n\nfunction setScore(v){score=v;if(window.AJ)AJ.score(score);}\nfunction updateItemBar(){for(let i=1;i<=3;i++)document.getElementById('ib'+i).classList.toggle('sel',selectedItem===i);}\n\nfunction moveCursor(dx,dy){cursorX=Math.max(0,Math.min(COLS-1,cursorX+dx));cursorY=Math.max(0,Math.min(ROWS-1,cursorY+dy));}\nconst costs={1:20,2:40,3:30};\nfunction placeTower(){\n if(pathSet.has(cursorX+','+cursorY))return;\n if(towers.find(t=>t.x===cursorX&&t.y===cursorY))return;\n let c=costs[selectedItem];if(gold<c)return;\n gold-=c;towers.push({x:cursorX,y:cursorY,type:selectedItem,level:1,cd:0});\n}\nfunction upgradeTower(){\n let t=towers.find(t=>t.x===cursorX&&t.y===cursorY);\n if(!t||t.level>=3)return;\n let cost=15*t.level;if(gold<cost)return;\n gold-=cost;t.level++;\n}\ndocument.getElementById('ib1').onclick=()=>{selectedItem=1;updateItemBar();};\ndocument.getElementById('ib2').onclick=()=>{selectedItem=2;updateItemBar();};\ndocument.getElementById('ib3').onclick=()=>{selectedItem=3;updateItemBar();};\n\nfunction startWave(){wave++;spawnQueue=5+wave;spawnTimer=0;if(window.AJ)AJ.level(wave);}\nfunction newEnemy(){let hp=20+wave*10;return{pathIdx:0,frac:0,hp:hp,maxhp:hp,speed:70+wave*3,slowT:0};}\n\nfunction keydown(e){\n if(e.code==='ArrowLeft'||e.code==='KeyA')keyState.left=true;\n if(e.code==='ArrowRight'||e.code==='KeyD')keyState.right=true;\n if(e.code==='ArrowUp'||e.code==='KeyW')keyState.up=true;\n if(e.code==='ArrowDown'||e.code==='KeyS')keyState.down=true;\n if(e.code==='Space')keyState.fire=true;\n if(e.code==='KeyX')keyState.useItem=true;\n if(e.code==='Digit1'){selectedItem=1;updateItemBar();}\n if(e.code==='Digit2'){selectedItem=2;updateItemBar();}\n if(e.code==='Digit3'){selectedItem=3;updateItemBar();}\n}\nfunction keyup(e){\n if(e.code==='ArrowLeft'||e.code==='KeyA')keyState.left=false;\n if(e.code==='ArrowRight'||e.code==='KeyD')keyState.right=false;\n if(e.code==='ArrowUp'||e.code==='KeyW')keyState.up=false;\n if(e.code==='ArrowDown'||e.code==='KeyS')keyState.down=false;\n if(e.code==='Space')keyState.fire=false;\n if(e.code==='KeyX')keyState.useItem=false;\n}\ndocument.addEventListener('keydown',keydown);document.addEventListener('keyup',keyup);\n\nfunction statsByType(type,level){\n if(type===1)return{range:2.5*CELL,dmg:10*level,rate:0.5};\n if(type===2)return{range:2*CELL,dmg:15*level,rate:1.0,splash:1.2*CELL};\n return{range:2*CELL,dmg:2*level,rate:0.8,slow:0.5};\n}\nfunction enemyPos(en){\n let a=path[Math.min(en.pathIdx,path.length-1)];\n let b=path[Math.min(en.pathIdx+1,path.length-1)];\n return{x:(a[0]+(b[0]-a[0])*en.frac)*CELL+CELL/2,y:(a[1]+(b[1]-a[1])*en.frac)*CELL+CELL/2};\n}\nfunction furthestProg(en){return en.pathIdx+en.frac;}\n\nfunction update(dt){\n moveAcc+=dt;\n if(moveAcc>0.14){moveAcc=0;\n  if(keyState.left)moveCursor(-1,0);else if(keyState.right)moveCursor(1,0);\n  if(keyState.up)moveCursor(0,-1);else if(keyState.down)moveCursor(0,1);\n }\n if(keyState.fire&&!prevFire)placeTower();prevFire=keyState.fire;\n if(keyState.useItem&&!prevUse)upgradeTower();prevUse=keyState.useItem;\n\n if(spawnQueue>0){spawnTimer-=dt;if(spawnTimer<=0){spawnQueue--;spawnTimer=0.55;enemies.push(newEnemy());}}\n else if(enemies.length===0){\n  if(wave>=10){phase='cleared';document.getElementById('overClear').style.display='block';document.getElementById('clearScore').textContent='최종 점수: '+score;if(window.AJ)AJ.clear(score);return;}\n  waveCd-=dt;if(waveCd<=0){waveCd=3;startWave();}\n }\n for(let i=enemies.length-1;i>=0;i--){\n  let en=enemies[i];\n  if(en.slowT>0)en.slowT-=dt;\n  let sp=en.speed*(en.slowT>0?0.5:1);\n  en.frac+=sp*dt/CELL;\n  if(en.frac>=1){en.frac=0;en.pathIdx++;}\n  if(en.pathIdx>=path.length-1){enemies.splice(i,1);lives--;if(lives<=0){phase='over';document.getElementById('overOver').style.display='block';document.getElementById('overScore').textContent='최종 점수: '+score;if(window.AJ)AJ.over(score);}continue;}\n  if(en.hp<=0){enemies.splice(i,1);gold+=5+wave;killCount++;setScore(score+10+wave);}\n }\n for(const t of towers){\n  t.cd-=dt;if(t.cd>0)continue;\n  const st=statsByType(t.type,t.level);\n  const tx=t.x*CELL+CELL/2,ty=t.y*CELL+CELL/2;\n  let target=null,best=-1;\n  for(const en of enemies){\n   const p=enemyPos(en);const d=Math.hypot(p.x-tx,p.y-ty);\n   if(d<=st.range&&furthestProg(en)>best){best=furthestProg(en);target=en;}\n  }\n  if(target){\n   t.cd=st.rate;\n   if(t.type===2){\n    const tp=enemyPos(target);\n    for(const en of enemies){const p=enemyPos(en);if(Math.hypot(p.x-tp.x,p.y-tp.y)<=st.splash)en.hp-=st.dmg;}\n   } else if(t.type===3){\n    target.hp-=st.dmg;target.slowT=1.0;\n   } else {target.hp-=st.dmg;}\n  }\n }\n}\n\nfunction draw(){\n ctx.clearRect(0,0,W,H);\n for(let x=0;x<COLS;x++)for(let y=0;y<ROWS;y++){\n  ctx.fillStyle=pathSet.has(x+','+y)?'#5a4a2f':'#234a23';\n  ctx.fillRect(x*CELL+1,y*CELL+1,CELL-2,CELL-2);\n }\n ctx.strokeStyle='#ff0';ctx.lineWidth=3;\n ctx.strokeRect(cursorX*CELL+2,cursorY*CELL+2,CELL-4,CELL-4);\n for(const t of towers){\n  const cx=t.x*CELL+CELL/2,cy=t.y*CELL+CELL/2;\n  ctx.fillStyle=t.type===1?'#4caf50':t.type===2?'#e67e22':'#3498db';\n  ctx.beginPath();ctx.arc(cx,cy,16+t.level*3,0,7);ctx.fill();\n  ctx.fillStyle='#fff';ctx.font='14px sans-serif';ctx.textAlign='center';\n  ctx.fillText(t.level,cx,cy+5);\n }\n for(const en of enemies){\n  const p=enemyPos(en);\n  ctx.fillStyle='#e74c3c';ctx.beginPath();ctx.arc(p.x,p.y,14,0,7);ctx.fill();\n  ctx.fillStyle='#000';ctx.fillRect(p.x-15,p.y-24,30,5);\n  ctx.fillStyle='#0f0';ctx.fillRect(p.x-15,p.y-24,30*(en.hp/en.maxhp),5);\n }\n if(playerSkin){ctx.drawImage(playerSkin,W-56,H-56,48,48);}\n ctx.fillStyle='#fff';ctx.font='16px sans-serif';ctx.textAlign='left';\n document.getElementById('hud').innerHTML='웨이브 '+wave+'/10<br>골드 '+gold+'<br>생명 '+lives+'<br>점수 '+score;\n if(botOn){ctx.fillStyle='#ff0';ctx.font='bold 18px sans-serif';ctx.textAlign='center';ctx.fillText('AI PLAYING',W/2,24);}\n}\n\nfunction dangerDist(){\n if(enemies.length===0)return 1;\n let m=1;for(const en of enemies){let r=1-(furthestProg(en)/(path.length-1));if(r<m)m=r;}return m;\n}\n\nlet last=performance.now();\nfunction loop(t){\n requestAnimationFrame(loop);\n let dt=Math.min((t-last)/1000,0.05);last=t;\n if(phase==='playing'){update(dt);if(botOn)botTick(dt);}\n draw();\n}\nrequestAnimationFrame(loop);\n\ndocument.getElementById('vibrex-start').onclick=()=>{VIBREX_GAME.start();};\ndocument.getElementById('btnR1').onclick=()=>{VIBREX_GAME.restart();};\ndocument.getElementById('btnR2').onclick=()=>{VIBREX_GAME.restart();};\n\nwindow.VIBREX_GAME={\n title:'구불길 방어대',genre:'타워 디펜스',\n goal:'10웨이브 동안 생명을 지키며 방어하라',\n clearCondition:'10웨이브를 모두 방어하면 클리어',\n controls:[{input:'left/right/up/down',action:'커서 이동'},{input:'fire',action:'타워 설치'},{input:'item1',action:'화살탑 선택'},{input:'item2',action:'폭발탑 선택'},{input:'item3',action:'감속탑 선택'},{input:'useItem',action:'선택 타워 업그레이드'}],\n phase:()=>phase,\n progress:()=>wave/10,\n state:()=>({wave,gold,lives,enemiesAlive:enemies.length,towers:towers.length,progress:wave/10,score,cursorX,cursorY,dangerDist:dangerDist()}),\n start:()=>{if(phase==='title'||phase==='over'||phase==='cleared'){reset();document.getElementById('title').style.display='none';document.getElementById('overOver').style.display='none';document.getElementById('overClear').style.display='none';phase='playing';if(window.AJ)AJ.start();}},\n restart:()=>{reset();document.getElementById('title').style.display='none';document.getElementById('overOver').style.display='none';document.getElementById('overClear').style.display='none';phase='playing';if(window.AJ)AJ.start();},\n inputs:{\n  left:v=>keyState.left=v,right:v=>keyState.right=v,up:v=>keyState.up=v,down:v=>keyState.down=v,\n  jump:v=>{},fire:v=>keyState.fire=v,guard:v=>{},action:v=>keyState.fire=v,action2:v=>keyState.useItem=v,useItem:v=>keyState.useItem=v,\n  item1:v=>{if(v){selectedItem=1;updateItemBar();}},item2:v=>{if(v){selectedItem=2;updateItemBar();}},item3:v=>{if(v){selectedItem=3;updateItemBar();}},item4:v=>{}\n }\n};\n\nfunction botTick(dt){\n botTimer-=dt;if(botTimer>0)return;botTimer=0.35;\n if(phase!=='playing')return;\n let cands=buildable.filter(c=>!towers.find(t=>t.x===c[0]&&t.y===c[1]));\n if(cands.length&&gold>=20){\n  cands.sort((a,b)=>a[2]-b[2]);\n  const c=cands[0];cursorX=c[0];cursorY=c[1];\n  selectedItem=(gold>=60&&wave>3)?2:((gold>=30&&wave>5)?3:1);\n  updateItemBar();placeTower();\n } else if(towers.length){\n  let up=towers.filter(t=>t.level<3).sort((a,b)=>a.level-b.level)[0];\n  if(up&&gold>=15*up.level){cursorX=up.x;cursorY=up.y;upgradeTower();}\n }\n}\nwindow.vibrexBot={start(){botOn=true;if(phase==='title')VIBREX_GAME.start();},stop(){botOn=false;},setSkill(){}};\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"fire\"]};function I(){var G=window.VIBREX_GAME;return G&&G.inputs?G.inputs:null}function ch(code){var i=I();if(!i)return null;var T=window.VIBREX_CONTROLS||[{\"id\":\"left\",\"label\":\"왼쪽\",\"desc\":\"좌 이동·조향\",\"pc\":[\"ArrowLeft\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"right\",\"label\":\"오른쪽\",\"desc\":\"우 이동·조향\",\"pc\":[\"ArrowRight\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"up\",\"label\":\"위\",\"desc\":\"상 이동·가속·회전\",\"pc\":[\"ArrowUp\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"down\",\"label\":\"아래 (앉기)\",\"desc\":\"하 이동·앉기·슬라이드·빠른 낙하\",\"pc\":[\"ArrowDown\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"jump\",\"label\":\"점프\",\"desc\":\"도약·확정 (점프가 없는 게임은 스페이스가 발사)\",\"pc\":[\"Space\"],\"mobile\":\"button\",\"btnLabel\":\"JUMP\",\"size\":\"lg\",\"group\":\"main\",\"enabled\":true},{\"id\":\"fire\",\"label\":\"발사·공격\",\"desc\":\"발사·타격·상호작용\",\"pc\":[\"KeyA\"],\"mobile\":\"button\",\"btnLabel\":\"A\",\"size\":\"md\",\"group\":\"main\",\"enabled\":true},{\"id\":\"guard\",\"label\":\"