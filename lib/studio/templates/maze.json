] && grid[ny][nx]===0){\n        vis[ny*N+nx]=true;q.push({x:nx,y:ny,d:c.d+1});\n      }\n    }\n  }\n  return -1;\n}\nfunction bfsPath(sx,sy,tx,ty){\n  const q=[{x:sx,y:sy}],vis=new Array(N*N).fill(false),prev={};\n  vis[sy*N+sx]=true;\n  const dirs=[[1,0],[-1,0],[0,1],[0,-1]];\n  while(q.length){\n    const c=q.shift();\n    if(c.x===tx&&c.y===ty){\n      const path=[];let k=tx+','+ty;\n      while(k!==sx+','+sy){path.unshift(k);k=prev[k];}\n      return path.map(s=>{const p=s.split(',');return{x:+p[0],y:+p[1]};});\n    }\n    for(const[dx,dy] of dirs){\n      const nx=c.x+dx,ny=c.y+dy;\n      if(nx>=0&&nx<N&&ny>=0&&ny<N&&!vis[ny*N+nx]&&grid[ny]&&grid[ny][nx]===0){\n        vis[ny*N+nx]=true;prev[nx+','+ny]=c.x+','+c.y;q.push({x:nx,y:ny});\n      }\n    }\n  }\n  return [];\n}\nfunction resetGame(){\n  genMaze();\n  const cells=freeCells();\n  keys=[];\n  for(let i=0;i<3;i++){\n    if(cells.length===0)break;\n    const idx=Math.floor(Math.random()*cells.length);\n    keys.push({x:cells[idx].x,y:cells[idx].y,got:false});\n    cells.splice(idx,1);\n  }\n  player={x:1,y:1};\n  for(let y=0;y<N;y++)visited[y].fill(false);\n  visited[1][1]=true;\n  collected=0;timeLeft=90;score=0;startT=performance.now();\n  if(window.AJ)AJ.start();\n}\nfunction nearestTarget(){\n  let best=null,bd=Infinity;\n  for(const k of keys){if(k.got)continue;const d=bfs(player.x,player.y,k.x,k.y);if(d>=0&&d<bd){bd=d;best={x:k.x,y:k.y,d};}}\n  if(!best){const d=bfs(player.x,player.y,door.x,door.y);if(d>=0)best={x:door.x,y:door.y,d};}\n  return best;\n}\nfunction deadEndCheck(){\n  const dirs=[[1,0],[-1,0],[0,1],[0,-1]];\n  let open=0;\n  for(const[dx,dy] of dirs){\n    const nx=player.x+dx,ny=player.y+dy;\n    if(nx>=0&&nx<N&&ny>=0&&ny<N&&grid[ny]&&grid[ny][nx]===0)open++;\n  }\n  return open<=1?1:0;\n}\nlet keysDown={};\nwindow.addEventListener('keydown',e=>{keysDown[e.code]=true;});\nwindow.addEventListener('keyup',e=>{keysDown[e.code]=false;});\nlet inputState={left:false,right:false,up:false,