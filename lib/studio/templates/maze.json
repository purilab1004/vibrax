px sans-serif';ctx.fillText('🔑',ox+k.x*cs,oy+k.y*cs+cs*0.8);\n  }\n  {const d=Math.hypot(door.x-player.x,door.y-player.y);\n  if(d<=visR){ctx.font=cs*0.8+'px sans-serif';ctx.fillText(collected>=3?'🚪':'🔒',ox+door.x*cs,oy+door.y*cs+cs*0.8);}}\n  if(window.playerSkin)ctx.drawImage(window.playerSkin,ox+player.x*cs-cs*0.1,oy+player.y*cs-cs*0.1,cs*1.2,cs*1.2);\n  else{ctx.font=cs*0.8+'px sans-serif';ctx.fillText('🧑',ox+player.x*cs,oy+player.y*cs+cs*0.8);}\n  ctx.fillStyle='#fff';ctx.font='16px sans-serif';ctx.textAlign='left';\n  ctx.fillText('열쇠 '+collected+'/3   시간 '+Math.ceil(timeLeft)+'s   점수 '+score,10,canvas.height-15);\n  ctx.textAlign='center';\n  const mmSize=cs*N*0.3,mmX=canvas.width-mmSize-15,mmY=15,mc=mmSize/N;\n  ctx.fillStyle='rgba(20,20,20,0.8)';ctx.fillRect(mmX,mmY,mmSize,mmSize);\n  for(let y=0;y<N;y++)for(let x=0;x<N;x++){\n    if(visited[y][x]){ctx.fillStyle=grid[y][x]===0?'#555':'#222';ctx.fillRect(mmX+x*mc,mmY+y*mc,mc,mc);}\n  }\n  ctx.fillStyle='#0f0';ctx.fillRect(mmX+player.x*mc,mmY+player.y*mc,mc,mc);\n  if(window.vibrexBot&&window.vibrexBot._on){ctx.fillStyle='#0ff';ctx.font='14px sans-serif';}\n}\nlet last=performance.now();\nfunction loop(t){\n  const dt=Math.min(0.05,(t-last)/1000);last=t;\n  update(dt);draw();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\nfunction showEnd(cleared){\n  const ui=document.getElementById('ui');\n  ui.style.display='flex';\n  ui.setAttribute('data-vibrex-role',cleared?'clear':'');\n  ui.innerHTML='<div><h1>'+(cleared?'클리어!':'게임 오버')+'</h1><p>최종 점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>';\n  document.getElementById('rb').onclick=()=>{ui.style.display='none';startGame();};\n}\nfunction startGame(){\n  resetGame();phase='playing';\n  document.getElementById('ui').style.display='none';\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\nwindow.VIBREX_GAME={\n  title:'미로 탈출',genre:'maze',goal:'열쇠 3개를 모아 출구로 탈출',clearCondition:'열쇠 3개 획득 후 출구 도달',\n  controls:[{input:'ArrowLeft',action:'왼쪽'},{input:'ArrowRight',action:'오른쪽'},{input:'ArrowUp',action:'위'},{input:'ArrowDown',action:'아래'}],\n  phase:()=>phase,\n  progress:()=>{\n    let p=collected/3;\n    if(collected>=3){const d=bfs(player.x,player.y,door.x,door.y);if(d>=0)p+=Math.max(0,1-d/(N*N))*0.3;}\n    return Math.min(1,p);\n  },\n  state:()=>{\n    const t=nearestTarget();\n    const dx=t?(t.x-player.x):0,dy=t?(t.y-player.y):0;\n    const dist=t?Math.max(0,1-t.d/(N*2)):0;\n    return{\n      selfX:player.x/N,selfY:player.y/N,keys:collected,\n      targetDX:t?Math.sign(dx):0,targetDY:t?Math.sign(dy):0,targetDist:dist,\n      timeLeft:Math.max(0,timeLeft/90),\n      progress:window.VIBREX_GAME.progress(),\n      score:score,deadEndAhead:deadEndCheck()\n    };\n  },\n  start:startGame,restart:startGame,\n  inputs:{\n    left:on=>inputState.left=on,right:on=>inputState.right=on,\n    up:on=>inputState.up=on,down:on=>inputState.down=on,\n    jump:()=>{},fire:()=>{},guard:()=>{}\n  }\n};\nif(window.VIBREX_AVATAR){window.playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\nwindow.addEventListener('vibrex:avatar',e=>{window.playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{window.playerSkin=null;});\nlet botT=null;\nwindow.vibrexBot={\n  _on:false,\n  start(){\n    this._on=true;\n    if(phase==='title')startGame();\n    if(botT)clearInterval(botT);\n    botT=setInterval(()=>{\n      if(phase!=='playing'){if(phase==='over'||phase==='cleared'){const rb=document.getElementById('rb');if(rb)rb.click();}return;}\n      const t=nearestTarget();\n      if(!t)return;\n      const path=bfsPath(player.x,player.y,t.x,t.y);\n      if(path.length===0)return;\n      const nx=path[0].x,ny=path[0].y;\n      const dx=nx-player.x,dy=ny-player.y;\n      inputState.left=dx<0;inputState.right=dx>0;inputState.up=dy<0;inputState.down=dy>0;\n    },80);\n  },\n  stop(){\n    thi