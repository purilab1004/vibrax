a(255,255,255,.35);backdrop-filter:blur(6px);display:none}#vbx-knob{position:absolute;left:50%;top:50%;width:52px;height:52px;margin:-26px 0 0 -26px;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.95),rgba(200,210,230,.75));box-shadow:0 4px 14px rgba(0,0,0,.45)}#vbx-hint{position:absolute;left:22px;bottom:26px;width:84px;height:84px;border-radius:50%;border:1.5px dashed rgba(255,255,255,.28);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.45);font:600 10px/1 -apple-system,system-ui,sans-serif;letter-spacing:.12em}#vbx-acts{position:absolute;right:16px;bottom:22px;display:flex;gap:12px;align-items:flex-end;pointer-events:auto}.vbx-btn{width:64px;height:64px;border-radius:50%;border:1.5px solid rgba(255,255,255,.35);background:rgba(255,255,255,.10);backdrop-filter:blur(6px);color:#fff;font:800 15px/1 -apple-system,system-ui,sans-serif;display:flex;align-items:center;justify-content:center;touch-action:none;box-shadow:0 4px 14px rgba(0,0,0,.35)}.vbx-btn.b{width:52px;height:52px;margin-bottom:34px;opacity:.9}.vbx-btn:active,.vbx-btn.on{background:rgba(255,255,255,.32)}</style><div id=\"vbx-zone\"><div id=\"vbx-hint\">MOVE</div><div id=\"vbx-stick\"><div id=\"vbx-knob\"></div></div></div><div id=\"vbx-acts\"><div class=\"vbx-btn b\" data-k=\"x\" data-n=\"action2\">B</div><div class=\"vbx-btn\" data-k=\" \" data-n=\"action\">A</div></div>';(document.body||document.documentElement).appendChild(root);var zone=root.querySelector('#vbx-zone'),stick=root.querySelector('#vbx-stick'),knob=root.querySelector('#vbx-knob'),hint=root.querySelector('#vbx-hint');var ox=0,oy=0,pid=null,R=44;function apply(dx,dy){var d=Math.hypot(dx,dy);var nx=d>R?dx/d*R:dx,ny=d>R?dy/d*R:dy;knob.style.transform='translate('+nx+'px,'+ny+'px)';var dead=12;set('ArrowLeft','left',dx<-dead&&Math.abs(dx)>=Math.abs(dy)*0.5);set('ArrowRight','right',dx>dead&&Math.abs(dx)>=Math.abs(dy)*0.5);set('ArrowUp','up',dy<-dead&&Math.abs(dy)>=Math.abs(dx)*0.5);set('ArrowDown','down',dy>dead&&Math.abs(dy)>=Math.abs(dx)*0.5)}function release(){['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].forEach(function(k,i){set(k,['left','right','up','down'][i],false)});knob.style.transform='';stick.style.display='none';hint.style.display='flex';pid=null}zone.addEventListener('pointerdown',function(e){if(pid!==null)return;pid=e.pointerId;ox=e.clientX;oy=e.clientY;stick.style.left=ox+'px';stick.style.top=oy+'px';stick.style.display='block';hint.style.display='none';try{zone.setPointerCapture(e.pointerId)}catch(e1){}e.preventDefault()});zone.addEventListener('pointermove',function(e){if(e.pointerId!==pid)return;apply(e.clientX-ox,e.clientY-oy);e.preventDefault()});zone.addEventListener('pointerup',function(e){if(e.pointerId===pid)release()});zone.addEventListener('pointercancel',function(e){if(e.pointerId===pid)release()});root.querySelectorAll('.vbx-btn').forEach(function(b){var k=b.getAttribute('data-k'),n=b.getAttribute('data-n');b.addEventListener('pointerdown',function(e){b.classList.add('on');set(k,n,true);try{b.setPointerCapture(e.pointerId)}catch(e1){}e.preventDefault()});var up=function(){b.classList.remove('on');set(k,n,false)};b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up)});hideLegacy();setTimeout(hideLegacy,1500);setTimeout(hideLegacy,4000)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(build,50)});else setTimeout(build,50);})();</script></body></html>"
