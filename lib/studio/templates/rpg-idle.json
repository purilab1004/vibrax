nter}\n#shop{position:fixed;bottom:10px;left:0;width:100%;display:flex;justify-content:center;gap:8px;z-index:4}\n.sbtn{background:#333;color:#fff;border:1px solid #666;border-radius:6px;padding:8px;font-size:12px;min-width:80px}\n#hud{position:fixed;top:10px;left:10px;color:#fff;font-family:sans-serif;font-size:14px;z-index:4}\n#aiflag{position:fixed;top:10px;right:10px;color:#ff0;font-family:sans-serif;font-weight:bold;display:none;z-index:6}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"hud\"></div>\n<div id=\"aiflag\">AI PLAYING</div>\n<div id=\"shop\">\n<button class=\"sbtn\" id=\"b1\">공격력↑<br><span id=\"c1\"></span></button>\n<button class=\"sbtn\" id=\"b2\">공속↑<br><span id=\"c2\"></span></button>\n<button class=\"sbtn\" id=\"b3\">자동골드↑<br><span id=\"c3\"></span></button>\n</div>\n<div id=\"ui\"></div>\n<script>\nvar cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=innerWidth;cv.height=innerHeight;}\nresize();window.addEventListener('resize',resize);\n\nvar st={phase:'title',gold:0,stage:1,enemyHp:1,enemyMax:1,atk:5,aspd:1,agold:0,atkCost:20,aspdCost:30,agCost:40,score:0,dmgAccum:0};\nvar lastAtk=0,shakeT=0,playerSkin=null;\nvar isBoss=false;\n\nfunction enemyMaxHp(s,boss){return Math.floor(20*Math.pow(1.35,s-1)*(boss?5:1));}\n\nfunction initEnemy(){\n  isBoss=(st.stage==10);\n  st.enemyMax=enemyMaxHp(st.stage,isBoss);\n  st.enemyHp=st.enemyMax;\n}\n\nfunction resetGame(){\n  st={phase:'playing',gold:0,stage:1,atk:5,aspd:1,agold:0,atkCost:20,aspdCost:30,agCost:40,score:0,dmgAccum:0};\n  initEnemy();\n  if(window.AJ)AJ.start();\n  updateHUD();\n}\n\nfunction dps(){return st.atk*st.aspd+st.agold*0;}\nfunction totalDps(){return st.atk*st.aspd;}\n\nfunction hit(dmg){\n  st.enemyHp-=dmg;\n  st.dmgAccum+=dmg;\n  shakeT=6;\n  if(st.enemyHp<=0){\n    st.gold+=Math.floor(10+st.stage*5*(isBoss?3:1));\n    st.score=Math.floor(st.gold+st.stage*100);\n    if(window.AJ)AJ.score(st.score);\n    if(isBoss){\n      st.phase='cleared';\n      if(window.AJ)AJ.clear(st.score);\n      return;\n    }\n    st.stage++;\n    if(window.AJ)AJ.level(st.stage);\n    initEnemy();\n  }\n}\n\nvar last=performance.now();\nfunction loop(t){\n  var dt=(t-last)/1000;last=t;\n  if(st.phase=='playing'){\n    st.gold+=st.agold*dt;\n    lastAtk+=dt;\n    var interval=1/st.aspd;\n    if(lastAtk>=interval){\n      lastAtk-=interval;\n      hit(st.atk);\n    }\n    if(shakeT>0)shakeT--;\n    updateHUD();\n  }\n  render();\n  requestAnimationFrame(loop);\n}\n\nfunction render(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,cv.width,cv.height);\n  if(st.phase!='playing'&&st.phase!='cleared')return;\n  var cx=cv.width/2, cy=cv.height/2;\n  var sh=shakeT>0?(Math.random()*8-4):0;\n  ctx.font=(Math.min(cv.width,cv.height)*0.25)+'px sans-serif';\n  ctx.textAlign='center';ctx.textBaseline='middle';\n  if(playerSkin){\n    var s=Math.min(cv.width,cv.height)*0.3;\n    ctx.drawImage(playerSkin,cx-160-s/2,cy-s/2,s,s);\n  }else{\n    ctx.fillText('🧙',cx-160,cy);\n  }\n  ctx.font=(Math.min(cv.width,cv.height)*(isBoss?0.3:0.22))+'px sans-serif';\n  ctx.fillText(isBoss?'👹':'👾',cx+160+sh,cy);\n  var bw=200;\n  ctx.fillStyle='#333';ctx.fillRect(cx+160-bw/2,cy+80,bw,14);\n  ctx.fillStyle=isBoss?'#f44':'#4a7';\n  ctx.fillRect(cx+160-bw/2,cy+80,bw*(st.enemyHp/st.enemyMax),14);\n  ctx.fillStyle='#fff';ctx.font='16px sans-serif';\n  ctx.fillText('스테이지 '+st.stage+(isBoss?' (보스)':''),cx,cy-140);\n}\n\nfunction updateHUD(){\n  document.getElementById('hud').innerHTML='골드: '+Math.floor(st.gold)+' | DPS: '+totalDps().toFixed(1)+' | 스테이지: '+st.stage+'/10';\n  document.getElementById('c1').innerText=st.atkCost;\n  document.getElementById('c2').innerText=st.aspdCost;\n  document.getElementById('c3').innerText=st.agCost;\n}\n\nfunction buyAtk(){if(st.gold>=st.atkCost){st.gold-=st.atkCost;st.atk+=3;st.atkCost=Math.floor(st.atkCost*1.6);}}\nfunction buyAspd(){if(st.gold>=st.aspdCost){st.gold-=st.aspdCost;st.aspd+=0.2;st.aspdCost=Math.floor(st.aspdCost*1.7);}}\nfunction buyAgold(){if(st.gold>=st.agCost){st.gold-=st.agCost;st.agold+=1;st.agCost=Math.floor(st.agCost*1.8);}}\n\ndocument.getElementById('b1').onclick=buyAtk;\ndocument.getElementById('b2').onclick=buyAspd;\ndocument.getElementById('b3').onclick=buyAgold;\n\nfunction tapAttack(){if(st.phase=='playing')hit(st.atk*0.5);}\ncv.addEventListener('mousedown',function(e){\n  var r=cv.getBoundingClientRect();\n  if(e.clientX-r.left>cv.width/2)tapAttack();\n});\ncv.addEventListener('touchstart',function(e){\n  e.preventDefault();\n  var r=cv.getBoundingClientRect();\n  var x=e.touches[0].clientX-r.left;\n  if(x>cv.width/2)tapAttack();\n},{passive:false});\n\nfunction showTitle(){\n  document.getElementById('ui').style.display='flex';\n  document.getElementById('shop').style.display='none';\n  document.getElementById('ui').innerHTML=\n  '<div><h1>방치형 영웅</h1><p>영웅이 자동으로 몬스터를 공격합니다. 골드로 강해져 스테이지 10 보스를 처치하세요.</p>'+\n  '<p>조작: fire(오른쪽 탭/스페이스)=수동공격, item1~3=업그레이드 구매</p>'+\n  '<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>';\n  document.getElementById('vibrex-start').onclick=function(){\n    document.getElementById('ui').style.display='none';\n    document.getElementById('shop').style.display='flex';\n    resetGame();\n  };\n}\n\nfunction showClear(){\n  document.getElementById('shop').style.display='none';\n  document.getElementById('ui').style.display='flex';\n  document.getElementById('ui').setAttribute('data-vibrex-role','clear');\n  document.getElementById('ui').innerHTML=\n  '<div><h1>클리어!</h1><p>최종 점수: '+st.score+'</p>'+\n  '<button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>';\n  document.getElementById('rb').onclick=function(){\n    document.getElementById('ui').removeAttribute('data-vibrex-role');\n    document.getElementById('ui').style.display='none';\n    document.getElementById('shop').style.display='flex';\n    resetGame();\n  };\n}\n\nvar checkClearInt=setInterval(function(){\n  if(st.phase=='cleared'){\n    showClear();\n  }\n},200);\n\nshowTitle();\nrequestAnimationFrame(loop);\n\nwindow.VIBREX_GAME={\n  title:'방치형 영웅',genre:'idle rpg',\n  goal:'스테이지 10 보스를 처치하라',\n  clearCondition:'스테이지 10 보스 처치',\n  controls:[\n    {input:'fire',action:'수동 탭 공격'},\n    {input:'item1',action:'공격력 업그레이드'},\n    {input:'item2',action:'공속 업그레이드'},\n    {input:'item3',action:'자동골드 업그레이드'}\n  ],\n  phase:function(){\n    if(st.phase=='title')return 'title';\n    if(st.phase=='cleared')return 'cleared';\n    return 'playing';\n  },\n  progress:function(){return Math.min(1,(st.stage-1)/9+ (st.enemyMax? (1-st.enemyHp/st.enemyMax)/9 :0));},\n  state:function(){\n    var nextCost=Math.min(st.atkCost,st.aspdCost,st.agCost);\n    return {\n      gold:Math.floor(st.gold),dps:totalDps(),stage:st.stage,\n      progress:this.progress(),\n      enemyHp:st.enemyMax?st.enemyHp/st.enemyMax:0,\n      score:st.score,\n      upgradeCostRatio:nextCost?Math.min(2,st.gold/nextCost):0,\n      targetDX:0,targetDY:0,targetDist:st.enemyMax?st.enemyHp/st.enemyMax:0,\n      dangerDist:1,dangerETA:1,\n      fireReady:1,selfVX:0,selfVY:0,facing:1\n    };\n  },\n  start:function(){\n    if(st.phase=='title'){\n      document.getElementById('ui').style.display='none';\n      document.getElementById('shop').style.display='flex';\n      resetGame();\n    }\n  },\n  restart:function(){resetGame();document.getElementById('ui').style.display='none';document.getElementById('shop').style.display='flex';},\n  inputs:{\n    left:function(){},right:function(){},up:function(){},down:function(){},\n    jump:function(){},\n    fire:function(on){if(on)tapAttack();},\n    guard:function(){},\n    useItem:function(){},\n    item1:function(on){if(on)buyAtk();},\n    item2:function(on){if(on)buyAspd();},\n    item3:function(on){if(on)buyAgold();}\n  }\n};\n\nwindow.addEventListener('keydown',function(e){\n  if(e.code=='Space')tapAttack();\n  if(e.code=='Digit1')buyAtk();\n  if(e.code=='Digit2')buyAspd();\n  if(e.code=='Digit3')buyAgold();\n});\n\nwindow.addEventListener('vibrex:avatar',function(e){playerSkin=e.detail.img;if(window.vibrexAvatarAck)window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',function(){playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;if(window.vibrexAvatarAck)window.vibrexAvatarAck();}\n\nvar botRun=false,botInt=null;\nwindow.vibrexBot={\n  start:function(){\n    botRun=true;\n    document.getElementById('aiflag').style.display='block';\n    if(st.phase=='title')window.VIBREX_GAME.start();\n    if(botInt)clearInterval(botInt);\n    botInt=setInterval(function(){\n      if(!botRun)return;\n      if(st.phase=='cleared'){\n        var rb=document.getElementById('rb');\n        if(rb)rb.click();\n        return;\n      }\n      if(st.phase!='playing')return;\n      var opts=[\n        {name:'atk',cost:st.atkCost,gain:3*st.aspd,fn:buyAtk},\n        {name:'aspd',cost:st.aspdCost,gain:st.atk*0.2,fn:buyAspd},\n        {name:'agold',cost:st.agCost,gain:1,fn:buyAgold}\n      ];\n      var best=null,bestEff=-1;\n      for(var i=0;i<opts.length;i++){\n        var o=opts[i];\n        if(st.gold>=o.cost){\n          var eff=o.gain/o.cost;\n          if(eff>bestEff){bestEff=eff;best=o;}\n        }\n      }\n      if(best){best.fn();}\n      else tapAttack();\n    },300);\n  },\n  stop:function(){\n    botRun=false;\n    document.getElementById('aiflag').style.display='none';\n    if(botInt)clearInterval(botInt);\n  }\n};\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,cancelable:true};try{var e=new KeyboardEvent(type,o);Object.defineProperty(e,'keyCode',{get:function(){return o.keyCode}});Object.defineProperty(e,'which',{get:function(){return o.keyCo