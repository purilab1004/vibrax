nnerWidth, wh = window.innerHeight;\n    const scale = Math.min(ww / LW, wh / LH);\n    canvas.style.width = (LW * scale) + 'px';\n    canvas.style.height = (LH * scale) + 'px';\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  // 터치 기기 감지\n  const isTouch = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;\n  if (isTouch) {\n    document.getElementById('touchControls').style.display = 'flex';\n  }\n\n  // 게임 상태\n  const WIN_SCORE = 11;\n  const PADDLE_W = 14, PADDLE_H = 90;\n  const BALL_SIZE = 12;\n  const PADDLE_SPEED = 7;\n  const AI_SPEED = 5.4;\n  const BASE_BALL_SPEED = 5.5;\n  const SPEED_INCREASE = 0.35;\n  const MAX_BALL_SPEED = 15;\n\n  let player, ai, ball, scoreP, scoreA, gameOver, winner;\n  let rallyHits = 0;\n\n  function resetPositions(){\n    player = { x: 30, y: LH/2 - PADDLE_H/2, w: PADDLE_W, h: PADDLE_H, dy: 0 };\n    ai = { x: LW - 30 - PADDLE_W, y: LH/2 - PADDLE_H/2, w: PADDLE_W, h: PADDLE_H, dy: 0 };\n  }\n\n  function resetBall(direction){\n    rallyHits = 0;\n    const angle = (Math.random() * 0.6 - 0.3); // -0.3 ~ 0.3 rad\n    const speed = BASE_BALL_SPEED;\n    ball = {\n      x: LW/2 - BALL_SIZE/2,\n      y: LH/2 - BALL_SIZE/2,\n      w: BALL_SIZE, h: BALL_SIZE,\n      vx: Math.cos(angle) * speed * direction,\n      vy: Math.sin(angle) * speed,\n      speed: speed\n    };\n  }\n\n  function fullReset(){\n    scoreP = 0; scoreA = 0;\n    gameOver = false; winner = null;\n    resetPositions();\n    resetBall(Math.random() < 0.5 ? 1 : -1);\n  }\n\n  fullReset();\n\n  // 입력 처리\n  const keys = {};\n  window.addEventListener('keydown', e => {\n    keys[e.key] = true;\n    if (['ArrowUp','ArrowDown','w','W','s','S',' '].includes(e.key)) e.preventDefault();\n    if (gameOver && (e.key === ' ' || e.key === 'Enter')) {\n      fullReset();\n    }\n  }, {passive:false});\n  window.addEventListener('keyup', e => { keys[e.key] = false; });\n\n  let touchUp = false, touchDown = false;\n  let dragY = null;\n\n  function bindBtn(id, setter){\n    const el = document.getElementById(id);\n    el.addEventListener('touchstart', e => { e.preventDefault(); setter(true); }, {passive:false});\n    el.addEventListener('touchend', e => { e.preventDefault(); setter(false); }, {passive:false});\n    el.addEventListener('touchcancel', e => { setter(false); }, {passive:false});\n    el.addEventListener('mousedown', e => { setter(true); });\n    el.addEventListener('mouseup', e => { setter(false); });\n  }\n  bindBtn('btnUp', v => touchUp = v);\n  bindBtn('btnDown', v => touchDown = v);\n\n  // 캔버스 드래그로도 조작 가능 (왼쪽 절반 터치)\n  canvas.addEventListener('touchstart', handleTouch, {passive:false});\n  canvas.addEventListener('touchmove', handleTouch, {passive:false});\n  canvas.addEventListener('touchend', e => {\n    e.preventDefault();\n    if (gameOver) fullReset();\n  }, {passive:false});\n\n  function handleTouch(e){\n    e.preventDefault();\n    if (gameOver) { fullReset(); return; }\n    for (let i = 0; i < e.touches.length; i++){\n      const t = e.touches[i];\n      const rect = canvas.getBoundingClientRect();\n      const relY = (t.clientY - rect.top) / rect.height * LH;\n      dragY = relY;\n    }\n  }\n\n  canvas.addEventListener('click', () => {\n    if (gameOver) fullReset();\n  });\n\n  function clamp(v, min, max){ return Math.max(min, Math.min(max, v)); }\n\n  function update(){\n    if (gameOver) return;\n\n    // 플레이어 이동\n    let moveUp = keys['ArrowUp'] || keys['w'] || keys['W'] || touchUp;\n    let moveDown = keys['ArrowDown'] || keys['s'] || keys['S'] || touchDown;\n\n    if (dragY !== null) {\n      const target = dragY - player.h/2;\n      const diff = target - player.y;\n      player.y += clamp(diff, -PADDLE_SPEED, PADDLE_SPEED);\n    } else {\n      if (moveUp) player.y -= PADDLE_SPEED;\n      if (moveDown) player.y += PADDLE_SPEED;\n    }\n    player.y = clamp(player.y, 0, LH - player.h);\n\n    // AI 이동 (간단한 추적, 약간의 반응 지연 느낌을 위해 중심점 오차)\n    const aiCenter = ai.y + ai.h/2;\n    const ballCenter = ball.y + ball.h/2;\n    const diffAI = ballCenter - aiCenter;\n    if (Math.abs(diffAI) > 10) {\n      ai.y += clamp(diffAI, -AI_SPEED, AI_SPEED);\n    }\n    ai.y = clamp(ai.y, 0, LH - ai.h);\n\n    // 공 이동\n    ball.x += ball.vx;\n    ball.y += ball.vy;\n\n    // 상하 벽 충돌\n    if (ball.y <= 0) {\n      ball.y = 0;\n      ball.vy *= -1;\n    } else if (ball.y + ball.h >= LH) {\n      ball.y = LH - ball.h;\n      ball.vy *= -1;\n    }\n\n    // 플레이어 패들 충돌\n    if (ball.vx < 0 &&\n        ball.x <= player.x + player.w &&\n        ball.x + ball.w >= player.x &&\n        ball.y + ball.h >= player.y &&\n        ball.y <= player.y + player.h) {\n      ball.x = player.x + player.w;\n      hitPaddle(player);\n    }\n\n    // AI 패들 충돌\n    if (ball.vx > 0 &&\n        ball.x + ball.w >= ai.x &&\n        ball.x <= ai.x + ai.w &&\n        ball.y + ball.h >= ai.y &&\n        ball.y <= ai.y + ai.h) {\n      ball.x = ai.x - ball.w;\n      hitPaddle(ai);\n    }\n\n    // 점수\n    if (ball.x + ball.w < 0) {\n      scoreA++;\n      checkWin();\n      if (!gameOver) resetBall(1);\n    } else if (ball.x > LW) {\n      scoreP++;\n      checkWin();\n      if (!gameOver) resetBall(-1);\n    }\n  }\n\n  function hitPaddle(paddle){\n    rallyHits++;\n    const relIntersect = (ball.y + ball.h/2) - (paddle.y + paddle.h/2);\n    const norm = relIntersect / (paddle.h/2);\n    const bounceAngle = norm * (Math.PI/3.2); // 최대 약 56도\n\n    let newSpeed = Math.min(ball.speed + SPEED_INCREASE, MAX_BALL_SPEED);\n    ball.speed = newSpeed;\n\n    const dir = ball.vx < 0 ? 1 : -1;\n    // 패들 위치 기준 방향 재설정: player면 오른쪽으로, ai면 왼쪽으로\n    const direction = (paddle === player) ? 1 : -1;\n    ball.vx = Math.cos(bounceAngle) * newSpeed * direction;\n    ball.vy = Math.sin(bounceAngle) * newSpeed;\n  }\n\n  function checkWin(){\n    if (scoreP >= WIN_SCORE) {\n      gameOver = true; winner = 'PLAYER';\n    } else if (scoreA >= WIN_SCORE) {\n      gameOver = true; winner = 'AI';\n    }\n  }\n\n  //