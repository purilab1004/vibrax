:false,right:false,jump:false,fire:false,guard:false,useItem:false};\nlet phase='title',score=0,lives=5,botOn=false;\nlet P,B,cams;\n\nfunction initGame(){\nP={x:150,hp:1,stam:1,inv:0,rollT:0,facing:1,atkCd:0,itemCd:0,rollCd:0};\nB={x:760,hp:1,phase:1,state:'idle',timer:1,pattern:null,color:null,intent:0,stunT:0,cd:1,parryUsed:false,dashT:0};\n}\nfunction resetRun(){lives=5;score=0;initGame();}\n\nfunction fullReset(){resetRun();phase='playing';if(window.AJ)AJ.start();}\ninitGame();\n\nfunction damagePlayer(v){if(P.inv>0)return;P.hp-=v;if(P.hp<=0){lives--;score+=0;if(window.AJ)AJ.score(score);\n if(lives<=0){phase='over';if(window.AJ)AJ.over(score);}else{initGame();}}\n}\nfunction damageBoss(v){B.hp-=v;score+=Math.round(v*1000);if(window.AJ)AJ.score(score);\n let ph=B.hp>0.66?1:(B.hp>0.33?2:3);\n if(ph!==B.phase){B.phase=ph;if(window.AJ)AJ.level(ph);}\n if(B.hp<=0){B.hp=0;phase='cleared';if(window.AJ)AJ.clear(score);}\n}\n\nfunction dist(){return Math.abs(B.x-P.x);}\n\nconst PATTERNS={1:['slam','area'],2:['slam','area','dash'],3:['dash','area','slam']};\nfunction pickAttack(){\n const list=PATTERNS[B.phase];\n B.pattern=list[Math.floor(Math.random()*list.length)];\n const blueChance=B.phase===1?0.4:(B.phase===2?0.32:0.25);\n B.color=Math.random()<blueChance?'blue':'red';\n B.state='telegraph';B.timer=0.5;B.parryUsed=false;\n B.intent=B.color==='blue'?2:1;\n}\n\nfunction updateBoss(dt){\n if(B.stunT>0){B.stunT-=dt;B.intent=0;return;}\n if(B.state==='idle'){\n  B.cd-=dt;\n  const spd=140+B.phase*30;\n  if(dist()>90){B.x+=Math.sign(P.x-B.x)*spd*dt;}\n  if(B.cd<=0&&dist()<420){pickAttack();}\n  B.intent=0;\n }else if(B.state==='telegraph'){\n  B.timer-=dt;\n  if(B.color==='blue'&&keys.jump&&!B.parryUsed){\n   B.parryUsed=true;B.state='stunned';B.stunT=1.8;B.intent=0;\n   damageBoss(0.22);P.inv=0.3;\n   return;\n  }\n  if(B.timer<=0){B.state='active';B.intent=0;\n   if(B.pattern==='slam')B.timer=0.18;\n   else if(B.pattern==='area')B.timer=0.35;\n   else B.timer=0.45;\n   B.dashT=B.timer;\n  }\n }else if(B.state==='active'){\n  B.timer-=dt;\n  if(B.pattern==='dash'){\n   const t=1-(B.timer/B.dashT);\n   B.x+=Math.sign(P.x-B.x)*600*dt;\n  }\n  let hit=false;\n  if(B.pattern==='slam'&&dist()<95)hit=true;\n  if(B.pattern==='area'&&dist()<220)hit=true;\n  if(B.pattern==='dash'&&dist()<70)hit=true;\n  if(hit&&P.inv<=0){\n   const dmg=B.pattern==='area'?0.3:(B.pattern==='dash'?0.32:0.22);\n   damagePlayer(dmg);\n   B.timer=0;\n  }\n  if(B.timer<=0){B.state='recover';B.timer=0.6;}\n }else if(B.state==='recover'){\n  B.timer-=dt;B.intent=0;\n  if(B.timer<=0){B.state='idle';B.cd=0.5+Math.random()*0.6;}\n }else if(B.state==='stunned'){\n  B.stunT-=dt;\n  if(B.stunT<=0){B.state='idle';B.cd=0.3;}\n }\n}\n\nfunction updatePlayer(dt){\n P.stam=Math.min(1,P.stam+dt*0.25);\n if(P.inv>0)P.inv-=dt;\n if(P.rollT>0){P.rollT-=dt;P.x+=P.facing*420*dt;}\n else{\n  if(keys.left){P.x-=220*dt;P.facing=-1;}\n  if(keys.right){P.x+=220*dt;P.facing=1;}\n }\n P.x=Math.max(30,Math.min(W-30,P.x));\n if(dist()!==0)P.facing=P.x<B.x?1:-1;\n if(P.rollCd>0)P.rollCd-=dt;\n if(P.atkCd>0)P.atkCd-=dt;\n if(P.itemCd>0)P.itemCd-=dt;\n if(keys.guard&&P.rollCd<=0&&P.stam>=0.2&&P.rollT<=0){\n  P.stam-=0.2;P.rollT=0.35;P.inv=0.3;P.rollCd=0.5;\n }\n if(keys.fire&&P.atkCd<=0&&P.stam>=0.15){\n  P.stam-=0.15;P.atkCd=0.45;\n  if(dist()<100&&B.stunT<=0){damageBoss(0.06);}\n }\n if(keys.useItem&&P.itemCd<=0&&items>0){\n  P.itemCd=0.6;items--;P.hp=Math.min(1,P.hp+0.4);\n }\n}\n\nlet items=3;\n\nfunction loop(dt){\n if(phase!=='playing')return;\n updatePlayer(dt);\n updateBoss(dt);\n}\n\nfunction draw(){\n ctx.clearRect(0,0,W,H);\n ctx.fillStyle='#151515';ctx.fillRect(0,0,W,H);\n ctx.fillStyle='#333';ctx.fillRect(0,420,W,4);\n if(phase==='playing'||phase==='cleared'||phase==='over'){\n  let bc=B.state==='telegraph'?(B.color==='blue'?(Math.floor(Date.now()/100)%2?'#3af':'#08f'):(Math.floor(Date.now()/100)%2?'#f33':'#a00')):(B.stunT>0?'#ff0':'#833');\n  ctx.fillStyle=bc;\n  ctx.fillRect(B.x-30,340,60,80);\n  ctx.font='40px serif';ctx.fillText('👹',B.x-20,410);\n  if(playerSkin){\n   ctx.drawImage(playerSkin,P.x-30,340,60,80);\n  }else{\n   ctx.fillStyle=P.inv>0?'rgba(80,180,255,.6)':'#4af';\n   ctx.fillRect(P.x-15,360,30,60);\n  }\n  ctx.fillStyle='#fff';ctx.font='14px sans-serif';\n  ctx.fillText('보스 HP',20,20);\n  ctx.fillStyle='#333';ctx.fillRect(20,25,300,14);\n  ctx.fillStyle='#c33';ctx.fillRect(20,25,300*B.hp,14);\n  ctx.fillText('내 체력',20,55);\n  ctx.fillStyle='#333';ctx.fillRect(20,60,200,12);\n  ctx.fillStyle='#4c4';ctx.fillRect(20,60,200*Math.max(0,P.hp),12);\n  ctx.fillText('스태미나',20,85);\n  ctx.fillStyle='#333';ctx.fillRect(20,90,200,10);\n  ctx.fillStyle='#ff0';ctx.fillRect(20,90,200*P.stam,10);\n  ctx.fillText('물약x'+items,20,115);\n  ctx.fillText('생명 '+lives+'/5',20,135);\n  ctx.fillText('점수 '+score,20,155);\n  if(botOn){ctx.fillStyle='#0f0';ctx.fillText('AI PLAYING',W/2-40,20);}\n }\n}\n\nlet last=performance.now();\nfunction tick(now){\n const dt=Math.min(0.05,(now-last)/1000);last=now;\n loop(dt);\n draw();\n requestAnimationFrame(tick);\n}\nrequestAnimationFrame(tick);\n\nfunction keyDown(e){\n if(e.code==='ArrowLeft'||e.code==='KeyA')keys.left=true;\n if(e.code==='ArrowRight'||e.code==='KeyD')keys.right=true;\n if(e.code==='Space')keys.jump=true;\n if(e.code==='KeyX')keys.fire=true;\n if(e.code==='ShiftLeft'||e.code==='KeyC')keys.guard=true;\n if(e.code==='KeyE')keys.useItem=true;\n}\nfunction keyUp(e){\n if(e.code==='ArrowLeft'||e.code==='KeyA')keys.left=false;\n if(e.code==='ArrowRight'||e.code==='KeyD')keys.right=false;\n if(e.code==='Space')keys.jump=false;\n if(e.code==='KeyX')keys.fire=false;\n if(e.code==='ShiftLeft'||e.code==='KeyC')keys.guard=false;\n if(e.code==='KeyE')keys.useItem=false;\n}\naddEventListener('keydown',keyDown);addEventListener('keyup',keyUp);\n\nconst ui=document.getElementById('ui');\nfunction mkBtn(id,label,x,y,w){\n const b=document.createElement('div');b.className='btn';b.id=id;b.textContent=label;\n b.style.left=x;b.style.top=y;b.style.width=w+'px';b.style.height=w+'px';b.style.display='none';\n ui.appendChild(b);return b;\n}\nconst bLeft=mkBtn('bl','◀','20px','calc(100% - 80px)',50);\nconst bRight=mkBtn('br','▶','90px','calc(100% - 80px)',50);\nconst bGuard=mkBtn('bg','구르기','calc(100% - 260px)','calc(100% - 140px)',60);\nconst bJump=mkBtn('bj','패링','calc(100% - 190px)','calc(100% - 60px)',60);\nconst bFire=mkBtn('bf','공격','calc(100% - 120px)','calc(100% - 140px)',60);\nconst bItem=mkBtn('bi','물약','calc(100% - 60px)','calc(100% - 60px)',60);\nfunction bind(el,k){\n el.addEventListener('touchstart',ev=>{ev.preventDefault();keys[k]=true;});\n el.addEventListener('touchend',ev=>{ev.preventDefault();keys[k]=false;});\n el.addEventListener('mousedown',ev=>{keys[k]=true;});\n el.addEventListener('mouseup',ev=>{keys[k]=false;});\n}\nbind(bLeft,'left');bind(bRight,'right');bind(bGuard,'guard');bind(bJump,'jump');bind(bFire,'fire');bind(bItem,'useItem');\nfunction showTouch(v){[bLeft,bRight,bGuard,bJump,bFire,bItem].forEach(b=>b.style.display=v?'flex':'none');}\nshowTouch(false);\n\nconst scr=document.getElementById('scr');\nfunction renderScreen(){\n if(phase==='playing'){scr.style.display='none';showTouch(true);return;}\n showTouch(false);\n if(phase==='title'){\n  scr.style.display='flex';scr.setAttribute('data-vibrex-role','');\n  scr.innerHTML='<h1>고요한 검투사</h1><p>사이드뷰 1대1 보스전. 빨간 예고=회피, 파란 예고=점프로 패링!</p><p style=\"font-size:13px;max-width:340px\">이동:←→ | 구르기(무적):Guard | 패링:Jump | 공격:Fire | 물약:UseItem</p><button id=\"vibrex-start\" class=\"vb\" data-vibrex-role=\"start\">시작</button>';\n  document.getElementById('vibrex-start').onclick=()=>{fullReset();renderScreen();};\n }else if(phase==='over'){\n  scr.style.display='flex';scr.setAttribute('data-vibrex-role','over');\n  scr.innerHTML='<h1>패배</h1><p>최종 점수: '+score+'</p><button class=\"vb\" data-vibrex-role=\"restart\">다시하기</button>';\n  scr.querySelector('button').onclick=()=>{fullReset();renderScreen();};\n }else i