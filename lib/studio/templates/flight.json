rowLeft','left',dx<-dead&&Math.abs(dx)>=Math.abs(dy)*0.5);set('ArrowRight','right',dx>dead&&Math.abs(dx)>=Math.abs(dy)*0.5);set('ArrowUp','up',dy<-dead&&Math.abs(dy)>=Math.abs(dx)*0.5);set('ArrowDown','down',dy>dead&&Math.abs(dy)>=Math.abs(dx)*0.5)}function release(){['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].forEach(function(k,i){set(k,['left','right','up','down'][i],false)});knob.style.transform='';stick.style.display='none';hint.style.display='flex';pid=null}zone.addEventListener('pointerdown',function(e){if(pid!==null)return;pid=e.pointerId;ox=e.clientX;oy=e.clientY;stick.style.left=ox+'px';stick.style.top=oy+'px';stick.style.display='block';hint.style.display='none';try{zone.setPointerCapture(e.pointerId)}catch(e1){}e.preventDefault()});zone.addEventListener('pointermove',function(e){if(e.pointerId!==pid)return;apply(e.clientX-ox,e.clientY-oy);e.preventDefault()});zone.addEventListener('pointerup',function(e){if(e.pointerId===pid)release()});zone.addEventListener('pointercancel',function(e){if(e.pointerId===pid)release()});root.querySelectorAll('.vbx-btn').forEach(function(b){var k=b.getAttribute('data-k'),n=b.getAttribute('data-n');b.addEventListener('pointerdown',function(e){b.classList.add('on');set(k,n,true);try{b.setPointerCapture(e.pointerId)}catch(e1){}e.preventDefault()});var up=function(){b.classList.remove('on');set(k,n,false)};b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up)});hideLegacy();setTimeout(hideLegacy,1500);setTimeout(hideLegacy,4000)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(build,50)});else setTimeout(build,50);})();</script></body></html>"
