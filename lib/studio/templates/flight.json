button{font-size:18px;padding:10px 24px;border-radius:8px;border:none;background:#4CAF50;color:#fff;margin-top:10px}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d'),ui=document.getElementById('ui');\nlet W=800,H=450,scale=1;\nfunction resize(){\n  const r=800/450, ww=window.innerWidth, wh=window.innerHeight;\n  if(ww/wh>r){H=wh;W=H*r}else{W=ww;H=W/r}\n  cv.width=W;cv.height=H;\n}\nwindow.addEventListener('resize',resize);resize();\n\nlet phase='title',score=0,fuel=1,speed=0.5,alt=0.5,pitch=0,throttle=0.5,gear=1,vx=0,vy=0,px=0.1,progress=0;\nlet rings=[],terrain=[],runway={x:0,w:0},camX=0,elapsed=0;\nlet playerSkin=window.VIBREX_AVATAR||null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck()});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\n\nconst WORLD_LEN=6000;\nfunction genTerrain(){\n  terrain=[];\n  let h=60;\n  for(let x=0;x<=WORLD_LEN;x+=40){\n    h+=(Math.random()-0.5)*30;\n    h=Math.max(30,Math.min(220,h));\n    terrain.push({x,h});\n  }\n  runway={x:WORLD_LEN-500,w:400};\n  for(let t of terrain){ if(t.x>=runway.x-40 && t.x<=runway.x+runway.w+40) t.h=40; }\n}\nfunction genRings(){\n  rings=[];\n  for(let i=0;i<5;i++){\n    let x=500+i*1000+Math.random()*200;\n    let y=100+Math.random()*180;\n    rings.push({x,y,passed:false});\n  }\n}\nfunction terrainHeightAt(x){\n  for(let i=0;i<terrain.length-1;i++){\n    if(x>=terrain[i].x && x<=terrain[i+1].x){\n      let t=(x-terrain[i].x)/(terrain[i+1].x-terrain[i].x);\n      return terrain[i].h+(terrain[i+1].h-terrain[i].h)*t;\n    }\n  }\n  return 100;\n}\n\nlet keys={left:false,right:false,up:false,down:false,jump:false,fire:false,guard:false,useItem:false};\nfunction keyDown(e){\n  if(e.code==='ArrowUp'){keys.up=true}\n  if(e.code==='ArrowDown'){keys.down=true}\n  if(e.code==='ArrowLeft'){keys.left=true}\n  if(e.code==='ArrowRight'){keys.right=true}\n  if(e.code==='Space'){keys.useItem=true;toggleGear()}\n  if(e.code==='KeyX'){keys.useItem=true;toggleGear()}\n}\nfunction keyUp(e){\n  if(e.code==='ArrowUp'){keys.up=false}\n  if(e.code==='ArrowDown'){keys.down=false}\n  if(e.code==='ArrowLeft'){keys.left=false}\n  if(e.code==='ArrowRight'){keys.right=false}\n}\nwindow.addEventListener('keydown',keyDown);\nwindow.addEventListener('keyup',keyUp);\nlet gearToggleLock=false;\nfunction toggleGear(){\n  if(gearToggleLock)return;\n  gearToggleLock=true;\n  gear=gear?0:1;\n  setTimeout(()=>gearToggleLock=false,300);\n}\n\nfunction resetGame(){\n  score=0;fuel=1;speed=0.5;alt=0.5;pitch=0;throttle=0.5;gear=1;vx=0;vy=0;px=0.1;progress=0;elapsed=0;\n  genTerrain();genRings();\n  camX=0;\n}\n\nfunction startGame(){\n  resetGame();\n  phase='playing';\n  ui.innerHTML='';\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){\n  startGame();\n  if(window.AJ)AJ.restart();\n}\n\nfunction showTitle(){\n  phase='title';\n  ui.innerHTML=`<div class=\"panel\" data-vibrex-role=\"title\">\n  <h2>산악 비행 착륙</h2>\n  <p>산과 구름을 피해 링 5개를 통과하고 활주로에 착륙하세요</p>\n  <p style=\"font-size:13px;text-align:left\">\n  ↑:기수 올리기 ↓:기수 내리기<br>\n  ←:스로틀 감소 →:스로틀 증가<br>\n  Space/X: 착륙기어 토글</p>\n  <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n  </div>`;\n  document.getElementById('vibrex-start').onclick=startGame;\n}\nfunction showOver(msg){\n  phase='over';\n  ui.innerHTML=`<div class=\"panel\" data-vibrex-role=\"over\">\n  <h2>게임 오버</h2><p>${msg}</p><p>점수: ${Math.floor(score)}</p>\n  <button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>`;\n  document.getElementById('rb').onclick=restartGame;\n  if(window.AJ)AJ.over(Math.floor(score));\n}\nfunction showClear(){\n  phase='cleared';\n  ui.innerHTML=`<div class=\"panel\" data-vibrex-role=\"clear\">\n  <h2>착륙 성공! 클리어</h2><p>최종 점수: ${Math.floor(score)}</p>\n  <button data-vibrex-role=\"restart\" id=\"rb2\">다시하기</button></div>`;\n  document.getElementById('rb2').onclick=restartGame;\n  if(window.AJ)AJ.clear(Math.floor(score));\n}\nshowTitle();\n\nfunction update(dt){\n  if(phase!=='playing')return;\n  elapsed+=dt;\n  if(keys.left)throttle=Math.max(0,throttle-0.6*dt);\n  if(keys.right)throttle=Math.min(1,throttle+0.6*dt);\n  if(keys.up)pitch=Math.max(-1,pitch-1.2*dt);\n  else if(keys.down)pitch=Math.min(1,pitch+1.2*dt);\n  else pitch*=(1-1.5*dt);\n\n  fuel-=throttle*0.03*dt;\n  fuel=Math.max(0,fuel);\n  let targetSpeed=0.2+throttle*0.8;\n  speed+=(targetSpeed-speed)*0.5*dt;\n  let liftFactor=speed*(1-Math.abs(pitch)*0.3);\n  vy=-pitch*speed*1.5+(0.15-liftFactor*0.3);\n  if(gear)vy+=0.02;\n  alt+=-vy*dt*0.5;\n  alt=Math.max(0,Math.min(1,alt));\n  vx=speed;\n  px+=vx*dt*0.05;\n  camX=px*WORLD_LEN-100;\n  if(camX<0)camX=0;\n\n  let worldX=px*WORLD_LEN;\n  let groundH=terrainHeightAt(worldX);\n  let planeScreenY=H-(alt*(H-60))-30;\n  let groundScreenY=H-groundH;\n\n  for(let r of rings){\n    if(!r.passed){\n      let dx=Math.abs(worldX-r.x);\n      let planeY=H-40-alt*(H-100);\n      let dy=Math.abs(planeY-r.y);\n      if(dx<25 && dy<50){\n        r.passed=true;\n        progress++;\n        score+=100;\n        if(window.AJ)AJ.score(Math.floor(score));\n      }\n    }\n  }\n\n  // runway landing check\n  if(worldX>=runway.x-50 && worldX<=runway.x+runway.w+50){\n    let groundY=H-groundH;\n    let planeGroundDist=groundScreenY-planeScreenY;\n    if(alt<0.15){\n      if(gear && speed<0.45 && speed>0.15 && Math.abs(pitch)<0.3 && progress>=5){\n        score+=500;\n        if(window.AJ)AJ.score(Math.floor(score));\n        showClear();\n        return;\n      } else if(alt<0.05){\n        showOver('착륙 실패');\n        return;\n      }\n    }\n  } else {\n    if(alt<=0.02 || planeScreenY>=groundScreenY-8){\n      showOver('지면 충돌');\n      return;\n    }\n  }\n\n  if(speed<0.12){\n    showOver('실속');\n    return;\n  }\n  if(fuel<=0){\n    showOver('연료 소진');\n    return;\n  }\n  if(worldX>WORLD_LEN+50){\n    showOver('활주로를 지나쳤습니다');\n    return;\n  }\n  score+=dt*2;\n}\n\nfunction draw(){\n  ctx.clearRect(0,0,W,H);\n  let sx=W/800;\n  ctx.save();\n  ctx.scale(sx,sx);\n  ctx.fillStyle='#87CEEB';\n  ctx.fillRect(0,0,800,450);\n\n  // clouds\n  ctx.fillStyle='rgba(255,255,255,0.8)';\n  for(let i=0;i<8;i++){\n    let cx=((i*700-camX*0.5)%900+900)%900-50;\n    ctx.beginPath();\n    ctx.ellipse(cx,80+((i*53)%100),40,20,0,0,7);\n    ctx.fill();\n  }\n\n  // terrain\n  ctx.fillStyle='#654321';\n  ctx.beginPath();\n  ctx.moveTo(0,450);\n  for(let t of terrain){\n    let sx2=t.x-camX;\n    if(sx2<-50||sx2>850)continue;\n    ctx.lineTo(sx2,450-t.h);\n  }\n  ctx.lineTo(850,450);\n  ctx.closePath();\n  ctx.fill();\n\n  // runway\n  ctx.fillStyle='#555';\n  ctx.fillRect(runway.x-camX,450-40,runway.w,40);\n  ctx.fillStyle='#fff';\n  for(let i=0;i<runway.w;i+=40){\n    ctx.fillRect(runway.x-camX+i,450-22,20,4);\n  }\n\n  // rings\n  for(let r of rings){\n    let sx2=r.x-camX;\n    if(sx2<-50||sx2>850)continue;\n    ctx.strokeStyle=r.passed?'#0f0':'#ff0';\n    ctx.lineWidth=6;\n    ctx.beginPath();\n    ctx.arc(sx2,r.y,30,0,7);\n    ctx.stroke();\n  }\n\n  // plane\n  let planeX=100;\n  let planeY=450-40-alt*(450-100);\n  ctx.save();\n  ctx.translate(planeX,planeY);\n  ctx.rotate(pitch*0.8);\n  if(playerSkin){\n    let sz=50;\n    ctx.drawImage(playerSkin,-sz/2,-sz/2,sz,sz);\n  } else {\n    ctx.fillStyle='#d33';\n    ctx.beginPath();\n    ctx.moveTo(-20,0);ctx.lineTo(20,-6);ctx.lineTo(20,6);\n    ctx.closePath();ctx.fill();\n    ctx.fillStyle='#888';\n    ctx.fillRect(-4,-2,8,20);\n    if(gear){\n      ctx.strokeStyle='#333';\n      ctx.beginPath();ctx.moveTo(-10,6);ctx.lineTo(-10,14);ctx.moveTo(10,6);ctx.lineTo(10,14);ctx.stroke();\n    }\n  }\n  ctx.restore();\n  ctx.restore();\n\n  // HUD\n  ctx.save();\n  ctx.fillStyle='#fff';\n  ctx.font='16px sans-serif';\n  ctx.fillText('속도: '+Math.floor(speed*100),10,20*sx===0?20:20);\n  ctx.restore();\n\n  ctx.save();\n  ctx.scale(1,1);\n  ctx.fillStyle='#fff';\n  ctx.font=(14*sx)+'px sans-serif';\n  ctx.fillText('속도 '+Math.floor(speed*200)+'kt',10,20);\n  ctx.fillText('고도 '+Math.floor(alt*100)+'%',10,40);\n  ctx.fillText('연료 '+Math.floor(fuel*100)+'%',10,60);\n  ctx.fillText('스로틀 '+Math.floor(throttle*100)+'%',10,80);\n  ctx.fillText('기어 '+(gear?'DOWN':'UP'),10,100);\n  ctx.fillText('링 '+progress+'/5',10,120);\n  ctx.fillText('점수 '+Math.floor(score),10,140);\n  if(botRunning){\n    ctx.fillStyle='#f00';\n    ctx.fillText('AI PLAYING',W-120,20);\n  }\n  ctx.restore();\n}\n\nlet last=performance.now();\nfunction loop(t){\n  let dt=Math.min(0.05,(t-last)/1000);\n  last=t;\n  update(dt);\n  draw();\n  if(botRunning)botStep();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nwindow.VIBREX_GAME={\n  title:'산악 비행 착륙',\n  genre:'flight sim',\n  goal:'링 5개 통과 후 활주로 착륙',\n  clearCondition:'5링 통과 + 저속/저각 착륙',\n  controls:[\n    {input:'ArrowUp',action:'기수 올리기'},\n    {input:'ArrowDown',action:'기수 내리기'},\n    {input:'ArrowLeft',action:'스로틀 감소'},\n    {input:'ArrowRight',action:'스로틀 증가'},\n    {input:'useItem',action:'착륙기어 토글'}\n  ],\n  phase:()=>phase,\n  progress:()=>Math.min(1,(progress+(phase==='cleared'?1:0))/6),\n  state:()=>{\n    let worldX=px*WORLD_LEN;\n    let nextRing=rings.find(r=>!r.passed);\n    let tdx=0,tdy=0,tdist=1;\n    if(nextRing){\n      tdx=Math.max(-1,Math.min(1,(nextRing.x-worldX)/500));\n      let planeY=450-40-alt*(450-100);\n      tdy=Math.max(-1,Math.min(1,(nextRing.y-planeY)/200));\n      tdist=Math.min(1,Math.abs(nextRing.x-worldX)/1000);\n    }\n    let groundH=terrainHeightAt(worldX);\n    let planeScreenY=450-40-alt*(450-100);\n    let groundDist=Math.max(0,Math.min(1,((450-groundH)-planeScreenY)/300));\n    return {\n      score:Math.floor(score),\n      altitude:alt,\n      speed:speed,\n      pitch:pitch,\n      fuel:fuel,\n      targetDX:tdx,targetDY:tdy,targetDist:tdist,\n      dangerDist:groundDist,\n      groundDist:groundDist,\n      onGround:alt<0.03?1:0,\n      selfVX:Math.min(1,vx*2),selfVY:Math.max(-1,Math.min(1,vy*2)),\n      facing:1,\n      progress:progress/5,\n      gearDown:gear,\n      fireReady:1\n    };\n  },\n  start:()=>{ if(phase==='title')startGame(); },\n  restart:()=>{ restartGame(); },\n  inputs:{\n    left:on=>keys.left=on,\n    right:on=>keys.right=on,\n    up:on=>keys.up=on,\n    down:on=>keys.down=on,\n    jump:on=>{},\n    fire:on=>{},\n    guard:on=>{},\n    useItem:on=>{ if(on)toggleGear(); }\n  }\n};\n\nlet botRunning=false,botLast=0;\nfunction botStep(){\n  if(phase==='title'){ startGame(); return; }\n  if(phase!=='playing')return;\n  let s=window.VIBREX_GAME.state();\n  keys.up=false;keys.down=false;keys.left=false;keys.right=false;\n  if(s.progress<1){\n    if(s.targetDY<-0.05)keys.up=true;\n    else if(s.targetDY>0.05)keys.down=true;\n    if(s.speed<0.5)keys.right=true;\n    else if(s.speed>0.65)keys.left=true;\n  } else {\n    let worldX=px*WORLD_LEN;\n    if(worldX>runway.x-600){\n      if(!gear)toggleGear();\n      if(s.altitude>0.15)keys.up=false,keys.down=true;\n      else if(s.altitude<0.05)keys.up=true;\n      if(s.speed>0.35)keys.left=true;\n      else if(s.speed<0.25)keys.right=true;\n    } else {\n      if(s.speed<0.5)keys.right=true;\n      else if(s.speed>0.65)keys.left=true;\n      if(s.altitude<0.4)keys.up=true;\n      else if(s.altitude>0.6)keys.down=true;\n    }\n  }\n}\nwindow.vibrexBot={\n  start(){ botRunning=true; },\n  stop(){ botRunning=false; keys.left=false;keys.right=false;keys.up=false;keys.down=false; },\n  setSkill(){}\n};\n\nif(window.VIBREX_AVATAR){ playerSkin=window.VIBREX_AVATAR; window.vibrexAvatarAck&&window.vibrexAvatarAck(); }\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,ca