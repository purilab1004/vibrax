></head><body>\n<div id=\"hud\"></div>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nconst CW=19,CH=15;\nconst M=[\n\"1111111111111111111\",\n\"1000000010000000001\",\n\"1011110110111101101\",\n\"1000000000000000001\",\n\"1011010111010110101\",\n\"1000010001000010001\",\n\"1111010101010101111\",\n\"0000010101010100000\",\n\"1111010111010101111\",\n\"1000000000000000001\",\n\"1011110110111101101\",\n\"1000010000010000001\",\n\"1101011111110101011\",\n\"1000000000000000001\",\n\"1111111111111111111\"];\nlet grid=[],dots=0,totalDots=0;\nfunction initGrid(){\ngrid=[];dots=0;totalDots=0;\nfor(let y=0;y<CH;y++){grid.push([]);for(let x=0;x<CW;x++){\nlet w=M[y][x]=='1';\nlet d=!w;\ngrid[y].push({wall:w,dot:d,power:false});\nif(d){dots++;totalDots++;}\n}}\n[[1,1],[17,1],[1,13],[17,13]].forEach(p=>{grid[p[1]][p[0]].power=true;});\n}\nlet cvs=document.getElementById('c'),ctx=cvs.getContext('2d');\nlet TS=24;\nfunction resize(){\nlet w=window.innerWidth,h=window.innerHeight;\nTS=Math.floor(Math.min(w/CW,h/CH));\ncvs.width=TS*CW;cvs.height=TS*CH;\n}\nwindow.addEventListener('resize',resize);\nlet player,ghosts,lives,score,powered,poweredLeft,phase='title',inputDir={x:0,y:0},nextDir={x:0,y:0};\nfunction cellFree(x,y){\nif(x<0||x>=CW||y<0||y>=CH)return false;\nreturn !grid[y][x].wall;\n}\nfunction resetLevel(){\ninitGrid();\nplayer={x:9,y:7,px:9,py:7,moveT:0};\nghosts=[\n{x:9,y:6,type:'chase',px:9,py:6,moveT:0,dir:{x:0,y:-1},scared:false},\n{x:8,y:6,type:'ambush',px:8,py:6,moveT:0,dir:{x:0,y:-1},scared:false},\n{x:10,y:6,type:'random',px:10,py:6,moveT:0,dir:{x:0,y:-1},scared:false},\n{x:9,y:7,type:'random2',px:9,py:7,moveT:0,dir:{x:0,y:-1},scared:false}\n];\npowered=false;poweredLeft=0;\n}\nfunction newGame(){\nlives=3;score=0;resetLevel();phase='playing';\nif(window.AJ)AJ.start();\nupdateScore(0);\n}\nfunction updateScore(n){score+=n;if(window.AJ)AJ.score(score);}\nconst STEP=0.13;\nfunction tryMove(ent,dir){\nlet nx=ent.x+dir.x,ny=ent.y+dir.y;\nif(nx<0)nx=CW-1;if(nx>=CW)nx=0;\nif(cellFree(nx,ny)){ent.px=ent.x;ent.py=ent.y;ent.x=nx;ent.y=ny;ent.moveT=0;return true;}\nreturn false;\n}\nfunction bfsPath(sx,sy,tx,ty){\nlet q=[[sx,sy]],visited=Array.from({length:CH},()=>Array(CW).fill(false));\nvisited[sy][sx]=true;let prev={};\nwhile(q.length){\nlet[cx,cy]=q.shift();\nif(cx==tx&&cy==ty){\nlet path=[];let k=cx+','+cy;\nwhile(prev[k]){path.unshift(prev[k].dir);k=prev[k].pk;}\nreturn path;\n}\nlet dirs=[[1,0],[-1,0],[0,1],[0,-1]];\nfor(let d of dirs){\nlet nx=cx+d[0],ny=cy+d[1];\nif(nx<0)nx=CW-1;if(nx>=CW)nx=0;\nif(ny<0||ny>=CH)continue;\nif(!visited[ny][nx]&&cellFree(nx,ny)){\nvisited[ny][nx]=true;\nprev[nx+','+ny]={pk:cx+','+cy,dir:{x:d[0],y:d[1]}};\nq.push([nx,ny]);\n}\n}\n}\nreturn null;\n}\nfunction ghostMove(g,dt){\ng.moveT+=dt;\nif(g.moveT<STEP)return;\nlet dirs=[{x:1,y:0},{x:-1,y:0},{x:0,y:1},{x:0,y:-1}];\nlet valid=dirs.filter(d=>cellFree((g.x+d.x+CW)%CW,g.y+d.y)&&!(d.x==-g.dir.x&&d.y==-g.dir.y));\nif(valid.length==0)valid=dirs.filter(d=>cellFree((g.x+d.x+CW)%CW,g.y+d.y));\nlet choice;\nif(g.scared){\nchoice=valid[Math.floor(Math.random()*valid.length)];\n}else if(g.type=='chase'){\nlet path=bfsPath(g.x,g.y,player.x,player.y);\nchoice=(path&&path.length)?path[0]:valid[Math.floor(Math.random()*valid.length)];\n}else if(g.type=='ambush'){\nlet tx=player.x+player.dir?.x*3||player.x,ty=player.y;\ntx=Math.max(0,Math.min(CW-1,tx));\nlet path=bfsPath(g.x,g.y,tx,ty);\nchoice=(path&&path.length)?path[0]:valid[Math.floor(Math.random()*valid.length)];\n}else{\nif(Math.random()<0.5){\nlet path=bfsPath(g.x,g.y,player.x,player.y);\nchoice=(path&&path.length)?path[0]:valid[Math.floor(Math.random()*valid.length)];\n}else choice=valid[Math.floor(Math.random()*valid.length)];\n}\nif(choice){g.dir=choice;tryMove(g,choice);}\ng.moveT=0;\n}\nfunction eatDot(x,y){\nlet c=grid[y][x];\nif(c.dot){c.dot=false;dots--;updateScore(10);}\nif(c.power){c.power=false;powered=true;poweredLeft=10;ghosts.forEach(g=>g.scared=true);updateScore(50);}\n}\nlet lastT=0;\nfunction loop(t){\nlet dt=(t-lastT)/1000;lastT=t;\nif(dt>0.1)dt=0.1;\nif(phase=='playing'){\nupdate(dt);\n}\ndraw();\nrequestAnimationFrame(loop);\n}\nfunction update(dt){\nplayer.moveT+=dt;\nif(cellFree((player.x+nextDir.x+CW)%CW,player.y+nextDir.y)&&(nextDir.x||nextDir.y)){\nif(player.moveT>=STEP){inputDir=nextDir;}\n}\nif(player.moveT>=STEP&&(inputDir.x||inputDir.y)){\ntryMove(player,inputDir);\nplayer.dir=inputDir;\neatDot(player.x,player.y);\n}\nif(powered){\npoweredLeft-=dt;\nif(poweredLeft<=0){powered=false;ghosts.forEach(g=>g.scared=false);}\n}\nghosts.forEach(g=>ghostMove(g,dt));\nghosts.forEach(g=>{\nif(g.x==player.x&&g.y==player.y){\nif(g.scared){\nupdateScore(200);\ng.x=9;g.y=7;g.scared=false;\n}else{\nlives--;\nif(lives<=0){\nphase='over';\nif(window.AJ)AJ.over(score);\n}else{\nplayer.x=9;player.y=7;player.moveT=0;\nghosts.forEach((gg,i)=>{gg.x=9+((i%2)?1:-1);gg.y=6+Math.floor(i/2);});\n}\n}\n}\n});\nif(dots<=0){\nphase='cleared';\nif(window.AJ)AJ.clear(score);\n}\n}\nfunction drawCell(x,y){\nlet c=grid[y][x];\nlet px=x*TS,py=y*TS;\nif(c.wall){ctx.fillStyle='#1122aa';ctx.fillRect(px,py,TS,TS);}\nelse{\nif(c.dot){ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(px+TS/2,py+TS/2,TS*0.08,0,7);ctx.fill();}\nif(c.power){ctx.fillStyle='#ff0';ctx.beginPath();ctx.arc(px+TS/2,py+TS/2,TS*0.22,0,7);ctx.fill();}\n}\n}\nfunction drawPlayer(){\nlet px=player.x*TS+TS/2,py=player.y*TS+TS/2;\nif(playerSkin){\nlet s=TS*1.1;\nctx.drawImage(playerSkin,px-s/2,py-s/2,s,s);\n}else{\nctx.fillStyle='#ff0';\nctx.beginPath();ctx.arc(px,py,TS*0.4,0.25*Math.PI,1.75*Math.PI);ctx.lineTo(px,py);ctx.fill();\n}\n}\nfunction drawGhost(g){\nlet px=g.x*TS+TS/2,py=g.y*TS+TS/2;\nctx.fillStyle=g.scared?'#33f':({chase:'#f00',ambush:'#f0f',random:'#0ff',random2:'#fa0'}[g.type]);\nctx.beginPath();ctx.arc(px,py,TS*0.4,Math.PI,0);\nctx.lineTo(px+TS*0.4,py+TS*0.4);\nctx.lineTo(px-TS*0.4,py+TS*0.4);\nctx.fill();\n}\nfunction draw(){\nctx.clearRect(0,0,cvs.width,cvs.height);\nfor(let y=0;y<CH;y++)for(let x=0;x<CW;x++)drawCell(x,y);\nif(phase!='title'){\ndrawPlayer();\nghosts.forEach(drawGhost);\n}\ndocument.getElementById('hud').innerText=(phase=='playing'||phase=='over'||phase=='cleared')?`점수:${score} 생명:${lives} 남은점:${dots}`:'';\nif(botActive){\nctx.fillStyle='#0f0';ctx.font='16px sans-serif';ctx.fillText('AI PLAYING',10,20);\n}\nif(phase=='title')renderTitle();\nif(phase=='over')renderOver();\nif(phase=='cleared')renderClear();\n}\nfunction renderTitle(){\nlet ui=document.getElementById('ui');\nui.style.display='flex';\nui.innerHTML=`<div><h1>미로 먹기</h1><p>19x15 미로의 모든 점을 먹으면 클리어. 유령 4마리를 피하고, 파워알약을 먹으면 10초간 유령을 먹을 수 있다.</p>\n<p>조작: 방향키/터치 조이스틱 4방향</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;\ndocument.getElementById('vibrex-start').onclick=()=>{newGame();ui.style.display='none';};\n}\nfunction renderOver(){\nlet ui=document.getElementById('ui');\nui.style.display='flex';\nui.innerHTML=`<div><h2>게임 오버</h2><p>점수: ${score}</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>`;\ndocument.getElementById('rb').onclick=()=>{newGame();ui.style.display='none';if(window.AJ)AJ.restart();};\n}\nfunction renderClear(){\nlet ui=document.getElementById('ui');\nui.style.display='flex';\nui.innerHTML=`<div data-vibrex-role=\"clear\"><h2>클리어!</h2><p>최종 점수: ${score}</p><button data-vibrex-role=\"restart\" id=\"rb2\">다시하기</button></div>`;\ndocument.getElementById('rb2').onclick=()=>{newGame();ui.style.display='none';if(window.AJ)AJ.restart();};\n}\ndocument.getElementById('ui').style.display='flex';\nresize();resetLevel();\nrequestAnimationFrame(t=>{lastT=t;requestAnimationFrame(loop);});\nrenderTitle();\nfunction setDir(x,y){nextDir={x,y};}\nwindow.addEventListener('keydown',e=>{\nif(e.key=='ArrowLeft')setDir(-1,0);\nif(e.key=='ArrowRight')setDir(1,0);\nif(e.key=='ArrowUp')setDir(0,-1);\nif(e.key=='ArrowDown')setDir(0,1);\n});\nlet playerSkin=null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\nfunction norm(v,max){return Math.max(-1,Math.min(1,v/max));}\nwindow.VIBREX_GAME={\ntitle:'미로 먹기',genre:'미로/팩맨류',\ngoal:'미로의 모든 점을 먹기',\nclearCondition:'모든 점을 먹으면 클리어, 생명 0이면 게임오버',\ncontrols:[\n{input:'ArrowLeft',action:'왼쪽 이동'},\n{input:'ArrowRight',action:'오른쪽 이동'},\n{input:'ArrowUp',action:'위 이동'},\n{input:'ArrowDown',action:'아래 이동'}\n],\nphase:()=>phase=='title'?'title':phase=='over'?'over':phase=='cleared'?'cleared':'playing',\nprogress:()=>totalDots?1-dots/totalDots:0,\nstate:()=>{\nlet s={score,lives,dotsLeft:dots,progress:totalDots?1-dots/totalDots:0,powered:powered?1:0,poweredLeft:Math.max(0,poweredLeft)/10};\ns.selfX=player.x/CW;s.selfY=player.y/CH;\nlet nearestG=null,nd=1e9;\nghosts.forEach(g=>{let d=Math.hypot(g.x-player.x,g.y-player.y);if(d<nd){nd=d;nearestG=g;}});\nif(nearestG){\ns.dangerDX=norm(nearestG.x-player.x,CW);s.dangerDY=norm(nearestG.y-player.y,CH);\ns.dangerDist=Math.min(1,nd/Math.hypot(CW,CH));\n}\ns.dangerCount=ghosts.length;\nlet nearestD=null,ndd=1e9;\nfor(let y=0;y<CH;y++)for(let x=0;x<CW;x++){\nif(grid[y][x].dot||grid[y][x].power){\nlet d=Math.hypot(x-player.x,y-player.y);\nif(d<ndd){ndd=d;nearestD={x,y};}\n}}\nif(nearestD){\ns.targetDX=norm(nearestD.x-player.x,CW);s.targetDY=norm(nearestD.y-player.y,CH);\ns.targetDist=Math.min(1,ndd/Math.hypot(CW,CH));\n}\nreturn s;\n},\nstart(){newGame();document.getElementById('ui').style.display='none';},\nrestart(){newGame();document.getElementById('ui').style.display='none';if(window.AJ)AJ.restart();},\ninputs:{\nleft(on){if(on)setDir(-1,0);},\nright(on){if(on)setDir(1,0);},\nup(on){if(on)setDir(0,-1);},\ndown(on){if(on)setDir(0,1);}\n}\n};\nlet botActive=false,botTimer=null;\nwindow.vibrexBot={\nstart(){\nbotActive=true;\nif(phase=='title'){window.VIBREX_GAME.start();}\nif(botTimer)clearInterval(botTimer);\nbotTimer=setInterval(()=>{\nif(phase=='title'){window.VIBREX_GAME.start();return;}\nif(phase!='playing')return;\nlet s=window.VIBREX_GAME.state();\nlet danger=s.dangerDist<0.15&&!powered;\nlet dx=0,dy=0;\nif(danger){\ndx=-s.dangerDX;dy=-s.dangerDY;\nif(Math.abs(dx)>Math.abs(dy)){dx=dx>0?1:-1;dy=0;}else{dy=dy>0?1:-1;dx=0;}\nif(!cellFree((player.x+dx+CW)%CW,player.y+dy)){dx=0;dy=0;}\n}\nif(!dx&&!dy){\nlet path=null;\nlet nearestD=null,ndd=1e9;\nfor(let y=0;y<CH;y++)for(let x=0;x<CW;x++){\nif(grid[y][x].dot||grid[y][x].power){\nlet d=Math.hypot(x-player.x,y-player.y);\nif(d<ndd){ndd=d;nearestD={x,y};}\n}}\nif(nearestD)path=bfsPath(player.x,player.y,nearestD.x,nearestD.y);\nif(path&&path.length){dx=path[0].x;dy=path[0].y;}\n}\nif(dx||dy)setDir(dx,dy);\n},150);\n},\nstop(){\nbotActive=false;\nif(botTimer)clearInterval(botTimer);\n}\n};\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[key]||0,which:codes[key]||0,bubbles:true,cancelable:true};try{var e=new KeyboardEvent(type,o);Object.defineProperty(e,'keyCode',{get:function(){return o.keyCode}});Object.defineProperty(e,'which',{get:function(){return o.keyCode}});window.dispatchEvent(e);document.dispatchEvent(e);(document.activeElement||document.body).dispatchEvent(e);var c=document.querySelector('canvas');if(c)c.dispatchEvent(e)}catch(e2){}}function inp(name,on){var G=window.VIBREX_GAME;if(G&&G.inputs&&typeof G.inputs[name]==='function'){try{G.inputs[name](on)}catch(e){}}}function set(key,name,on){if(!!held[key]===on)return;held[key]=on;kev(on?'keydown':'keyup',key);inp(name,on)}function hideLegacy(){try{var els=document.querySelectorAll('button,div,span,a');for(var i=0;i<els.length;i++){var el=els[i];var t=(el.textContent||'').trim();var cls=(el.className&&el.className.baseVal!==