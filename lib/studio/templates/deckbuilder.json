brexBot&&typeof window.vibrexBot.stop==='function'){try{window.vibrexBot.stop()}catch(e1){}}fallbackStop()}});})();</script><meta charset=\"utf8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\"><title>덱빌더 배틀</title>\n<style>\nhtml,body{margin:0;padding:0;background:#111;color:#eee;font-family:sans-serif;overflow:hidden;touch-action:none}\n#c{display:block;margin:0 auto;background:#111}\n#ui{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;pointer-events:none}\n.panel{pointer-events:auto;background:#222;padding:20px;border-radius:10px;text-align:center;max-width:90vw}\nbutton{background:#4a4;color:#fff;border:none;padding:10px 20px;border-radius:6px;font-size:16px;margin-top:10px;cursor:pointer}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=Math.min(innerWidth,900);cv.height=Math.min(innerHeight,700);}\nresize();window.addEventListener('resize',resize);\n\nlet playerSkin=null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.()});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\n\nfunction mkCard(type,name,val,cost){return{type,name,val,cost};}\nfunction starterDeck(){\n  let d=[];\n  for(let i=0;i<4;i++)d.push(mkCard('atk','타격',6,1));\n  for(let i=0;i<4;i++)d.push(mkCard('def','방어',5,1));\n  d.push(mkCard('spc','강타',10,2));\n  d.push(mkCard('spc','회복',8,1));\n  return d;\n}\nlet pool=[\n  mkCard('atk','베기',9,1),mkCard('atk','연타',4,1),mkCard('def','철벽',8,2),\n  mkCard('spc','강타',14,2),mkCard('spc','치유',12,2),mkCard('atk','일격',7,1)\n];\n\nlet G={};\nfunction initGame(){\n  G={\n    phase:'title',health:70,maxHealth:70,block:0,energy:3,maxEnergy:3,\n    deck:[],draw:[],hand:[],discard:[],handIdx:0,\n    encounter:0,enemy:null,enemyIntent:0,enemyIntentVal:0,\n    score:0,bestCardValue:0,rewardCards:[],rewardIdx:0,turn:0,\n    log:''\n  };\n  G.deck=starterDeck();\n  shuffle(G.deck);\n  G.draw=G.deck.slice();\n}\nfunction shuffle(a){for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}}\n\nfunction newEnemy(idx){\n  let base=[{hp:30,name:'슬라임'},{hp:45,name:'고블린'},{hp:60,name:'오크'},{hp:100,name:'보스'}][idx];\n  return {hp:base.hp,maxHp:base.hp,name:base.name};\n}\n\nfunction startEncounter(){\n  G.enemy=newEnemy(G.encounter);\n  G.deck=G.deck.concat(G.discard,G.hand,G.draw);\n  G.discard=[];G.hand=[];G.draw=G.deck.slice();shuffle(G.draw);\n  G.block=0;G.energy=G.maxEnergy;G.handIdx=0;\n  setEnemyIntent();\n  drawHand();\n  G.phase='playing';\n}\nfunction setEnemyIntent(){\n  let r=Math.random();\n  if(r<0.5){G.enemyIntent=0;G.enemyIntentVal=6+G.encounter*3;}\n  else if(r<0.75){G.enemyIntent=1;G.enemyIntentVal=5+G.encounter*2;}\n  else{G.enemyIntent=2;G.enemyIntentVal=12+G.encounter*4;}\n}\nfunction drawHand(){\n  while(G.hand.length<5){\n    if(G.draw.length==0){\n      if(G.discard.length==0)break;\n      G.draw=G.discard.slice();G.discard=[];shuffle(G.draw);\n    }\n    G.hand.push(G.draw.pop());\n  }\n  G.handIdx=0;\n}\nfunction playCard(){\n  if(G.phase!='playing')return;\n  if(G.hand.length==0)return;\n  let c=G.hand[G.handIdx];\n  if(c.cost>G.energy)return;\n  G.energy-=c.cost;\n  if(c.type=='atk'){G.enemy.hp-=c.val;if(c.val>G.bestCardValue)G.bestCardValue=c.val;}\n  else if(c.type=='def'){G.block+=c.val;}\n  else if(c.type=='spc'){\n    if(c.name=='강타'){G.enemy.hp-=c.val;if(c.val>G.bestCardValue)G.bestCardValue=c.val;}\n    else if(c.name=='회복'||c.name=='치유'){G.health=Math.min(G.maxHealth,G.health+c.val);}\n  }\n  G.discard.push(c);\n  G.hand.splice(G.handIdx,1);\n  if(G.handIdx>=G.hand.length)G.handIdx=Math.max(0,G.hand.length-1);\n  checkEnemyDead();\n}\nfunction checkEnemyDead(){\n  if(G.enemy.hp<=0){\n    G.score+=100+G.encounter*50;\n    if(window.AJ)AJ.score(G.score);\n    G.encounter++;\n    if(window.AJ)AJ.level(G.encounter);\n    if(G.encounter>=4){\n      G.phase='cleared';\n      if(window.AJ)AJ.clear(G.score);\n    } else {\n      startReward();\n    }\n  }\n}\nfunction startReward(){\n  G.phase='reward';\n  let pick=[];\n  let p=pool.slice();shuffle(p);\n  G.rewardCards=p.slice(0,3);\n}\nfunction chooseReward(i){\n  if(i<0||i>=G.rewardCards.length)return;\n  G.deck.push(G.rewardCards[i]);\n  startEncounter();\n}\nfunction endTurn(){\n  if(G.phase!='playing')return;\n  let dmg=0;\n  if(G.enemyIntent==0)dmg=G.enemyIntentVal;\n  else if(G.enemyIntent==2)dmg=G.enemyIntentVal;\n  if(G.enemyIntent==1){}\n  let net=Math.max(0,dmg-G.block);\n  G.health-=net;\n  G.block=0;\n  G.discard=G.discard.concat(G.hand);\n  G.hand=[];\n  G.energy=G.maxEnergy;\n  if(G.health<=0){\n    G.phase='over';\n    if(window.AJ)AJ.over(G.score);\n    return;\n  }\n  setEnemyIntent();\n  drawHand();\n}\nfunction moveLeft(){if(G.hand.length)G.handIdx=(G.handIdx-1+G.hand.length)%G.hand.length;}\nfunction moveRight(){if(G.hand.length)G.handIdx=(G.handIdx+1)%G.hand.length;}\n\nfunction startGame(){\n  initGame();\n  startEncounter();\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){\n  startGame();\n  if(window.AJ)AJ.restart();\n}\n\nlet keys={};\nwindow.addEventListener('keydown',e=>{\n  keys[e.code]=true;\n  if(G.phase=='title'&&(e.code=='Space'))startGame();\n  if(e.code=='ArrowLeft')handleInput('left');\n  if(e.code=='ArrowRight')handleInput('right');\n  if(e.code=='Space')handleInput('fire');\n  if(e.code=='KeyX')handleInput('guard');\n  if(e.code=='Digit1')handleInput('item1');\n  if(e.code=='Digit2')handleInput('item2');\n  if(e.code=='Digit3')handleInput('item3');\n});\nwindow.addEventListener('keyup',e=>{keys[e.code]=false;});\n\nfunction handleInput(name){\n  if(G.phase=='title'){if(name=='fire')startGame();return;}\n  if(G.phase=='over'||G.phase=='cleared'){if(name=='fire')restartGame();return;}\n  if(G.phase=='reward'){\n    if(name=='item1')chooseReward(0);\n    if(name=='item2')chooseReward(1);\n    if(name=='item3')chooseReward(2);\n    return;\n  }\n  if(G.phase=='playing'){\n    if(name=='left')moveLeft();\n    if(name=='right')moveRight();\n    if(name=='fire')playCard();\n    if(name=='guard')endTurn();\n  }\n}\n\ncv.addEventListener('click',e=>{\n  let r=cv.getBoundingClientRect();\n  let x=e.clientX-r.left,y=e.clientY-r.top;\n  if(G.phase=='title'){startGame();return;}\n  if(G.phase=='over'||G.phase=='cleared'){restartGame();return;}\n  if(G.phase=='reward'){\n    let w=cv.width/3;\n    let idx=Math.floor(x/w);\n    chooseReward(idx);\n    return;\n  }\n  if(G.phase=='playing'&&G.hand.length){\n    let cw=cv.width/G.hand.length;\n    let idx=Math.floor(x/cw);\n    if(idx>=0&&idx<G.hand.length){G.handIdx=idx;playCard();}\n  }\n});\n\nfunction draw(){\n  ctx.clearRect(0,0,cv.width,cv.height);\n  ctx.fillStyle='#111';ctx.fillRect(0,0,cv.width,cv.height);\n  if(G.phase=='title'){drawTitle();requestAnimationFrame(draw);return;}\n  if(G.phase=='over'){drawOver();requestAnimationFrame(draw);return;}\n  if(G.phase=='cleared'){drawCleared();requestAnimationFrame(draw);return;}\n\n  ctx.fillStyle='#eee';ctx.font='16px sans-serif';\n  ctx.fillText('HP:'+Math.max(0,Math.floor(G.health))+'/'+G.maxHealth+' 방어:'+G.block+' 에너지:'+G.energy+'/'+G.maxEnergy,10,25);\n  ctx.fillText('전투 '+(G.encounter+1)+'/4  점수:'+G.score,10,45);\n\n  if(playerSkin){ctx.drawImage(playerSkin,50,cv.height/2-40,80,80);}\n  else{ctx.fillStyle='#48f';ctx.beginPath();ctx.arc(90,cv.height/2,40,0,7);ctx.fill();ctx.font='30px sans-serif';ctx.fillText('🛡️',75,cv.height/2+10);}\n\n  if(G.phase=='reward'){\n    ctx.fillStyle='#eee';ctx.font='20px sans-serif';\n    ctx.fillText('카드 획득! (1~3키 또는 클릭)',cv.width/2-150,50);\n    let w=cv.width/3;\n    G.rewardCards.forEach((c,i)=>{\n      ctx.fillStyle='#334';ctx.fillRect(i*w+20,100,w-40,180);\n      ctx.fillStyle='#fff';ctx.font='16px sans-serif';\n      ctx.fillText(c.name,i*w+35,140);\n      ctx.fillText('비용:'+c.cost,i*w+35,165);\n      ctx.fillText('값:'+c.val,i*w+35,190);\n      ctx.fillText((i+1)+'번',i*w+35,250);\n    });\n    requestAnimationFrame(draw);return;\n  }\n\n  if(G.enemy){\n    let ex=cv.width-150,ey=cv.height/2;\n    ctx.font='50px sans-serif';ctx.fillText('👹',ex-25,ey+15);\n    ctx.fillStyle='#eee';ctx.font='14px sans-serif';\n    ctx.fillText(G.enemy.name+' HP:'+Math.max(0,Math.floor(G.enemy.hp))+'/'+G.enemy.maxHp,ex-60,ey-50);\n    let bw=140;\n    ctx.fillStyle='#500';ctx.fillRect(ex-60,ey-40,bw,10);\n    ctx.fillStyle='#e33';ctx.fillRect(ex-60,ey-40,bw*Math.max(0,G.enemy.hp/G.enemy.maxHp),10);\n    let intentText=['⚔️공격 '+G.enemyIntentVal,'🛡️방어 '+G.enemyIntentVal,'💥강공격 '+G.enemyIntentVal][G.enemyIntent];\n    ctx.fillStyle='#ff0';ctx.fillText('예고: '+intentText,ex-60,ey+70);\n  }\n\n  let cardW=Math.min(90,cv.width/6-10),cardH=120;\n  let startX=cv.width/2-(G.hand.length*(cardW+10))/2;\n  G.hand.forEach((c,i)=>{\n    let x=startX+i*(cardW+10),y=cv.height-cardH-20;\n    ctx.fillStyle=i==G.handIdx?'#663':'#334';\n    ctx.fillRect(x,y,cardW,cardH);\n    if(i==G.handIdx){ctx.strokeStyle='#ff0';ctx.lineWidth=3;ctx.strokeRect(x,y,cardW,cardH);}\n    ctx.fillStyle='#fff';ctx.font='13px sans-serif';\n    ctx.fillText(c.name,x+5,y+20);\n    ctx.fillText('비용'+c.cost,x+5,y+40);\n    let icon=c.type=='atk'?'⚔️':c.type=='def'?'🛡️':'✨';\n    ctx.font='24px sans-serif';ctx.fillText(icon,x+5,y+75);\n    ctx.font='13px sans-serif';ctx.fillText(''+c.val,x+5,y+100);\n  });\n  ctx.fillStyle='#aaa';ctx.font='13px sans-serif';\n  ctx.fillText('덱:'+(G.deck.length+G.draw.length+G.discard.length-G.hand.length),10,cv.height-10);\n  requestAnimationFrame(draw);\n}\nfunction drawTitle(){\n  ctx.fillStyle='#fff';ctx.font='30px sans-serif';ctx.textAlign='center';\n  ctx.fillText('덱빌더 배틀',cv.width/2,cv.height/2-100);\n  ctx.font='16px sans-serif';\n  ctx.fillText('적 3마리와 보스를 카드로 격파하라',cv.width/2,cv.height/2-60);\n  ctx.fillText('조작: ←→ 카드선택, fire(스페이스) 사용, guard(X) 턴종료',cv.width/2,cv.height/2-30);\n  ctx.fillText('보상 선택: 1,2,3키',cv.width/2,cv.height/2-5);\n  ctx.fillText('클릭 또는 스페이스로 시작',cv.width/2,cv.height/2+40);\n  ctx.textAlign='left';\n  drawStartBtn();\n}\nfunction drawOver(){\n  ctx.fillStyle='#f55';ctx.font='30px sans-serif';ctx.textAlign='center';\n  ctx.fillText('게임오버',cv.width/2,cv.height/2-30);\n  ctx.font='18px sans-serif';ctx.fillStyle='#fff';\n  ctx.fillText('점수:'+G.score,cv.width/2,cv.height/2+10);\n  ctx.fillText('클릭 또는 스페이스로 재시작',cv.width/2,cv.height/2+50);\n  ctx.textAlign='left';\n  drawRestartBtn();\n}\nfunction drawCleared(){\n  ctx.fillStyle='#5f5';ctx.font='30px sans-serif';ctx.textAlign='center';\n  ctx.fillText('클리어!',cv.width/2,cv.height/2-30);\n  ctx.font='18px sans-serif';ctx.fillStyle='#fff';\n  ctx.fillText('최종 점수:'+G.score,cv.width/2,cv.height/2+10);\n  ctx.fillText('클릭 또는 스페이스로 재시작',cv.width/2,cv.height/2+50);\n  ctx.textAlign='left';\n  drawRestartBtn();\n}\n\nlet btnEl=null;\nfunction ensureBtn(role,text){\n  if(!btnEl){\n    btnEl=document.createElement('button');\n    btnEl.style.position='absolute';btnEl.style.left='50%';btnEl.style.top='70%';\n    btnEl.style.transform='translate(-50%,-50%)';btnEl.style.zIndex=10;\n    document.body.appendChild(btnEl);\n  }\n  btnEl.setAttribute('data-vibrex-role',role);\n  btnEl.id=role=='start'?'vibrex-start':'';\n  btnEl.textContent=text;\n  btnEl.style.display='block';\n  btnEl.onclick=role=='start'?startGame:restartGame;\n}\nfunction hideBtn(){if(btnEl)btnEl.style.display='none';}\nfunction drawStartBtn(){ensureBtn('start','시작');}\nfunction drawRestartBtn(){ensureBtn('restart','다시하기');}\n\ninitGame();\nrequestAnimationFrame(draw);\nsetInterval(()=>{if(G.phase=='playing'||G.phase=='reward')hideBtn();},100);\n\nwindow.VIBREX_GAME={\n  title:'덱빌더 배틀',genre:'card',goal:'적 3마리와 보스를 카드로 격파하라',\n  clearCondition:'4번째 전투(보스) 승리',\n  controls:[{input:'ArrowLeft',action:'카드 왼쪽 선택'},{input:'ArrowRight',action:'카드 오른쪽 선택'},\n    {input:'fire',action:'카드 사용'},{input:'guard',action:'턴 종료'},\n    {input:'item1',action:'보상카드1 선택'},{input:'item2',action:'보상카드2 선택'},{input:'item3',action:'보상카드3 선택'}],\n  phase:()=>G.phase=='title'?'title':G.phase=='over'?'over':G.phase=='cleared'?'cleared':'playing',\n  progress:()=>G.encounter/4,\n  state:()=>({\n    health:G.health/G.maxHealth,lives:G.health,block:G.block,energy:G.energy,\n    handSize:G.hand.length,enemyHp:G.enemy?Math.max(0,G.enemy.hp/G.enemy.maxHp):0,\n    enemyIntent:G.enemyIntent,deckSize:G.deck.length+G.draw.length+G.discard.length,\n    encounter:G.encounter,progress:G.encounter/4,score:G.score,bestCardValue:G.bestCardValue,\n    targetDX:0,targetDY:0,targetDist:G.enemy?G.enemy.hp/G.enemy.maxHp:0,\n    dangerDX:1,dangerDY:0,dangerDist:G.enemyIntent==0||G.enemyIntent==2?0.2:0.8,dangerETA:0.5,\n    onGround:1,selfVX:0,selfVY:0,facing:1,fireReady:G.energy>0?1:0\n  }),\n  start:startGame,restart:restartGame,\n  inputs:{\n    left:on=>{if(on)handleInput('left');},\n    right:on=>{if(on)handleInput('right');},\n    up:on=>{},down:on=>{},\n    jump:on=>{},\n    fire:on=>{if(on)handleInput('fire');},\n    guard:on=>{if(on)handleInput('guard');},\n    useItem:on=>{},\n    item1:on=>{if(on)handleInput('item1');},\n    item2:on=>{if(on)handleInput('item2');},\n    item3:on=>{if(on)handleInput('item3');},\n    item4:on=>{}\n  }\n};\n\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\n\nlet botRunning=false,botTimer=null;\nwindow.vibrexBot={\n  start(){\n    botRunning=true;\n    if(botTimer)clearInterval(botTimer);\n    botTimer=setInterval(()=>{\n      if(!botRunning)return;\n      if(G.phase=='title'){startGame();return;}\n      if(G.phase=='over'||G.phase=='cleared'){restartGame();return;}\n      if(G.phase=='reward'){chooseReward(0);return;}\n      if(G.phase=='playing'){\n        if(G.hand.length==0){endTurn();return;}\n        let wantDefend=(G.enemyIntent==0||G.enemyIntent==2);\n        let played=false;\n        if(wantDefend){\n          let bi=-1,bv=-1;\