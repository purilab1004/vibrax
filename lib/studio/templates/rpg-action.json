(e.code=='ArrowDown')keys.down=0;\n if(e.code=='Space')keys.fire=0;if(e.code=='KeyX')keys.useItem=0;\n});\n\nlet phase='title',score=0,level=1,room=0,potions=1;\nlet player,mons=[],items=[],atkCd=0,fireBuf=0,useBuf=0,facing={x:1,y:0};\n\nfunction initPlayer(){player={x:400,y:500,r:16,hp:100,maxhp:100,atk:12,vx:0,vy:0};}\nfunction spawnRoom(idx){\n mons=[];items=[];\n if(idx<2){\n  let n=3+idx;\n  for(let i=0;i<n;i++)mons.push({x:150+Math.random()*500,y:100+Math.random()*300,r:14,hp:30+idx*10,maxhp:30+idx*10,vx:0,vy:0,boss:false,cd:0});\n } else {\n  mons.push({x:400,y:200,r:34,hp:250,maxhp:250,vx:0,vy:0,boss:true,cd:0});\n }\n}\nfunction startGame(){\n phase='playing';score=0;level=1;room=0;potions=1;\n initPlayer();spawnRoom(0);\n if(window.AJ)AJ.start();\n document.getElementById('ui').style.display='none';\n}\nfunction restartGame(){startGame();document.getElementById('ui').innerHTML=titleHTML();document.getElementById('ui').removeAttribute('data-vibrex-role');document.getElementById('ui').style.display='none';}\nfunction titleHTML(){return `<div style=\"text-align:center\"><h2>던전 삼중방</h2><p>몬스터를 잡고 성장해 보스를 처치하세요</p><p>이동: 방향키/조이스틱 | 공격: fire(스페이스) | 포션: useItem(X)</p><button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;}\n\ndocument.getElementById('vibrex-start').onclick=startGame;\n\nfunction levelUp(){\n level++;player.maxhp+=20;player.hp=player.maxhp;player.atk+=4;\n if(window.AJ)AJ.level(level);\n}\n\nfunction attack(){\n if(atkCd>0)return;atkCd=25;\n let ang=Math.atan2(facing.y,facing.x);\n for(let m of mons){\n  let dx=m.x-player.x,dy=m.y-player.y,d=Math.hypot(dx,dy);\n  if(d<70){\n   let a2=Math.atan2(dy,dx);\n   let diff=Math.atan2(Math.sin(a2-ang),Math.cos(a2-ang));\n   if(Math.abs(diff)<0.9){\n    m.hp-=player.atk;\n    if(m.hp<=0){\n     killMonster(m);\n    }\n   }\n  }\n }\n}\nfunction killMonster(m){\n mons.splice(mons.indexOf(m),1);\n score+=m.boss?200:30;\n if(window.AJ)AJ.score(score);\n if(Math.random()<0.35&&!m.boss)items.push({x:m.x,y:m.y,r:8,type:'potion'});\n if(!m.boss){let need=level*3;if(score/10>=need*level)levelUp();}\n if(m.boss){\n  phase='cleared';\n  if(window.AJ)AJ.clear(score);\n } else if(mons.length===0){\n  nextRoom();\n }\n}\nfunction nextRoom(){\n room++;\n if(room>=3){phase='cleared';if(window.AJ)AJ.clear(score);return;}\n player.x=400;player.y=550;\n spawnRoom(room);\n}\n\nfunction usePotion(){\n if(potions>0&&player.hp<player.maxhp){\n  potions--;player.hp=Math.min(player.maxhp,player.hp+40);\n }\n}\n\nfunction update(){\n if(phase!=='playing')return;\n let dx=(keys.right-keys.left),dy=(keys.down-keys.up);\n let sp=3.2;\n player.x+=dx*sp;player.y+=dy*sp;\n player.x=Math.max(20,Math.min(W-20,player.x));\n player.y=Math.max(20,Math.min(H-20,player.y));\n if(dx||dy){let l=Math.hypot(dx,dy);facing.x=dx/l;facing.y=dy/l;}\n if(atkCd>0)atkCd--;\n if(keys.fire)attack();\n if(keys.useItem&&!useBuf)usePotion();\n useBuf=keys.useItem;\n\n for(let m of mons){\n  let dxm=player.x-m.x,dym=player.y-m.y,d=Math.hypot(dxm,dym)||1;\n  let msp=m.boss?1.6:1.2;\n  m.x+=dxm/d*msp;m.y+=dym/d*msp;\n  if(m.cd>0)m.cd--;\n  if(d<m.r+player.r+4&&m.cd<=0){\n   player.hp-=m.boss?15:8;m.cd=45;\n   if(player.hp<=0){phase='over';if(window.AJ)AJ.over(score);}\n  }\n }\n for(let it of items.slice()){\n  let d=Math.hypot(player.x-it.x,player.y-it.y);\n  if(d<player.r+it.r){potions++;items.splice(items.indexOf(it),1);}\n }\n}\n\nfunction draw(){\n ctx.fillStyle='#151515';ctx.fillRect(0,0,W,H);\n ctx.strokeStyle='#444';ctx.strokeRect(10,10,W-20,H-20);\n if(phase==='playing'||phase==='cleared'||phase==='over'){\n  ctx.fillStyle='#5a5';\n  for(let it of items){ctx.beginPath();ctx.arc(it.x,it.y,it.r,0,7);ctx.fillStyle='#e33';ctx.fill();}\n  for(let m of mons){\n   ctx.fillStyle=m.boss?'#a33':'#c66';\n   ctx.beginPath();ctx.arc(m.x,m.y,m.r,0,7);ctx.fill();\n   ctx.fillStyle='#000';ctx.fillRect(m.x-m.r,m.y-m.r-10,m.r*2*(m.hp/m.maxhp),4);\n  }\n  if(playerSkin){\n   let s=player.r*2.4;\n   ctx.drawImage(playerSkin,player.x-s/2,player.y-s/2,s,s);\n  } else {\n   ctx.fillStyle='#4af';ctx.beginPath();ctx.arc(player.x,player.y,player.r,0,7);ctx.fill();\n   ctx.strokeStyle='#fff';ctx.beginPath();ctx.moveTo(player.x,player.y);\n   ctx.lineTo(player.x+facing.x*30,player.y+facing.y*30);ctx.stroke();\n  }\n }\n document.getElementById('hud').textContent=phase==='playing'?`Lv${level} HP${Math.max(0,Math.round(player.hp))}/${player.maxhp} 방${room+1}/3 포션${potions} 점수${score}`:'';\n if(phase==='over'){\n  ctx.fillStyle='#fff';ctx.font='30px sans-serif';ctx.textAlign='center';\n  ctx.fillText('게임 오버 점수:'+score,W/2,H/2);\n }\n if(phase==='cleared'){\n  ctx.fillStyle='#fff';ctx.font='30px sans-serif';ctx.textAlign='center';\n  ctx.fillText('클리어! 점수:'+score,W/2,H/2);\n }\n}\nfunction loop(){update();draw();\n if(phase==='over'||phase==='cleared'){showEnd();}\n requestAnimationFrame(loop);\n}\nlet endShown=false;\nfunction showEnd(){\n if(endShown)return;endShown=true;\n let ui=document.getElementById('ui');\n ui.style.display='flex';\n ui.setAttribute('data-vibrex-role',phase==='cleared'?'clear':'over');\n ui.innerHTML=`<div style=\"text-align:center\"><h2>${phase==='cleared'?'클리어!':'게임 오버'}</h2><p>점수: ${score}</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>`;\n document.getElementById('rb').onclick=()=>{endShown=false;ui.style.display='none';restartGame();};\n}\nloop();\n\nwindow.VIBREX_GAME={\n title:'던전 삼중방',genre:'액션RPG',goal:'3개의 방을 돌파하고 보스를 처치',clearCondition:'보스 몬스터 처치',\n controls:[{input:'left/right/up/down',action:'이동'},{input:'fire',action:'근접 공격'},{input:'useItem',action:'포션 사용'}],\n phase:()=>phase==='title'?'title':phase==='playing'?'playing':phase==='over'?'over':phase==='cleared'?'cleared':'title',\n progress:()=>Math.min(1,room/3),\n state:()=>{\n  let nm=null,nd=1e9;\n  for(let m of mons){let d=Math.hypot(m.x-player.x,m.y-player.y);if(d<nd){nd=d;nm=m;}}\n  let tdx=0,tdy=0,tdist=1,ddx=0,ddy=0,ddist=1;\n  if(nm){tdx=(nm.x-player.x)/400;tdy=(nm.y