wport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>새총 돼지 사냥</title>\n<style>\nhtml,body{margin:0;padding:0;background:#000;overflow:hidden;height:100%}\n#wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}\ncanvas{background:#1a2b3c;touch-action:none}\n.ov{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;font-family:sans-serif;background:rgba(0,0,0,.75);text-align:center;padding:20px;box-sizing:border-box}\n.ov h1{font-size:28px;margin:6px}\n.ov p{font-size:14px;margin:4px;line-height:1.5}\n.ov button{margin-top:14px;padding:12px 28px;font-size:18px;border-radius:10px;border:none;background:#e74c3c;color:#fff;cursor:pointer}\n.hid{display:none}\n#hud{position:fixed;top:6px;left:8px;color:#fff;font-family:sans-serif;font-size:14px;z-index:5}\n</style></head>\n<body>\n<div id=\"wrap\"><canvas id=\"c\" width=\"800\" height=\"450\"></canvas></div>\n<div id=\"hud\"></div>\n<div class=\"ov\" id=\"title\"><h1>🐦 새총 돼지 사냥</h1>\n<p>새총으로 돼지를 모두 제거하라!<br>조작: ↑/↓ 각도 조절, ←/→ 파워 조절, 발사(Space/X/액션버튼)<br>새 5마리로 돼지 6마리를 모두 제거하면 클리어</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>\n<div class=\"ov hid\" id=\"over\"><h1>게임 오버</h1><p id=\"overScore\"></p><button data-vibrex-role=\"restart\">다시하기</button></div>\n<div class=\"ov hid\" id=\"clear\" data-vibrex-role=\"clear\"><h1>🎉 클리어!</h1><p id=\"clearScore\"></p><button data-vibrex-role=\"restart\">다시하기</button></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nconst W=800,H=450,groundY=400,G=0.5;\nfunction fit(){const s=Math.min(innerWidth/W,innerHeight/H);cv.style.width=(W*s)+'px';cv.style.height=(H*s)+'px';}\naddEventListener('resize',fit);fit();\n\nlet phase='title',score=0,birdsLeft=5,pigs=[],blocks=[],bird=null,aimAngle=.5,aimPower=.5,lastHit=0,shotHit=false,botTag=null;\nlet playerSkin=null;\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\n\nfunction addBlock(x,y,w,h){blocks.push({x,y,w,h,vx:0,vy:0,angle:0,va:0});}\nfunction addPig(x,y){pigs.push({x,y,r:14,dead:false});}\nfunction initLevel(){\n  blocks=[];pigs=[];\n  [400,560,700].forEach(gx=>{\n    addBlock(gx-18,groundY-30,16,60);\n    addBlock(gx+18,groundY-30,16,60);\n    addBlock(gx,groundY-64,44,16);\n    addPig(gx-8,groundY-80);addPig(gx+8,groundY-80);\n  });\n  bird={x:100,y:groundY-100,vx:0,vy:0,r:14,flying:false};\n  birdsLeft=5;score=0;lastHit=0;shotHit=false;\n  aimAngle=.5;aimPower=.5;\n}\ninitLevel();\n\nfunction alivePigs(){return pigs.filter(p=>!p.dead);}\nfunction nearestPig(rx,ry){\n  let ap=alivePigs(),best=null,bd=1e9;\n  for(const p of ap){const d=Math.hypot(p.x-rx,p.y-ry);if(d<bd){bd=d;best=p;}}\n  return best;\n}\n\nfunction resetBird(){bird={x:100,y:groundY-100,vx:0,vy:0,r:14,flying:false};}\n\nfunction fire(){\n  if(phase!=='playing'||bird.flying||birdsLeft<=0)return;\n  const deg=10+aimAngle*70,rad=deg*Math.PI/180,spd=6+aimPower*14;\n  bird.vx=Math.cos(rad)*spd;bird.vy=-Math.sin(rad)*spd;bird.flying=true;\n  birdsLeft--;shotHit=false;\n  if(window.AJ)AJ.score(score);\n}\n\nfunction endShot(){\n  bird.flying=false;\n  lastHit=shotHit?1:0;\n  if(alivePigs().length===0){\n    score+=birdsLeft*50;\n    phase='cleared';\n    document.getElementById('title').classList.add('hid');\n    document.getElementById('clearScore').textContent='최종 점수: '+score;\n    document.getElementById('clear').classList.remove('hid');\n    if(window.AJ)AJ.clear(score);\n    return;\n  }\n  if(birdsLeft<=0){\n    phase='over';\n    document.getElementById('overScore').textContent='최종 점수: '+score;\n    document.getElementById('over').classList.remove('hid');\n    if(window.AJ)AJ.over(score);\n    return;\n  }\n  resetBird();\n}\n\nfunction rectCircleHit(b,c){\n  const cx=Math.max(b.x-b.w/2,Math.min(c.x,b.x+b.w/2));\n  const cy=Math.max(b.y-b.h/2,Math.min(c.y,b.y+b.h/2));\n  return Math.hypot(c.x-cx,c.y-cy)<c.r;\n}\n\nfunction update(dt){\n  if(phase!=='playing')return;\n  const dts=Math.min(2,dt/16.7);\n  if(bird.flying){\n    bird.vy+=G*dts;\n    bird.x+=bird.vx*dts;bird.y+=bird.vy*dts;\n    if(bird.y+bird.r>groundY){bird.y=groundY-bird.r;bird.vy*=-.3;bird.vx*=.7;if(Math.abs(bird.vy)<1)bird.vy=0;}\n    for(const p of alivePigs()){\n      if(Math.hypot(bird.x-p.x,bird.y-p.y)<bird.r+p.r){p.dead=true;score+=100;shotHit=true;if(window.AJ)AJ.score(score);}\n    }\n    for(const b of blocks){\n      if(rectCircleHit(b,bird)){\n        b.vx+=bird.vx*0.5;b.vy-=2;b.va+=(Math.random()-.5)*0.3;\n        bird.vx*=-.3;bird.vy*=.3;\n      }\n    }\n    if(bird.x>W+60||bird.x<-60)endShot();\n    else if(!bird.vx&&!bird.vy&&bird.y>=groundY-bird.r-1)endShot();\n  }\n  for(const b of blocks){\n    b.vy+=G*dts;\n    b.x+=b.vx*dts;b.y+=b.vy*dts;\n    b.angle+=b.va*dts;b.va*=0.95;b.vx*=0.98;\n    if(b.y+b.h/2>groundY){b.y=groundY-b.h/2;b.vy=0;b.vx*=0.9;}\n    for(const p of alivePigs()){\n      if((Math.abs(b.vx)>1||Math.abs(b.vy)>1)&&rectCircleHit(b,p)){p.dead=true;score+=100;shotHit=true;if(window.AJ)AJ.score(score);}\n    }\n  }\n}\n\nlet keys={};\naddEventListener('keydown',e=>{keys[e.code]=true;if(e.code==='Space'||e.code==='KeyX')fire();});\naddEventListener('keyup',e=>{keys[e.code]=false;});\nfunction handleHeld(dt){\n  if(phase!=='playing')return;\n  const s=0.01*Math.min(2,dt/16.7);\n  if(keys['ArrowUp'])aimAngle=Math.min(1,aimAngle+s);\n  if(keys['ArrowDown'])aimAngle=Math.max(0,aimAngle-s);\n  if(keys['ArrowRight'])aimPower=Math.min(1,aimPower+s);\n  if(keys['ArrowLeft'])aimPower=Math.max(0,aimPower-s);\n}\n\nfunction drawBlock(b){\n  ctx.save();ctx.translate(b.x,b.y);ctx.rotate(b.angle);\n  ctx.fillStyle='#8b5a2b';ctx.fillRect(-b.w/2,-b.h/2,b.w,b.h);\n  ctx.restore();\n}\nfunction draw(){\n  ctx.clearRect(0,0,W,H);\n  ctx.fillStyle='#1a2b3c';ctx.fillRect(0,0,W,H);\n  ctx.fillStyle='#3a2a1a';ctx.fillRect(0,groundY,W,H-groundY);\n  ctx.strokeStyle='#654';ctx.lineWidth=6;ctx.beginPath();ctx.moveTo(0,groundY);ctx.lineTo(W,groundY);ctx.stroke();\n  ctx.strokeStyle='#654';ctx.lineWidth=8;\n  ctx.beginPath();ctx.moveTo(90,groundY);ctx.lineTo(100,groundY-90);ctx.stroke();\n  ctx.beginPath();ctx.moveTo(115,groundY);ctx.lineTo(100,groundY-90);ctx.stroke();\n  for(const b of blocks)drawBlock(b);\n  for(const p of pigs){if(p.dead)continue;ctx.font='26px sans-serif';ctx.textAlign='center';ctx.fillText('🐷',p.x,p.y+9);}\n  if(bird){\n    if(playerSkin){const s=bird.r*2.6;ctx.drawImage(playerSkin,bird.x-s/2,bird.y-s/2,s,s);}\n    else{ctx.font='28px sans-serif';ctx.textAlign='center';ctx.fillText('🐦',bird.x,bird.y+9);}\n  }\n  if(phase==='playing'&&!bird.flying){\n    const deg=10+aimAngle*70,rad=deg*Math.PI/180,len=40+aimPower*40;\n    ctx.strokeStyle='#0f0';ctx.lineWidth=3;\n    ctx.beginPath();ctx.moveTo(bird.x,bird.y);ctx.lineTo(bird.x+Math.cos(rad)*len,bird.y-Math.sin(rad)*len);ctx.stroke();\n  }\n  ctx.fillStyle='#fff';ctx.font='16px sans-serif';ctx.textAlign='left';\n  ctx.fillText('점수:'+score+'  새:'+birdsLeft+'  남은돼지:'+alivePigs().length,10,20);\n  if(botActive){ctx.fillStyle='#ff0';ctx.font='14px sans-serif';}\n}\n\nlet last=performance.now();\nfunction loop(t){\n  const dt=t-last;last=t;\n  handleHeld(dt);\n  update(dt);\n  draw();\n  if(botActive)botStep();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nfunction startGame(){\n  initLevel();\n  phase='playing';\n  document.getElementById('title').classList.add('hid');\n  document.getElementById('over').classList.add('hid');\n  document.getElementById('clear').classList.add('hid');\n  if(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\ndocument.querySelectorAll('[data-vibrex-role=\"restart\"]').forEach(b=>b.onclick=()=>{if(window.AJ)AJ.restart();startGame();});\n\nwindow.VIBREX_GAME={\n  title:'새총 돼지 사냥',genre:'물리퍼즐',\n  goal:'새 5마리로 돼지 6마리를 모두 제거하라',\n  clearCondition:'돼지 6마리를 모두 제거하면 클리어',\n  controls:[{input:'ArrowUp/Down',action:'각도 조절'},{input:'ArrowLeft/Right',action:'파워 조절'},{input:'Space/action',action:'발사'}],\n  phase:()=>phase==='playing'?'playing':phase,\n  progress:()=>1-alivePigs().length/6,\n  state:()=>{\n    const np=nearestPig(bird.x,bird.y);\n    const diag=Math.hypot(W,H);\n    let tdx=0,tdy=0,tdist=1;\n    if(np){tdx=Math.max(-1,Math.min(1,(np.x-bird.x)/W));tdy=Math.max(-1,Math.min(1,(np.y-bird.y)/H));tdist=Math.min(1,Math.hypot(np.x-bird.x,np.y-bird.y)/diag);}\n    return{score,birdsLeft,targetsLeft:alivePigs().length,aimAngle,aimPower,\n      targetDX:tdx,targetDY:tdy,targetDist:tdist,\n      progress:1-alivePigs().length/6,lastHit,\n      selfVX:bird?Math.max(-1,Math.min(1,bird.vx/15)):0,\n      selfVY:bird?Math.max(-1,Math.min(1,bird.vy/15)):0,\n      onGround:bird&&!bird.flying?1:0};\n  },\n  start:startGame,\n  restart:startGame,\n  inputs:{\n    left:on=>keys['ArrowLeft']=on,right:on=>keys['ArrowRight']=on,\n    up:on=>keys['ArrowUp']=on,down:on=>keys['ArrowDown']=on,\n    jump:on=>{if(on)fire();},fire:on=>{if(on)fire();},action:on=>{if(on)fire();},\n    guard:()=>{},useItem:()=>{},item1:()=>{},item2:()=>{},item3:()=>{},item4:()=>{}\n  }\n};\n\nlet botActive=false,botState={waitTimer:0,pending:null},lastCands=[],botWeights={w_dist:1};\nfunction simDist(a,p,target){\n  let deg=10+a*70,rad=deg*Math.PI/180,spd=6+p*14;\n  let x=100,y=groundY-100,vx=Math.cos(rad)*spd,vy=-Math.sin(rad)*spd,minD=1e9;\n  for(let i=0;i<220;i++){\n    vy+=G;x+=vx;y+=vy;\n    const d=Math.hypot(x-target.x,y-target.y);\n    if(d<minD)minD=d;\n    if(y>groundY+60||x>W+60)break;\n  }\n  return minD;\n}\nfunction evaluateBest(){\n  const np=nearestPig(bird.x,bird.y);\n  if(!np)return null;\n  let cands=[],best=null,bestScore=-1e18,id=0;\n  for(let a=0.05;a<=0.95;a+=0.06){\n    for(let p=0.15;p<=1;p+=0.08){\n      const d=s