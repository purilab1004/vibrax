orage',{value:s,configurable:true})}catch(_){}})()}</script><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>미로 사격전</title>\n<style>\nhtml,body{margin:0;padding:0;background:#000;overflow:hidden;height:100%;width:100%}\ncanvas{display:block;touch-action:none}\n#ui{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;font-family:sans-serif;color:#fff}\n.screen{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.85);display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:auto;text-align:center;padding:20px;box-sizing:border-box}\nbutton{font-size:20px;padding:10px 24px;margin-top:14px;background:#e33;color:#fff;border:none;border-radius:8px}\n#hud{position:absolute;top:8px;left:8px;font-size:15px;text-shadow:1px 1px 2px #000}\n#hp{position:absolute;top:8px;right:8px;font-size:15px}\nli{list-style:none}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\">\n<div id=\"hud\"></div>\n<div id=\"hp\"></div>\n<div id=\"title\" class=\"screen\">\n<h1>미로 사격전</h1>\n<p>미로 속 적 8마리를 처치하고 출구를 찾아라</p>\n<ul style=\"text-align:left;font-size:14px\">\n<li>↑↓ 전진/후진, ←→ 회전</li>\n<li>Space 발사, X 달리기</li>\n</ul>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div id=\"over\" class=\"screen\" style=\"display:none\">\n<h1>사망</h1><p id=\"overScore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button>\n</div>\n<div id=\"clear\" class=\"screen\" data-vibrex-role=\"clear\" style=\"display:none\">\n<h1>클리어!</h1><p id=\"clearScore\"></p>\n<button data-vibrex-role=\"restart\" onclick=\"restartGame()\">다시하기</button>\n</div>\n</div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){cv.width=innerWidth;cv.height=innerHeight;}\naddEventListener('resize',resize);resize();\n\nconst MAP=[\n\"1111111111111\",\n\"1000000000001\",\n\"1011111011101\",\n\"1010000010101\",\n\"1010111010101\",\n\"1010100010101\",\n\"1010101110101\",\n\"1010001000101\",\n\"1011101110101\",\n\"1000100000101\",\n\"1110101011101\",\n\"1000000000001\",\n\"1111111111111\"];\nconst MW=MAP[0].length,MH=MAP.length;\nfunction mapAt(x,y){\n  if(!isFinite(x)||!isFinite(y))return 1;\n  const mx=Math.floor(x),my=Math.floor(y);\n  if(my<0||my>=MH||mx<0||mx>=MW)return 1;\n  return MAP[my][mx]==='1'?1:0;\n}\nconst exitX=11.5,exitY=1.5;\n\nlet px,py,pa,hp,score,kills,fireCd,dmgCd,phase,running,botOn=false;\nlet enemies=[];\nlet keys={l:0,r:0,u:0,d:0,fire:0,run:0};\n\nfunction newGame(){\n  px=1.5;py=1.5;pa=0;hp=1;score=0;kills=0;fireCd=0;dmgCd=0;\n  enemies=[];\n  const spots=[[9.5,1.5],[3.5,3.5],[9.5,3.5],[5.5,5.5],[9.5,7.5],[3.5,9.5],[7.5,9.5],[11.5,9.5]];\n  for(const s of spots)enemies.push({x:s[0],y:s[1],alive:true,hp:2});\n  phase='playing';\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){\n  document.getElementById('over').style.display='none';\n  document.getElementById('clear').style.display='none';\n  newGame();\n  if(window.AJ)AJ.restart();\n}\nwindow.VIBREX_GAME={\n  title:'미로 사격전',genre:'FPS슈팅',goal:'적 8마리 처치 후 출구 도달',\n  clearCondition:'8마리 모두 처치+출구 도달',\n  controls:[{input:'ArrowUp',action:'전진'},{input:'ArrowDown',action:'후진'},{input:'ArrowLeft',action:'좌회전'},{input:'ArrowRight',action:'우회전'},{input:'fire',action:'발사'},{input:'guard',action:'달리기'}],\n  phase:()=>phase,\n  progress:()=>kills/8,\n  state:()=>{\n    let ne=null,nd=1e9;\n    for(const e of enemies){if(!e.alive)continue;const dx=e.x-px,dy=e.y-py,d=Math.hypot(dx,dy);if(d<nd){nd=d;ne=e;}}\n    let tdx=0,tdy=0,tdist=1;\n    if(ne){tdx=(ne.x-px)/Math.max(nd,0.01);tdy=(ne.y-py)/Math.max(nd,0.01);tdist=Math.min(nd/15,1);}\n    return {\n      selfX:px/MW,selfY:py/MH,facing:Math.max(-1,Math.min(1,pa/Math.PI)),\n      targetDX:tdx,targetDY:tdy,targetDist:tdist,\n      dangerDX:tdx,dangerDY:tdy,dangerDist:tdist,\n      health:hp,score,progress:kills/8,fireReady:fireCd<=0?1:0\n    };\n  },\n  start:()=>{document.getElementById('title').style.display='none';newGame();},\n  restart:restartGame,\n  inputs:{\n    left:on=>keys.l=on,right:on=>keys.r=on,up:on=>keys.u=on,down:on=>keys.d=on,\n    fire:on=>keys.fire=on,guard:on=>keys.run=on\n  }\n};\nif(window.VIBREX_AVATAR){}\naddEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')keys.l=1;if(e.code==='ArrowRight')keys.r=1;\n  if(e.code==='ArrowUp')keys.u=1;if(e.code==='ArrowDown')keys.d=1;\n  if(e.code==='Space')keys.fire=1;if(e.code==='KeyX')keys.run=1;\n});\naddEventListener('keyup',e=>{\n  if(e.code==='ArrowLeft')keys.l=0;if(e.code==='ArrowRight')keys.r=0;\n  if(e.code==='ArrowUp')keys.u=0;if(e.code==='ArrowDown')keys.d=0;\n  if(e.code==='Space')keys.fire=0;if(e.code==='KeyX')keys.run=0;\n});\n\nfunction tryMove(nx,ny){\n  if(!isFinite(nx)||!isFinite(ny))return;\n  if(!mapAt(nx,py))px=nx;\n  if(!mapAt(px,ny))py=ny;\n}\n\nfunction update(dt){\n  if(phase!=='playing')return;\n  const rot=2.2*dt,spd=(keys.run?3.6:1.8)*dt;\n  if(keys.l)pa-=rot;\n  if(keys.r)pa+=rot;\n  while(pa>Math.PI)pa-=2*Math.PI;\n  while(pa<-Math.PI)pa+=2*Math.PI;\n  let mv=0;\n  if(keys.u)mv+=spd;\n  if(keys.d)mv-=spd;\n  if(mv){\n    tryMove(px+Math.cos(pa)*mv,py+Math.sin(pa)*mv);\n  }\n  fireCd-=dt;dmgCd-=dt;\n  if(keys.fire&&fireCd<=0){\n    fireCd=0.4;\n    let best=null,bd=1e9;\n    for(const e of enemies){\n      if(!e.alive)continue;\n      const dx=e.x-px,dy=e.y-py,d=Math.hypot(dx,dy);\n      let ang=Math.atan2(dy,dx)-pa;\n      while(ang>Math.PI)ang-=2*Math.PI;while(ang<-Math.PI)ang+=2*Math.PI;\n      if(Math.abs(ang)<0.25&&d<12&&d<bd){bd=d;best=e;}\n    }\n    if(best){\n      best.hp--;\n      if(best.hp<=0){best.alive=false;kills++;score+=100;if(window.AJ)AJ.score(score);}\n    }\n  }\n  for(const e of enemies){\n    if(!e.alive)continue;\n    const dx=px-e.x,dy=py-e.y,d=Math.hypot(dx,dy);\n    if(d>0.01&&d<6){\n      const sp=0.7*dt;\n      let nx=e.x+dx/d*sp,ny=e.y+dy/d*sp;\n      if(!mapAt(nx,e.y))e.x=nx;\n      if(!mapAt(e.x,ny))e.y=ny;\n    }\n    if(d<0.5&&dmgCd<=0){hp-=0.2;dmgCd=0.6;if(hp<0)hp=0;}\n  }\n  if(hp<=0){\n    phase='over';\n    document.getElementById('overScore').textContent='점수: '+score;\n    document.getElementById('over').style.display='flex';\n    if(window.AJ)AJ.over(score);\n  }\n  if(kills>=8&&Math.hypot(px-exitX,py-exitY)<0.8){\n    phase='cleared';score+=200;if(window.AJ){AJ.score(score);AJ.clear(score);}\n    document.getElementById('clearScore').textContent='점수: '+score;\n    document.getElementById('clear').style.display='flex';\n  }\n}\n\nfunction render(){\n  const W=cv.width,H=cv.height;\n  ctx.fillStyle='#333';ctx.fillRect(0,0,W,H/2);\n  ctx.fillStyle='#111';ctx.fillRect(0,H/2,W,H/2);\n  const FOV=Math.PI/3,rays=Math.min(160,Math.floor(W/4));\n  const zbuf=new Array(rays).fill(1e9);\n  for(let i=0;i<rays;i++){\n    const ra=pa-FOV/2+FOV*i/rays;\n    let dist=0,hitx=px,hity=py;\n    const stepx=Math.cos(ra)*0.02,stepy=Math.sin(ra)*0.02;\n    let hit=0;\n    for(let s=0;s<800;s++){\n      hitx+=stepx;hity+=stepy;dist+=0.02;\n      if(mapAt(hitx,hity)){hit=1;break;}\n      if(dist>16)break;\n    }\n    if(!hit)dist=16;\n    const corr=dist*Math.cos(ra-pa);\n    zbuf[i]=corr;\n    const wh=Math.min(H,H/Math.max(corr,0.1));\n    const shade=Math.max(0,255-corr*16);\n    ctx.fillStyle='rgb('+shade+','+Math.floor(shade*0.3)+','+Math.floor(shade*0.3)+')';\n    const cx=i*(W/rays);\n    ctx.fillRect(cx,(H-wh)/2,Math.ceil(W/rays)+1,wh);\n  }\n  const sp=[];\n  for(const e of enemies){\n    if(!e.alive)continue;\n    const dx=e.x-px,dy=e.y-py,d=Math.hypot(dx,dy);\n    let ang=Math.atan2(dy,dx)-pa;\n    while(ang>Math.PI)ang-=2*Math.PI;while(ang<-Math.PI)ang+=2*Math.PI;\n    sp.push({d,ang});\n  }\n  sp.sort((a,b)=>b.d-a.d);\n  for(const s of sp){\n    if(Math.abs(s.ang)>FOV/2+0.3)continue;\n    const scrx=(0.5+s.ang/FOV)*W;\n    const col=Math.floor((s.ang/FOV+0.5)*rays);\n    if(col<0||col>=rays)continue;\n    if(s.d>zbuf[col])continue;\n    const size=Math.min(H,H*0.9/Math.max(s.d,0.3));\n    ctx.font=size+'px sans-serif';\n    ctx.textAlign='center';ctx.textBaseline='middle';\n    ctx.fillText('👾',scrx,H/2);\n  }\n  const mmS=6,ox=8,oy=8;\n  ctx.fillStyle='rgba(0,0,0,.5)';ctx.fillRect(ox-2,oy-2,MW*mmS+4,MH*mmS+4);\n  for(let y=0;y<MH;y++)for(let x=0;x<MW;x++){\n    if(MAP[y][x]==='1'){ctx.fillStyle='#888';ctx.fillRect(ox+x*mmS,oy+y*mmS,mmS,mmS);}\n  }\n  ctx.fillStyle='#0f0';ctx.fillRect(ox+exitX*mmS-2,oy+exitY*mmS-2,4,4);\n  for(const e of enemies){if(!e.alive)continue;ctx.fillStyle='#f00';ctx.fillRect(ox+e.x*mmS-2,oy+e.y*mmS-2,4,4);}\n  ctx.fillStyle='#0af';ctx.beginPath();ctx.arc(ox+px*mmS,oy+py*mmS,3,0,7);ctx.fill();\n  ctx.strokeStyle='#0af';ctx.beginPath();ctx.moveTo(ox+px*mmS,oy+py*mmS);\n  ctx.lineTo(ox+px*mmS+Math.cos(pa)*8,oy+py*mmS+Math.sin(pa)*8);ctx.stroke();\n\n  document.getElementById('hud').textContent='점수: '+score+'  처치: '+kills+'/8';\n  document.getElementById('hp').textContent='체력: '+Math.round(hp*100)+'%';\n  if(botOn){\n    ctx.fillStyle='#ff0';ctx.font='16px sans-serif';ctx.textAlign='left';\n    \n  }\n}\n\nlet last=performance.now();\nfunction loop(t){\n  const dt=Math.min(0.05,(t-last)/1000);last=t;\n  update(dt);render();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\ndocument.getElementById('vibrex-start').addEventListener('click',()=>{\n  document.getElementById('title').style.display='none';\n  newGame();\n});\n\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\n\nwindow.vibrexBot={\n  start(){\n    botOn=true;\n    if(document.getElementById('title').style.display!=='none'){\n      document.getElementById('title').style.display='none';newGame();\n    }\n    if(this._t)clearInterv