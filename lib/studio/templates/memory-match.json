,'🍌','🍇','🍉','🍒','🍋','🍓','🥝'];\nlet cards=[],cx=0,cy=0,flipped=[],compareLock=false,compareTimer=0,attempts=0,matched=0,timeLeft=60,seen={};\nlet phase='title',finalScore=0;\nlet playerSkin=null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\n\nfunction shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}\n\nfunction initGame(){\n  let vals=[];for(let i=0;i<8;i++){vals.push(i,i);}\n  shuffle(vals);\n  cards=vals.map(v=>({val:v,rev:false,matched:false}));\n  cx=0;cy=0;flipped=[];compareLock=false;compareTimer=0;attempts=0;matched=0;timeLeft=60;seen={};\n  phase='playing';\n  document.getElementById('titleScreen').style.display='none';\n  document.getElementById('overScreen').style.display='none';\n  document.getElementById('clearScreen').style.display='none';\n  if(window.AJ)AJ.start();\n}\nfunction computeScore(){return Math.max(0,matched*100-attempts*5+Math.floor(timeLeft*2));}\nfunction doMove(dx,dy){\n  if(phase!=='playing')return;\n  cx=Math.max(0,Math.min(3,cx+dx));\n  cy=Math.max(0,Math.min(3,cy+dy));\n}\nfunction doFire(){\n  if(phase!=='playing'||compareLock)return;\n  const idx=cy*4+cx,c=cards[idx];\n  if(c.rev||c.matched)return;\n  c.rev=true;seen[idx]=c.val;flipped.push(idx);\n  if(flipped.length===2){\n    attempts++;\n    const[a,b]=flipped;\n    if(cards[a].val===cards[b].val){\n      cards[a].matched=true;cards[b].matched=true;matched++;flipped=[];\n      if(window.AJ)AJ.score(computeScore());\n      if(matched===8)doClear();\n    }else{compareLock=true;compareTimer=0.6;}\n  }\n}\nfunction doOver(){\n  phase='over';finalScore=computeScore();\n  document.getElementById('overScore').textContent='최종 점수: '+finalScore;\n  document.getElementById('overScreen').style.display='flex';\n  if(window.AJ)AJ.over(finalScore);\n}\nfunction doClear(){\n  phase='cleared';finalScore=computeScore()+Math.floor(timeLeft*3);\n  document.getElementById('clearScore').textContent='최종 점수: '+finalScore;\n  document.getElementById('clearScreen').style.display='flex';\n  if(window.AJ)AJ.clear(finalScore);\n}\n\nlet keyState={left:false,right:false,up:false,down:false,fire:false};\nfunction edge(name,on){if(on&&!keyState[name]){keyState[name]=true;return true;}if(!on)keyState[name]=false;return false;}\n\ndocument.addEventListener('keydown',e=>{\n  if(e.repeat)return;\n  if(e.code==='ArrowLeft')doMove(-1,0);\n  else if(e.code==='ArrowRight')doMove(1,0);\n  else if(e.code==='ArrowUp')doMove(0,-1);\n  else if(e.code==='ArrowDown')doMove(0,1);\n  else if(e.code==='Space'||e.code==='KeyX')doFire();\n});\n\ndocument.getElementById('vibrex-start').onclick=()=>{initGame();};\ndocument.querySelectorAll('[data-vibrex-role=\"restart\"]').forEach(b=>b.onclick=()=>{initGame();if(window.AJ)AJ.restart();});\n\nlet lastT=performance.now();\nfunction loop(t){\n  const dt=Math.min(0.05,(t-lastT)/1000);lastT=t;\n  if(phase==='playing'){\n    if(compareLock){\n      compareTimer-=dt;\n      if(compareTimer<=0){\n        const[a,b]=flipped;cards[a].rev=false;cards[b].rev=false;flipped=[];compareLock=false;\n      }\n    }\n    timeLeft-=dt;\n    if(timeLeft<=0){timeLeft=0;doOver();}\n  }\n  if(botActive)botTick(dt);\n  render();\n  requestAnimationFrame(loop);\n}\nfunction render(){\n  ctx.fillStyle='#222';ctx.fillRect(0,0,480,640);\n  ctx.fillStyle='#fff';ctx.font='18px sans-serif';ctx.textAlign='left';\n  if(phase==='playing'||phase==='over'||phase==='cleared'){\n    ctx.fillText('시도: '+attempts,10,25);\n    ctx.fillText('짝: '+matched+'/8',150,25);\n    ctx.fillText('시간: '+Math.ceil(timeLeft)+'s',300,25);\n    const ox=40,oy=60,cw=100,ch=100,gap=10;\n    for(let r=0;r<4;r++)for(let c=0;c<4;c++){\n      const idx=r*4+c,card=cards[idx];\n      const x=ox+c*(cw+gap),y=oy+r*(ch+gap);\n      ctx.fillStyle=card.matched?'#2e7d32':(card.rev?'#ffca28':'#455a64');\n      ctx.fillRect(x,y,cw,ch);\n      if(card.rev||card.matched){\n        ctx.font='48px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';\n        ctx.fillText(EMO[card.val],x+cw/2,y+ch/2+4);\n        ctx.textAlign='left';ctx.textBaseline='alphabetic';\n      }\n      if(c===cx&&r===cy&&phase==='playing'){\n        ctx.strokeStyle='#fff';ctx.lineWidth=4;ctx.strokeRect(x+2,y+2,cw-4,ch-4);\n      }\n    }\n  }\n}\n\nlet botActive=false,botTimer=0,botQueue=[];\nfunction botDecide(){\n  const valMap={};\n  for(let i=0;i<16;i++){\n    if(cards[i].matched)continue;\n    if(seen[i]!==undefined){(valMap[seen[i]]=valMap[seen[i]]||[]).push(i);}\n  }\n  for(const v in valMap){if(valMap[v].length>=2)return valMap[v].slice(0,2);}\n  const unseen=[];for(let i=0;i<16;i++)if(!cards[i].matched&&seen[i]===undefined&&!flipped.includes(i))unseen.push(i);\n  if(unseen.length)return[unseen[Math.floor(Math.random()*unseen.length)]];\n  const un=[];for(let i=0;i<16;i++)if(!cards[i].matched&&!flipped.includes(i))un.push(i);\n  return un.length?[un[0]]:[];\n}\nfunction botTick(dt){\n  botTimer-=dt;\n  if(botTimer>0)return;\n  if(phase==='title'){document.getElementById('vibrex-start').click();botTimer=0.3;return;}\n  if(phase==='over'||phase==='cleared'){document.querySelector('[data-vibrex-role=\"restart\"]').click();botTimer=0.5;return;}\n  if(phase!=='playing'||compareLock)return;\n  if(botQueue.length===0){botQueue=botDecide();if(botQueue.length===0)return;}\n  const target=botQueue[0];\n  const tx=target%4,ty=Math.floor(target/4);\n  if(cx<tx){doMove(1,0);}else if(cx>tx){doMove(-1,0);}\n  else if(cy<ty){doMove(0,1);}else if(cy>ty){doMove(0,-1);}\n  else{doFire();botQueue.shift();}\n  botTimer=0.15;\n}\nwindow.vibrexBot={\n  start(){botActive=true;botTimer=0;document.getElementById('aiTag').style.display='block';},\n  stop(){botActive=false;document.getElementById('aiTag').style.display='none';}\n};\n\nwindow.VIBREX_GAME={\n  title:'기억력 카드 짝맞추기',\n  genre:'memory',\n  goal:'60초 안에 8쌍의 카드를 모두 맞추기',\n  clearCondition:'16장의 카드를 모두 짝지으면 클리어',\n  controls:[\n    {input:'ArrowLeft/Right/Up/Down',action:'커서 이동'},\n    {input:'fire(Space/X)',action:'카드 뒤집기'}\n  ],\n  phase(){return phase==='title'?'title':phase==='playing'?'playing':phase==='over'?'over':'cleared';},\n  progress(){return matched/8;},\n  state(){\n    let knownPairs=0;const valMap={};\n    for(let i=0;i<16;i++){if(seen[i]!==undefined){(valMap[seen[i]]=valMap[seen[i]]||[]).push(i);}}\n    for(const v in valMap){if(valMap[v].length>=2)knownPairs++;}\n    return{\n      matched,attempts,progress:matched/8,knownPairs,\n      score:computeScore(),timeLeft:Math.ceil(timeLeft),\n      cursorX:cx,cursorY:cy,selfX:cx/3,selfY:cy/3,\n      fireReady:compareLock?0:1\n    };\n  },\n  start(){initGame();},\n  restart(){initGame();if(window.AJ)AJ.restart();},\n  inputs:{\n    left(on){if(edge('left',on))doMove(-1,0);},\n    right(on){if(edge('right',on))doMove(1,0);},\n    up(on){if(edge('up',on))doMove(0,-1);},\n    down(on){if(edge('down',on))doMove(0,1);},\n    fire(on){if(edge('fire',on))doFire();},\n    action(on){if(edge('fire',on))doFire();}\n  }\n};\nrequestAnimationFrame(loop);\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"fire\"]};function I(){var G=window.VIBREX_GAME;return G&&G.inputs?G.inputs:null}function ch(code){var i=I();if(!i)return null;var T=window.VIBREX_CONTROLS||[{\"id\":\"left\",\"label\":\"왼쪽\",\"desc\":\"좌 이동·조향\",\"pc\":[\"ArrowLeft\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"right\",\"label\":\"오른쪽\",\"desc\":\"우 이동·조향\",\"pc\":[\"ArrowRight\"],\"mobile\":\"stick\",\"group\":\"move\",\"enabled\":true},{\"id\":\"up\",\"label\":\"위\