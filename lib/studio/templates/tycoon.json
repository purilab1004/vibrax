brexBot&&typeof window.vibrexBot.stop==='function'){try{window.vibrexBot.stop()}catch(e1){}}fallbackStop()}});})();</script><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>매장 운영 타이쿤</title>\n<style>\nhtml,body{margin:0;padding:0;background:#111;overflow:hidden;touch-action:none;font-family:sans-serif}\ncanvas{display:block;margin:0 auto;background:#222}\n#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;text-align:center;z-index:5}\nbutton{padding:12px 24px;font-size:18px;border:none;border-radius:8px;background:#4caf50;color:#fff;cursor:pointer;margin-top:10px}\n#hud{position:fixed;top:0;left:0;right:0;color:#fff;font-size:14px;padding:6px;display:none;z-index:3;background:rgba(0,0,0,0.4)}\n</style></head>\n<body>\n<div id=\"hud\"></div>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nlet cv=document.getElementById('c'),ctx=cv.getContext('2d');\nlet W=0,H=0;\nfunction resize(){W=innerWidth;H=innerHeight;cv.width=W;cv.height=H;}\naddEventListener('resize',resize);resize();\n\nlet phase='title';\nlet money=0,reputation=1,goal=50000,timeLeft=300,gameTime=300;\nlet counters=[],seats=[],staff=[],customers=[];\nlet playerSkin=null;\nlet player={x:0,y:0,size:36};\nlet selIdx=0;\nlet costs={counter:1000,seat:500,staff:2000,ad:1500};\nlet inputs={left:false,right:false,up:false,down:false,jump:false,fire:false,guard:false,useItem:false,item1:false,item2:false,item3:false,item4:false};\n\nfunction initLayout(){\n counters=[{x:W*0.3,y:H*0.3,busy:false}];\n seats=[{x:W*0.3,y:H*0.6,used:false},{x:W*0.45,y:H*0.6,used:false}];\n staff=[];\n customers=[];\n player.x=W*0.5;player.y=H*0.5;\n}\n\nfunction resetGame(){\n money=0;reputation=1;timeLeft=gameTime;\n initLayout();\n phase='playing';\n spawnTimer=0;\n if(window.AJ)AJ.start();\n}\n\nlet spawnTimer=0,spawnInterval=4;\n\nfunction spawnCustomer(){\n if(customers.length>15)return;\n let free=seats.find(s=>!s.used);\n customers.push({x:-30,y:H*0.5+Math.random()*40-20,wait:0,maxWait:20,state:'entering',target:null,order:1});\n}\n\nfunction nearestSeat(){return seats.find(s=>!s.used);}\nfunction nearestCounter(){return counters.find(c=>!c.busy);}\n\nfunction update(dt){\n if(phase!=='playing')return;\n timeLeft-=dt;\n if(timeLeft<=0){\n  phase='over';\n  if(window.AJ)AJ.over(Math.floor(money));\n  return;\n }\n if(reputation<=0){\n  phase='over';\n  if(window.AJ)AJ.over(Math.floor(money));\n  return;\n }\n if(money>=goal){\n  phase='cleared';\n  if(window.AJ)AJ.clear(Math.floor(money));\n  return;\n }\n spawnTimer+=dt;\n if(spawnTimer>spawnInterval){spawnTimer=0;spawnCustomer();}\n\n let speed=120;\n if(inputs.left)player.x-=speed*dt;\n if(inputs.right)player.x+=speed*dt;\n if(inputs.up)player.y-=speed*dt;\n if(inputs.down)player.y+=speed*dt;\n player.x=Math.max(20,Math.min(W-20,player.x));\n player.y=Math.max(20,Math.min(H-20,player.y));\n\n for(let c of customers){\n  if(c.state==='entering'){\n   let seat=nearestSeat();\n   if(seat){c.target=seat;seat.used=true;c.state='toseat';}\n   else{c.x+=30*dt;if(c.x>60)c.x=60;}\n  } else if(c.state==='toseat'){\n   let dx=c.target.x-c.x,dy=c.target.y-c.y;\n   let d=Math.hypot(dx,dy);\n   if(d<5){c.state='waiting';c.x=c.target.x;c.y=c.target.y;}\n   else{c.x+=dx/d*100*dt;c.y+=dy/d*100*dt;}\n  } else if(c.state==='waiting'){\n   c.wait+=dt;\n   for(let s of staff){\n    if(s.busy)continue;\n    let dist=Math.hypot(s.x-c.x,s.y-c.y);\n    if(dist<400){s.busy=true;s.target=c;c.serving=true;s.timer=1.5;break;}\n   }\n   if(c.serving){\n    c.serveTimer=(c.serveTimer||0)+dt;\n    if(c.serveTimer>1.5){finishCustomer(c);}\n   }\n   if(c.wait>c.maxWait&&!c.serving){\n    c.state='leaving';\n    reputation=Math.max(0,reputation-0.08);\n    if(c.target)c.target.used=false;\n   }\n  } else if(c.state==='leaving'){\n   c.x-=60*dt;\n  }\n }\n customers=customers.filter(c=>!(c.state==='leaving'&&c.x<-50)&&!(c.state==='done'));\n\n for(let s of staff){\n  if(s.busy&&s.target){\n   s.timer-=dt;\n   let c=s.target;\n   s.x+=(c.x-s.x)*0.1;\n   s.y+=(c.y-s.y)*0.1;\n   if(s.timer<=0){finishCustomer(c);s.busy=false;s.target=null;}\n  }\n }\n}\n\nfunction finishCustomer(c){\n if(c.state==='done')return;\n c.state='done';\n if(c.target)c.target.used=false;\n let earn=200+Math.random()*100;\n addMoney(earn);\n reputation=Math.min(1,reputation+0.02);\n}\n\nfunction addMoney(v){\n money+=v;\n if(window.AJ)AJ.score(Math.floor(money));\n}\n\nfunction tryFire(){\n let waiting=customers.filter(c=>c.state==='waiting'&&!c.serving);\n if(!waiting.length)return;\n let nearest=null,nd=Infinity;\n for(let c of waiting){\n  let d=Math.hypot(c.x-player.x,c.y-player.y);\n  if(d<nd){nd=d;nearest=c;}\n }\n if(nearest&&nd<300){\n  finishCustomer(nearest);\n }\n}\n\nfunction buyCounter(){\n if(money>=costs.counter){\n  money-=costs.counter;\n  counters.push({x:W*(0.3+counters.length*0.15),y:H*0.3,busy:false});\n  costs.counter*=1.5;\n }\n}\nfunction buySeat(){\n if(money>=costs.seat){\n  money-=costs.seat;\n  seats.push({x:W*(0.3+(seats.length%5)*0.15),y:H*(0.6+Math.floor(seats.length/5)*0.15),used:false});\n  costs.seat*=1.4;\n }\n}\nfunction buyStaff(){\n if(money>=costs.staff){\n  money-=costs.staff;\n  staff.push({x:W*0.5,y:H*0.2,busy:false});\n  costs.staff*=1.6;\n }\n}\nfunction buyAd(){\n if(money>=costs.ad){\n  money-=costs.ad;\n  spawnInterval=Math.max(1,spawnInterval-0.5);\n  costs.ad*=1.3;\n }\n}\n\nlet lastT=performance.now();\nfunction loop(){\n let now=performance.now();\n let dt=Math.min(0.05,(now-lastT)/1000);\n lastT=now;\n update(dt);\n render();\n requestAnimationFrame(loop);\n}\n\nfunction render(){\n ctx.fillStyle='#222';ctx.fillRect(0,0,W,H);\n if(phase==='playing'){\n  for(let c of counters){\n   ctx.fillStyle='#8a5';ctx.fillRect(c.x-25,c.y-20,50,40);\n   ctx.font='20px sans-serif';ctx.fillText('🍽️',c.x-10,c.y+8);\n  }\n  for(let s of seats){\n   ctx.fillStyle=s.used?'#a55':'#555';ctx.beginPath();ctx.arc(s.x,s.y,15,0,7);ctx.fill();\n  }\n  for(let s of staff){\n   ctx.font='24px sans-serif';ctx.fillText('👔',s.x-12,s.y+8);\n  }\n  for(let c of customers){\n   ctx.font='24px sans-serif';\n   let icon=c.state==='waiting'?(c.wait>c.maxWait*0.7?'😠':'🙂'):'🚶';\n   ctx.fillText(icon,c.x-12,c.y+8);\n  }\n  if(playerSkin){\n   let s=player.size*1.3;\n   ctx.drawImage(playerSkin,player.x-s/2,player.y-s/2,s,s);\n  } else {\n   ctx.fillStyle='#4af';ctx.beginPath();ctx.arc(player.x,player.y,18,0,7);ctx.fill();\n   ctx.font='20px sans-serif';ctx.fillText('🧑‍🍳',player.x-10,player.y+7);\n  }\n  document.getElementById('hud').style.display='block';\n  document.getElementById('hud').innerText=\n   `💰${Math.floor(money)}/${goal} ⭐${(reputation*100).toFixed(0)}% ⏱${Math.max(0,Math.floor(timeLeft))}s 대기${customers.filter(c=>c.state==='waiting').length} 직원${staff.length} 카운터${counters.length} 좌석${seats.length}`;\n } else {\n  document.getElementById('hud').style.display='none';\n }\n if(window.vibrexBotOn){\n  ctx.fillStyle='#0f0';ctx.font='16px sans-serif';ctx.fillText('AI PLAYING',W/2-40,20);\n }\n renderUI();\n}\n\nfunction renderUI(){\n let ui=document.getElementById('ui');\n if(phase==='title'){\n  ui.style.display='flex';\n  ui.innerHTML=`<div><h1>매장 운영 타이쿤</h1>\n  <p>손님을 서빙해 5분 안에 ₩${goal.toLocaleString()} 매출을 달성하세요</p>\n  <p>이동:방향키/조이스틱 | fire:직접 서빙 | item1:카운터 item2:좌석 item3:직원 useItem:광고</p>\n  <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;\n  document.getElementById('vibrex-start').onclick=()=>{resetGame();};\n } else if(phase==='over'){\n  ui.style.display='flex';\n  ui.innerHTML=`<div data-vibrex-role=\"over\"><h1>게임 오버</h1><p>최종 매출: ₩${Math.floor(money).toLocaleString()}</p>\n  <button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>`;\n  document.getElementById('rb').onclick=()=>{resetGame();};\n } else if(phase==='cleared'){\n  ui.style.display='flex';\n  ui.innerHTML=`<div data-vibrex-role=\"clear\"><h1>목표 달성! 🎉</h1><p>최종 매출: ₩${Math.floor(money).toLocaleString()}</p>\n  <button data-vibrex-role=\"restart\" id=\"rb2\">다시하기</button></div>`;\n  document.getElementById('rb2').onclick=()=>{resetGame();};\n } else {\n  ui.style.display='none';\n }\n}\n\nlet keys={};\naddEventListener('keydown',e=>{\n keys[e.code]=true;\n if(e.code==='ArrowLeft')inputs.left=true;\n if(e.code==='ArrowRight')inputs.right=true;\n if(e.code==='ArrowUp')inputs.up=true;\n if(e.code==='ArrowDown')inputs.down=true;\n if(e.code==='Space'){inputs.fire=true;tryFire();}\n if(e.code==='Digit1'){inputs.item1=true;buyCounter();}\n if(e.code==='Digit2'){inputs.item2=true;buySeat();}\n if(e.code==='Digit3'){inputs.item3=true;buyStaff();}\n if(e.code==='KeyE'){inputs.useItem=true;buyAd();}\n});\naddEventListener('keyup',e=>{\n keys[e.code]=false;\n if(e.code==='ArrowLeft')inputs.left=false;\n if(e.code==='ArrowRight')inputs.right=false;\n if(e.code==='ArrowUp')inputs.up=false;\n if(e.code==='ArrowDown')inputs.down=false;\n if(e.code==='Space')inputs.fire=false;\n if(e.code==='Digit1')inputs.item1=false;\n if(e.code==='Digit2')inputs.item2=false;\n if(e.code==='Digit3')inputs.item3=false;\n if(e.code==='KeyE')inputs.useItem=false;\n});\n\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\n\nfunction clamp01(v){return Math.max(0,Math.min(1,v));}\n\nwindow.VIBREX_GAME={\n title:'매장 운영 타이쿤',\n genre:'타이쿤',\n goal:'5분 안에 매출 ₩50,000 달성',\n clearCondition:'매출 목표 달성',\n controls:[\n  {input:'ArrowKeys',action:'이동'},\n  {input:'fire',action:'직접 서빙'},\n  {input:'item1',action:'카운터 추가'},\n  {input:'item2',action:'좌석 추가'},\n  {input:'item3',action:'직원 고용'},\n  {input:'useItem',action:'광고(손님 증가)'}\n ],\n phase:()=>phase==='title'?'title':phase==='playing'?'playing':phase==='over'?'over':phase==='cleared'?'cleared':'title',\n progress:()=>clamp01(money/go