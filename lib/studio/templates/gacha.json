iewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>보석 용사단</title><style>\nbody{margin:0;background:#111;color:#fff;font-family:sans-serif;overflow:hidden;touch-action:none}\n#c{display:block;margin:0 auto;background:#181828}\n#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;background:rgba(0,0,0,.7)}\nbutton{font-size:18px;padding:10px 20px;margin:6px;border-radius:8px;border:none;background:#5b8cff;color:#fff}\n#tag{position:fixed;top:4px;left:4px;color:#ff0;font-size:12px}\n</style></head><body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"><h1>보석 용사단</h1><p>스테이지 자동전투로 보석 획득 → 뽑기 → 파티 편성 → 10스테이지 클리어!</p>\n<p style=\"text-align:left;font-size:13px\">조작<br>fire: 뽑기<br>left/right: 파티 슬롯 선택<br>item1~3: 보유 캐릭터 선택<br>jump: 슬롯에 편성<br>up/down: 전투 시작/재시작</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>\n<div id=\"tag\" style=\"display:none\"></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction rs(){let w=innerWidth,h=innerHeight;cv.width=w;cv.height=h;}\naddEventListener('resize',rs);rs();\n\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.()});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\n\nconst RATE={R:0.7,SR:0.25,SSR:0.05};\nconst NAMES=['전사','궁수','마법사','성기사','도적','드루이드','기사','정령사','투사','현자'];\nlet gems=0,stage=1,score=0,phase='title';\nlet roster=[]; // {name,rank,lv,power}\nlet party=[null,null,null,null,null];\nlet slotSel=0,rosterSel=0;\nlet msg='';\nlet battleTimer=0,inBattle=false,battleResult=null;\nlet enemyPower=0;\n\nfunction rankPower(r){return r==='SSR'?30:r==='SR'?15:6;}\nfunction mkChar(){\n  let r=Math.random(); let rank=r<RATE.SSR?'SSR':r<RATE.SSR+RATE.SR?'SR':'R';\n  let name=NAMES[Math.floor(Math.random()*NAMES.length)];\n  return {name,rank,lv:1,power:rankPower(rank)};\n}\nfunction pull(){\n  if(gems<10){msg='보석 부족';return;}\n  gems-=10;\n  let c=mkChar();\n  let ex=roster.find(x=>x.name===c.name&&x.rank===c.rank);\n  if(ex){ex.lv++;ex.power+=Math.round(rankPower(ex.rank)*0.3);msg=c.name+'('+c.rank+') 중복! 강화 Lv'+ex.lv;}\n  else{roster.push(c);msg=c.name+'('+c.rank+') 획득!';}\n  scoreUp();\n}\nfunction scoreUp(){score=gems+stage*100+roster.length*10;if(window.AJ)AJ.score(score);}\n\nfunction partyPower(){let s=0;for(let p of party)if(p)s+=p.power*(1+p.lv*0.1);return s;}\nfunction enemyPowerAt(st){return 20+st*18;}\n\nfunction startBattle(){\n  if(inBattle)return;\n  enemyPower=enemyPowerAt(stage);\n  inBattle=true;battleTimer=0;battleResult=null;\n}\nfunction updateBattle(dt){\n  if(!inBattle)return;\n  battleTimer+=dt;\n  if(battleTimer>1.6){\n    inBattle=false;\n    let pp=partyPower();\n    if(pp>=enemyPower){\n      battleResult='win';\n      gems+=20+stage*5;\n      if(stage>=10){phase='cleared';if(window.AJ)AJ.clear(score);}\n      else{stage++;if(window.AJ)AJ.level(stage);}\n    }else{\n      battleResult='lose';\n      gems+=5;\n    }\n    scoreUp();\n  }\n}\nfunction assignParty(){\n  let c=roster[rosterSel];\n  if(!c){msg='보유 캐릭터 없음';return;}\n  party[slotSel]=c;\n  msg=c.name+' 편성 완료';\n}\n\nlet keys={};\nfunction setKey(k,v){keys[k]=v;}\naddEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')doLeft();\n  if(e.code==='ArrowRight')doRight();\n  if(e.code==='Space')doFire();\n  if(e.code==='ArrowUp')doUp();\n  if(e.code==='ArrowDown')doDown();\n  if(e.code==='KeyX')doJump();\n  if(e.code==='Digit1')rosterSel=Math.min(rosterSel,roster.length-1)>=0?0:0;\n});\nfunction doLeft(){slotSel=(slotSel+4)%5;}\nfunction doRight(){slotSel=(slotSel+1)%5;}\nfunction doFire(){pull();}\nfunction doUp(){startBattle();}\nfunction doDown(){if(phase==='over'||phase==='cleared')restart();}\nfunction doJump(){assignParty();}\nfunction selItem(i){rosterSel=Math.min(i,Math.max(0,roster.length-1));}\n\nwindow.VIBREX_GAME={\n  title:'보석 용사단',genre:'수집형 육성',goal:'파티를 육성해 스테이지10 클리어',\n  clearCondition:'스테이지 10 전투 승리',\n  controls:[\n    {input:'fire',action:'뽑기'},{input:'left',action:'슬롯 이전'},{input:'right',action:'슬롯 다음'},\n    {input:'item1~3',action:'보유 캐릭터 선택'},{input:'jump',action:'슬롯에 편성'},{input:'up',action:'전투 시작'}\n  ],\n  phase:()=>phase,\n  progress:()=>Math.min(1,stage/10),\n  state:()=>({\n    gems,stage,partyPower:Math.min(1,partyPower()/100),enemyPower:Math.min(1,enemyPowerAt(stage)/200),\n    rosterCount:roster.length,ssrCount:roster.filter(r=>r.rank==='SSR').length,\n    progress:Math.min(1,stage/10),score,canPull:gems>=10?1:0,\n    targetDX:0,targetDY:0,targetDist:Math.min(1,enemyPowerAt(stage)/200-partyPower()/200),\n    dangerDX:0,dangerDY:0,dangerDist:0,dangerETA:1,onGround:1,selfVX:0,selfVY:0,facing:1\n  }),\n  start(){startGame();},\n  restart(){restart();},\n  inputs:{\n    left:v=>{if(v)doLeft();},right:v=>{if(v)doRight();},\n    up:v=>{if(v)doUp();},down:v=>{if(v)doDown();},\n    jump:v=>{if(v)doJump();},fire:v=>{if(v)doFire();},\n    item1:v=>{if(v)selItem(0);},item2:v=>{if(v)selItem(1);},item3:v=>{if(v)selItem(2);},item4:v=>{}\n  }\n};\n\nfunction startGame(){\n  document.getElementById('ui').style.display='none';\n  phase='playing';gems=30;stage=1;roster=[];party=[null,null,null,null,null];score=0;msg='시작!';\n  if(window.AJ)AJ.start();\n  scoreUp();\n}\nfunction restart(){\n  document.getElementById('ui').innerHTML='';\n  phase='title';\n  showTitle();\n}\nfunction showTitle(){\n  let ui=document.getElementById('ui');\n  ui.style.display='flex';\n  ui.innerHTML='<h1>보석 용사단</h1><p>스테이지 자동전투로 보석 획득 → 뽑기 → 파티 편성 → 10스테이지 클리어!</p>'+\n  '<p style=\"text-align:left;font-size:13px\">조작<br>fire: 뽑기<br>left/right: 파티 슬롯 선택<br>item1~3: 보유 캐릭터 선택<br>jump: 슬롯에 편성<br>up: 전투 시작<br>down: 재시작</p>'+\n  '<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>';\n  document.getElementById('vibrex-start').onclick=startGame;\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\n\nfunction showEnd(txt){\n  let ui=document.getElementById('ui');\n  ui.style.display='flex';\n  ui.innerHTML='<h1>'+txt+'</h1><p>최종 점수: '+score+'</p><button data-vibrex-role=\"restart\">다시하기</button>';\n  ui.setAttribute('data-vibrex-role',phase==='cleared'?'clear':'over');\n  ui.querySelector('button').onclick=restart;\n}\n\nlet last=performance.now();\nfunction loop(t){\n  let dt=(t-last)/1000;last=t;\n  if(phase==='playing'){\n    updateBattle(dt);\n    if(phase==='cleared'){showEnd('클리어! 🎉');}\n  }\n  draw();\n  requestAnimationFrame(loop);\n}\nfunction draw(){\n  ctx.fillStyle='#181828';ctx.fillRect(0,0,cv.width,cv.height);\n  let w=cv.width,h=cv.height;\n  ctx.fillStyle='#fff';ctx.font='20px sans-serif';\n  ctx.fillText('💎 '+gems+'   스테이지 '+stage+'/10   점수 '+score,20,30);\n  ctx.font='13px sans-serif';\n  ctx.fillText('확률 R:'+(RATE.R*100)+'% SR:'+(RATE.SR*100)+'% SSR:'+(RATE.SSR*100)+'%',20,50);\n  ctx.fillText(msg,20,70);\n  // party slots\n  let sx=20,sy=100,sw=Math.min(90,(w-40)/5-8);\n  for(let i=0;i<5;i++){\n    let x=sx+i*(sw+8);\n    ctx.strokeStyle=i===slotSel?'#ff0':'#888';ctx.lineWidth=3;\n    ctx.strokeRect(x,sy,sw,sw);\n    let p=party[i];\n    if(p){\n      ctx.fillStyle=p.rank==='SSR'?'#ffd700':p.rank==='SR'?'#9b6bff':'#8ecbff';\n      ctx.fillRect(x+4,sy+4,sw-8,sw-8);\n      ctx.fillStyle='#000';ctx.font='11px sans-serif';\n      ctx.fillText(p.name,x+6,sy+sw/2);\n      ctx.fillText(p.rank+' Lv'+p.lv,x+6,sy+sw/2+14);\n    }\n  }\n  ctx.fillStyle='#fff';ctx.font='14px sans-serif';\n  ctx.fillText('파티 전력: '+Math.round(partyPower())+'  적 전력: '+Math.round(enemyPowerAt(stage)),20,sy+sw+25);\n  // roster\n  let ry=sy+sw+50;\n  ctx.fillText('보유 캐릭터 ('+roster.length+') - item1~3으로 선택: '+rosterSel,20,ry);\n  let rw=Math.min(80,(w-40)/6-6);\n  for(let i=0;i<roster.length;i++){\n    let x=20+i*(rw+6),y=ry+15;\n    if(x>w-rw-10){}\n    ctx.strokeStyle=i===rosterSel?'#ff0':'#555';\n    ctx.strokeRect(x,y,rw,40);\n    ctx.fillStyle=roster[i].rank==='SSR'?'#ffd700':roster[i].rank==='SR'?'#9b6bff':'#8ecbff';\n    ctx.fillRect(x+2,y+2,rw-4,36);\n    ctx.fillStyle='#000';ctx.font='10px sans-serif';\n    ctx.fillText(roster[i].name.slice(0,4),x+4,y+16);\n    ctx.fillText(roster[i].rank+'L'+roster[i].lv,x+4,y+30);\n  }\n  // battle status\n  if(inBattle){\n    ctx.fillStyle='#f55';ctx.font='24px sans-serif';\n    ctx.fillText('전투중...',w/2-40,h/2);\n  } else if(battleResult){\n    ctx.fillStyle=battleResult==='win'?'#5f5':'#f55';\n    ctx.font='24px sans-serif';\n    ctx.fillText(battleResult==='win'?'승리!':'패배...',w/2-40,h/2);\n  }\n  if(botOn){ctx.fillStyle='#ff0';ctx.font='16px sans-serif';}\n}\nrequestAnimationFrame(loop);\n\nlet botOn=false,botInterval=null;\nwindow.vibrexBot={\n  start(){\n    botOn=true;document.getElementById('tag').style.display='block';\n    if(document.getElementById('vibrex-start'))document.getElementById('vibrex-start').click();\n    botInterval=setInterval(()=>{\n      if(phase==='title'){startGame();return;}\n      if(phase==='playing'&&!inBattle){\n        if(gems>=10)pull();\n        // assign strongest available roster to weakest slots\n        let empty=party.findIndex(p=>!p);\n        if(empty>=0&&roster.length>0){\n          let best=roster.reduce((a,b)=>b.power*(1+b.lv*0.1)>a.power*(1+a.lv*0.1)?b:a);\n          slotSel=empty;rosterSel=roster.indexOf(best);\n          assignParty();\n        } else if(roster.length>0){\n          // replace weakest slot if roster has stronger unassigned char\n          let weakestIdx=0,weakestP=Infinity;\n          for(let i=0;i<5;i++){let p=party[i];let val=p?p.power*(1+p.lv*0.1):-1;if(val<weakestP){weakestP=val;weakestIdx=i;}}\n          let best=roster.reduce((a,b)=>b.power*(1+b.lv*0.1)>a.power*(1+a.lv*0.1)?b:a);\n          if(best.power*(1+best.lv*0.1)>weakestP){\n            slotSel=weakestIdx;rosterSel=roster.indexOf(best);assignParty();\n          } else {\n            startBattle();\n          }\n