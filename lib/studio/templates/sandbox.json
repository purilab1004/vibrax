age',{value:s,configurable:true})}catch(_){}})()}</script><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\"><title>지층 채굴 샌드박스</title>\n<style>\nhtml,body{margin:0;background:#000;overflow:hidden;height:100%}\n#wrap{position:absolute;top:0;left:0;width:960px;height:540px;transform-origin:top left}\ncanvas{position:absolute;top:0;left:0;background:#000}\n.ov{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;font-family:sans-serif;background:rgba(0,0,0,.75);text-align:center;box-sizing:border-box;padding:20px}\n.hidden{display:none!important}\nbutton{padding:10px 22px;font-size:18px;margin-top:12px;cursor:pointer;border-radius:8px;border:none;background:#4fc3f7;color:#000;font-weight:bold}\n#itembar{position:absolute;top:8px;right:8px;display:flex;gap:6px;touch-action:none}\n.ib{width:44px;height:44px;background:rgba(255,255,255,.25);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;border:2px solid transparent;user-select:none}\n.ib.act{border-color:#ff0}\n#useBtn{position:absolute;bottom:90px;right:80px;width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,.35);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;touch-action:none;user-select:none}\n</style></head>\n<body>\n<div id=\"wrap\">\n<canvas id=\"c\" width=\"960\" height=\"540\"></canvas>\n<div id=\"itembar\" class=\"hidden\">\n<div class=\"ib act\" id=\"ib0\">🟫</div><div class=\"ib\" id=\"ib1\">🪨</div><div class=\"ib\" id=\"ib2\">🪵</div><div class=\"ib\" id=\"ib3\">✨</div>\n</div>\n<div id=\"useBtn\" class=\"hidden\">놓기</div>\n<div id=\"titleScreen\" class=\"ov\">\n<h1>지층 채굴 샌드박스</h1>\n<p>목표: 광석 10개를 캐고, 높이 12칸의 탑을 쌓으면 클리어!</p>\n<p>조작: 방향키 이동 · Space 점프 · X 채굴(바라보는 방향) · C 블록 설치 · 1~4 아이템 선택<br>모바일: 좌하단 조이스틱 이동, 우측 버튼 점프/채굴/설치</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n<div id=\"overScreen\" class=\"ov hidden\">\n<h1>게임 오버</h1><p id=\"overScore\"></p>\n<button data-vibrex-role=\"restart\">다시하기</button>\n</div>\n<div id=\"clearScreen\" class=\"ov hidden\" data-vibrex-role=\"clear\">\n<h1>클리어! 🎉</h1><p id=\"clearScore\"></p>\n<button data-vibrex-role=\"restart\">다시하기</button>\n</div>\n</div>\n<script>\nconst wrap=document.getElementById('wrap'),cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){let s=Math.min(innerWidth/960,innerHeight/540);wrap.style.transform=`translate(${(innerWidth-960*s)/2}px,${(innerHeight-540*s)/2}px) scale(${s})`;}\naddEventListener('resize',resize);resize();\nconst LW=960,LH=540,TS=32,COLS=140,ROWS=26,GRAV=760,JUMPV=310,SPEED=140,PW=22,PH=30;\nlet tiles=[],placed=[];\nlet playerSkin=null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\nconst COLORS={1:'#8B5A2B',2:'#888888',3:'#5b3a1e',4:'#e8c34a'};\nfunction surfaceRow(x){return 10+Math.round(Math.sin(x*0.3)*2+Math.sin(x*0.13)*2);}\nfunction genWorld(){\n for(let x=0;x<COLS;x++){tiles[x]=[];placed[x]=[];let s=surfaceRow(x);\n  for(let y=0;y<ROWS;y++){let t=0;\n   if(y===s)t=1;else if(y>s&&y<s+3)t=1;else if(y>=s+3)t=(Math.random()<0.12)?4:2;\n   tiles[x][y]=t;placed[x][y]=false;}\n  if(Math.random()<0.08){let s2=surfaceRow(x);if(s2-1>=0)tiles[x][s2-1]=3;}\n }\n}\nfunction solid(px,py){let cx=Math.floor(px/TS),cy=Math.floor(py/TS);if(cy>=ROWS)return true;if(cy<0)return false;if(cx<0||cx>=COLS)return true;return tiles[cx][cy]!==0;}\nfunction colHeight(c){let n=0;for(let y=0;y<ROWS;y++)if(placed[c][y])n++;return n;}\nlet phase='title',score=0,ore=0,health=100,maxHeightEver=0,dayTimer=0,isNight=false,wasNight=false;\nlet inv={1:0,2:0,3:0,4:0},activeItem=1;\nlet px=0,py=0,pvx=0,pvy=0,onGround=false,facing=1,camX=0,camY=0;\nlet slimes=[];\nlet digCd=0,placeCd=0,dmgCd=0;\nlet dangerDX=0,dangerDY=0,dangerDist=1;\nlet botActive=false,progress=0;\nlet keys={left:false,right:false,up:false,down:false,jump:false,fire:false,guard:false,useItem:false,item1:false,item2:false,item3:false,item4:false};\nfunction spawnSlime(){let col=Math.floor(px/TS)+(Math.random()<0.5?-15-Math.floor(Math.random()*10):15+Math.floor(Math.random()*10));col=Math.max(1,Math.min(COLS-2,col));let s=surfaceRow(col);slimes.push({x:col*TS,y:(s-1)*TS,vy:0});if(slimes.length>8)slimes.shift();}\nfunction startGame(){\n genWorld();\n let sx=Math.floor(COLS/2),s=surfaceRow(sx);\n tiles[sx][s-1]=0;tiles[sx][s-2]=0;\n px=sx*TS+4;py=(s-2)*TS;pvx=0;pvy=0;\n score=0;ore=0;health=100;maxHeightEver=0;dayTimer=0;isNight=false;wasNight=false;\n inv={1:0,2:0,3:0,4:0};activeItem=1;\n slimes=[];digCd=0;placeCd=0;dmgCd=0;\n phase='playing';\n document.getElementById('titleScreen').classList.add('hidden');\n document.getElementById('overScreen').classList.add('hidden');\n document.getElementById('clearScreen').classList.add('hidden');\n document.getElementById('itembar').classList.remove('hidden');\n document.getElementById('useBtn').classList.remove('hidden');\n if(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\ndocument.querySelectorAll('[data-vibrex-role=\"restart\"]').forEach(b=>b.onclick=startGame);\nfunction clamp(v,a,b){return Math.max(a,Math.min(b,v));}\nfunction computeBot(){\n keys.left=false;keys.right=false;keys.jump=false;keys.fire=false;keys.useItem=false;\n let pc=Math.floor((px+PW/2)/TS),pr=Math.floor((py+PH/2)/TS);\n if(ore<10){\n  let best=null,bd=1e9;\n  for(let x=Math.max(0,pc-25);x<Math.min(COLS,pc+25);x++)\n   for(let y=Math.max(0,pr-10);y<Math.min(ROWS,pr+10);y++)\n    if(tiles[x][y]===4){let d=Math.abs(x-pc)+Math.abs(y-pr);if(d<bd){bd=d;best={x,y};}}\n  if(best){\n   if(best.x<pc-1)keys.left=true;else if(best.x>pc+1)keys.right=true;\n   if(best.y<pr)keys.jump=Math.random()<0.5;\n  } else {keys.right=true;}\n  keys.fire=true;\n  if(Math.random()<0.02)keys.jump=true;\n } else {\n  activeItem=inv[1]>0?1:(inv[2]>0?2:(inv[3]>0?3:4));\n  keys.useItem=true;\n  keys.jump=Math.random()<0.4;\n }\n}\nfunction update(dt){\n if(botActive)computeBot();\n if(keys.left)facing=-1;else if(keys.right)facing=1;\n pvx=keys.left?-SPEED:(keys.right?SPEED:0);\n pvy+=GRAV*dt;if(pvy>600)pvy=600;\n if(keys.jump&&onGround)pvy=-JUMPV;\n let nx=px+pvx*dt;\n if(!(solid(nx,py)||solid(nx+PW,py)||solid(nx,py+PH-1)||solid(nx+PW,py+PH-1)))px=nx;\n let ny=py+pvy*dt;\n onGround=false;\n if(!(solid(px,ny)||solid(px+PW,ny)||solid(px,ny+PH)||solid(px+PW,ny+PH))){py=ny;}\n else{if(pvy>0)onGround=true;pvy=0;}\n px=clamp(px,0,COLS*TS-PW);\n digCd-=dt;placeCd-=dt;dmgCd-=dt;\n let pc=Math.floor((px+PW/2)/TS),pr=Math.floor((py+PH/2)/TS);\n let tc=pc+facing,tr=pr;\n if(keys.fire&&digCd<=0&&tc>=0&&tc<COLS&&tr>=0&&tr<ROWS){\n  let t=tiles[tc][tr];\n  if(t!==0){tiles[tc][tr]=0;placed[tc][tr]=false;let pts=1;if(t===4){ore++;pts=10;}inv[t]=(inv[t]||0)+1;score+=pts;if(window.AJ)AJ.score(score);digCd=0.22;}\n }\n if(keys.useItem&&placeCd<=0&&tc>=0&&tc<COLS&&tr>=0&&tr<ROWS){\n  if(inv[activeItem]>0&&tiles[tc][tr]===0){\n   tiles[tc][tr]=activeItem;placed[tc][tr]=true;inv[activeItem]--;\n   let ch=colHeight(tc);\n   if(ch>maxHeightEver){score+=5*(ch-maxHeightEver);maxHeightEver=ch;if(window.AJ)AJ.score(score);}\n   placeCd=0.2;\n  }\n }\n dayTimer+=dt;isNight=(dayTimer%40)>20;\n if(isNight&&!wasNight){spawnSlime();spawnSlime();}\n wasNight=isNight;\n let nd=1e9,ddx=0,ddy=0;\n for(let s of slimes){\n  let vx=Math.sign((px)-(s.x))*40;\n  s.x+=vx*dt;s.vy+=GRAV*dt;\n  let sny=s.y+s.vy*dt;\n  if(solid(s.x+4,sny+24)||solid(s.x+20,sny+24)){s.vy=0;sny=Math.floor(sny/TS)*TS;}\n  s.y=sny;\n  let dx=s.x-px,dy=s.y-py,d=Math.hypot(dx,dy);\n  if(d<nd){nd=d;ddx=dx;ddy=dy;}\n  if(Math.abs(dx)<26&&Math.abs(dy)<28&&dmgCd<=0){health-=20;dmgCd=1;if(health<=0){phase='over';document.getElementById('overScore').textContent='점수: '+score;document.getElementById('overScreen').classList.remove('hidden');if(window.AJ)AJ.over(score);}}\n }\n dangerDX=slimes.length?clamp(ddx/300,-1,1):0;\n dangerDY=slimes.length?clamp(ddy/300,-1,1):0;\n dangerDist=slimes.length?clamp(nd/600,0,1):1;\n progress=Math.min(1,(ore/10+maxHeightEver/12)/2);\n if(ore>=10&&maxHeightEver>=12&&phase==='playing'){\n  phase='cleared';document.getElementById('clearScore').textContent='점수: '+score;document.getElementById('clearScreen').classList.remove('hidden');if(window.AJ)AJ.clear(score);\n }\n for(let i=0;i<4;i++)document.getElementById('ib'+i).classList.toggle('act',activeItem===i+1);\n camX=clamp(px+PW/2-LW/2,0,COLS*TS-LW);\n camY=clamp(py+PH/2-LH/2,0,ROWS*TS-LH);\n}\nfunction render(){\n ctx.clearRect(0,0,LW,LH);\n ctx.fillStyle=isNight?'#0a1030':'#7ec8e3';ctx.fillRect(0,0,LW,LH);\n let sc=Math.floor(camX/TS),ec=sc+Math.ceil(LW/TS)+2,sr=Math.floor(camY/TS),er=sr+Math.ceil(LH/TS)+2;\n for(let x=sc;x<ec;x++){if(x<0||x>=COLS)continue;for(let y=sr;y<er;y++){if(y<0||y>=ROWS)continue;let t=tiles[x][y];if(t===0)continue;\n  ctx.fillStyle=COLORS[t];let dx=x*TS-camX,dy=y*TS-camY;ctx.fillRect(dx,dy,TS,TS);\n  if(placed[x][y]){ctx.strokeStyle='#ff0';ctx.strokeRect(dx+1,dy+1,TS-2,TS-2);}\n }}\n ctx.fillStyle='#2ecc71';\n for(let s of slimes){ctx.beginPath();ctx.arc(s.x-camX+12,s.y-camY+12,14,0,7);ctx.fill();}\n let dx=px-camX,dy=py-camY;\n if(playerSkin)ctx.drawImage(playerSkin,dx-4,dy-6,PW+8,PH+8);\n else{ctx.fillStyle='#3498db';ctx.fillRect(dx,dy,PW,PH);ctx.fillStyle='#fff';ctx.fillRect(dx+(facing>0?PW-6:2),dy+6,4,4);}\n ctx.fillStyle='#fff';ctx.font='16px sans-serif';\n ctx.fillText('점수 '+score+'  광석 '+ore+'/10  높이 '+maxHeightEver+'/12',10,20);\n ctx.fillStyle='#500';ctx.fillRect(10,26,150,8);\n ctx.fillStyle='#e74c3c';ctx.fillRect(10,26,150*Math.max(0,health)/100,8);\n if(botActive){ctx.fillStyle='#ff0';ctx.font='18px sans-serif';}\n}\nlet