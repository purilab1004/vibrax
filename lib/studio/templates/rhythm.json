ewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>4레인 리듬 노트</title>\n<style>\nhtml,body{margin:0;background:#000;overflow:hidden;height:100%;touch-action:none}\ncanvas{display:block;margin:0 auto;background:#111}\n#ui{position:fixed;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;pointer-events:none}\n.panel{pointer-events:auto;background:#111;color:#fff;padding:20px;border-radius:10px;text-align:center;font-family:sans-serif;max-width:90vw}\nbutton{font-size:18px;padding:10px 20px;margin-top:10px;border-radius:8px;border:none;background:#0af;color:#fff}\nh1{font-size:22px}\nli{list-style:none}\n</style></head><body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\"></div>\n<script>\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nfunction resize(){let w=window.innerWidth,h=window.innerHeight;cv.width=w;cv.height=h;}\nwindow.addEventListener('resize',resize);resize();\n\nlet playerSkin=null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\n\nconst LANES=4,KEYS=['ArrowLeft','ArrowUp','ArrowDown','ArrowRight'];\nlet phase='title',notes=[],combo=0,maxCombo=0,health=100,score=0,acc={p:0,g:0,m:0};\nlet t0=0,elapsed=0,SONG=60,BPM=120,beatDur=60/BPM;\nlet laneHeld=[false,false,false,false];\nlet judgeY=0,laneEffects=[0,0,0,0];\nlet audioCtx=null,nextBeat=0,beatIdx=0,pattern=[];\n\nfunction buildPattern(){\n  pattern=[];\n  let totalBeats=Math.floor(SONG/beatDur);\n  for(let i=4;i<totalBeats-4;i++){\n    if(Math.random()<0.65){\n      let lane=Math.floor(Math.random()*4);\n      pattern.push({beat:i,lane});\n      if(Math.random()<0.15){\n        let l2=(lane+1+Math.floor(Math.random()*3))%4;\n        pattern.push({beat:i,lane:l2});\n      }\n    }\n  }\n  pattern.sort((a,b)=>a.beat-b.beat);\n}\n\nfunction initAudio(){\n  if(audioCtx)return;\n  try{audioCtx=new (window.AudioContext||window.webkitAudioContext)();}catch(e){}\n}\nfunction playClick(freq,t,dur,gain){\n  if(!audioCtx)return;\n  let o=audioCtx.createOscillator(),g=audioCtx.createGain();\n  o.type='square';o.frequency.value=freq;\n  g.gain.setValueAtTime(gain,t);\n  g.gain.exponentialRampToValueAtTime(0.001,t+dur);\n  o.connect(g);g.connect(audioCtx.destination);\n  o.start(t);o.stop(t+dur);\n}\nfunction audioTick(now){\n  if(!audioCtx)return;\n  let songT=now-t0;\n  while(nextBeat*beatDur<songT+0.5 && nextBeat*beatDur<SONG){\n    let bt=t0+nextBeat*beatDur;\n    playClick(nextBeat%4===0?880:440,bt,0.08,nextBeat%4===0?0.15:0.08);\n    nextBeat++;\n  }\n}\n\nfunction startGame(){\n  initAudio();\n  phase='playing';combo=0;maxCombo=0;health=100;score=0;acc={p:0,g:0,m:0};\n  notes=[];buildPattern();\n  t0=performance.now()/1000+0.5;\n  nextBeat=0;\n  elapsed=0;\n  if(window.AJ)AJ.start();\n}\nfunction restartGame(){startGame();}\n\nconst FALL=1.6; // seconds notes take to fall\nfunction spawnNotes(now){\n  let songT=now-t0;\n  for(let i=pattern.length-1;i>=0;i--){\n    let p=pattern[i];\n    let hitTime=p.beat*beatDur;\n    if(hitTime-songT<FALL && hitTime-songT>FALL-0.05){\n      notes.push({lane:p.lane,hitTime,judged:false});\n    }\n  }\n}\n\nfunction judgeLane(lane,now){\n  let songT=now-t0;\n  let best=null,bestDiff=999;\n  for(let n of notes){\n    if(n.lane===lane && !n.judged){\n      let diff=Math.abs(n.hitTime-songT);\n      if(diff<bestDiff){bestDiff=diff;best=n;}\n    }\n  }\n  if(best && bestDiff<0.15){\n    best.judged=true;\n    laneEffects[lane]=1;\n    if(bestDiff<0.06){acc.p++;combo++;score+=100;health=Math.min(100,health+1);}\n    else{acc.g++;combo++;score+=50;}\n    maxCombo=Math.max(maxCombo,combo);\n    if(window.AJ)AJ.score(score);\n  }\n}\n\nfunction update(){\n  if(phase!=='playing')return;\n  let now=performance.now()/1000;\n  elapsed=now-t0;\n  spawnNotes(now);\n  for(let n of notes){\n    if(!n.judged && now-t0-n.hitTime>0.15){\n      n.judged=true;combo=0;acc.m++;health-=8;laneEffects[n.lane]=0.5;\n      if(health<=0){\n        phase='over';\n        if(window.AJ)AJ.over(score);\n      }\n    }\n  }\n  notes=notes.filter(n=>!(n.judged && now-t0-n.hitTime>0.3));\n  for(let i=0;i<4;i++)laneEffects[i]=Math.max(0,laneEffects[i]-0.05);\n  if(elapsed>=SONG && phase==='playing'){\n    phase='cleared';\n    if(window.AJ)AJ.clear(score);\n  }\n  audioTick(now);\n}\n\nfunction laneX(lane){\n  let w=cv.width,lw=w/4;\n  return lw*lane+lw/2;\n}\n\nfunction draw(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,cv.width,cv.height);\n  judgeY=cv.height*0.82;\n  let lw=cv.width/4;\n  for(let i=0;i<4;i++){\n    ctx.strokeStyle='#333';ctx.beginPath();ctx.moveTo(lw*i,0);ctx.lineTo(lw*i,cv.height);ctx.stroke();\n  }\n  ctx.strokeStyle='#0af';ctx.lineWidth=4;\n  ctx.beginPath();ctx.moveTo(0,judgeY);ctx.lineTo(cv.width,judgeY);ctx.stroke();\n  ctx.lineWidth=1;\n  const labels=['←','↑','↓','→'];\n  for(let i=0;i<4;i++){\n    ctx.fillStyle=laneHeld[i]?'rgba(0,170,255,0.3)':'rgba(255,255,255,'+(0.1+laneEffects[i]*0.3)+')';\n    ctx.fillRect(lw*i,judgeY-40,lw,80);\n    ctx.fillStyle='#fff';ctx.font=(lw*0.4)+'px sans-serif';ctx.textAlign='center';\n    ctx.fillText(labels[i],laneX(i),judgeY+lw*0.15);\n  }\n  if(phase==='playing'){\n    let now=performance.now()/1000;\n    for(let n of notes){\n      if(n.judged)continue;\n      let timeLeft=n.hitTime-(now-t0);\n      let y=judgeY-(timeLeft/FALL)*judgeY;\n      if(y<-30||y>cv.height+30)continue;\n      ctx.fillStyle=['#f55','#5f5','#ff5','#5af'][n.lane];\n      ctx.beginPath();ctx.arc(laneX(n.lane),y,lw*0.28,0,7);ctx.fill();\n    }\n    ctx.fillStyle='#fff';ctx.font='20px sans-serif';ctx.textAlign='left';\n    ctx.fillText('Combo '+combo,10,30);\n    ctx.fillText('Score '+score,10,55);\n    ctx.fillText('HP',10,cv.height-20);\n    ctx.fillStyle='#f00';ctx.fillRect(50,cv.height-30,Math.max(0,health)*1.5,15);\n    ctx.strokeStyle='#fff';ctx.strokeRect(50,cv.height-30,150,15);\n    let total=acc.p+acc.g+acc.m;\n    let accP=total>0?(acc.p+acc.g*0.6)/total:1;\n    ctx.textAlign='right';\n    ctx.fillText('Acc '+Math.round(accP*100)+'%',cv.width-10,30);\n    ctx.fillText(Math.floor(elapsed)+'/'+SONG+'s',cv.width-10,55);\n  }\n  if(window.vibrexBot && window.vibrexBot._running){\n    ctx.fillStyle='#0f0';ctx.font='16px sans-serif';ctx.textAlign='center';\n    \n  }\n}\n\nfunction loop(){update();draw();requestAnimationFrame(loop);}\nloop();\n\nfunction renderUI(){\n  const ui=document.getElementById('ui');\n  if(phase==='title'){\n    ui.innerHTML=`<div class=\"panel\" data-vibrex-role=\"titlepanel\">\n    <h1>4레인 리듬 노트</h1>\n    <p>노트가 떨어지면 판정선에서 맞춰 눌러라!</p>\n    <ul style=\"text-align:left\">\n    <li>←/↑/↓/→ : 4레인 입력</li>\n    <li>모바일: 화면 4분할 터치</li>\n    </ul>\n    <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n    </div>`;\n    document.getElementById('vibrex-start').onclick=()=>{startGame();renderUI();};\n  } else if(phase==='over'){\n    ui.innerHTML=`<div class=\"panel\" data-vibrex-role=\"over\">\n    <h1>게임 오버</h1><p>점수: ${score}</p>\n    <button data-vibrex-role=\"restart\">다시하기</button></div>`;\n    ui.querySelector('[data-vibrex-role=restart]').onclick=()=>{restartGame();renderUI();};\n  } else if(phase==='cleared'){\n    let total=acc.p+acc.g+acc.m;\n    let accP=total>0?Math.round(((acc.p+acc.g*0.6)/total)*100):100;\n    ui.innerHTML=`<div class=\"panel\" data-vibrex-role=\"clear\">\n    <h1>클리어!</h1><p>최종 점수: ${score}</p><p>정확도: ${accP}%</p><p>최대 콤보: ${maxCombo}</p>\n    <button data-vibrex-role=\"restart\">다시하기</button></div>`;\n    ui.querySelector('[data-vibrex-role=restart]').onclick=()=>{restartGame();renderUI();};\n  } else {\n    ui.innerHTML='';\n  }\n}\nlet lastPhase='';\nfunction uiLoop(){\n  if(phase!==lastPhase){lastPhase=phase;renderUI();}\n  requestAnimationFrame(uiLoop);\n}\nuiLoop();\nrenderUI();\n\nfunction keyDown(e){\n  let idx=KEYS.indexOf(e.code)>=0?KEYS.indexOf(e.code):-1;\n  if(e.code==='ArrowLeft')idx=0;\n  else if(e.code==='ArrowUp')idx=1;\n  else if(e.code==='ArrowDown')idx=2;\n  else if(e.code==='ArrowRight')idx=3;\n  if(idx>=0){\n    e.preventDefault();\n    if(!laneHeld[idx]){\n      laneHeld[idx]=true;\n      if(phase==='playing')judgeLane(idx,performance.now()/1000);\n    }\n  }\n}\nfunction keyUp(e){\n  if(e.code==='ArrowLeft')laneHeld[0]=false;\n  else if(e.code==='ArrowUp')laneHeld[1]=false;\n  else if(e.code==='ArrowDown')laneHeld[2]=false;\n  else if(e.code==='ArrowRight')laneHeld[3]=false;\n}\nwindow.addEventListener('keydown',keyDown);\nwindow.addEventListener('keyup',keyUp);\n\nfunction touchHandler(e){\n  e.preventDefault();\n  for(let t of e.touches){\n    let lane=Math.floor(t.clientX/(cv.width/4));\n    lane=Math.max(0,Math.min(3,lane));\n    if(!laneHeld[lane]){\n      laneHeld[lane]=true;\n      if(phase==='playing')judgeLane(lane,performance.now()/1000);\n    }\n  }\n}\ncv.addEventListener('touchstart',touchHandler,{passive:false});\ncv.addEventListener('touchend',e=>{laneHeld=[false,false,false,false];},{passive:false});\n\nfunction laneETA(lane){\n  let now=performance.now()/1000;\n  let best=999;\n  for(let n of notes){\n    if(n.lane===lane && !n.judged){\n      let t=n.hitTime-(now-t0);\n      if(t<best)best=t;\n    }\n  }\n  if(best===999)return 1;\n  return Math.max(0,Math.min(1,best/FALL));\n}\n\nwindow.VIBREX_GAME={\n  title:'4레인 리듬 노트',\n  genre:'리듬',\n  goal:'60초 곡을 끝까지 클리어',\n  clearCondition:'체력 0 되기 전에 곡 완주',\n  controls:[\n    {input:'ArrowLeft',action:'레인0 입력'},\n    {input:'ArrowUp',action:'레인1 입력'},\n    {input:'ArrowDown',action:'레인2 입력'},\n    {input:'ArrowRight',action:'레인3 입력'}\n  ],\n  phase:()=>phase==='title'?'title':phase==='playing'?'playing':phase==='over'?'over':phase==='cleared'?'cleared':'title',\n  progress:()=>Math.min(1,elapsed/SONG),\n  state:()=>{\n    let total=acc.p+acc.g+acc.m;\n    let accP=total>0?(acc.p+ac