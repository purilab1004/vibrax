"지구의 위성은?\",[\"달\",\"화성\",\"금성\",\"목성\"],0],\n[\"세계에서 인구가 가장 많은 나라는?\",[\"중국\",\"인도\",\"미국\",\"러시아\"],0],\n[\"곤충의 다리는 몇 개?\",[\"6개\",\"4개\",\"8개\",\"10개\"],0],\n[\"대한민국의 계절은 몇 개?\",[\"4개\",\"3개\",\"2개\",\"5개\"],0],\n[\"설날에 먹는 음식은?\",[\"떡국\",\"송편\",\"팥죽\",\"수정과\"],0],\n[\"사람의 뼈는 총 몇 개?\",[\"206개\",\"100개\",\"300개\",\"150개\"],0],\n[\"1리터는 몇 밀리리터?\",[\"1000ml\",\"100ml\",\"10ml\",\"500ml\"],0],\n[\"세계 최초의 인공위성은?\",[\"스푸트니크\",\"아폴로\",\"보이저\",\"허블\"],0],\n[\"대한민국 국기의 이름은?\",[\"태극기\",\"무궁화기\",\"오성기\",\"일장기\"],0],\n[\"봄 다음 계절은?\",[\"여름\",\"가을\",\"겨울\",\"봄\"],0],\n[\"숫자 0을 발명한 문명은?\",[\"인도\",\"이집트\",\"그리스\",\"로마\"],0],\n[\"대한민국의 표준시는 UTC+9이다.\",[\"O\",\"X\"],0],\n[\"피타고라스는 수학자다.\",[\"O\",\"X\"],0],\n[\"원의 지름은 반지름의 몇 배?\",[\"2배\",\"3배\",\"4배\",\"1배\"],0],\n[\"사람의 눈은 몇 개?\",[\"2개\",\"1개\",\"3개\",\"4개\"],0],\n[\"가을에 부는 바람의 대표 축제는?\",[\"단풍\",\"눈사람\",\"벚꽃\",\"해수욕\"],0],\n[\"세계지도에서 적도가 지나는 대륙은?\",[\"아프리카\",\"유럽\",\"북극\",\"남극\"],0],\n[\"대한민국의 전통 옷은?\",[\"한복\",\"기모노\",\"치파오\",\"사리\"],0],\n[\"가장 가까운 행성 순서상 지구 다음은?\",[\"화성\",\"금성\",\"목성\",\"토성\"],0],\n[\"로마는 하루아침에 이루어지지 않았다는 속담이 있다.\",[\"O\",\"X\"],0],\n[\"삼국지의 배경 국가는?\",[\"중국\",\"일본\",\"한국\",\"몽골\"],0],\n[\"대한민국의 최북단 도시는?\",[\"파주\",\"부산\",\"제주\",\"목포\"],0],\n[\"12개월 중 31일까지 있는 달의 개수는?\",[\"7개\",\"6개\",\"5개\",\"12개\"],0],\n[\"새는 알을 낳는다.\",[\"O\",\"X\"],0],\n[\"거미는 곤충이다.\",[\"O\",\"X\"],1],\n[\"세계에서 가장 긴 강은?\",[\"나일강\",\"아마존강\",\"황하강\",\"한강\"],0],\n[\"소금의 화학식은?\",[\"NaCl\",\"H2O\",\"CO2\",\"KCl\"],0],\n[\"대한민국의 공용어는?\",[\"한국어\",\"영어\",\"일본어\",\"중국어\"],0],\n[\"7의 배수가 아닌 것은?\",[\"15\",\"14\",\"21\",\"28\"],0],\n[\"별은 낮에도 하늘에 있다.\",[\"O\",\"X\"],0],\n[\"초등학교는 몇 년제인가?\",[\"6년\",\"3년\",\"4년\",\"5년\"],0],\n[\"대한민국의 화폐 최고액권은?\",[\"5만원\",\"1만원\",\"10만원\",\"1000원\"],0],\n[\"나무는 광합성을 한다.\",[\"O\",\"X\"],0],\n[\"1시간은 몇 분?\",[\"60분\",\"100분\",\"30분\",\"120분\"],0]\n];\nfunction shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nlet W,H;\nfunction resize(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}\nwindow.addEventListener('resize',resize);resize();\n\nlet playerSkin=null;\nwindow.addEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.();});\nwindow.addEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\n\nlet phase='title',questions=[],qi=0,score=0,correct=0,wrong=0,streak=0,selected=0,timeLeft=10,timer=null,botTimer=0;\nlet keys={left:false,right:false,up:false,down:false,jump:false,fire:false,guard:false,item1:false,item2:false,item3:false,item4:false,useItem:false};\n\nfunction newGame(){\n  questions=shuffle(QB.slice()).slice(0,20).map(q=>{\n    let opts=q[1].map((t,i)=>({t,orig:i}));\n    let ansOrig=q[2];\n    let ansText=q[1][ansOrig];\n    if(opts.length===4)opts=shuffle(opts);\n    let ansIdx=opts.findIndex(o=>o.orig===ansOrig);\n    return{q:q[0],opts:opts.map(o=>o.t),ans:ansIdx};\n  });\n  qi=0;score=0;correct=0;wrong=0;streak=0;selected=0;timeLeft=10;\n}\nfunction startGame(){\n  newGame();phase='playing';\n  if(window.AJ)AJ.start();\n  loadQ();\n  clearInterval(timer);timer=setInterval(tick,100);\n}\nfunction loadQ(){\n  if(qi>=questions.length){clearInt();phase='cleared';if(window.AJ)AJ.clear(score);return;}\n  timeLeft=10;selected=0;\n}\nfunction clearInt(){clearInterval(timer);}\nfunction tick(){\n  if(phase!=='playing')return;\n  timeLeft-=0.1;\n  if(timeLeft<=0){onWrong();}\n}\nfunction onWrong(){\n  wrong++;streak=0;\n  if(wrong>=3){clearInt();phase='over';if(window.AJ)AJ.over(score);return;}\n  qi++;loadQ();\n}\nfunction onCorrect(){\n  correct++;streak++;\n  let bonus=Math.floor(timeLeft*10);\n  score+=100+bonus;\n  if(window.AJ)AJ.score(score);\n  qi++;loadQ();\n}\nfunction confirmSelect(){\n  if(phase!=='playing')return;\n  const q=questions[qi];\n  if(selected===q.ans)onCorrect();else onWrong();\n}\nfunction restart(){\n  startGame();\n}\n\nwindow.VIBREX_GAME={\n  title:'상식퀴즈',genre:'퀴즈',goal:'20문제를 풀어라',clearCondition:'20문제 완주',\n  controls:[\n    {input:'up/down',action:'보기 이동'},\n    {input:'item1~item4',action:'보기 직접 선택'},\n    {input:'fire',action:'정답 확정'}\n  ],\n  phase:()=>phase,\n  progress:()=>qi/20,\n  state:()=>({\n    questionIndex:qi,correct,wrong,timeLeft,progress:qi/20,score,streak,selected,\n    lives:3-wrong,targetDist:qi<questions.length?timeLeft/10:0\n  }),\n  start:()=>{ if(phase==='title')startGame(); },\n  restart:()=>{ restart(); },\n  inputs:{\n    left:v=>{},right:v=>{},\n    up:v=>{ if(v&&phase==='playing'){const n=questions[qi].opts.length;selected=(selected-1+n)%n;} },\n    down:v=>{ if(v&&phase==='playing'){const n=questions[qi].opts.length;selected=(selected+1)%n;} },\n    jump:v=>{},\n    fire:v=>{ if(v)confirmSelect(); },\n    guard:v=>{},\n    item1:v=>{ if(v&&phase==='playing'&&questions[qi].opts.length>0)selected=0; },\n    item2:v=>{ if(v&&phase==='playing'&&questions[qi].opts.length>1)selected=1; },\n    item3:v=>{ if(v&&phase==='playing'&&questions[qi].opts.length>2)selected=2; },\n    item4:v=>{ if(v&&phase==='playing'&&questions[qi].opts.length>3)selected=3; },\n    useItem:v=>{}\n  }\n};\n\ndocument.addEventListener('keydown',e=>{\n  if(e.code==='ArrowUp')VIBREX_GAME.inputs.up(true);\n  if(e.code==='ArrowDown')VIBREX_GAME.inputs.down(true);\n  if(e.code==='Space'){VIBREX_GAME.inputs.fire(true);e.preventDefault();}\n  if(e.code==='Digit1')VIBREX_GAME.inputs.item1(true);\n  if(e.code==='Digit2')VIBREX_GAME.inputs.item2(true);\n  if(e.code==='Digit3')VIBREX_GAME.inputs.item3(true);\n  if(e.code==='Digit4')VIBREX_GAME.inputs.item4(true);\n});\n\nlet botActive=false,botSkill=0.7,botTimeout=null;\nwindow.vibrexBot={\n  start(){\n    botActive=true;\n    if(phase==='title')VIBREX_GAME.start();\n    botLoop();\n  },\n  stop(){ botActive=false; if(botTimeout)clearTimeout(botTimeout); },\n  setSkill(s){ botSkill=s; }\n};\nfunction botLoop(){\n  if(!botActive)return;\n  if(phase==='title'){VIBREX_GAME.start();}\n  else if(phase==='over'||phase==='cleared'){VIBREX_GAME.restart();}\n  else if(phase==='playing'){\n    const q=questions[qi];\n    let target;\n    if(Math.random()<botSkill){ target=q.ans; }\n    else { let idx=Math.floor(Math.random()*q.opts.length); target=idx; }\n    let n=q.opts.length;\n    let tries=0;\n    while(selected!==target&&tries<n+2){\n      if(selected<target)VIBREX_GAME.inputs.down(true);\n      else VIBREX_GAME.inputs.up(true);\n      tries++;\n    }\n    VIBREX_GAME.inputs.fire(true);\n  }\n  botTimeout=setTimeout(botLoop,600);\n}\n\nfunction drawTitle(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,W,H);\n  ctx.fillStyle='#fff';ctx.textAlign='center';\n  ctx.font='bold 36px sans-serif';ctx.fillText('상식퀴즈',W/2,H/2-120);\n  ctx.font='18px sans-serif';\n  ctx.fillText('4지선다/OX 20문제, 3회 오답시 게임오버',W/2,H/2-70);\n  ctx.fillText('조작: ↑/↓ 보기이동, 1~4 직접선택, Space 확정',W/2,H/2-40);\n  if(playerSkin){ ctx.drawImage(playerSkin,W/2-40,H/2-20,80,80); }\n  else{ ctx.font='40px sans-serif';ctx.fillText('❓',W/2,H/2+40); }\n}\nfunction drawPlaying(){\n  ctx.fillStyle='#111';ctx.fillRect(0,0,W,H);\n  ctx.fillStyle='#fff';ctx.textAlign='left';\n  ctx.font='16px sans-serif';\n  ctx.fillText('문제 '+(qi+1)+'/20  점수:'+score+'  오답:'+wrong+'/3  연속:'+streak,20,30);\n  ctx.fillStyle=timeLeft<3?'#f55':'#5f5';\n  ctx.fillRect(20,45,Math.max(0,(W-40)*(timeLeft/10)),10);\n  ctx.strokeStyle='#888';ctx.strokeRect(20,45,W-40,10);\n  const q=questions[qi];\n  ctx.fillStyle='#fff';ctx.textAlign='center';\n  ctx.font='bold 24px sans-serif';\n  wrapText(q.q,W/2,H*0.3,W-60,32);\n  let oy=H*0.45;\n  q.opts.forEach((o,i)=>{\n    ctx.fillStyle= i===selected?'#4a90d9':'#333';\n    ctx.fillRect(W/2-200,oy-25,400,45);\n    ctx.fillStyle='#fff';ctx.font='18px sans-serif';\n    ctx.fillText((i+1)+'. '+o,W/2,oy+5);\n    oy+=60;\n  });\n  if(playerSkin){ ctx.drawImage(playerSkin,20,H-70,50,50); }\n}\nfunction wrapText(t,x,y,mw,lh){\