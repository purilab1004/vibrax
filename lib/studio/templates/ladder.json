ta-vibrex-role=\"start\">시작</button>';\n    document.getElementById('vibrex-start').onclick=startGame;\n  } else if(phase==='over'){\n    ov.style.display='flex';\n    ov.innerHTML='<h1>게임 오버</h1><p>최종 점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button>';\n    document.getElementById('rb').onclick=restart;\n  } else if(phase==='cleared'){\n    ov.style.display='flex'; ov.setAttribute('data-vibrex-role','clear');\n    ov.innerHTML='<h1>🎉 클리어!</h1><p>최종 점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button>';\n    document.getElementById('rb').onclick=restart;\n  } else {\n    ov.style.display='none'; ov.removeAttribute('data-vibrex-role');\n  }\n}\nupdateOv();\n\nfunction layout(){\n  const mx=Math.max(40,cv.width*0.08),top=Math.max(70,cv.height*0.12),bot=cv.height-Math.max(70,cv.height*0.12);\n  const gap=lanes>1?(cv.width-2*mx)/(lanes-1):0;\n  const rg=(bot-top)/ROWS;\n  return {mx,top,bot,gap,rg,x:i=>mx+i*gap};\n}\n\nfunction draw(){\n  ctx.fillStyle='#000';ctx.fillRect(0,0,cv.width,cv.height);\n  if(phase==='title'){requestAnimationFrame(draw);return}\n  const L=layout();\n  ctx.strokeStyle='#666';ctx.lineWidth=3;\n  for(let i=0;i<lanes;i++){ ctx.beginPath();ctx.moveTo(L.x(i),L.top);ctx.lineTo(L.x(i),L.bot);ctx.stroke(); }\n  if(revealed){\n    ctx.strokeStyle='#39f';ctx.lineWidth=4;\n    for(let r=0;r<ROWS;r++){ const y=L.top+r*L.rg;\n      for(let i=0;i<lanes-1;i++){ if(bridges[r][i]){ ctx.beginPath();ctx.moveTo(L.x(i),y);ctx.lineTo(L.x(i+1),y);ctx.stroke(); } } }\n  }\n  if(hintFlash>0){\n    ctx.strokeStyle='rgba(255,220,0,'+Math.min(1,hintFlash)+')';ctx.lineWidth=8;\n    ctx.beginPath();ctx.moveTo(L.x(winStart),L.top-20);ctx.lineTo(L.x(winStart),L.top);ctx.stroke();\n  }\n  for(let i=0;i<lanes;i++){\n    ctx.fillStyle='#0af';ctx.font='16px sans-serif';ctx.textAlign='center';\n    ctx.fillText(String.fromCharCode(65+i),L.x(i),L.top-24);\n    let icon='?';\n    if(phase==='result'||phase==='over'||phase==='clear