5';ctx.beginPath();ctx.arc(x,y,12,0,7);ctx.fill(); }\n}\nrequestAnimationFrame(draw);\n\nfunction doLeft(){ if(phase==='select'&&selLane>0) selLane--; }\nfunction doRight(){ if(phase==='select'&&selLane<lanes-1) selLane++; }\nfunction doFire(){ confirmPick(); }\nfunction doGuard(){ if(phase==='select'&&hintLeft>0){ hintLeft=0; hintFlash=1; } }\n\naddEventListener('keydown',e=>{\n  if(keys[e.code])return; keys[e.code]=true;\n  if(e.code==='ArrowLeft')doLeft();\n  if(e.code==='ArrowRight')doRight();\n  if(e.code==='Space'||e.code==='KeyX')doFire();\n  if(e.code==='KeyC')doGuard();\n});\naddEventListener('keyup',e=>{keys[e.code]=false});\n\nwindow.VIBREX_GAME={\n  title:'사다리 게임',genre:'퍼즐',goal:'10스테이지까지 당첨 사다리를 찾아라',\n  clearCondition:'스테이지 10에서 당첨 도달',\n  controls:[{input:'ArrowLeft',action:'줄 왼쪽'},{input:'ArrowRight',action:'줄 오른쪽'},{input:'fire',action:'확정'},{input:'guard',action:'힌트'}],\n  phase:()=>phase==='title'?'title':phase==='over'?'over':phase==='cleared'?'cleared':'playing',\n  progress:()=>Math.min(1,(stage-1)/10),\n  state:()=>({\n    score,lives,stage,progress:Math.min(1,(stage-1)/10),lane:selLane,lanes,\n    hint:hintLeft,revealed:revealed?1:0,phase,\n    targetDX: lanes>1?((winStart-selLane)/(lanes-1))*2:0,\n    targetDist: lanes>1?Math.abs(winStart-selLane)/(lanes-1):0,\n    onGround:1\n  }),\n  start:startGame,restart:restart,\n  inputs:{\n    left:on=>{if(on)doLeft()}, right:on=>{if(on)doRight()},\n    up:()=>{}, down:()=>{},\n    jump:on=>{if(on)doFire()}, fire:on=>{if(on)doFire()},\n    guard:on=>{if(on)doGuard()}, useItem:()=>{},\n    item1:()=>{},item2:()=>{},item3:()=>{},item4:()=>{}\n  }\n};\n\nlet botOn=false,botTimer=0,botTargetSet=false;\nwindow.vibrexBot={\n  start(){ botOn=true; window.vibrexBotOn=true; },\n  stop(){ botOn=false; window.vibrexBotOn=false; },\n  setSkill(){}\n};\nfunction botLoop(){\n  if(botOn){\n    if(phase==='title'){ startGame(); }\n    else if(phase==='select'){\n      botTimer+=1/60;\n      if(selLane<winStart) doR