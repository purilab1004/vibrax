iewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>초소형 전략전쟁</title>\n<style>\nhtml,body{margin:0;background:#000;overflow:hidden;height:100%}\ncanvas{display:block;margin:auto;background:#111;touch-action:none}\n#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-family:sans-serif;text-align:center}\nbutton{font-size:18px;padding:10px 20px;margin:4px;border-radius:8px;border:none;background:#4a90d9;color:#fff}\n#bot{position:fixed;top:6px;right:6px;color:#ff0;font-family:monospace;display:none}\n</style></head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"bot\"></div>\n<div id=\"ui\"></div>\n<script>\n(function(){\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nconst W=800,H=450;\nfunction fit(){let sc=Math.min(innerWidth/W,innerHeight/H);cv.width=W;cv.height=H;cv.style.width=(W*sc)+'px';cv.style.height=(H*sc)+'px';}\naddEventListener('resize',fit);fit();\n\nlet phase='title';\nlet minerals,workers,soldiers,archers,armyPosM,armyModeM;\nlet eMinerals,eWorkers,eSoldiers,eArchers,armyPosE,armyModeE;\nlet myBaseHp,enemyBaseHp,score,timeT;\nconst MYBASE=40,ENBASE=760;\nconst SCOST=50,ACOST=60,WCOST=40;\nlet prevI={1:false,2:false,3:false};\n\nfunction reset(){\n minerals=100;workers=3;soldiers=0;archers=0;armyPosM=MYBASE;armyModeM='guard';\n eMinerals=100;eWorkers=3;eSoldiers=0;eArchers=0;armyPosE=ENBASE;armyModeE='guard';\n myBaseHp=500;enemyBaseHp=500;score=0;timeT=0;\n prevI={1:false,2:false,3:false};\n phase='playing';\n}\n\nfunction myPow(){return soldiers*5+archers*8;}\nfunction myHp(){return soldiers*20+archers*15;}\nfunction enPow(){return eSoldiers*5+eArchers*8;}\nfunction enHp(){return eSoldiers*20+eArchers*15;}\nfunction dmg(side,d){\n if(side==='me'){let h=myHp();if(h<=0)return;let r=Math.min(1,d/h);let s2=Math.round(soldiers*r),a2=Math.round(archers*r);soldiers=Math.max(0,soldiers-s2);archers=Math.max(0,archers-a2);}\n else{let h=enHp();if(h<=0)return;let r=Math.min(1,d/h);let s2=Math.round(eSoldiers*r),a2=Math.round(eArchers*r);eSoldiers=Math.max(0,eSoldiers-s2);eArchers=Math.max(0,eArchers-a2);}\n}\nfunction setScore(v){if(v!=score){score=v;if(window.AJ)AJ.score(Math.round(score));}}\n\nfunction step(dt){\n timeT+=dt;\n minerals+=workers*0.6*dt;\n eMinerals+=eWorkers*0.6*dt;\n let tgtM = armyModeM==='attack'?ENBASE-60:MYBASE+10;\n armyPosM += Math.sign(tgtM-armyPosM)*Math.min(Math.abs(tgtM-armyPosM),60*dt);\n let tgtE = armyModeE==='attack'?MYBASE+60:ENBASE-10;\n armyPosE += Math.sign(tgtE-armyPosE)*Math.min(Math.abs(tgtE-armyPosE),60*dt);\n let haveM=soldiers+archers>0, haveE=eSoldiers+eArchers>0;\n if(haveM&&haveE&&Math.abs(armyPosM-armyPosE)<45){\n  dmg('enemy',myPow()*dt);dmg('me',enPow()*dt);\n  if(soldiers+archers<=0)armyModeM='guard';\n  if(eSoldiers+eArchers<=0)armyModeE='guard';\n } else {\n  if(haveM&&armyModeM==='attack'&&armyPosM>=ENBASE-65){enemyBaseHp-=myPow()*dt;}\n  if(haveE&&armyModeE==='attack'&&armyPosE<=MYBASE+65){myBaseHp-=enPow()*dt;}\n }\n setScore(Math.round((500-enemyBaseHp)+minerals*0.1));\n eAI(dt);\n if(myBaseHp<=0){myBaseHp=0;phase='over';if(window.AJ)AJ.over(Math.round(score));}\n if(enemyBaseHp<=0){enemyBaseHp=0;phase='cleared';if(window.AJ)AJ.clear(Math.round(score));}\n}\n\nlet eTimer=0;\nfunction eAI(dt){\n eTimer+=dt;\n if(eTimer<0.5)return;eTimer=0;\n if(eWorkers<5&&eMinerals>=WCOST){eMinerals-=WCOST;eWorkers++;return;}\n if(eMinerals>=SCOST&&Math.random()<0.5){eMinerals-=SCOST;eSoldiers++;}\n else if(eMinerals>=ACOST){eMinerals-=ACOST;eArchers++;}\n if(eSoldiers+eArchers>=8)armyModeE='attack';\n if(myBaseHp<450)armyModeE='attack';\n}\n\nfunction produce(n){\n if(n===1&&minerals>=SCOST){minerals-=SCOST;soldiers++;}\n if(n===2&&minerals>=ACOST){minerals-=ACOST;archers++;}\n if(n===3&&minerals>=WCOST){minerals-=WCOST;workers++;}\n}\n\nfunction setInput(k,v){\n if(k==='fire'&&v)armyModeM='attack';\n if(k==='guard'&&v)armyModeM='guard';\n if(k==='item1'||k==='item2'||k==='item3'){\n  let n=+k.slice(4);\n  if(v&&!prevI[n])produce(n);\n  prevI[n]=v;\n }\n}\n\nfunction draw(){\n ctx.clearRect(0,0,W,H);\n ctx.fillStyle='#123';ctx.fillRect(0,0,W,H);\n ctx.fillStyle='#246';ctx.fillRect(0,H-60,W,60);\n ctx.fillStyle=`rgba(80,160,255,${0.3+0.7*(myBaseHp/500)})`;ctx.fillRect(MYBASE-25,H/2-40,50,80);\n ctx.fillStyle=`rgba(255,90,90,${0.3+0.7*(enemyBaseHp/500)})`;ctx.fillRect(ENBASE-25,H/2-40,50,80);\n ctx.fillStyle='#fff';ctx.font='14px monospace';\n ctx.fillText('내기지 '+Math.round(myBaseHp),MYBASE-30,H/2-50);\n ctx.fillText('적기지 '+Math.round(enemyBaseHp),ENBASE-70,H/2-50);\n ctx.fillStyle='#8cf';ctx.beginPath();ctx.arc(170,H/2,14,0,7);ctx.fill();\n for(let i=0;i<workers;i++){let x=MYBASE+20+((timeT*30+i*40)%100);ctx.fillStyle='#ff0';ctx.beginPath();ctx.arc(x,H/2+60+((i%3)*10),5,0,7);ctx.fill();}\n if(soldiers+archers>0){ctx.fillStyle='#0f0';ctx.beginPath();ctx.arc(armyPosM,H/2,8+Math.min(20,soldiers+archers),0,7);ctx.fill();ctx.fillStyle='#fff';ctx.fillText(soldiers+'S '+archers+'A',armyPosM-20,H/2-20);}\n if(eSoldiers+eArchers>0){ctx.fillStyle='#f55';ctx.beginPath();ctx.arc(armyPosE,H/2,8+Math.min(20,eSoldiers+eArchers),0,7);ctx.fill();}\n ctx.fillStyle='#fff';ctx.font='13px monospace';\n ctx.fillText('광물:'+Math.floor(minerals)+' 일꾼:'+workers+' 병사:'+soldiers+' 궁수:'+archers,10,20);\n ctx.fillText('모드:'+(armyModeM==='attack'?'진격':'귀환'),10,38);\n drawButtons();\n}\n\nconst btns=[\n {id:'fire',x:660,y:340,r:32,label:'⚔진격'},\n {id:'guard',x:730,y:340,r:32,label:'🛡귀환'},\n {id:'item1',x:60,y:400,r:28,label:'병사'},\n {id:'item2',x:130,y:400,r:28,label:'궁수'},\n {id:'item3',x:200,y:400,r:28,label:'일꾼'},\n];\nfunction drawButtons(){\n for(const b of btns){\n  ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,7);ctx.fillStyle='rgba(255,255,255,0.25)';ctx.fill();\n  ctx.fillStyle='#fff';ctx.font='12px sans-serif';ctx.textAlign='center';\n  ctx.fillText(b.label,b.x,b.y+4);ctx.textAlign='left';\n }\n}\nfunction hitBtn(px,py){for(const b of btns){if((px-b.x)**2+(py-b.y)**2<=b.r*b.r)return b.id;}return null;}\nfunction localPt(cx,cy){const r=cv.getBoundingClientRect();return [(cx-r.left)/r.width*W,(cy-r.top)/r.height*H];}\nconst activeTouches={};\ncv.addEventListener('pointerdown',e=>{\n const[px,py]=localPt(e.clientX,e.clientY);\n const id=hitBtn(px,py);\n if(id){activeTouches[e.pointerId]=id;setInput(id,true);}\n e.preventDefault();\n});\ncv.addEventListener('pointerup',e=>{const id=activeTouches[e.pointerId];if(id){setInput(id,false);delete activeTouches[e.pointerId];}});\ncv.addEventListener('pointercancel',e=>{const id=activeTouches[e.pointerId];if(id){setInput(id,false);delete activeTouches[e.pointerId];}});\n\naddEventListener('keydown',e=>{\n if(e.code==='Space')setInput('fire',true);\n if(e.code==='KeyG')setInput('guard',true);\n if(e.code==='Digit1')setInput('item1',true);\n if(e.code==='Digit2')setInput('item2',true);\n if(e.code==='Digit3')setInput('item3',true);\n});\naddEventListener('keyup',e=>{\n if(e.code==='Space')setInput('fire',false);\n if(e.code==='KeyG')setInput('guard',false);\n if(e.code==='Digit1')setInput('item1',false);\n if(e.code==='Digit2')setInput('item2',false);\n if(e.code==='Digit3')setInput('item3',false);\n});\n\nconst ui=document.getElementById('ui');\nfunction showTitle(){\n ui.style.display='flex';\n ui.innerHTML='<div><h1>초소형 전략전쟁</h1><p>일꾼이 광물을 캐고 병사·궁수를 생산해 적 기지를 파괴하라</p>'+\n '<p>fire=전군 진격 · guard=전군 귀환 · item1=병사생산 · item2=궁수생산 · item3=일꾼생산</p>'+\n '<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>';\n document.getElementById('vibrex-start').onclick=startGame;\n}\nfunction showOver(win){\n ui.style.display='flex';\n ui.setAttribute('data-vibrex-role',win?'clear':'');\n ui.innerHTML='<div><h1>'+(win?'승리! 적 기지 파괴':'패배...')+'</h1><p>점수: '+Math.round(score)+'</p>'+\n '<button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>';\n document.getElementById('rb').onclick=startGame;\n}\nfunction startGame(){\n ui.style.display='none';ui.removeAttribute('data-vibrex-role');\n reset();\n if(window.AJ)AJ.start();\n}\nshowTitle();\n\nlet last=performance.now();\nfunction loop(now){\n let dt=Math.min(0.05,(now-last)/1000);last=now;\n if(phase==='playing'){\n  step(dt);draw();\n  if(phase==='over')showOver(false);\n  if(phase==='cleared')showOver(true);\n } else if(phase==='cleared'||phase==='over'){draw();}\n requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nlet playerSkin=null;\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null;});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck&&window.vibrexAvatarAck();}\n\nwindow.VIBREX_GAME={\n title:'초소형 전략전쟁',genre:'RTS',\n goal:'적 기지를 파괴하라',clearCondition:'적 기지 HP 0',\n controls:[\n  {input:'fire',action:'전군 진격'},\n  {input:'guard',action:'전군 귀환'},\n  {input:'item1',action:'병사 생산'},\n  {input:'item2',action:'궁수 생산'},\n  {input:'item3',action:'일꾼 생산'},\n ],\n touchUI:'custom',\n phase:()=>phase,\n progress:()=>phase==='playing'||phase==='cleared'||phase==='over'?Math.max(0,Math.min(1,(500-enemyBaseHp)/500)):0,\n state:()=>({\n  minerals:Math.floor(minerals||0),workers:workers||0,soldiers:soldiers||0,archers:archers||0,\n  enemyArmy:(eSoldiers||0)+(eArchers||0),\n  enemyBaseHp:phase==='playing'?enemyBaseHp/500:(phase==='cleared'?0:1),\n  myBaseHp:phase==='playing'?myBaseHp/500:(phase==='over'?0:1),\n  lives:phase==='playing'?myBaseHp/500:1,\n  score:Math.round(score||0),\n  progress:phase==='playing'?(500-enemyBaseHp)/500:0,\n  armyPower:Math.min(1,((soldiers||0)+(archers||0))/15),\n  targetDX:1,targetDY:0,targetDist:phase==='playing'?Math.max(0,(ENBASE-armyPosM)/800):0,\n  dangerDX:armyPosE>armyPosM?1:-1,dangerDY:0,\n  dangerDist:phase==='playing'?Math.max(0,Math.abs(armyPosE-armyPosM)/800):1,\n  selfVX:armyModeM==='attack'?1:-1,selfVY:0,facing:1,\n  fireReady:1\n }),\n start:startGame,\n restart:startGame,\n inputs:{\n  left:()=>{},right: