%)',t:rnd(0,10)};}\n\nfunction reset(){\n  player={x:WS/2,y:WS/2,r:START_R};\n  foods=[]; for(let i=0;i<160;i++)foods.push(mkFood());\n  ais=[]; for(let i=0;i<16;i++)ais.push(mkAI());\n  keys={left:false,right:false,up:false,down:false,guard:false};\n  dashT=0; score=0;\n}\nreset();\n\nfunction allCells(){return [{r:player.r,me:true}].concat(ais.map(a=>({r:a.r})));}\nfunction rank(){let all=allCells(); all.sort((a,b)=>b.r-a.r); for(let i=0;i<all.length;i++) if(all[i].me) return i+1; return all.length;}\n\nfunction update(dt){\n  if(phase!=='playing') return;\n  let dx=(keys.right?1:0)-(keys.left?1:0), dy=(keys.down?1:0)-(keys.up?1:0);\n  let len=Math.hypot(dx,dy); if(len>0){dx/=len;dy/=len;}\n  let spd=(140*(30/Math.max(player.r,15)))*(dashT>0?2.2:1);\n  player.x+=dx*spd*dt; player.y+=dy*spd*dt;\n  player.x=Math.max(player.r,Math.min(WS-player.r,player.x));\n  player.y=Math.max(player.r,Math.min(WS-player.r,player.y));\n  if(keys.guard && dashT<=0 && player.r>START_R*1.2){\n    dashT=0.35; player.r*=0.92;\n  }\n  if(dashT>0) dashT-=dt;\n\n  for(let i=foods.length-1;i>=0;i--){\n    let f=foods[i]; let d=Math.hypot(player.x-f.x,player.y-f.y);\n    if(d<player.r+f.r){ player.r=Math.min(TARGET+40,Math.sqrt(player.r*player.r+f.r*f.r*0.6)); foods.splice(i,1); foods.push(mkFood()); }\n  }\n  for(let a of ais){\n    a.t-=dt;\n    let nx=null,nd=1e9,fx=null,fd=1e9;\n    for(let b of ais){ if(b===a)continue; let d=Math.hypot(a.x-b.x,a.y-b.y);\n      if(b.r<a.r*0.9 && d<fd){fd=d;fx=b;}\n      if(b.r>a.r*1.1 && d<nd){nd=d;nx=b;}\n    }\n    let pd=Math.hypot(a.x-player.x,a.y-player.y);\n    if(player.r>a.r*1.1 && pd<nd){nd=pd;nx=player;}\n    if(player.r<a.r*0.9 && pd<fd){fd=pd;fx=player;}\n    let vx=0,vy=0;\n    if(nx && nd<220){ vx=(a.x-nx.x)/nd; vy=(a.y-nx.y)/nd; }\n    else if(fx){ let d=fd||1; vx=(fx.x-a.x)/d; vy=(fx.y-a.y)/d; }\n    else if(a.t<0){ a.vx=rnd(-1,1); a.vy=rnd(-1,1); a.t=rnd(1,3); vx=a.vx; vy=a.vy; }\n    else { vx=a.vx; vy=a.vy; }\n    let sp=90*(20/Math.max(a.r,15));\n    a.x+=vx*sp*dt; a.y+=vy*sp*dt;\n    a.x=Math.max(a.r,Math.min(WS-a.r,a.x));\n    a.y=Math.max(a.r,Math.min(WS-a.r,a.y));\n  }\n  for(let i=ais.length-1;i>=0;i--){\n    let a=ais[i]; let d=Math.hypot(player.x-a.x,player.y-a.y);\n    if(d<Math.max(player.r,a.r)*0.9){\n      if(player.r>a.r*1.1){ player.r=Math.min(TARGET+40,Math.sqrt(player.r*player.r+a.r*a.r*0.5)); ais.splice(i,1); ais.push(mkAI()); }\n      else if(a.r>player.r*1.1){ gameOver(); return; }\n    }\n    for(let j=ais.length-1;j>=0;j--){\n      if(i===j||!ais[i]||!ais[j])continue;\n      let A=ais[i],B=ais[j]; if(!A||!B)continue;\n      let d2=Math.hypot(A.x-B.x,A.y-B.y);\n      if(d2<Math.max(A.r,B.r)*0.9){\n        if(A.r>B.r*1.1){ A.r=Math.min(TARGET,Math.sqrt(A.r*A.r+B.r*B.r*0.3)); ais.splice(j,1); ais.push(mkAI()); if(j<i)i--; }\n      }\n    }\n  }\n  score=Math.floor(player.r);\n  if(window.AJ) AJ.score(score);\n  if(player.r>=TARGET) clearGame();\n}\n\nfunction draw(){\n  ctx.fillStyle='#1b1f24'; ctx.fillRect(0,0,cv.width,cv.height);\n  if(phase==='title') return;\n  let cx=player.x,cy=player.y;\n  let ox=cv.width/2-cx, oy=cv.height/2-cy;\n  ctx.strokeStyle='#333'; ctx.lineWidth=4;\n  ctx.strokeRect(ox,oy,WS,WS);\n  for(let f of foods){\n    let x=f.x+ox,y=f.y+oy;\n    if(x<-20||x>cv.width+20||y<-20||y>cv.height+20)continue;\n    ctx.fillStyle=f.c; ctx.beginPath(); ctx.arc(x,y,f.r,0,7); ctx.fill();\n  }\n  for(let a of ais){\n    let x=a.x+ox,y=a.y+oy;\n    if(x<-a.r-20||x>cv.width+a.r+20||y<-a.r-20||y>cv.height+a.r+20)continue;\n    ctx.fillStyle=a.c; ctx.beginPath(); ctx.arc(x,y,a.r,0,7); ctx.fill();\n  }\n  let px=cv.width/2,py=cv.height/2;\n  if(playerSkin){\n    let s=player.r*2.2;\n    ctx.drawImage(playerSkin,px-s/2,py-s/2,s,s);\n  } else {\n    ctx.fillStyle='#4caf50'; ctx.beginPath(); ctx.arc(px,py,player.r,0,7); ctx.fill();\n    ctx.strokeStyle='#fff'; ctx.lineWidth=2; ctx.stroke();\n  }\n  hud.textContent='크기: '+Math.floor(player.r)+' / '+TARGET+'  순위: '+rank()+'/'+(ais.length+1);\n  if(window.vibrexBot && window.vibrexBot.__on){\n    ctx.fillStyle='#ff0'; ctx.font='16px sans-serif'; ctx.fillText('AI PLAYING',cv.width/2-40,24);\n  }\n}\n\nlet last=performance.now();\nfunction loop(t){\n  let dt=Math.min(0.05,(t-last)/1000); last=t;\n  update(dt); draw();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nfunction showUI(html){ ui.style.display='flex'; ui.innerHTML=html; }\nfunction hideUI(){ ui.style.display='none'; }\n\nfunction startGame(){\n  reset(); phase='playing'; hideUI();\n  if(window.AJ) AJ.start();\n}\nfunction gameOver(){\n  phase='over';\n  showUI('<div><h1>게임오버</h1><p>먹혔습니다! 최종 크기: '+Math.floor(player.r)+'</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>');\n  document.getElementById('rb').onclick=startGame;\n  if(window.AJ) AJ.over(score);\n}\nfunction clearGame(){\n  phase='cleared';\n  document.body.setAttribute('data-vibrex-role','cleared');\n  showUI('<div data-vibrex-role=\"clear\"><h1>클리어!</h1><p>목표 크기 도달! 점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>');\n  document.getElementById('rb').onclick=startGame;\n  if(window.AJ) AJ.clear(score);\n}\ndocument.getElementById('vibrex-start').onclick=startGame;\n\naddEventListener('keydown',e=>{\n  if(e.code==='ArrowLeft')keys.left=true;\n  if(e.code==='ArrowRight')keys.right=true;\n  if(e.code==='ArrowUp')keys.up=true;\n  if(e.code==='ArrowDown')keys.down=true;\n  if(e.code==='KeyX'||e.code==='KeyD')keys.guard=true;\n});\naddEventListener('keyup',e=>{\n  if(e.code==='ArrowLeft')keys.left=false;\n  if(e.code==='ArrowRight')keys.right=false;\n  if(e.code==='ArrowUp')keys.up=false;\n  if(e.code==='ArrowDown')keys.down=false;\n  if(e.code==='KeyX'||e.code==='KeyD')keys.guard=false;\n});\n\nfunction computeState(){\n  let all=[]; let selfObj={r:player.r,me:true};\n  ais.forEach(a=>all.push({r:a.r,x:a.x,y:a.y}));\n  let nearestFood=null,nfd=1e9;\n  for(let f of foods){ let d=Math.hypot(player.x-f.x,player.y-f.y); if(d<nfd){nfd=d;nearestFood=f;} }\n  let nearestSmall=null,nsd=1e9;\n  for(let a of ais){ if(a.r<player.r*0.9){ let d=Math.hypot(player.x-a.x,player.y-a.y); if(d<nsd){nsd=d;nearestSmall=a;} } }\n  let target=null,td=1e9;\n  if(nearestSmall && nsd<nfd){target=nearestSmall;td=nsd;} else {target=nearestFood;td=nfd;}\n  let danger=null,dd=1e9;\n  for(let a of ais){ if(a.r>player.r*1.1){ let d=Math.hypot(player.x-a.x,player.y-a.y); if(d<dd){dd=d;danger=a;} } }\n  let VR=500;\n  let tdx=0,tdy=0,tdist=1;\n  if(target){ tdx=Math.max(-1,Math.min(1,(target.x-player.x)/VR)); tdy=Math.max(-1,Math.min(1,(target.y-player.y)/VR)); tdist=Math.min(1,td/VR); }\n  let ddx=0,ddy=0,ddist=1;\n  if(danger){ ddx=Math.max(-1,Math.min(1,(danger.x-player.x)/VR)); ddy=Math.max(-1,Math.min(1,(danger.y-player.y)/VR)); ddist=Math.min(1,dd/VR); }\n  return {\n    selfX:player.x/WS, selfY:player.y/WS, size:Math.min(1,player.r/TARGET),\n    targetDX:tdx,targetDY:tdy,targetDist:tdist,\n    dangerDX:ddx,dangerDY:ddy,dangerDist:ddist,\n    rank:rank(), progress:Math.min(1,player.r/TARGET),\n    score:score, aliveCells:ais.length+1,\n    dangerCount: ais.filter(a=>a.r>player.r*1.1).length,\n    targetCount: foods.length+ais.filter(a=>a.r<player.r*0.9).length\n  };\n}\n\nwindow.VIBREX_GAME={\n  title:'세포 성장', genre:'topdown-survival',\n  goal:'세포를 성장시켜 목표 크기 도달', clearCondition:'크기 '+TARGET+' 도달 시 클리어',\n  controls:[{input:'ArrowLeft/Right/Up/Down',action:'이동'},{input:'guard',action:'분열 대시(작아짐)'}],\n  phase:()=>phase, progress:()=>Math.min(1,player.r/TARGET),\n  state:()=>computeState(),\n  start:startGame, restart:startGame,\n  inputs:{\n    left:on=>keys.left=on, right:on=>keys.right=on, up:on=>keys.up=on, down:on=>keys.down=on,\n    guard:on=>keys.guard=on, jump:()=>{}, fire:()=>{}, useItem:()=>{}\n  }\n};\n\nwindow.vibrexBot={\n  __on:false,\n  start(){\n    this.__on=true;\n    this._iv=setInterval(()=>{\n      if(phase==='title'){ document.getElementById('vibrex-start').click(); return