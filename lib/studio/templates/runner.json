ue:s,configurable:true})}catch(_){}try{Object.defineProperty(window,'sessionStorage',{value:s,configurable:true})}catch(_){}})()}</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>공룡 무한 러너</title>\n<style>\n  html,body{margin:0;padding:0;width:100%;height:100%;background:#000;overflow:hidden;touch-action:none;-webkit-user-select:none;user-select:none;font-family:'Segoe UI',sans-serif;}\n  #wrap{width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;background:#000;}\n  canvas{display:block;background:#f7f7f7;image-rendering:crisp-edges;}\n  #touchControls{\n    position:fixed;left:0;bottom:0;width:100%;\n    display:none; justify-content:space-between; align-items:flex-end;\n    padding:0 3vw 3vh 3vw; box-sizing:border-box; pointer-events:none; z-index:10;\n  }\n  .ctrlBtn{\n    pointer-events:auto;\n    width:clamp(64px,16vmin,110px); height:clamp(64px,16vmin,110px);\n    border-radius:50%; border:3px solid rgba(255,255,255,0.6);\n    background:rgba(60,60,60,0.55); color:#fff;\n    font-size:clamp(13px,3vmin,18px); font-weight:bold;\n    display:flex;align-items:center;justify-content:center;\n    touch-action:none; -webkit-tap-highlight-color:transparent;\n    user-select:none;\n  }\n  .ctrlBtn:active{ background:rgba(120,120,120,0.75); }\n  #hint{\n    position:fixed; top:1.5vh; left:50%; transform:translateX(-50%);\n    color:#888; font-size:clamp(11px,2vmin,15px); pointer-events:none; z-index:5;\n    text-align:center; white-space:nowrap;\n  }\n</style>\n</head>\n<body>\n<div id=\"wrap\"><canvas id=\"c\"></canvas></div>\n<div id=\"hint\"></div>\n<div id=\"touchControls\">\n  <button id=\"duckBtn\" class=\"ctrlBtn\">⬇<br>숙이기</button>\n  <button id=\"jumpBtn\" class=\"ctrlBtn\">⬆<br>점프</button>\n</div>\n<script>\n(function(){\n  const canvas = document.getElementById('c');\n  const ctx = canvas.getContext('2d');\n  const VW = 1000, VH = 300;\n\n  function resize(){\n    const dpr = window.devicePixelRatio || 1;\n    const scale = Math.min(window.innerWidth / VW, window.innerHeight / VH);\n    canvas.style.width = (VW*scale) + 'px';\n    canvas.style.height = (VH*scale) + 'px';\n    canvas.width = Math.round(VW*scale*dpr);\n    canvas.height = Math.round(VH*scale*dpr);\n    ctx.setTransform(scale*dpr, 0, 0, scale*dpr, 0, 0);\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  const isTouch = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;\n  const touchControls = document.getElementById('touchControls');\n  const hintEl = document.getElementById('hint');\n  if(isTouch){\n    touchControls.style.display = 'flex';\n    hintEl.textContent = '화면을 탭하거나 버튼으로 점프 / 숙이기';\n  } else {\n    hintEl.textContent = 'SPACE / ↑ : 점프    ↓ : 숙이기';\n  }\n  document.body.addEventListener('touchmove', function(e){ e.preventDefault(); }, {passive:false});\n\n  // ---------- constants ----------\n  const GROUND_Y = VH - 40;\n  const GRAVITY = 1500;\n  const JUMP_VEL = 560;\n  const STAND_W = 42, STAND_H = 46;\n  const CROUCH_W = 58, CROUCH_H = 22;\n  const BIRD_TOP_OFFSET = 70; // above ground\n  const BIRD_H = 36;\n  const MARGIN = 4; // collision leniency\n  const BASE_SPEED = 260, MAX_SPEED = 700, ACCEL = 4.2;\n  const HS_KEY = 'dinoRunnerHighScore_v1';\n\n  // ---------- state ----------\n  let state = 'ready'; // ready, playing, over\n  let score = 0;\n  let highScore = parseFloat(localStorage.getItem(HS_KEY) || '0');\n  let elapsed = 0;\n  let speed = BASE_SPEED;\n  let spawnTimer = 1.2;\n  let groundOffset = 0;\n  let obstacles = [];\n  let clouds = [];\n  let stars = [];\n  let dino = { airborne:0, vy:0, onGround:true, crouching:false, legPhase:0, legTimer:0 };\n  let duckHeld = false;\n  let fastFall = false;\n  let flashTimer = 0;\n\n  function initDeco(){\n    clouds = [];\n    for(let i=0;i<5;i++){\n      clouds.push({x: Math.random()*VW, y: 30+Math.random()*70, r: 14+Math.random()*10});\n    }\n    stars = [];\n    for(let i=0;i<40;i++){\n      stars.push({x: Math.random()*VW, y: Math.random()*(GROUND_Y-40), r: Math.random()*1.6+0.4, ph: Math.random()*Math.PI*2});\n    }\n  }\n  initDeco();\n\n  function resetGame(){\n    score = 0;\n    elapsed = 0;\n    speed = BASE_SPEED;\n    spawnTimer = 1.3;\n    obstacles = [];\n    groundOffset = 0;\n    dino.airborne = 0;\n    dino.vy = 0;\n    dino.onGround = true;\n    dino.crouching = false;\n    dino.legPhase = 0;\n    dino.legTimer = 0;\n    fastFall = false;\n  }\n\n  function startGame(){\n    resetGame();\n    state = 'playing';\n  }\n  function gameOver(){\n    state = 'over';\n    if(score > highScore){\n      highScore = score;\n      localStorage.setItem(HS_KEY, String(highScore));\n    }\n    flashTimer = 0.15;\n  }\n\n  function doJump(){\n    if(state === 'ready'){ startGame(); return; }\n    if(state === 'over'){ startGame(); return; }\n    if(state === 'playing' && dino.onGround && !dino.crouching){\n      dino.vy = JUMP_VEL;\n      dino.onGround = false;\n    } else if(state === 'playing' && dino.onGround && dino.crouching){\n      // allow jump out of crouch too\n      dino.vy = JUMP_VEL;\n      dino.onGround = false;\n      dino.crouching = false;\n    }\n  }\n  function setDuck(v){\n    duckHeld = v;\n    if(state === 'ready' && v){ startGame(); return; }\n    if(state === 'over') return;\n    if(state === 'playing'){\n      if(dino.onGround){ dino.crouching = v; }\n      fastFall = v && !dino.onGround;\n    }\n  }\n\n  // ---------- input ----------\n  window.addEventListener('keydown', function(e){\n    if(e.code === 'Space' || e.code === 'ArrowUp'){\n      e.preventDefault(); doJump();\n    } else if(e.code === 'ArrowDown'){\n      e.preventDefault(); setDuck(true);\n    }\n  });\n  window.addEventListener('keyup', function(e){\n    if(e.code === 'ArrowDown'){ setDuck(false); }\n  });\n\n  canvas.addEventListener('pointerdown', function(e){\n    e.preventDefault();\n    doJump();\n  });\n\n  const jumpBtn = document.getElementById('jumpBtn');\n  const duckBtn = document.getElementById('duckBtn');\n  jumpBtn.addEventListener('pointerdown', function(e){ e.preventDefault(); doJump(); });\n  duckBtn.addEventListener('pointerdown', function(e){ e.preventDefault(); setDuck(true); });\n  duckBtn.addEventListener('pointerup', function(e){ e.preventDefault(); setDuck(false); });\n  duckBtn.addEventListener('pointerleave', function(e){ setDuck(false); });\n  duckBtn.addEventListener('pointercancel', function(e){ setDuck(false); });\n\n  // ---------- obstacles ----------\n  function computeInterval(){\n    let base = 1.3 + Math.random()*0.9;\n    let reduction = Math.min(0.75, elapsed*0.01);\n    return Math.max(0.75, base - reduction);\n  }\n\n  function spawnObstacle(){\n    const allowBird = elapsed > 10;\n    if(allowBird && Math.random() < 0.32){\n      obstacles.push({\n        type:'bird', x: VW+40, w: 46, h: BIRD_H, topOff: BIRD_TOP_OFFSET, flapT: 0, flap:0\n      });\n    } else {\n      let maxCount = elapsed > 20 ? 3 : (elapsed > 8 ? 2 : 1);\n      let count = 1 + Math.floor(Math.random()*maxCount);\n      let parts = [];\n      let totalW = 0;\n      let maxH = 0;\n      for(let i=0;i<count;i++){\n        let w = 16 + Math.random()*10;\n        let h = 26 + Math.random()*22;\n        parts.push({dx: totalW, w:w, h:h});\n        totalW += w + 3;\n        if(h > maxH) maxH = h;\n      }\n      obstacles.push({ type:'cactus', x: VW+40, w: totalW, h: maxH, parts: parts });\n    }\n  }\n\n  function aabb(a,b){\n    return a.x < b.x+b.w && a.x+a.w > b.x && a.y < b.y+b.h && a.y+a.h > b.y;\n  }\n\n  // ---------- update ----------\n  function update(dt){\n    groundOffset -= speed*dt;\n\n    // clouds always drift slowly\n    for(const cl of clouds){\n      cl.x -= 20*dt;\n      if(cl.x < -40){ cl.x = VW+40; cl.y = 20+Math.random()*70; cl.r = 14+Math.random()*10; }\n    }\n\n    if(state !== 'playing'){\n      if(flashTimer>0) flashTimer -= dt;\n      return;\n    }\n\n    elapsed += dt;\n    speed = Math.min(MAX_SPEED, BASE_SPEED + elapsed*ACCEL);\n    score += dt*speed*0.09;\n\n    // physics\n    let g = GRAVITY * (fastFall ? 2.4 : 1);\n    dino.vy -= g*dt;\n    dino.airborne += dino.vy*dt;\n    if(dino.airborne <= 0){\n      dino.airborne = 0;\n      dino.vy = 0;\n      dino.onGround = true;\n      dino.crouching = duckHeld;\n    } else {\n      dino.onGround = false;\n    }\n\n    // leg animation\n    if(dino.onGround){\n      dino.legTimer += dt;\n      const cycleTime = Math.max(0.08, 0.16 - speed*0.00012);\n      if(dino.legTimer > cycleTime){ dino.legTimer = 0; dino.legPhase = 1-dino.legPhase; }\n    }\n\n    // spawn\n    spawnTimer -= dt;\n    if(spawnTimer <= 0){\n      spawnObstacle();\n      spawnTimer = computeInterval();\n    }\n\n    // move & collide\n    const dw = dino.crouching ? CROUCH_W : STAND_W;\n    const dh = dino.crouching ? CROUCH_H : STAND_H;\n    const footY = GROUND_Y - dino.airborne;\n    const dinoBox = {\n      x: 80 + MARGIN, y: (footY - dh) + MARGIN,\n      w: dw - MARGIN*2, h: dh - MARGIN*2\n    };\n\n    for(let i=obstacles.length-1;i>=0;i--){\n      const o = obstacles[i];\n      o.x -= speed*dt;\n      if(o.type === 'bird'){\n        o.flapT += dt;\n        if(o.flapT > 0.15){ o.flapT = 0; o.flap = 1-o.flap; }\n      }\n      if(o.x + o.w < -20){ obstacles.splice(i,1); continue; }\n\n      let obox;\n      if(o.type === 'bird'){\n        obox = { x:o.x, y: GROUND_Y - o.topOff, w:o.w, h:o.h };\n      } else {\n        obox = { x:o.x, y: GROUND_Y - o.h, w:o.w, h:o.h };\n      }\n      const obShrunk = { x:obox.x+MARGIN, y:obox.y+MARGIN, w:obox.w-MARGIN*2, h:obox.h-MARGIN*2 };\n      if(aabb(dinoBox, obShrunk)){\n        gameOver();\n      }\n    }\n  }\n\n  // ---------- palette ----------\n  function getPalette(){\n    const night = Math.floor(score/500) % 2 === 1;\n    return night\n      ? { bg:'#0c1420', fg:'#e8e8e8', ground:'#e8e8e8', night:true }\n      : { bg:'#f7f7f7', fg:'#535353', ground:'#535353', night:false };\n  }\n\n  // ---------- drawing ----------\n  function drawDino(x, footY, crouching, legPhase, dead, color){\n    ctx.save();\n    ctx.translate(x, footY);\n    ctx.fillStyle = dead ? '#c0392b' : color;\n    if(!crouching){\n      const w = STAND_W, h = STAND_H;\n      const legH = 14, legW = 8;\n      const off = legPhase ? 5 : -1;\n      ctx.fillRect(6+off, -legH, legW, legH);\n      ctx.fillRect(w-16-off, -legH, legW, legH);\n      ctx.fillRect(-6, -h+6, 14, 10); // tail\n      ctx.fillRect(0, -h, w-10, h-legH+2); // body\n      ctx.fillRect(w-24, -h-16, 26, 24); // head\n      ctx.fillStyle = dead ? '#000' : (color==='#e8e8e8' ? '#111' : '#fff');\n      ctx.fillRect(w-10, -h-8, 4, 4); // eye\n    } else {\n      const w = CROUCH_W, h = CROUCH_H;\n      const legH = 8, legW = 8;\n      const off = legPhase ? 4 : -1;\n      ctx.fillRect(10+off, -legH, legW, legH);\n      ctx.fillRect(w-20-off, -legH, legW, legH);\n      ctx.fillRect(-8, -h+3, 14, 8); // tail\n      ctx.fillRect(0, -h, w-14, h-legH+2); // body\n      ctx.fillRect(w-28, -h-4, 30, 18); // head\n      ctx.fillStyle = dead ? '#000' : (color==='#e8e8e8' ? '#111' : '#fff');\n      ctx.fillRect(w-12, -h+1, 4, 4); // eye\n    }\n    ctx.restore();\n  }\n\n  function drawCactus(o, color){\n    ctx.fillStyle = color;\n    for(const p of o.parts){\n      const x = o.x + p.dx;\n      const y = GROUND_Y - p.h;\n      ctx.fillRect(x, y, p.w, p.h);\n      ctx.fillRect(x-4, y+p.h*0.3, 4, p.h*0.28);\n      ctx.fillRect(x+p.w, y+p.h*0.45, 4, p.h*0.25);\n    }\n  }\n\n  function drawBird(o, color){\n    ctx.fillStyle = color;\n    const cx = o.x + o.w/2;\n    const cy = GROUND_Y - o.topOff + o.h/2;\n    ctx.beginPath();\n    ctx.ellipse(cx, cy, o.w*0.32, o.h*0.32, 0, 0, Math.PI*2);\n    ctx.fill();\n    const wingUp = o.flap === 0;\n    ctx.beginPath();\n    if(wingUp){\n      ctx.moveTo(cx-6, cy);\n      ctx.lineTo(cx-26, cy-14);\n      ctx.lineTo(cx-2, cy-4);\n    } else {\n      ctx.moveTo(cx-6, cy);\n      ctx.lineTo(cx-26, cy+12);\n      ctx.lineTo(cx-2, cy+2);\n    }\n    ctx.closePath();\n    ctx.fill();\n    ctx.beginPath();\n    if(wingUp){\n      ctx.moveTo(cx+6, cy);\n      ctx.lineTo(cx+26, cy-14);\n      ctx.lineTo(cx+2, cy-4);\n    } else {\n      ctx.moveTo(cx+6, cy);\n      ctx.lineTo(cx+26, cy+12);\n      ctx.lineTo(cx+2, cy+2);\n    }\n    ctx.closePath();\n    ctx.fill();\n  }\n\n  function render(){\n    const pal = getPalette();\n    ctx.fillStyle = pal.bg;\n    ctx.fillRect(0,0,VW,VH);\n\n    // stars (night)\n    if(pal.night){\n      for(const s of stars){\n        const a = 0.5 + 0.5*Math.sin(performance.now()*0.002 + s.ph);\n        ctx.fillStyle = 'rgba(255,255,255,'+(0.3+0.6*a)+')';\n        ctx.beginPath();\n        ctx.arc(s.x, s.y, s.r, 0, Math.PI*2);\n        ctx.fill();\n      }\n      // moon\n      ctx.fillStyle = '#e8e8e8';\n      ctx.beginPath();\n      ctx.arc(VW-70, 50, 18, 0, Math.PI*2);\n      ctx.fill();\n      ctx.fillStyle = pal.bg;\n      ctx.beginPath();\n      ctx.arc(VW-62, 44, 16, 0, Math.PI*2);\n      ctx.fill();\n    } else {\n      ctx.fillStyle = 'rgba(180,180,180,0.5)';\n      for(const cl of clouds){\n        ctx.beginPath();\n        ctx.ellipse(cl.x, cl.y, cl.r, cl.r*0.6, 0, 0, Math.PI*2);\n        ctx.ellipse(cl.x+cl.r*0.8, cl.y+3, cl.r*0.7, cl.r*0.5, 0, 0, Math.PI*2);\n        ctx.fill();\n      }\n    }\n\n    // ground\n    ctx.strokeStyle = pal.ground;\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(0, GROUND_Y+1);\n    ctx.lineTo(VW, GROUND_Y+1);\n    ctx.stroke();\n    ctx.fillStyle = pal.ground;\n    const spacing = 42;\n    let off = groundOffset % spacing;\n    if(off > 0) off -= spacing;\n    for(let x = off; x < VW+spacing; x += spacing){\n      ctx.fillRect(x, GROUND_Y+6, 20, 3);\n    }\n\n    // obstacles\n    for(const o of obstacles){\n      if(o.type === 'cactus') drawCactus(o, pal.fg);\n      else drawBird(o, pal.fg);\n    }\n\n    // dino\n    const footY = GROUND_Y - dino.airborne;\n    drawDino(80, footY, dino.crouching, dino.legPhase, state==='over', pal.fg);\n\n    // score\n    ctx.fillStyle = pal.fg;\n    ctx.font = 'bold 20px monospace';\n    ctx.textAlign = 'right';\n    const scoreTxt = String(Math.floor(score)).padStart(5,'0');\n    const hsTxt = 'HI ' + String(Math.floor(highScore)).padStart(5,'0');\n    ctx.fillText(hsTxt + '   ' + scoreTxt, VW-20, 34);\n\n    if(state === 'ready'){\n      ctx.textAlign = 'center';\n      ctx.font = 'bold 26px sans-serif';\n      ctx.fillText('🦖 무한 러너', VW/2, VH/2 - 30);\n      ctx.font = '16px sans-serif';\n      ctx.fillText(isTouch ? '화면을 탭해서 시작' : 'SPACE / ↑ 를 눌러 시작', VW/2, VH/2 + 4);\n    } else if(state === 'over'){\n      if(flashTimer > 0){\n        ctx.fillStyle = 'rgba(255,255,255,0.5)';\n        ctx.fillRect(0,0,VW,VH);\n      }\n      ctx.fillStyle = pal.fg;\n      ctx.textAlign = 'center';\n      ctx.font = 'bold 30px sans-serif';\n      ctx.fillText('GAME OVER', VW/2, VH/2 - 30);\n      ctx.font = '16px sans-serif';\n      ctx.fillText('점수 ' + Math.floor(score) + '   최고점 ' + Math.floor(highScore), VW/2, VH/2);\n      ctx.fillText(isTouch ? '탭해서 재시작' : 'SPACE / ↑ 로 재시작', VW/2, VH/2 + 26);\n    }\n    ctx.textAlign = 'left';\n  }\n\n  // ---------- loop ----------\n  let last = performance.now();\n  function loop(now){\n    let dt = (now - last) / 1000;\n    if(dt > 0.05) dt = 0.05;\n    last = now;\n    update(dt);\n    render();\n    requestAnimationFrame(loop);\n  }\n  requestAnimationFrame(loop);\n})();\n</script>\n<script>(function(){var held={};var FB={\"jump\":[\"fire\",\"action\"],\"down\":[\"crouch\",\"guard\"],\"fire\":[\"action\"],\"guard\":[\"crouch\"],\"useItem\":[\"action2\"],\"action\":[\"jump\",\"fire\"],\"action2\":[\"useItem\",\"fire\"]};function I(){var G=window.VIBREX_GAME;return G&&G.inputs?G.inputs:null}function ch(code){var i=I();if(!i)return null;var T=window.VIBREX_CONTROLS||[{\"id\":\"left\",\"label\":\"왼쪽\",\"desc\":\"좌 이동·조