\n  } else {\n    enemies.push({x:650,y:GROUND-30,hp:40,vx:0,type:'boss',t:0,fireT:40});\n  }\n  if(window.AJ)AJ.level(wave);\n}\nfunction dropItem(x,y){\n  let r=Math.random();\n  let g=r<0.5?'common':r<0.8?'rare':r<0.95?'epic':'legend';\n  let kind=Math.random()<0.5?'weapon':'armor';\n  drops.push({x,y,kind,grade:g,t:0});\n}\nfunction gearScore(){return (GR[weapon].v-1)/2*0.5+(GR[armor].v-1)/2*0.5;}\nfunction tryEquip(){\n  let best=null,bd=9999;\n  for(const d of drops){\n    let dist=Math.hypot(d.x-px,d.y-py);\n    if(dist<40 && dist<bd){bd=dist;best=d;}\n  }\n  if(best){\n    let g=GR[best.grade].v;\n    if(best.kind=='weapon'&&g>GR[weapon].v){weapon=best.grade;}\n    else if(best.kind=='armor'&&g>GR[armor].v){armor=best.grade;}\n    drops.splice(drops.indexOf(best),1);\n  }\n}\n\nfunction update(dt){\n  if(phase!='playing')return;\n  let sp=3;\n  if(keys.left){pvx=-sp;facing=-1}\n  else if(keys.right){pvx=sp;facing=1}\n  else pvx*=0.8;\n  if(keys.jump&&onGround){pvy=-8;onGround=false;}\n  pvy+=0.35;\n  px+=pvx;py+=pvy;\n  px=Math.max(15,Math.min(W-15,px));\n  if(py>=GROUND-20){py=GROUND-20;pvy=0;onGround=true;}\n  fireT-=1;invT-=1;\n  if(keys.fire&&fireT<=0){\n    bullets.push({x:px+facing*15,y:py-8,vx:facing*8,dmg:1*GR[weapon].v});\n    fireT=Math.max(6,20-GR[weapon].v*4);\n  }\n  if(keys.useItem)tryEquip();\n\n  for(const b of bullets)b.x+=b.vx;\n  bullets=bullets.filter(b=>b.x>-20&&b.x<W+20);\n  for(const b of ebullets)b.x+=b.vx;\n  ebullets=ebullets.filter(b=>b.x>-20&&b.x<W+20);\n\n  for(const e of enemies){\n    e.t+=1;\n    let dir=px<e.x?-1:1;\n    if(e.type=='grunt'){\n      if(Math.abs(px-e.x)>150)e.x+=dir*1.2; \n      e.fireT-=1;\n      if(e.fireT<=0&&Math.abs(px-e.x)<400){ebullets.push({x:e.x,y:e.y-8,vx:dir*4});e.fireT=70+Math.random()*40;}\n    } else {\n      if(Math.abs(px-e.x)>200)e.x+=dir*0.8;\n      e.fireT-=1;\n      if(e.fireT<=0){ebullets.push({x:e.x,y:e.y-8,vx:dir*5});e.fireT=35;}\n    }\n  }\n  for(const b of bullets){\n    for(const e of enemies){\n      if(Math.abs(b.x-e.x)<18&&Math.abs(b.y-e.y)<20){e.hp-=b.dmg;b.x=-999;\n        if(e.hp<=0){score+=e.type=='boss'?500:50;if(window.AJ)AJ.score(score);dropItem(e.x,e.y-20);}\n      }\n    }\n  }\n  enemies=enemies.filter(e=>e.hp>0);\n  if(invT<=0){\n    for(const b of ebullets){\n      if(Math.abs(b.x-px)<15&&Math.abs(b.y-py)<20){\n        health-=0.12/GR[armor].v;invT=40;b.x=-999;\n      }\n    }\n    for(const e of enemies){\n      if(Math.abs(e.x-px)<20&&Math.abs(e.y-py)<20){health-=0.08/GR[armor].v;invT=40;}\n    }\n  }\n  health=Math.max(0,health);\n  if(health<=0){gameOver();}\n  if(enemies.length==0){\n    wave+=1;\n    if(wave>8){gameClear();}\n    else spawnWave();\n  }\n  drops=drops.filter(d=>{d.t+=1;return d.t<600;});\n}\n\nfunction gameOver(){phase='over';if(window.AJ)AJ.over(score);showUI();}\nfunction gameClear(){phase='cleared';if(window.AJ)AJ.clear(score);showUI();}\n\nfunction draw(){\n  ctx.clearRect(0,0,W,H);\n  ctx.fillStyle='#223';ctx.fillRect(0,0,W,H);\n  ctx.fillStyle='#354';ctx.fillRect(0,GROUND,W,H-GROUND);\n  for(const d of drops){\n    ctx.fillStyle=GR[d.grade].c;\n    ctx.beginPath();ctx.arc(d.x,d.y,8,0,7);ctx.fill();\n    ctx.fillStyle='#fff';ctx.font='10px sans-serif';ctx.textAlign='center';\n    ctx.fillText(d.kind=='weapon'?'⚔':'🛡',d.x,d.y+4);\n  }\n  for(const b of bullets){ctx.fillStyle='#ff0';ctx.fillRect(b.x-4,b.y-2,8,4);}\n  for(const b of ebullets){ctx.fillStyle='#f55';ctx.fillRect(b.x-4,b.y-2,8,4);}\n  for(const e of enemies){\n    ctx.fillStyle=e.type=='boss'?'#c33':'#e83';\n    let sz=e.type=='boss'?30:16;\n    ctx.fillRect(e.x-sz/2,e.y-sz*1.4,sz,sz*1.4);\n    ctx.fillStyle='#0f0';ctx.fillRect(e.x-sz/2,e.y-sz*1.4-8,sz*(e.hp/(e.type=='boss'?40:2+wave*0.5)),4);\n  }\n  if(playerSkin){\n    let s=32;\n    ctx.save();\n    if(facing<0){ctx.translate(px,0);ctx.scale(-1,1);ctx.translate(-px,0);}\n    ctx.drawImage(playerSkin,px-s/2,py-s*1.3,s,s*1.3);\n    ctx.restore();\n  } else {\n    ctx.fillStyle='#3cf';ctx.fillRect(px-8,py-28,16,28);\n  }\n  ctx.fillStyle='#fff';ctx.font='16px sans-serif';ctx.textAlign='center';\n  ctx.fillText('😀',px,py-32);\n\n  document.getElementById('hud').innerHTML=\n   `점수:${score} 웨이브:${wave}/8 체력:${Math.round(health*100)}%<br>무기:<span style=\"color:${GR[weapon].c}\">${weapon}</span> 방어구:<span style=\"color:${GR[armor].c}\">${armor}</span> 드롭:${drops.length}`;\n\n  if(botOn){ctx.fillStyle='#0f0';ctx.font='14px sans-serif';ctx.fillText('AI PLAYING',W/2,20);}\n}\n\nlet last=0;\nfunction loop(t){\n  let dt=t-last;last=t;\n  update(dt);draw();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\nfunction showUI(){\n  const ui=document.getElementById('ui');\n  if(phase=='title'){\n    ui.innerHTML=`<div><h1>웨이브 루트 슈터</h1>\n    <p>적을 잡아 장비를 얻고 8웨이브 보스를 처치하라</p>\n    <p style=\"font-size:13px\">조작: 방향키 이동/점프, 스페이스 사격, X 줍기</p>\n    <button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button></div>`;\n    document.getElementById('vibrex-start').onclick=startGame;\n  } else if(phase=='over'){\n    ui.innerHTML=`<div data-vibrex-role=\"over\"><h1>게임 오버</h1><p>점수:${score}</p><button data-vibrex-role=\"restart\" id=\"rb\">다시하기</button></div>`;\n    document.getElementById('rb').onclick=startGame;\n  } else if(phase=='cleared'){\n    ui.innerHTML=`<div data-vibrex-role=\"clear\"><h1>클리어!</h1><p>최종 점수:${score}</p><button data-vibrex-role=\"restart\" id=\"rb2\">다시하기</button></div>`;\n    document.getElementById('rb2').onclick=startGame;\n  } else {\n    ui.innerHTML='';\n  }\n}\nfunction startGame(){\n  reset();phase='playing';\n  if(window.AJ)AJ.start();\n  showUI();\n}\nshowUI();\n\naddEventListener('keydown',e=>{\n  if(e.code=='ArrowLeft')keys.left=true;\n  if(e.code=='ArrowRight')keys.right=true;\n  if(e.code=='ArrowUp'||e.code=='Space')keys.jump=true;\n  if(e.code=='Space')keys.fire=true;\n  if(e.code=='KeyX')keys.useItem=true;\n});\naddEventListener('keyup',e=>{\n  if(e.code=='ArrowLeft')keys.left=false;\n  if(e.code=='ArrowRight')keys.right=false;\n  if(e.code=='ArrowUp'||e.code=='Space')keys.jump=false;\n  if(e.code=='Space')keys.fire=false;\n  if(e.code=='KeyX')keys.useItem=false;\n});\n\naddEventListener('vibrex:avatar',e=>{playerSkin=e.detail.img;window.vibrexAvatarAck?.()});\naddEventListener('vibrex:avatar-remove',()=>{playerSkin=null});\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;window.vibrexAvatarAck?.();}\n\nwindow.VIBREX_GAME={\n  title:'웨이브 루트 슈터',genre:'sidescroll shooter',\n  goal:'8웨이브 보스를 처치하라',\n  clearCondition:'8웨이브 보스 처치',\n  controls:[{input:'ArrowLeft/Right',action:'이동'},{input:'ArrowUp/Space',action:'점프'},{input:'Space',action:'사격'},{input:'KeyX',action:'장비줍기'}],\n  phase:()=>phase,\n  progress:()=>Math.min(1,wave/8),\n  state:()=>{\n    let target=enemies[0],td=1,tdx=0,tdy=0;\n    let dang=null,dd=1,ddx=0,ddy=0;\n    let mind=9999;\n    for(const e of enemies){let d=Math.hypot(e.x-px,e.y-py);if(d<mind){mind=d;target=e;}}\n    if(target){tdx=Math.max(-1,Math.min(1,(target.x-px)/400));tdy=Math.max(-1,Math.min(1,(target.y-py)/400));td=Math.min(1,mind/500);}\n    let mind2=9999;\n    for(const b of ebullets){let d=Math.hypot(b.x-px,b.y-py);if(d<mind2)mind2=d;}\n    for(const e of enemies){let d=Math.hypot(e.x-px,e.y-py);if(d<mind2)mind2=d;}\n    dd=Math.min(1,mind2/500);\n    return {\n      selfX:px/W,selfY:py/H,selfVX:pvx/8,selfVY:pvy/10,facing,\n      targetDX:tdx,targetDY:tdy,targetDist:td,\n      dangerDX:ddx,dangerDY:ddy,dangerDist:dd,\n      groundDist:Math.max(0,(GROUND-py)/H),onGround:onGround?1:0,\n      health,score,progress:Math.min(1,wave/8),\n      gearScore:gearScore(),itemCount:drops.length,\n      fireReady:fireT<=0?1:0\n    };\n  },\n  start(){if(phase=='title')startGame();},\n  restart(){startGame();},\n  inputs:{\n    left:v=>keys.left=v,right:v=>keys.right=v,up:v=>{},down:v=>{},\n    jump:v=>keys.jump=v,fire:v=>keys.fire=v,guard:v=>{},\n    useItem:v=>keys.useItem=v,item1:v=>{},item2:v=>{},item3:v=>{},item4:v=>{}\n  }\n};\n\nlet botOn=false,