lassName='hide';startGame();},\ninputs:{\nleft:function(v){keys.left=v;},right:function(v){keys.right=v;},\nup:function(v){keys.up=v;},down:function(v){keys.down=v;},\njump:function(v){},fire:function(v){keys.fire=v;},guard:function(v){},\nuseItem:function(v){keys.useItem=v;},\nitem1:function(v){keys.item1=v;},item2:function(v){keys.item2=v;},\nitem3:function(v){keys.item3=v;},item4:function(v){}\n}\n};\n\nvar botActive=false;\nfunction botStep(dt){\nif(phase=='title'){document.getElementById('vibrex-start').click();return;}\nif(phase!='playing')return;\nvar s=window.VIBREX_GAME.state();\nkeys.left=keys.right=keys.up=keys.down=false;\nkeys.fire=false;keys.useItem=false;keys.item1=false;keys.item2=false;keys.item3=false;\nif(!isNight){\nif(s.hunger<0.5&&food>0){keys.useItem=true;}\nvar timeLeft=DAYLEN-timer;\nif(timeLeft<8){\nif(!hasSpear&&wood>=2&&stone>=2){keys.item3=true;}\nelse if(wood>=3){keys.item1=true;}\nelse if(wood>=2&&stone>=1){keys.item2=true;}\n}\nvar nr=nearestRes();\nif(nr){\nvar dx=nr.o.x-P.x,dy=nr.o.y-P.y;\nif(nr.d<28){keys.fire=true;}\nelse{if(dx<-5)keys.left=true;else if(dx>5)keys.right=true;\nif(dy<-5)keys.up=true;else if(dy>5)keys.down=true;}\n}\n}else{\nvar nt=nearestTorch();\nif(nt&&nt.d>40){\nvar dx=nt.o.x-P.x,dy=nt.o.y-P.y;\nif(dx<-5)keys.left=true;else if(dx>5)keys.right=true;\nif(dy<-5)keys.up=true;else if(dy>5)keys.down=true;\n}\nvar nm=nearestMon();\nif(nm&&nm.d<45&&hasSpear){keys.fire=true;}\nif(!hasSpear&&wood>=2&&stone>=2)keys.item3=true;\n}\nupdate.__bot=true;\n}\nwindow.vibrexBot={\nstart:function(){botActive=true;},\nstop:function(){botActive=false;keys.left=keys.right=keys.up=keys.down=false;keys.fire=false;},\nsetSkill:function(){}\n};\n</script>\n<script>(function(){if(!('ontouchstart' in window)&&!(navigator.maxTouchPoints>0))return;var held={};var codes={ArrowLeft:37,ArrowRight:39,ArrowUp:38,ArrowDown:40,' ':32,x:88};function kev(type,key){var code=key===' '?'Space':key==='x'?'KeyX':key;var o={key:key,code:code,keyCode:codes[ke