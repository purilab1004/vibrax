rock'?'🪨':'🍒',r.x,r.y);\n}\nctx.fillStyle='#8b5a2b';\nfor(var i=0;i<walls.length;i++){var w=walls[i];ctx.fillRect(w.x-14,w.y-14,28,28);}\nctx.font='26px sans-serif';\nfor(var i=0;i<torches.length;i++){\nvar t=torches[i];\nif(isNight){ctx.save();ctx.globalAlpha=0.15;ctx.fillStyle='orange';ctx.beginPath();ctx.arc(t.x,t.y,100,0,7);ctx.fill();ctx.restore();}\nctx.fillText('🔥',t.x,t.y);\n}\nfor(var i=0;i<monsters.length;i++){ctx.fillText('👹',monsters[i].x,monsters[i].y);}\nif(playerSkin){\nvar s=44;ctx.drawImage(playerSkin,P.x-s/2,P.y-s/2,s,s);\n}else{\nctx.font='30px sans-serif';ctx.fillText('🧑',P.x,P.y);\n}\nif(isNight){ctx.save();ctx.globalAlpha=0.35;ctx.fillStyle='#000030';ctx.fillRect(0,0,800,600);ctx.restore();}\nif(botActive){ctx.fillStyle='#0f0';ctx.font='16px monospace';ctx.textAlign='left';ctx.fillText('AI PLAYING',10,20);}\n}\n\nfunction hud(){\nvar el=document.getElementById('hud');\nif(phase!='playing'){el.innerHTML='';return;}\nel.innerHTML='Day '+(dayIndex+1)+'/3 '+(isNight?'🌙밤':'☀낮')+\n' | ❤'+Math.round(health*100)+'% 🍖'+Math.round(hunger*100)+'%<br>'+\n'🌲'+wood+' 🪨'+stone+' 🍒'+food+(hasSpear?' 🗡':'');\n}\n\nvar last=Date.now();\nfunction loop(){\nvar now=Date.now();var dt=Math.min(0.05,(now-last)/1000);last=now;\nupdate(dt);draw();hud();\nif(botActive)botStep(dt);\nrequestAnimationFrame(loop);\n}\nloop();\n\ndocument.getElementById('vibrex-start').onclick=function(){\ndocument.getElementById('ui').className='hide';\nstartGame();\n};\nfunction showUI(title,msg,role){\nvar ui=document.getElementById('ui');\nui.className='';ui.setAttribute('data-vibrex-role',role);\ndocument.getElementById('t').textContent=title;\ndocument.getElementById('msg').innerHTML=msg;\nvar btn=document.getElementById('vibrex-start');\nbtn.textContent=role=='start'?'시작':'다시하기';\nbtn.setAttribute('data-vibrex-role',role=='start'?'start':'restart');\nbtn.onclick=function(){ui.className='hide';startGame();};\n}\nvar lastPhase='title';\nsetInterval(function(){\nif(phase==lastPhase)return