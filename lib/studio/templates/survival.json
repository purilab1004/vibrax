16);\n}\n\nfunction startGame(){\nreset();phase='playing';\nif(window.AJ)AJ.start();\n}\nfunction overGame(){\nphase='over';\nif(window.AJ)AJ.over(Math.floor(score));\n}\nfunction clearGame(){\nphase='cleared';\nif(window.AJ)AJ.clear(Math.floor(score));\n}\nfunction setScore(s){\nscore=s;\nif(window.AJ)AJ.score(Math.floor(score));\n}\n\nfunction nearestRes(){\nvar best=null,bd=1e9;\nfor(var i=0;i<resources.length;i++){var r=resources[i];if(r.amt<=0)continue;var d=dist(P.x,P.y,r.x,r.y);if(d<bd){bd=d;best=r;}}\nreturn best?{o:best,d:bd}:null;\n}\nfunction nearestMon(){\nvar best=null,bd=1e9;\nfor(var i=0;i<monsters.length;i++){var m=monsters[i];var d=dist(P.x,P.y,m.x,m.y);if(d<bd){bd=d;best=m;}}\nreturn best?{o:best,d:bd}:null;\n}\nfunction nearestTorch(){\nvar best=null,bd=1e9;\nfor(var i=0;i<torches.length;i++){var t=torches[i];var d=dist(P.x,P.y,t.x,t.y);if(d<bd){bd=d;best=t;}}\nreturn best?{o:best,d:bd}:null;\n}\n\nfunction doFire(){\nvar nr=nearestRes();\nif(nr&&nr.d<30){\nvar r=nr.o;\nif(r.type=='tree')wood++;else if(r.type=='rock')stone++;else food++;\nr.amt--;if(r.amt<=0)resources.splice(resources.indexOf(r),1);\nsetScore(score+2);\nreturn;\n}\nif(hasSpear){\nvar nm=nearestMon();\nif(nm&&nm.d<45){\nnm.o.hp--;\nif(nm.o.hp<=0){monsters.splice(monsters.indexOf(nm.o),1);setScore(score+20);}\n}\n}\n}\nfunction doUseItem(){\nif(food>0){food--;hunger=Math.min(1,hunger+0.3);}\n}\nfunction doItem1(){\nif(wood>=3){wood-=3;walls.push({x:P.x+P.fx*40,y:P.y+P.fy*40,hp:3});}\n}\nfunction doItem2(){\nif(wood>=2&&stone>=1){wood-=2;stone--;torches.push({x:P.x+P.fx*40,y:P.y+P.fy*40});}\n}\nfunction doItem3(){\nif(!hasSpear&&wood>=2&&stone>=2){wood-=2;stone-=2;hasSpear=true;}\n}\n\nfunction spawnMonsters(n){\nfor(var i=0;i<n;i++){\nvar side=Math.floor(Math.random()*4);var x,y;\nif(side==0){x=0;y=rnd(0,600);}else if(side==1){x=800;y=rnd(0,600);}\nelse if(side==2){x=rnd(0,800);y=0;}else{x=rnd(0,800);y=600;}\nmonsters.push({x:x,y:y,hp:3});\n}}\n\nfunction update(dt){\nif(phase!='pla