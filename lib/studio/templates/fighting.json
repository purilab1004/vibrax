viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>격투대전</title>\n<style>\nhtml,body{margin:0;padding:0;background:#000;overflow:hidden;height:100%;touch-action:none;font-family:sans-serif;}\n#wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#000;}\ncanvas{background:#223;image-rendering:pixelalpha;}\n#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;text-align:center;z-index:5;}\n#ui.hidden{display:none;}\n#ui button{font-size:20px;padding:10px 24px;margin-top:14px;border-radius:10px;border:none;background:#e63;color:#fff;cursor:pointer;}\n#ui div.box{background:#111c;padding:20px 26px;border-radius:14px;max-width:90vw;}\n#tc{position:fixed;inset:0;pointer-events:none;z-index:4;display:none;}\n#tc.show{display:block;}\n.tb{position:absolute;pointer-events:auto;border-radius:50%;background:#fff3;color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;user-select:none;border:2px solid #fff6;}\n</style></head>\n<body>\n<div id=\"wrap\"><canvas id=\"c\"></canvas></div>\n<div id=\"tc\">\n<div class=\"tb\" id=\"bL\" style=\"left:16px;bottom:70px;width:60px;height:60px;\">◀</div>\n<div class=\"tb\" id=\"bR\" style=\"left:86px;bottom:70px;width:60px;height:60px;\">▶</div>\n<div class=\"tb\" id=\"bJ\" style=\"right:180px;bottom:100px;width:56px;height:56px;\">점프</div>\n<div class=\"tb\" id=\"bG\" style=\"right:250px;bottom:30px;width:56px;height:56px;\">막기</div>\n<div class=\"tb\" id=\"bF\" style=\"right:110px;bottom:30px;width:56px;height:56px;\">약공</div>\n<div class=\"tb\" id=\"bH\" style=\"right:20px;bottom:100px;width:60px;height:60px;\">강공</div>\n<div class=\"tb\" id=\"bS\" style=\"right:20px;bottom:20px;width:50px;height:50px;background:#f906;\">필살</div>\n</div>\n<div id=\"ui\">\n<div class=\"box\" id=\"uiTitle\">\n<h2>격투대전</h2>\n<p>3판 2선승, 라운드 60초</p>\n<p style=\"text-align:left;font-size:13px\">조작<br>←→: 이동 / ↑: 점프 / ↓: 막기<br>Space: 약공격(약→약→강 콤보)<br>X: 강공격 / C: 기 만땅시 필살기</p>\n<button id=\"vibrex-start\" data-vibrex-role=\"start\">시작</button>\n</div>\n</div>\n<script>\n(function(){\nvar cv=document.getElementById('c'),ctx=cv.getContext('2d');\nvar LW=800,LH=450;\nfunction resize(){var vw=window.innerWidth,vh=window.innerHeight;var s=Math.min(vw/LW,vh/LH);cv.width=LW*s;cv.height=LH*s;cv.style.width=cv.width+'px';cv.style.height=cv.height+'px';ctx.setTransform(s,0,0,s,0,0);}\nwindow.addEventListener('resize',resize);resize();\nvar GROUND=360,GRAV=1900,JUMPV=-640,SPD=250;\nvar keys={left:0,right:0,jump:0,guard:0,fire:0,useItem:0,item1:0};\nvar prev={fire:0,useItem:0,item1:0};\nvar pulses={};\nfunction pulse(n,d){pulses[n]=d||0.09;keys[n]=true;}\nvar playerSkin=null;\nif(window.VIBREX_AVATAR){playerSkin=window.VIBREX_AVATAR;}\nwindow.addEventListener('vibrex:avatar',function(e){playerSkin=e.detail.img;window.vibrexAvatarAck&&window.vibrexAvatarAck();});\nwindow.addEventListener('vibrex:avatar-remove',function(){playerSkin=null;});\n\nfunction newF(x,facing){return{x:x,y:GROUND,vx:0,vy:0,onGround:true,facing:facing,hp:1,meter:0,state:'idle',stun:0,comboStep:0,comboTimer:0,cooldown:0,atk:null,intent:0,intentTimer:0,intentType:'',dTimer:0.4};}\nvar player,enemy,phase='title',round=1,pWins=0,eWins=0,score=0,roundTimer=60,freeze=0,resultMsg='';\nfunction resetPositions(){player=newF(180,1);enemy=newF(620,-1);}\nresetPositions();\n\nvar ATK={weak:{startup:.08,active:.09,recover:.16,range:75,dmg:.06},\nstrong:{startup:.26,active:.12,recover:.34,range:82,dmg:.15},\ncombo:{startup:.2,active:.12,recover:.3,range:85,dmg:.23},\nspecial:{startup:.18,active:.16,recover:.32,range:115,dmg:.34}};\n\nfunction doAtk(f,type){f.state='atk';f.atk={type:type,timer:0,hasHit:false,def:ATK[type]};f.vx=0;}\n\nfunction edge(name){var v=keys[name]&&!prev[name];return v;}\n\nfunction handlePlayer(dt){\nvar f=player;\nif(f.state!=='atk'&&f.stun<=0){\n if(keys.guard){f.state='guard';f.vx=-f.facing*120;}\n else{f.state='idle';\n  var mv=0;if(keys.left)mv-=1;if(keys.right)mv+=1;f.vx=mv*SPD;\n  if(mv!==0)f.state='walk';\n  if(keys.jump&&f.onGround){f.vy=JUMPV;f.onGround=false;}\n }\n if(edge('fire')&&f.cooldown<=0){\n  if(f.comboStep===0){doAtk(f,'weak');f.comboStep=1;f.comboTimer=0.7;}\n  else if(f.comboStep===1){doAtk(f,'weak');f.comboStep=2;f.comboTimer=0.7;}\n  else {doAtk(f,'weak');f.comboStep=1;f.comboTimer=0.7;}\n } else if(edge('useItem')&&f.cooldown<=0){\n  if(f.comboStep===2&&f.comboTimer>0){doAtk(f,'combo');f.comboStep=0;}\n  else{doAtk(f,'strong');f.comboStep=0;}\n } else if(edge('item1')&&f.cooldown<=0&&f.meter>=1){\n  doAtk(f,'special');f.meter=0;f.comboStep=0;\n }\n}\n}\nfunction handleEnemy(dt){\nvar f=enemy,dist=Math.abs(player.x-f.x)/LW;\nf.dTimer-=dt;\nif(f.intent===1){\n f.intentTimer-=dt;\n if(f.intentTimer<=0){doAtk(f,f.intentType);f.intent=0;}\n} else if(f.state!=='atk'&&f.stun<=0){\n if(f.dTimer<=0){\n  f.dTimer=0.35+Math.random()*0.35;\n  var r=Math.random();\n  if(dist>0.35){\n   f.state='walk';f.vx=(player.x>f.x?1:-1)*SPD*0.8;\n   if(r<0.15){f.vy=JUMPV;f.onGround=false;f.intent=2;}else f.intent=0;\n  } else if(dist>0.15){\n   if(r<0.45){f.intent=1;f.intentTimer=0.35;f.intentType=Math.random()<0.5?'weak':'strong';f.vx=0;f.state='idle';}\n   else if(r<0.75){f.state='walk';f.vx=(player.x>f.x?1:-1)*SPD*0.7;f.intent=0;}\n   else{f.state='guard';f.vx=-f.facing*100;f.intent=0;}\n  } else {\n   if(f.meter>=1&&r<0.3){f.intent=1;f.intentTimer=0.3;f.intentType='special';}\n   else if(r<0.55){f.intent=1;f.intentTimer=0.28;f.intentType=Math.random()<0.6?'weak':'strong';f.vx=0;f.state='idle';}\n   else if(r<0.8){f.state='guard';f.vx=-f.facing*90;f.intent=0;}\n   else{f.state='walk';f.vx=-(player.x>f.x?1:-1)*SPD*0.6;f.intent=0;}\n  }\n } else if(f.state==='walk'){}\n}\nif(f.intent===1&&f.state==='atk')f.intent=0;\n}\n\nfunction physics(f,dt){\nif(f.state!=='atk'&&f.stun<=0&&f.state!=='guard'){f.x+=f.vx*dt;}\nelse if(f.state==='guard'){f.x+=f.vx*dt;}\nf.x=Math.max(40,Math.min(LW-40,f.x));\nif(!f.onGround){f.vy+=GRAV*dt;f.y+=f.vy*dt;if(f.y>=GROUND){f.y=GROUND;f.vy=0;f.onGround=true;}}\nif(f.stun>0){f.stun-=dt;if(f.stun<=0){f.state='idle';}}\nif(f.comboTimer>0){f.comboTimer-=dt;if(f.comboTimer<=0)f.comboStep=0;}\nif(f.cooldown>0)f.cooldown-=dt;\nif(f.atk){\n f.atk.timer+=dt;var d=f.atk.def;\n var t=f.atk.timer;\n if(t>=d.startup+d.active+d.recover){f.atk=null;f.state='idle';f.cooldown=0.08;}\n}\nvar other=f===player?enemy:player;\nif(f.state!=='atk')f.facing=other.x>f.x?1:-1;\n}\nfunction checkHits(){\n[[player,enemy],[enemy,player]].forEach(function(pair){\n var a=pair[0],b=pair[1];\n if(a.atk&&!a.atk.hasHit){\n  var d=a.atk.def,t=a.atk.timer;\n  if(t>=d.startup&&t<=d.startup+d.active){\n   var dist=Math.abs(b.x-a.x);\n   var facingOk=(b.x-a.x)*a.facing>=-10;\n   if(dist<=d.range&&facingOk){\n    a.atk.hasHit=true;\n    var blocked=(b.state==='guard'&&(a.x-b.x)*b.facing<=10);\n    var dmg=d.dmg;\n    if(blocked){dmg*=0.15;b.meter=Math.min(1,b.meter+0.03);}\n    else{b.stun=0.35;b.state='hit';b.vx=0;b.meter=Math.min(1,b.meter+0.06);}\n    b.hp=Math.max(0,b.hp-dmg);\n    a.meter=Math.min(1,a.meter+0.12);\n    if(a===player){score+=Math.round(dmg*400);if(window.AJ)AJ.score(score);}\n   }\n  }\n }\n});\n}\nfunction endRound(winner){\n if(!winner){\n  if(player.hp>enemy.hp)winner='player';else if(enemy.hp>player.hp)winner='enemy';else winner='player';\n }\n if(winner==='player'){pWins++;score+=500;}else{eWins++;}\n if(window.AJ)AJ.score(score);\n if(pWins>=2){phase='cleared';if(window.AJ)AJ.clear(score);showEnd();return;}\n if(eWins>=2){phase='over';if(window.AJ)AJ.over(score);showEnd();return;}\n round++;if(window.AJ)AJ.level(round);\n resetPositions();roundTimer=60;freeze=1.4;\n}\nfunction showEnd(){\nvar ui=document.getElementById('ui');ui.classList.remove('hidden');\nvar box=document.createElement('div');box.className='box';\nif(phase==='cleared'){\n ui.setAttribute('data-vibrex-role','clear');\n box.innerHTML='<h2>승리! 우승자입니다</h2><p>최종 점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rbtn\">다시하기</button>';\n}else{\n box.innerHTML='<h2>패배</h2><p>최종 점수: '+score+'</p><button data-vibrex-role=\"restart\" id=\"rbtn\">다시하기</button>';\n}\nui.innerHTML='';ui.appendChild(box);\ndocument.getElementById('rbtn').onclick=function(){restart();};\ndocument.getElementById('tc').classList.remove('show');\n}\nfunction restart(){\nround=1;pWins=0;eWins=0;score=0;roundTimer=60;freeze=0;resultMsg='';\nresetPositions();\ndocument.getElementById('ui').classList.add('hidden');\ndocument.getElementById('ui').removeAttribute('data-vibrex-role');\nif(!botOn)document.getElementById('tc').classList.add('show');\nphase='playing';\nif(window.AJ)AJ.start();\n}\nfunction start(){\ndocument.getElementById('ui').classList.add('hidden');\nif(!botOn)document.getElementById('tc').classList.add('show');\nphase='playing';\nresetPositions();round=1;pWins=0;eWins=0;score=0;roundTimer=60;freeze=0;\nif(window.AJ)AJ.start();\n}\ndocument.getElementById('vibrex-start').onclick=start;\n\nvar last=0;\nfunction loop(ts){\nvar dt=Math.min(0.033,(ts-last)/1000||0.016);last=ts;\nfor(var k in pulses){pulses[k]-=dt;if(pulses[k]<=0){keys[k]=false;delete pulses[k];}}\nif(phase==='playing'){\n if(freeze>0){freeze-=dt;}\n else{\n  roundTimer-=dt;\n  handlePlayer(dt);handleEnemy(dt);\n  physics(player,dt);physics(enemy,dt);\n  checkHits();\n  if(player.hp<=0)endRound('enemy');\n  else if(enemy.hp<=0)endRound('player');\n  else if(roundTimer<=0)endRound(null);\n }\n}\nprev.fire=keys.fire;prev.useItem=keys.useItem;prev.item1=keys.item1;\ndraw();\nif(botOn)botTick(dt);\nrequestAnimationFrame(loop);\n}\nfunction drawFighter(f,color,skin){\nctx.save();\nvar w=48,h=110;\nif(skin){\n var iw=90,ih=110;\n ctx.save();\n if(f.facing<0){ctx.translate(f.x,0);ctx.scale(-1,1);ctx.drawImage(skin,-iw/2,f.y-ih,iw,ih);}\n else ctx.drawImage(skin,f.x-iw/2,f.y-ih,iw,ih);\n ctx.restore();\n}else{\n ctx.fillStyle=color;\n ctx.fillRect(f.x-w/2,f.y-h,w,h);\n ctx.begin