{
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/aj-design",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/story",
      "schedule": "0 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/godot/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}